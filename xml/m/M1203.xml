  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠮᠠᠺᠥᠰᠲᠠᠺᠥ</unicode>
      <uighur>meküsdekü</uighur>
      <cyrillic>мөхөстөх</cyrillic>
      <transcript>MEKYSTE-</transcript>
      <definition>[=megysde-] v.i. To lose one's strength, weaken; to be feeble; to be insufficient, poor, mediocre; to lack.</definition>
      <page>534</page>
      <examples>
        <example>
          <unicode>ᠠᠷᠭ᠎ᠠ ᠮᠠᠺᠥᠰᠲᠠᠺᠥ</unicode>
          <transcript>arγ-a –ky </transcript>
          <definition>To lack means</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠳᠠᠯ ᠮᠠᠺᠥᠰᠲᠠᠺᠥ</unicode>
          <transcript>cidal --ky</transcript>
          <definition> To lack power or strength.</definition>
        </example>
        <example>
          <unicode>ᠳᠤᠲᠠᠭᠳᠠᠨ ᠮᠠᠺᠥᠰᠲᠠᠺᠥ</unicode>
          <transcript>dutaγdan --ky</transcript>
          <definition> To lack or be insufficient.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠷ ᠤᠨ ᠠᠵᠤ ᠺᠢᠺᠦ ᠺᠦᠮᠦᠨ ᠢᠶᠡᠷ ᠮᠠᠺᠥᠰᠲᠠᠺᠥ</unicode>
          <transcript>ger yn azu kiky kymyn ijer --ky</transcript>
          <definition> To lack or need someone to do the household work.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠮᠡᠺᠦᠰᠳᠡᠺᠦ</unicode>
      <definition>être . faible, être épuisé: 2 être pauvre, indigent.</definition>
      <page>2018</page>
      <examples>
        <example>
          <unicode>ᠺᠦᠴᠦᠪᠡᠨ ᠮᠡᠺᠦᠰᠳᠡᠺᠦ</unicode>
          <definition>s'affaiblir, devenir faible</definition>
        </example>
      </examples>
    </entry_item>
  </entries>
