    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠮᠥᠯᠲᠥᠯᠠᠺᠥ</unicode>
      <uighur>möldülekü</uighur>
      <cyrillic>мөлтлөх</cyrillic>
      <transcript>MØLTYLE-</transcript>
      <definition>v.t. To dislocate, disjoint. cf. multul-.</definition>
      <page>546</page>
      <examples>
        <example>
          <unicode>ᠡᠷᠡᠭᠦᠦ ᠎ᠶᠢ ᠢᠨᠤ ᠮᠥᠯᠲᠥᠯᠠᠺᠥ</unicode>
          <transcript>eregyy ji inu --ky</transcript>
          <definition>To dislocate someone's jaw</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠮᠥᠯᠳᠦᠯᠡᠺᠦ</unicode>
      <definition>faire descendre: 2 arracher, dévisser: 3 dételer, détacher. séparer: 4 ôter (cerceau, écrou, anneau).</definition>
      <page>2059</page>
      <examples>
        <example>
          <unicode>ᠤᠷᠤᠬ ᠢᠶᠠᠨ ᠮᠥᠯᠲᠵᠦ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <definition>faire descendre le panier et le mettre à terre</definition>
        </example>
        <example>
          <unicode>ᠨᠣᠮᠤ ᠮᠥᠯᠲᠦᠯᠡᠺᠦ</unicode>
          <definition>baisser l'arc</definition>
        </example>
        <example>
          <unicode>ᠬᠤᠮᠬᠠᠨ ᠤ ᠤᠭᠤᠰᠤᠷ ᠢ ᠮᠥᠯᠲᠦᠯᠡᠺᠦ</unicode>
          <definition>dénouer le cordon du vase</definition>
        </example>
        <example>
          <unicode>ᠪᠦᠯᠦᠴᠦᠭ ᠎ᠢᠶᠡᠨ ᠮᠥᠯᠲᠦᠯᠡᠺᠦ</unicode>
          <definition>ôter l'anneau</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠯᠭᠢᠭᠦᠷ᠎ᠢᠶᠡᠷ ᠮᠥᠯᠲᠦᠯᠡᠺᠦ</unicode>
          <definition>ouvrir avec une clef</definition>
        </example>
        <example>
          <unicode>ᠮᠥᠯᠲᠦᠯᠦᠨ ᠬᠠᠶᠠᠬᠤ</unicode>
          <definition>retourner (son adversaire dans la lutte)</definition>
        </example>
      </examples>
    </entry_item>
