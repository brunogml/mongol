    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠮᠠᠺᠥᠶᠢᠺᠥ</unicode>
      <uighur>meküyikü</uighur>
      <cyrillic>мэхийх - мөхийх</cyrillic>
      <transcript>MEKYI-</transcript>
      <definition>v.i. To bow, incline, bend; render homage.</definition>
      <page>534</page>
      <examples>
        <example>
          <unicode>ᠮᠠᠺᠥᠶᠢᠨ ᠶᠣᠰᠤ</unicode>
          <transcript>--n josu</transcript>
          <definition> To salute by bowing.</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠺᠥᠶᠢᠵᠦ ᠰᠠᠨᠠᠪᠠᠰᠤ</unicode>
          <transcript>--zy sanabasu</transcript>
          <definition> In my humble opinion</definition>
        </example>
      </examples>
    </entry_item>
