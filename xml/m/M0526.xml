      <dico>Kowalewski</dico>
      <unicode>ᠮᠠᠯᠠᠭ᠎ᠠ ~ ᠮᠠᠯᠠᠭᠠᠢ</unicode>
      <definition>bonnet, casquette. chapeau</definition>
      <page>1993</page>
      <examples>
        <example>
          <unicode>ᠡᠪᠦᠯ ᠤᠨ ᠮᠠᠯᠠᠭ᠎ᠠ</unicode>
          <definition>bonnet d'hiver</definition>
        </example>
        <example>
          <unicode>ᠡᠰᠢᠭᠡᠢ ᠮᠠᠯᠠᠭ᠎ᠠ</unicode>
          <definition>bonnet de feutre</definition>
        </example>
        <example>
          <unicode>ᠦᠨᠡᠭᠡᠨ ᠮᠠᠯᠠᠭ᠎ᠠ</unicode>
          <definition>un bonnet de renard</definition>
        </example>
        <example>
          <unicode>ᠥᠷᠭᠡᠨ ᠰᠡᠷᠡᠪᠴᠢᠲᠦ ᠮᠠᠯᠠᠭ᠎ᠠ</unicode>
          <definition>bonnet avec des larges bords, en drap jaune, bordé d'une fourrure à longs poils</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠷᠠ ᠮᠠᠯᠠᠭ᠎ᠠ</unicode>
          <definition>bonnet jaune, porté par une secte bouddhique</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠷᠠ ᠮᠠᠯᠠᠭ᠎ᠠ ᠎ᠲᠤ ᠎ᠶᠢᠨ ᠬᠠᠤᠯᠢ ᠵᠣᠰᠤᠨ</unicode>
          <definition>règles de la secte au bonnet jaune c.à.d. de l'école de Tsongkava</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯᠠᠭ᠎ᠠ ᠡᠮᠦᠰᠺᠦ</unicode>
          <definition>mettre son bonnet</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯᠠᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠣᠷᠤᠢ</unicode>
          <definition>pilei apex, la pointe du bonnet</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯᠠᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠪᠦᠷᠭᠦᠭᠦᠯ</unicode>
          <definition>housse d'un bonnet</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯᠠᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠰᠠᠭᠠᠯᠳᠤᠷᠭ᠎ᠠ</unicode>
          <definition>cordon du bonnet (galeri sublimen)</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯᠠᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠰᠠᠨᠵᠢ</unicode>
          <definition>maille en dedans du bonnet</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯᠠᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠲᠠᠯᠪᠢᠭᠤᠷ</unicode>
          <definition>machine à poser son bonnet</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯᠠᠭ᠎ᠠ ᠮᠤᠯᠳᠤᠯᠬᠤ</unicode>
          <definition>ôter son bonnet</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯᠠᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠵᠠᠯᠠᠭ᠎ᠠ</unicode>
          <definition>la houppe d'un bonnet</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯᠠᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠵᠢᠩᠰᠡ</unicode>
          <definition>bouton que les mandarins portent sur leurs bonnets</definition>
        </example>
      </examples>
