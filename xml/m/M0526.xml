    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠮᠠᠯᠠᠭ᠎ᠠ</unicode>
      <uighur>malaγ-a</uighur>
      <definition>n. A cap, a hat, a bonnet. A crown. A sheath for protection of the point of a pen or pencil.</definition>
      <page>834</page>
      <examples>
        <example>
          <uighur>malaγ-a-yin oroi</uighur>
          <definition>The top or top cover of a cap or hat.</definition>
        </example>
        <example>
          <uighur>malaγ-a-yin ǰalaγ-a</uighur>
          <definition>The tuft or tassel on the top of a cap worn together with festival attire.</definition>
        </example>
        <example>
          <uighur>malaγ-a-yin saγaldorγ-a</uighur>
          <definition>n. The cheek-band on a cap or hat.</definition>
        </example>
        <example>
          <uighur>malaγ-a-yin serebči</uighur>
          <definition>n. A cap-peak</definition>
        </example>
      </examples>
    </entry_item>
