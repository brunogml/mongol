      <examples>
        <example>
          <unicode>ᠮᠥᠷᠦ ᠭᠠᠷᠬᠤ</unicode>
          <transcript>-- γarxu</transcript>
          <definition>For a shoulder joint to become dislocated</definition>
        </example>
        <example>
          <unicode>ᠮᠥᠷᠦ ᠰᠠᠴᠠᠭᠤ</unicode>
          <transcript>-- sacaγu</transcript>
