    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠮᠠᠩᠨᠣᠬ</unicode>
      <uighur>mangnoq</uighur>
      <cyrillic>магнаг</cyrillic>
      <transcript>MANGNUΓ</transcript>
      <definition>[Ch. mang-lung] n. Brocade; silk material interwoven with dragons of certain type in silver or gold.</definition>
      <page>527</page>
      <examples>
        <example>
          <unicode>ᠮᠠᠩᠨᠣᠬ ᠳᠡᠪᠡᠯ</unicode>
          <transcript>-- debel</transcript>
          <definition> A brocaded ceremonial robe.</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠩᠨᠣᠬ ᠲᠣᠷᠭ᠎ᠠ</unicode>
          <transcript>-- torγ-a</transcript>
          <definition> Chinese material which resembles cloth of gold brocaded with dragons and flowers.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠰᠤᠭ᠎ᠠ ᠮᠠᠩᠨᠣᠬ</unicode>
          <transcript>bosuγ-a -- </transcript>
          <definition> A kind of silk with the emblem of two dragons.</definition>
        </example>
      </examples>
    </entry_item>
