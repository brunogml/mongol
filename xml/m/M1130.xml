      <dico>Lessing</dico>
      <unicode>ᠮᠠᠯᠵᠠᠺᠠ</unicode>
      <uighur>melǰeke</uighur>
      <cyrillic>мэлзээ</cyrillic>
      <transcript>MELZEGE</transcript>
      <definition>[= melzij-e] n. Bet, stake, wager, argument over something, dispute, debate, controversy</definition>
      <page>535</page>
      <examples>
        <example>
          <unicode>ᠮᠠᠯᠵᠠᠺᠠ ᠺᠢᠺᠦ</unicode>
          <transcript>-- kiky</transcript>
          <definition> To make abet, place a wager.</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯᠵᠠᠺᠠ ᠨᠠᠭᠠᠳᠤᠮ</unicode>
          <transcript>-- naγadum</transcript>
          <definition> Contest, match.</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯᠵᠠᠺᠠ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <transcript>-- talbixu</transcript>
          <definition> To place a bet, wager; to argue as to the prospective winner.</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯᠵᠠᠺᠠ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition> Unquestionable, incontestable.</definition>
        </example>
      </examples>
    </entry_item>
