    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠮᠣᠲᠣᠷ</unicode>
      <uighur>mutur</uighur>
      <cyrillic>мутар</cyrillic>
      <transcript>MUTUR</transcript>
      <definition>[S. mudrā, "seal"] n. Any of the different hand gestrues used in religious ceremonies (see kylil), such as ‘praying, blessing, making offerings, reciting dharanis or mantras (see tarni); hand (referring to deities or dignitaries); seal, imprint of a seal; emblem, symbol</definition>
      <page>553</page>
      <examples>
        <example>
          <unicode>ᠮᠣᠲᠣᠷ ᠢᠶᠠᠨ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <transcript>-- ijen talbixu</transcript>
          <definition> To lay one's hand on somebody's head (in blessing); to sign one's name (hon.)</definition>
        </example>
        <example>
          <unicode>ᠡᠵᠡᠨ ᠤ ᠮᠣᠲᠣᠷ ᠢᠶᠠᠷ ᠪᠢᠴᠢᠭᠰᠡᠨ ᠪᠢᠴᠢᠭ</unicode>
          <transcript>ezen y -- ijer bicigsen bicig</transcript>
          <definition> Letter written by the hand of the emperor; Imperial rescript.</definition>
        </example>
      </examples>
    </entry_item>
