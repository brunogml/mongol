    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠮᠠᠳᠠᠺᠥᠢ</unicode>
      <uighur>medeküi</uighur>
      <transcript>MEDEKYI</transcript>
      <definition>[fut. n. of mede-] n. Knowledge; feeling, sensation; intelligence, intellect, perception.</definition>
      <page>532</page>
      <examples>
        <example>
          <unicode>ᠮᠠᠳᠠᠺᠥᠢ ᠭᠠᠷᠬᠤᠢ ᠎ᠶᠢᠨ ᠣᠷᠣᠨ</unicode>
          <transcript>-- γarxui jin orun</transcript>
          <definition> The source of knowledge.</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠳᠠᠺᠥᠢ ᠺᠦᠮᠦᠨ</unicode>
          <transcript>-- kymyn </transcript>
          <definition> Man of intellect, expert, connoisseur.</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠳᠠᠺᠥᠢ ᠤᠬᠠᠭᠠᠨ</unicode>
          <transcript>-- uxaγan</transcript>
          <definition> Developed intellect, intelligence.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠯᠡᠨ ᠤ ᠮᠠᠳᠠᠺᠥᠢ</unicode>
          <transcript>kelen y --</transcript>
          <definition> The sensation or sense of taste.</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠳᠦᠨ ᠤ ᠮᠠᠳᠠᠺᠥᠢ</unicode>
          <transcript>nidyn y --</transcript>
          <definition> Knowledge which comes through sight, visual perception or impression</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠳᠺᠢᠯ ᠤᠨ ᠮᠠᠳᠠᠺᠥᠢ</unicode>
          <transcript>sedkil yn --</transcript>
          <definition> Will; knowledge acquired by the mind.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠠᠷ ᠤᠨ ᠮᠠᠳᠠᠺᠥᠢ</unicode>
          <transcript>xabar un -- </transcript>
          <definition> Sensation of smell.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠮᠠᠳᠠᠺᠥᠢ</unicode>
      <transcript>MEDEKYI </transcript>
      <definition>T. (rnam par) çes pa; S. vijnana. States of consciousness, last of the five coγca. They are classified according to the senses: consciousness of vision (nidyn), audition ( cikin), olfaction (xabar), gustation (kelen), touch ( bej-e).</definition>
      <page>1176</page>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠮᠡᠳᠡᠭᠦᠢ</unicode>
      <definition>le savoir, le connaître: 2 intelligence, esprit, intelligence de la Pradjnâ; 3 sensation, perception</definition>
      <page>2010</page>
      <examples>
        <example>
          <unicode>ᠨᠢᠳᠦᠨ ᠤ ᠮᠡᠳᠡᠭᠦᠢ</unicode>
          <definition>le savoir qui vient par les yeux, l'impression que nous donnent les yeux</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠤᠷ ᠤᠨ ᠮᠡᠳᠡᠭᠦᠢ</unicode>
          <definition>le savoir qui vient par le nez, l'impression que nous donne le nez</definition>
        </example>
        <example>
          <unicode>ᠬᠤᠷᠠᠨ ᠮᠡᠳᠡᠭᠦᠢ ᠎ᠶᠢᠨ ᠴᠤᠭᠴᠠ</unicode>
          <definition>masse d'idées, des sensations</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠎ᠶᠢᠨ ᠮᠡᠳᠡᠭᠦᠢ</unicode>
          <definition>le savoir qui vient par le corps ou plutôt par la peau qui enveloppe le corps et qui est le siège du tact</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠳᠺᠢᠯ ᠤᠨ ᠮᠡᠳᠡᠭᠦᠢ</unicode>
          <definition>volonté, organe interne; connaissance acquise par le sens intérieur</definition>
        </example>
        <example>
          <unicode>ᠮᠡᠳᠡᠭᠦᠢ ᠢᠷᠭᠡᠨ</unicode>
          <definition>les gens d'esprit, connaisseurs</definition>
        </example>
        <example>
          <unicode>ᠮᠡᠳᠡᠭᠦᠢ ᠤᠬᠠᠭᠠᠨ</unicode>
          <definition>esprit développé, intelligence</definition>
        </example>
        <example>
          <unicode>ᠮᠡᠳᠡᠭᠦᠢ ᠭᠠᠷᠬᠤᠢ ᠎ᠶᠢᠨ ᠣᠷᠣᠨ</unicode>
          <definition>la source du savoir</definition>
        </example>
        <example>
          <unicode>ᠮᠡᠳᠡᠭᠦᠢ ᠎ᠶᠢᠨ ᠴᠢᠭᠤᠯᠭᠠᠨ</unicode>
          <definition>la masse du savoir, le savoir; âme intelligente, abstraite de ce monde</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠺᠢᠨ ᠤ ᠮᠡᠳᠡᠭᠦᠢ</unicode>
          <definition>connaissance acquise par les oreilles</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠯᠡᠨ ᠤ ᠮᠡᠳᠡᠭᠦᠢ</unicode>
          <definition>la sensation du goût</definition>
        </example>
      </examples>
