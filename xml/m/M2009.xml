    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠮᠣᠷᠢᠯᠠᠬᠣ</unicode>
      <uighur>morilaqu</uighur>
      <cyrillic>морилох</cyrillic>
      <transcript>MORILA-</transcript>
      <definition>v.i. To mount a horse (obs. ); to leave or set out for (hon); to die ( hon ); converb imperf. used with certain other verbs as apolite imperative).</definition>
      <page>543</page>
      <examples>
        <example>
          <unicode>ᠮᠣᠷᠢᠯᠠᠵᠤ ᠪᠠᠭᠤ</unicode>
          <transcript>--zu baγu</transcript>
          <definition>Please dismount! Please enter'!.</definition>
        </example>
        <example>
          <unicode>ᠮᠣᠷᠢᠯᠠᠵᠤ ᠢᠷᠡ</unicode>
          <transcript>--zu ire</transcript>
          <definition>Please come</definition>
        </example>
        <example>
          <unicode>ᠮᠣᠷᠢᠯᠠᠵᠤ ᠰᠠᠶᠠᠲᠠ</unicode>
          <transcript>--zu sayata</transcript>
          <definition>Please sit down</definition>
        </example>
        <example>
          <unicode>ᠮᠣᠷᠢᠯᠠᠵᠤ ᠰᠠᠭᠤ</unicode>
          <transcript>--zu saγu</transcript>
          <definition>Please sit down</definition>
        </example>
        <example>
          <unicode>ᠨᠣᠶᠠᠨ ᠨᠡᠶᠢᠰᠯᠡᠯ ᠎ᠳᠦ ᠮᠣᠷᠢᠯᠠᠭᠰᠠᠨ</unicode>
          <transcript>nojan neislel dy --gsan</transcript>
          <definition>The prince has left for the capital</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠶᠢᠨ ᠮᠣᠷᠢᠯᠠ</unicode>
          <transcript>Sain --</transcript>
          <definition>Bon voyage!</definition>
        </example>
        <example>
          <unicode>ᠲᠠ ᠺᠡᠵᠢᠶ᠎ᠡ ᠮᠣᠷᠢᠯᠠᠨ᠎ᠠ ᠤᠤ</unicode>
          <transcript>ta kezij-e --n-a uu?</transcript>
          <definition>When will you depart?.</definition>
        </example>
      </examples>
    </entry_item>
