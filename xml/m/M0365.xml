      <dico>Lessing</dico>
      <unicode>ᠮᠠᠭᠤᠳᠬᠠᠬᠤ</unicode>
      <uighur>maγudqaqu</uighur>
      <cyrillic>муутгах</cyrillic>
      <transcript>MAΓUDXA-</transcript>
      <definition>[v. caus. of maγud-] To make worse; to slander calumniate malign; to blame, rebuke, reprimand.</definition>
      <page>521</page>
      <examples>
        <example>
          <unicode>ᠳᠠᠯᠳᠠ ᠮᠠᠭᠤᠳᠬᠠᠬᠤ</unicode>
          <transcript>dalda --xu</transcript>
          <definition>To speak badly about someone behind his back</definition>
        </example>
        <example>
          <unicode>ᠨᠡᠷ᠎ᠡ ᠎ᠶᠢ ᠮᠠᠭᠤᠳᠬᠠᠨ ᠭᠤᠲᠤᠭᠠᠬᠤ</unicode>
          <transcript>ner-e ji --n γutuγaxu</transcript>
          <definition>To discredit, undermine somebody's reputation.</definition>
        </example>
      </examples>
