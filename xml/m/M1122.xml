      <dico>Lessing</dico>
      <unicode>ᠮᠠᠯᠮᠠᠶᠢᠺᠥ</unicode>
      <uighur>melmeyikü</uighur>
      <cyrillic>мэлмийх</cyrillic>
      <transcript>MELMEI-</transcript>
      <definition>v.t. and i. To become very full, or completely full; to shine, be bright, reflect light ( as hair, water, eyes).</definition>
      <page>534</page>
      <examples>
        <example>
          <unicode>ᠮᠠᠯᠮᠠᠶᠢᠲᠡᠯ᠎ᠡ</unicode>
          <transcript>--tel-e</transcript>
          <definition> To the edge, brim, or limit.</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯᠮᠠᠶᠢᠲᠡᠯ᠎ᠡ ᠳᠦᠭᠦᠷᠺᠦ</unicode>
          <transcript>--tel-e dygyrky</transcript>
          <definition> To be filled to the brim.</definition>
        </example>
        <example>
          <unicode>ᠨᠠᠭᠤᠷ ᠮᠠᠯᠮᠠᠶᠢᠵᠦ ᠪᠠᠶᠢᠨᠠᠮ</unicode>
          <transcript>naγur --zy bainam</transcript>
          <definition> The lake shines or reflects light</definition>
        </example>
      </examples>
