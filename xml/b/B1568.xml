        </example>
        <example>
          <unicode>ᠪᠠᠷᠳᠠᠮ ᠰᠠᠨᠠᠬᠤ</unicode>
          <transcript>-- sanaxu</transcript>
          <definition> To be overconfident; to take something lightly.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠷᠳᠠᠮ ᠵᠠᠩ</unicode>
          <transcript>-- zang, </transcript>
