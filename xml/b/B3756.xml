    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠺᠢᠨᠢᠳᠬᠣ</unicode>
      <uighur>bukinidku</uighur>
      <cyrillic>бухиндах</cyrillic>
      <transcript>BUKINID-</transcript>
      <definition>[=bokinid-] v, i. To be very sad, chagrined, annoyed; to fret, grieve; to be troubled or upset; to become restive (of animals).</definition>
      <page>133</page>
      <examples>
        <example>
          <unicode>ᠴᠢᠳᠠᠬᠤ ᠦᠭᠡᠢ ᠳᠡᠭᠡᠨ ᠪᠣᠺᠢᠨᠢᠳᠬᠣ</unicode>
          <transcript>cidaxu ygei degen --xu</transcript>
          <definition> To be chagrined or frustrated because of one 's inability to do something.</definition>
        </example>
        <example>
          <unicode>ᠳᠣᠲᠤᠷ᠎ᠠ ᠪᠣᠺᠢᠨᠢᠳᠬᠣ</unicode>
          <transcript>dotur-a --xu</transcript>
          <definition> To feel sick.</definition>
        </example>
      </examples>
    </entry_item>
