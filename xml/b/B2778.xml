      <dico>Lessing</dico>
      <unicode>ᠪᠣᠭᠣᠮᠢᠯᠠᠬᠣ</unicode>
      <uighur>boγumilaqu</uighur>
      <cyrillic>боомьлох</cyrillic>
      <transcript>BOΓUMILA-</transcript>
      <definition>v.t. To catch with asnare, lariat, or lasso; to strangle.</definition>
      <page>112</page>
      <examples>
        <example>
          <unicode>ᠪᠣᠭᠣᠮᠢᠯᠠᠵᠤ ᠠᠯᠠᠬᠤ</unicode>
          <transcript>--zu alaxu</transcript>
          <definition> To put to death by strangling.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠭᠣᠮᠢᠯᠠᠵᠤ ᠦᠺᠦᠺᠦ</unicode>
          <transcript>--zy ykyky</transcript>
          <definition> To hang oneself.</definition>
        </example>
      </examples>
    </entry_item>
