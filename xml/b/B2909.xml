    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠰᠠᠨᠢᠭᠣᠯᠬᠣ</unicode>
      <uighur>busaniγulqu</uighur>
      <cyrillic>бусниулах</cyrillic>
      <transcript>BUSANIΓUL-</transcript>
      <definition>[V. caus, of busani-] v . t. To break up; to scatter; to destroy, ruin; to squander.</definition>
      <page>140</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠢ ᠪᠣᠰᠠᠨᠢᠭᠣᠯᠬᠣ</unicode>
          <transcript>ami --xu</transcript>
          <definition>To kill, murder.</definition>
        </example>
        <example>
          <unicode>ᠡᠪᠳᠡᠵᠦ ᠪᠣᠰᠠᠨᠢᠭᠣᠯᠬᠣ</unicode>
          <transcript>ebdezy --xu</transcript>
          <definition>To destroy.</definition>
        </example>
        <example>
          <unicode>ᠡᠳ ᠺᠥᠷᠦᠩᠭᠡ ᠪᠣᠰᠠᠨᠢᠭᠣᠯᠬᠣ</unicode>
          <transcript>ed køryngge --xu</transcript>
          <definition>To ruin financially or economically.</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠭᠡᠭᠡᠵᠦ ᠪᠣᠰᠠᠨᠢᠭᠣᠯᠬᠣ</unicode>
          <transcript>køgegezy --xu</transcript>
          <definition>To chase and disperse (as a herd of cattle).</definition>
        </example>
        <example>
          <unicode>ᠰᠦᠢᠳᠺᠡᠨ ᠪᠣᠰᠠᠨᠢᠭᠣᠯᠬᠣ</unicode>
          <transcript>syidken --xu</transcript>
          <definition>To squander.</definition>
        </example>
      </examples>
    </entry_item>
