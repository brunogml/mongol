      <uighur>bariγulqu</uighur>
      <cyrillic>бариулах</cyrillic>
      <transcript>BARIГUL-</transcript>
      <definition>Verb causative of bari- ; to offer, present.</definition>
      <page>87</page>
      <examples>
        <example>
          <unicode>ᠭᠠᠷ ᠎ᠲᠤᠷ ᠪᠠᠷᠢᠭᠣᠯᠬᠣ</unicode>
          <transcript>γar tur --xu</transcript>
          <definition> To give, offer, hand over.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠷ ᠪᠠᠷᠢᠭᠣᠯᠬᠣ</unicode>
          <transcript>ger --xu</transcript>
          <definition> To cause to build a house or pitch a tent.</definition>
        </example>
        <example>
          <unicode>ᠮᠥᠩᠭᠦ ᠪᠠᠷᠢᠭᠣᠯᠬᠣ</unicode>
          <transcript>mønggy --xu</transcript>
          <definition> To put someone in charge of money matters.</definition>
        </example>
        <example>
          <unicode>ᠵᠡᠪᠰᠡᠭ ᠪᠠᠷᠢᠭᠣᠯᠬᠣ</unicode>
          <transcript>zebseg --xu</transcript>
          <definition> To give weapons; to arm.</definition>
        </example>
      </examples>
