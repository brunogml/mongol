    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠠᠷᠠᠬᠳᠠᠬᠣ</unicode>
      <uighur>baraqdaqu</uighur>
      <cyrillic>барагдах</cyrillic>
      <transcript>BARAГDA-</transcript>
      <definition>[v. pass. of bara-] To become exhausted, worn out; to decrease, die out.</definition>
      <page>83</page>
      <examples>
        <example>
          <unicode>ᠠᠷᠭ᠎ᠠ ᠪᠠᠷᠠᠬᠳᠠᠬᠣ</unicode>
          <transcript>arγ-a --xu</transcript>
          <definition> To be restless, be at a loss.</definition>
        </example>
        <example>
          <unicode>ᠡᠳ ᠪᠠᠷᠠᠬᠳᠠᠮᠤᠢ</unicode>
          <transcript>ed --mui</transcript>
          <definition> The wealth becomes exhausted.</definition>
        </example>
        <example>
          <unicode>ᠡᠯᠡᠵᠦ ᠪᠠᠷᠠᠬᠳᠠᠬᠣ</unicode>
          <transcript>elezy --xu</transcript>
          <definition> To wear out (as clothes, etc.).</definition>
        </example>
        <example>
          <unicode>ᠦᠯᠦ ᠪᠠᠷᠠᠬᠳᠠᠬᠣᠢ</unicode>
          <transcript>yly --xui</transcript>
          <definition> Inexhaustible, infinite; indestructible; perpetual.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠪᠠᠷᠠᠬᠳᠠᠬᠤ</unicode>
      <definition>se terminer , être à sa fin. être réduit à l'extrémité; s' épuiser , cesser; être tué. exterminé, perdu: 2 troisième année du, cycle de soixante [mong, éré-ghalbarse-djil ; chin. ping-yn).</definition>
      <page>1098</page>
      <examples>
        <example>
          <unicode>ᠡᠳ ᠪᠠᠷᠠᠬᠳᠠᠮᠤᠢ</unicode>
          <definition>les biens s'épuisent</definition>
        </example>
        <example>
          <unicode>ᠦᠯᠦ ᠪᠠᠷᠠᠬᠳᠠᠬᠤᠢ</unicode>
          <definition>inépuisable, infini, indestructible, immortel, perpétuel</definition>
        </example>
        <example>
          <unicode>ᠦᠯᠦ ᠪᠠᠷᠠᠬᠳᠠᠬᠤᠢ ᠪᠡᠯᠭᠡ ᠪᠢᠯᠢᠭ</unicode>
          <definition>sagesse inépuisable</definition>
        </example>
        <example>
          <unicode>ᠦᠯᠦ ᠪᠠᠷᠠᠬᠳᠠᠬᠤᠢ ᠰᠠᠩ</unicode>
          <definition>trésor inépuisable, richesses immenses, innombrables</definition>
        </example>
        <example>
          <unicode>ᠥᠭᠦᠯᠡᠵᠦ ᠦᠯᠦ ᠪᠠᠷᠠᠬᠳᠠᠬᠤᠢ</unicode>
          <definition>indicible, ineffable, inexprimable</definition>
        </example>
        <example>
          <unicode>ᠬᠤᠷᠢᠶᠠᠭᠰᠠᠨ ᠤ ᠡᠴᠦᠰ ᠪᠠᠷᠠᠬᠳᠠᠬᠤ</unicode>
          <definition>tout ce qui est rassemblé (composé, créé) sera détruit</definition>
        </example>
      </examples>
    </entry_item>
