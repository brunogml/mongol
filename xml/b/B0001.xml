      <definition>1 [= cu] Generalizing particle following an interrogative pronoun (Eng. -ever).</definition>
      <page>64</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠢ ᠪᠠ</unicode>
          <transcript>ali --</transcript>
          <definition> same as aliba.</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠭᠤ ᠪᠠ ᠺᠡᠯᠡᠭᠰᠡᠨ ᠦᠭᠡᠢ ᠠᠮᠤᠢ</unicode>
          <transcript>jaγu -- kelegsen ygei amui</transcript>
          <definition> [He] has not said anything.</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠮᠪᠠᠷ ᠪᠠ ᠠᠮᠢᠲᠠᠨ</unicode>
          <transcript>jambar -- amitan</transcript>
          <definition> No matter what living being, any being.</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠮᠪᠠᠷ ᠪᠠ ᠦᠭᠡ</unicode>
          <transcript>jambar -- yge</transcript>
          <definition> Any word(s].</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠨ ᠪᠠ</unicode>
          <transcript>ken --</transcript>
          <definition> Whoever.</definition>
        </example>
      </examples>
