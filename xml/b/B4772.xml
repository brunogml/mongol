    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠥᠺᠥᠨ</unicode>
      <uighur>bükün</uighur>
      <cyrillic>бүхэн</cyrillic>
      <transcript>BYKYN</transcript>
      <definition>n. and postopositional adj. All, every, everything; no matter who</definition>
      <page>145</page>
      <examples>
        <example>
          <unicode>ᠪᠥᠺᠥᠨ ᠢ ᠮᠡᠳᠡᠭᠴᠢ</unicode>
          <transcript>-- i medegci</transcript>
          <definition> All-knowing, omniscient.</definition>
        </example>
        <example>
          <unicode>ᠳᠣᠯᠤᠭᠠᠨ ᠬᠣᠨᠤᠬ ᠪᠥᠺᠥᠨ ᠎ᠳᠤ</unicode>
          <transcript>doluγan xonuγ -- dy</transcript>
          <definition> Every week, weekly.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠵᠠᠷ ᠪᠥᠺᠥᠨ ᠎ᠳᠤ</unicode>
          <transcript>γazar -- dy,</transcript>
          <definition> At all places, everywhere</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠨ ᠪᠥᠺᠥᠨ</unicode>
          <transcript>ken --</transcript>
          <definition> Whoever.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠮᠦᠨ ᠪᠥᠺᠥᠨ</unicode>
          <transcript>kymyn --</transcript>
          <definition> Every man, everyone.</definition>
        </example>
        <example>
          <unicode>ᠲᠠ ᠪᠥᠺᠥᠨ ᠴᠥᠮ</unicode>
          <transcript>ta -- cøm</transcript>
          <definition> Everyone of you.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠥᠺᠥᠨ᠎ᠡ</unicode>
      <transcript>BYKYN-E</transcript>
      <definition> T. kun (tu) may stand for S. prefix pari-, "completely. " </definition>
      <page>1165</page>
      <examples>
        <example>
          <unicode>ᠪᠥᠺᠥᠨ᠎ᠡ ᠪᠡᠯᠭᠡᠳᠡᠺᠦ</unicode>
          <transcript>+++ -- belgedeky. </transcript>
          <definition>See belge cinar. </definition>
        </example>
        <example>
          <unicode>ᠪᠥᠺᠥᠨ᠎ᠡ ᠪᠡᠯᠭᠡᠳᠡᠭᠰᠡᠨ</unicode>
          <transcript>+++ -- belgedegsen; </transcript>
          <definition>T. kun tu brtags pa; S. pari-kalpita. Fictitious, mind -constructed (phenomena). </definition>
        </example>
        <example>
          <unicode>ᠪᠥᠺᠥᠨ᠎ᠡ ᠭᠠᠷᠬᠤᠢ</unicode>
          <transcript>+++ -- γarxui; </transcript>
          <definition>T. kun hbyung; S. samudaya Origin, namely of suffering. See yneny </definition>
        </example>
        <example>
          <unicode>ᠪᠥᠺᠥᠨ᠎ᠡ ᠰᠢᠲᠦᠭᠡᠨ ᠲᠡᠶᠢᠨ ᠮᠡᠳᠡᠺᠦᠢ</unicode>
          <transcript>+++ -- sitygen tein medekyi;</transcript>
          <definition> T. kun gzhi(hi) rnam (par) ces (pa); S. alaya-vijnana. The eighth and last form of 'consciousness' (as taught by the Yogacara school) which serves as a base for the preceding seven and the granary of the seeds of all karmic phenomena. See tein medekyi.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠪᠦᠭᠦᠨ</unicode>
