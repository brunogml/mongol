    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠠᠷ</unicode>
      <uighur>ber</uighur>
      <cyrillic>б</cyrillic>
      <transcript>BER</transcript>
      <definition>2 A syntactic particle emphasizing the subject or the preceding part of the" sentence.</definition>
      <page>99</page>
      <examples>
        <example>
          <unicode>ᠡᠳᠦᠷ ᠰᠥᠨᠢ ᠦᠭᠡᠢ ᠡᠷᠢᠪᠡᠰᠦ ᠪᠠᠷ ᠡᠰᠡ ᠣᠯᠪᠠ</unicode>
          <transcript>edyr søni ygei eribesy -- ese olbat</transcript>
          <definition> Though they looked for it day and night they could not find it.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠪᠢ ᠰᠤᠷᠪᠠᠰᠤ ᠪᠠᠷ ᠡᠰᠡ ᠮᠡᠳᠡᠪᠡ</unicode>
          <transcript>ilbi surbasu -- ese medebe</transcript>
          <definition> Although he had studied magic, he did not learn it.</definition>
        </example>
        <example>
          <unicode>ᠨᠠᠳᠤᠷ ᠺᠡᠨ ᠪᠠᠷ ᠥᠭᠺᠦ</unicode>
          <transcript>nadur ken -- øgky</transcript>
          <definition> Who will give [it] to me?.</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠪᠠᠭᠤᠨ ᠪᠠᠷ ᠲᠡᠨᠳᠡ ᠪᠠᠷᠤᠳᠠᠯ </unicode>
          <transcript>sibaγun -- tende barubal</transcript>
          <definition> .That bird lighted there.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠡ ᠬᠠᠭᠠᠨᠪᠠᠷ ᠦᠵᠡᠭᠡᠳ ᠰᠠᠴᠠ</unicode>
          <transcript>tere xaγan -- yzeged saca</transcript>
          <definition>.. As soon as that khan had seen [it] ...</definition>
        </example>
      </examples>
