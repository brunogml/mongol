    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠥᠺᠯᠠᠷᠠᠺᠥ</unicode>
      <uighur>böglerekü</uighur>
      <cyrillic>бөглөрөх</cyrillic>
      <transcript>BØGLERE-</transcript>
      <definition>[=bøglyre-] v, I, To be stopped up, obstructed; to feel suffocated; to choke; to suffer from asthma.</definition>
      <page>125</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠢᠰᠬᠠᠯ ᠪᠥᠺᠯᠠᠷᠠᠺᠦ</unicode>
          <transcript>amisxal --ky</transcript>
          <definition> To choke,</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠰᠠᠯᠠᠩ ᠢᠶᠠᠷ ᠪᠥᠺᠯᠠᠷᠠᠭᠰᠡᠨ</unicode>
          <transcript>γas alang ijer --gsen</transcript>
          <definition>Overwhelmed by, grief..</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠭᠤᠯᠠᠢ ᠪᠥᠺᠯᠠᠷᠠᠭᠡᠳ ᠦᠺᠦᠺᠦ</unicode>
          <transcript>xoγulai --ged ykyky.</transcript>
          <definition> To die of suffocation or choking.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠪᠦᠺᠯᠡᠷᠡᠺᠦ ~ ᠪᠦᠺᠯᠦᠷᠡᠺᠦ</unicode>
