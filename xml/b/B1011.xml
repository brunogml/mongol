    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠠᠴᠠᠬ</unicode>
      <uighur>bačaq</uighur>
      <cyrillic>бацаг</cyrillic>
      <transcript>BACAГ</transcript>
      <definition>[= macaγ, T. bsnyen gnas, S. upavāsatha] n, Fast, fasting, abstinence, vow of fasting.</definition>
      <page>64</page>
      <examples>
        <example>
          <unicode>ᠪᠠᠴᠠᠬ ᠠᠪᠬᠤ</unicode>
          <transcript>abxu</transcript>
          <definition> To take the vows or receive the consecration of a gelyng (q. v.) which involves the practice of fasting and abstinence; to fast</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠴᠠᠬ ᠪᠠᠷᠢᠬᠤ</unicode>
          <transcript>-- barixu</transcript>
          <definition> To fast, practice abstinence.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠴᠠᠬ ᠡᠪᠳᠡᠺᠦ</unicode>
          <transcript>-- ebdeky</transcript>
          <definition> To break the vow of fasting, end a fast.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠴᠠᠬ ᠤᠨ ᠰᠠᠨᠸᠠᠷ</unicode>
          <transcript>-- un sanvar</transcript>
          <definition> Vow of abstinence (also taken by laymen).</definition>
        </example>
      </examples>
    </entry_item>
