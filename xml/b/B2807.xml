    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠭᠣᠷᠠᠯ</unicode>
      <uighur>buγural</uighur>
      <cyrillic>буурал</cyrillic>
      <transcript>BUΓURAL</transcript>
      <definition>[= buγurul] adj. Grey, grey-haired, greyish</definition>
      <page>131</page>
      <examples>
        <example>
          <unicode>ᠪᠣᠭᠣᠷᠠᠯ ᠪᠣᠯᠬᠤ</unicode>
          <transcript>-- bolxu,</transcript>
          <definition>To grow grey,</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠭᠣᠷᠠᠯ ᠡᠪᠦᠭᠡᠨ</unicode>
          <transcript>-- ebygen</transcript>
          <definition>white-haired old man.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠭᠣᠷᠠᠯ ᠮᠣᠷᠢ</unicode>
          <transcript>-- mori</transcript>
          <definition>Partly grey horse, roan horse.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠭᠣᠷᠠᠯ ᠣᠷᠤᠬᠤ</unicode>
          <transcript>-- oruxu</transcript>
          <definition>To start turning grey.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠭᠣᠷᠠᠯ ᠰᠠᠬᠠᠯ</unicode>
          <transcript>-- saxal</transcript>
          <definition>Grey mustache.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠭᠣᠷᠠᠯ ᠬᠠᠯᠢᠭᠤᠨ</unicode>
          <transcript>-- xaliγun</transcript>
          <definition>Grey horse with dark mane and tail</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠭᠣᠷᠠᠯ ᠦᠰᠦᠲᠦ</unicode>
          <transcript>-- ysyty</transcript>
          <definition>Grey-haired</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠪᠤᠭᠣᠷᠠᠯ ~ ᠪᠤᠭᠣᠷᠣᠯ</unicode>
      <definition>gris, qui a quelques cheveux gris, blanc-gris. gris mêlé</definition>
      <page>1166</page>
      <examples>
        <example>
          <unicode>ᠪᠤᠭᠣᠷᠠᠯ ᠡᠪᠦᠭᠡᠨ</unicode>
          <definition>vieillard à cheveux blancs</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠭᠣᠷᠠᠯ ᠦᠰᠦᠲᠦ</unicode>
          <definition>ayant les cheveux gris, gris, devenu tout gris</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠭᠣᠷᠠᠯ ᠬᠠᠯᠢᠭᠤᠨ</unicode>
          <definition>cheval gris mélé avec la queue et la crinière foncée</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠭᠣᠷᠠᠯ ᠪᠣᠯᠪᠠ</unicode>
          <definition>il est devenu gris, celui dont les cheveux et la barbe ont blanchi à moitié</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠭᠣᠷᠠᠯ ᠮᠣᠷᠢᠨ</unicode>
          <definition>cheval gris mélé</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
