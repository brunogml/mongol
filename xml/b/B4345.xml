      <dico>Lessing</dico>
      <unicode>ᠪᠥᠳᠥᠺᠥᠪᠴᠢᠯᠠᠺᠥ</unicode>
      <uighur>büdügübčilekü</uighur>
      <cyrillic>бүдүүвчлэх</cyrillic>
      <transcript>BYDYGYBCILE-</transcript>
      <definition>v.t. and i. To do or act rudely, crudely, or clumsily; to do the major part of something.</definition>
      <page>144</page>
      <examples>
        <example>
          <unicode>ᠪᠥᠳᠥᠺᠥᠪᠴᠢᠯᠠᠭᠰᠡᠨ</unicode>
          <transcript>--gsen</transcript>
          <definition>Schematic, sketchy; I tentative.</definition>
        </example>
        <example>
          <unicode>ᠪᠥᠳᠥᠺᠥᠪᠴᠢᠯᠠᠨ</unicode>
          <transcript>--n</transcript>
          <definition>Crudely; in general, approximately.</definition>
        </example>
      </examples>
    </entry_item>
