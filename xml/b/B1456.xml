    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠠᠷᠢᠮᠲᠠᠯᠠᠬᠣ</unicode>
      <uighur>barimtalaqu</uighur>
      <cyrillic>баримтлах</cyrillic>
      <transcript>BARIMTALA-</transcript>
      <definition>v.t. To seize, hold fast; to stick to the point, old a view, be based on, be guided by.</definition>
      <page>88</page>
      <examples>
        <example>
          <unicode>ᠪᠠᠷᠢᠮᠲᠠᠯᠠᠨ ᠰᠠᠺᠢᠬᠤ</unicode>
          <transcript>--n sakixu, </transcript>
          <definition>To adhere firmly to</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠷᠢᠮᠲᠠᠯᠠᠵᠤ ᠪᠣᠯᠬᠤ</unicode>
          <transcript>--zu bolxu</transcript>
          <definition> To be possible to rely on.</definition>
        </example>
        <example>
          <unicode>ᠳᠦᠷᠢᠮ ᠢ ᠪᠠᠷᠢᠮᠲᠠᠯᠠᠬᠤ</unicode>
          <transcript>dyrim i --xu</transcript>
          <definition> To follow regulations; to base on rules.</definition>
        </example>
        <example>
          <unicode>ᠮᠢᠨᠦᠺᠡᠢ ᠳ᠋‍‍ᠤ‍ᠷ ᠪᠠᠷᠢᠮᠲᠠᠯᠠᠬᠤᠢ</unicode>
          <transcript>minykei dyr --xui</transcript>
          <definition> Egoism, selfishness.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠶᠢᠨ ᠳᠤᠷ᠎ᠠ ᠎ᠶᠢ ᠪᠠᠷᠢᠮᠲᠠᠯᠠᠨᠠ</unicode>
          <transcript>sain dur-a ji --no </transcript>
          <definition>On a voluntary basis</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠰᠢᠨ ᠢ ᠪᠠᠷᠢᠮᠲᠠᠯᠠᠭᠰᠠᠨ ᠺᠦᠮᠦᠵᠢᠯ</unicode>
          <transcript>sasin i --γsan kymyzil, </transcript>
          <definition>Education on a religious basis, religious education</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠤᠯᠢ ᠎ᠶᠢ ᠪᠠᠷᠢᠮᠲᠠᠯᠠᠬᠤ</unicode>
          <transcript>xauli ji --xu</transcript>
          <definition> To be guided by a law; to act according to law.</definition>
        </example>
        <example>
          <unicode>ᠦᠭᠡ ᠎ᠶᠢ ᠪᠠᠷᠢᠮᠲᠠᠯᠠᠬᠤ</unicode>
          <transcript>yge ji --xu</transcript>
          <definition> To be guided by someone's words.</definition>
        </example>
      </examples>
    </entry_item>
