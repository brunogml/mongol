    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠠᠷᠠᠭᠣᠯᠬᠣ</unicode>
      <uighur>baraγulqu</uighur>
      <cyrillic>баруулах</cyrillic>
      <transcript>BARAГUL-</transcript>
      <definition>[v , causa of bara-] To cause to end; to consume, spend, waste, destroy.</definition>
      <page>84</page>
      <examples>
        <example>
          <unicode>ᠡᠳ ᠢ ᠪᠠᠷᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>ed i --xu</transcript>
          <definition> To'waste one's fortune or possessions.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠮ ᠦᠳ ᠢ ᠪᠠᠷᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>gem yd i --xu</transcript>
          <definition> To expiate sins; to stop sinning.</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠰᠢᠨ ᠢ ᠪᠠᠷᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>šasin i --xu</transcript>
          <definition> To annihilate or destroy religion.</definition>
        </example>
      </examples>
    </entry_item>
