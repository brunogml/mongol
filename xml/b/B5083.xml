    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠥᠷᠺᠥᠺᠥ</unicode>
      <uighur>bürkükü</uighur>
      <cyrillic>бүрхэх</cyrillic>
      <transcript>BYRKY-</transcript>
      <definition>[= byrke-] v; t. and i. To grow or become cloudy; to cover, cover up; to envelop, obscure.</definition>
      <page>150</page>
      <examples>
        <example>
          <unicode>ᠡᠭᠦᠯᠡᠰ ᠢᠶᠡᠷ ᠪᠥᠷᠺᠥᠺᠦ</unicode>
          <transcript>egyles ijer --ky</transcript>
          <definition> To be enveloped in clouds.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠵᠠᠷ ᠳᠡᠯᠡᠺᠡᠢ ᠎ᠶᠢ ᠪᠥᠷᠺᠥᠵᠦᠺᠦᠢ</unicode>
          <transcript>γazar delekei ji --zykyi</transcript>
          <definition> [It] is spread over the whole earth.</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠳᠦ ᠪᠥᠷᠺᠥᠺᠦ</unicode>
          <transcript>nidy --ky</transcript>
          <definition> The eyes are blurred; the view is blurred.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠯᠤᠭᠠᠢ ᠪᠡᠨ ᠪᠥᠷᠺᠥᠺᠦ</unicode>
          <transcript>toluγai ben --ky</transcript>
          <definition> To cover one's head.</definition>
        </example>
      </examples>
    </entry_item>
