      <dico>Lessing</dico>
      <unicode>ᠪᠢᠲᠠᠺᠠᠢ</unicode>
      <uighur>bitegei</uighur>
      <cyrillic>битгий</cyrillic>
      <transcript>BITEGEI</transcript>
      <definition>[=betegei] Prohibitive particle used before imperative, optative, and dubitative. Cf. buu.</definition>
      <page>107</page>
      <examples>
        <example>
          <unicode>ᠪᠢᠲᠠᠺᠠᠢ ᠶᠠᠪᠤ</unicode>
          <transcript>-- jabu!</transcript>
          <definition> Do not go!.</definition>
        </example>
      </examples>
    </entry_item>
