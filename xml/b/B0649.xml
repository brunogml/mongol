      <dico>Lessing</dico>
      <unicode>ᠪᠠᠲᠣ</unicode>
      <uighur>batu</uighur>
      <cyrillic>бат</cyrillic>
      <transcript>BATU</transcript>
      <definition>adj. Firm, strong, solid, stable; reliable, loyal, true; chaste.</definition>
      <page>91</page>
      <examples>
        <example>
          <unicode>ᠪᠠᠲᠣ ᠪᠡᠺᠢ</unicode>
          <transcript>-- beki</transcript>
          <definition> Strong, firm, solid; lasting, steady.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠣ ᠪᠡᠺᠢ ᠪᠣᠯᠬᠤ</unicode>
          <transcript>-- beki bolxu</transcript>
          <definition> To become or grow firm, strong.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠣ ᠪᠣᠯᠭᠠᠬᠤ</unicode>
          <transcript>-- bolγaxu</transcript>
          <definition> To solidify, strengthen.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠣ ᠴᠠᠭᠠᠨ ᠮᠣᠳᠤ</unicode>
          <transcript>-- [caγan] modu</transcript>
          <definition> Maple tree; sycamore.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠣ ᠺᠥᠳᠡᠯᠦᠰᠢ ᠦᠭᠡᠢ</unicode>
          <transcript>-- kødelysi ygei</transcript>
          <definition> Firm, immovable, unshaken.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠣ ᠮᠥᠩᠺᠡ</unicode>
          <transcript>-- møngke</transcript>
          <definition> Constant, firm; eternal.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠣ ᠣᠳᠤ</unicode>
          <transcript>-- odu</transcript>
          <definition> Fixed star.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠣ ᠥᠺᠢᠨ</unicode>
          <transcript>-- økin</transcript>
          <definition> Chaste girl, virgin; girl who remains unmarried after the death of her fiance.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠣ ᠰᠠᠭᠤᠷᠢ</unicode>
          <transcript>-- saγuri</transcript>
          <definition> Firm foundation; citadel.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠣ ᠰᠠᠭᠤᠷᠢᠲᠠᠢ</unicode>
          <transcript>-- saγurital</transcript>
          <definition> Based on a firm foundation; well-grounded, firmly founded.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠣ ᠰᠡᠳᠺᠢᠯ</unicode>
          <transcript>-- sedkil</transcript>
          <definition> Firmness, firm mind, solid (of character)</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠣ ᠲᠡᠮᠳᠡᠭ</unicode>
          <transcript>-- temdeg</transcript>
          <definition> Receipt, signed statement, certificate.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition> Flimsy, rickety, not solid, not durable; unreliable.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠣ ᠦᠭᠡᠲᠡᠢ</unicode>
          <transcript>-- ygetei</transcript>
          <definition> Loyal or reliable in speech, keeping one's promise.</definition>
        </example>
        <example>
          <uighur>sakilg-a ᠪᠠᠲᠣ</uighur>
          <transcript>sakilγ-a --</transcript>
          <definition> Discipline.</definition>
        </example>
