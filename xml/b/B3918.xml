    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠷᠣᠭᠣᠰᠢᠶᠠᠬᠣ</unicode>
      <uighur>buruγusiyaqu</uighur>
      <cyrillic>буруушаах</cyrillic>
      <transcript>BURUΓUSIJA-</transcript>
      <definition>v.t. To recognize or acknowledge as incorrect, false, erroneous, or wrong; to disaprove, blame, reproach, rebuke; to accuse.</definition>
      <page>139</page>
      <examples>
        <example>
          <unicode>ᠪᠣᠷᠣᠭᠣᠰᠢᠶᠠᠨ ᠲᠡᠮᠳᠡᠭᠯᠡᠺᠦ</unicode>
          <transcript>--n temdegleky</transcript>
          <definition> To acknowledge or recognize as unsatisfactory; to blame, reproach, criticize.</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠪᠡᠨ ᠪᠣᠷᠣᠭᠣᠰᠢᠶᠠᠬᠤ</unicode>
          <transcript>bej-e ben --xu</transcript>
          <definition> To blame, accuse oneself.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
