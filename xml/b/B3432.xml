    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠯᠪᠠᠰᠣᠷᠠᠬᠣ</unicode>
      <uighur>bolbasuraqu</uighur>
      <cyrillic>боловсрох</cyrillic>
      <transcript>BOLBASURA-</transcript>
      <definition>v, i. To ripen, mature; to acquire knowledge or experience; to be[come] trained; to develop; to acquire immunity against a disease; to be prepared or processed; to be cooked (obs.).</definition>
      <page>116</page>
      <examples>
        <example>
          <unicode>ᠪᠣᠯᠪᠠᠰᠣᠷᠠᠭ᠎ᠠ ᠦᠭᠡᠢ</unicode>
          <transcript>--γ-a ygei</transcript>
          <definition> Unripe, unworked, undeveloped; untrained, inexperienced.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠯᠪᠠᠰᠣᠷᠠᠭᠰᠠᠨ</unicode>
          <transcript>--γsan</transcript>
          <definition> Ripe, mature; trained, educated, cultured.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠯᠪᠠᠰᠣᠷᠠᠨ ᠭᠡᠭᠡᠷᠡᠺᠦ</unicode>
          <transcript>--n gegereky</transcript>
          <definition> To become cultured and civilized.</definition>
        </example>
        <example>
          <unicode>ᠴᠡᠴᠡᠭ ᠢᠶᠡᠷ ᠪᠣᠯᠪᠠᠰᠣᠷᠠᠭᠰᠠᠨ</unicode>
          <transcript>ceceg ijer --γsan</transcript>
          <definition> Has or have become immune to smallpox. .</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠳᠡᠮ ᠎ᠳᠦ ᠪᠣᠯᠪᠠᠰᠣᠷᠠᠬᠤ</unicode>
          <transcript>erdem dy --xu</transcript>
          <definition>. To mature in learning or scholarly attainments.</definition>
        </example>
        <example>
          <unicode>ᠰᠤᠷᠭᠠᠭᠤᠯᠢ ᠎ᠳᠤ ᠪᠣᠯᠪᠠᠰᠣᠷᠠᠬᠤ</unicode>
          <transcript>surγaruli du --xu</transcript>
          <definition> To study in school</definition>
        </example>
      </examples>
    </entry_item>
