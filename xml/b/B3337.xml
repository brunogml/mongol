    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠯᠣᠳᠠᠬᠣ</unicode>
      <uighur>buludaqu</uighur>
      <cyrillic>булдах</cyrillic>
      <transcript>BULUDA-</transcript>
      <definition>v.t. To roll with a roller; to thrash wheat; to remove the hulls of grain with a stone roller.</definition>
      <page>136</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠤ ᠪᠣᠯᠣᠳᠠᠬᠣ</unicode>
          <transcript>amu --xu</transcript>
          <definition>To thrash grain.</definition>
        </example>
        <example>
          <unicode>ᠢᠰᠡᠭᠡᠢ ᠎ᠶᠢ ᠪᠣᠯᠣᠳᠠᠬᠣ</unicode>
          <transcript>isegei ji --xu</transcript>
          <definition>To roll felt with a roller.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠮᠦᠷ ᠪᠤᠯᠤᠰ ᠢᠶᠠᠷ ᠲᠠᠷᠢᠶ᠎ᠠ ᠪᠣᠯᠣᠳᠠᠬᠣ</unicode>
          <transcript>temyr bulus ijer tarij-a --xu</transcript>
          <definition>To thrash grain by rolling iron cylinders over it.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠪᠤᠯᠣᠳᠠᠬᠤ</unicode>
      <definition>battre (le blé), passer la pierre sur les grains pour leur ôter la peau, ou les faire sortir de l'épi.</definition>
      <page>1191</page>
      <examples>
        <example>
          <unicode>ᠲᠡᠮᠦᠷ ᠪᠣᠯᠤᠰ ᠢᠶᠠᠷ ᠲᠠᠷᠢᠶᠠᠨ ᠪᠤᠯᠣᠳᠠᠬᠤ</unicode>
          <definition>battre le blé au moyen d'un cylindre de fer</definition>
        </example>
      </examples>
    </entry_item>
