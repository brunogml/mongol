    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠠᠷᠢᠬᠳᠠᠬᠣ</unicode>
      <uighur>bariqdaqu</uighur>
      <cyrillic>баригдах</cyrillic>
      <transcript>BARIГDA-</transcript>
      <definition>[v. pass. of bari-] To be captured, etc.; to allow oneself to be seized or caught.</definition>
      <page>86</page>
      <examples>
        <example>
          <unicode>ᠪᠥᠭᠡᠰᠦᠨ ᠎ᠳᠦ ᠪᠠᠷᠢᠬᠳᠠᠬᠣ</unicode>
          <transcript>bøgesyn dy --xu</transcript>
          <definition> To become lousy.</definition>
        </example>
        <example>
          <unicode>ᠡᠪᠡᠳᠴᠢᠨ᠎ᠡ ᠪᠠᠷᠢᠬᠳᠠᠬᠣ</unicode>
          <transcript>ebedcin-e --xu: </transcript>
          <definition>To be stricken with a disease; to be disabled by a disease</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠷ ᠎ᠲᠤ ᠪᠠᠷᠢᠬᠳᠠᠬᠣ</unicode>
          <transcript>γar tu --xu</transcript>
          <definition> To fall into the hands of.</definition>
        </example>
        <example>
          <unicode>ᠨᠠᠷᠠ ᠪᠠᠷᠢᠬᠳᠠᠬᠣ</unicode>
          <transcript>nara --xu</transcript>
          <definition> Eclipse of the sun.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠭᠤᠰᠤᠨ ᠎ᠳᠤ ᠪᠠᠷᠢᠬᠳᠠᠬᠣ</unicode>
          <transcript>toγusun du --xu</transcript>
          <definition> To become covered with dust.</definition>
        </example>
      </examples>
    </entry_item>
