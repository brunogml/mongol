      <dico>Lessing</dico>
      <unicode>ᠪᠣᠯᠪᠠᠣ</unicode>
      <uighur>bolbau</uighur>
      <transcript>BOLBAU</transcript>
      <definition>[= bolba + uu] Is ... ?. Was ... ?. (expressing expectation, hope, or wonder).</definition>
      <page>116</page>
      <examples>
        <example>
          <unicode>ᠲᠡᠶᠢᠮᠦ ᠪᠣᠯᠪᠠᠣ</unicode>
          <transcript>teimy --?</transcript>
          <definition> I guess it is so; I wonder if it is SO?.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠶᠢᠷᠠᠯᠠᠬᠤ ᠪᠣᠯᠪᠠᠣ</unicode>
          <transcript>xairalaxu --?</transcript>
          <definition> Will you please grant ... (epist.).</definition>
        </example>
      </examples>
    </entry_item>
