    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠯᠢᠶᠠᠯᠳᠣᠬᠣ</unicode>
      <uighur>buliyalduqu</uighur>
      <cyrillic>булаалдах</cyrillic>
      <transcript>BULIJALDU-</transcript>
      <definition>[v; rec. of bulija-] To dispute, quarrel, fuss; to argue back and forth.</definition>
      <page>135</page>
      <examples>
        <example>
          <unicode>ᠡᠰᠡᠷᠭᠦᠦ ᠲᠡᠰᠡᠷᠭᠦᠦ ᠪᠣᠯᠢᠶᠠᠯᠳᠣᠨ ᠦᠭᠦᠯᠡᠳᠦᠺᠦ</unicode>
          <transcript>esergyy tesergyy --n ygyleldyky</transcript>
          <definition> To quarrel, argue back and forth.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠪᠤᠯᠢᠶᠠᠯᠳᠣᠬᠤ</unicode>
      <definition>disputer.</definition>
      <page>1188</page>
      <examples>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠵᠠᠭᠤᠷᠠᠪᠠᠨ ᠡᠰᠡᠷᠡᠺᠦ ᠳᠡᠰᠡᠷᠡᠺᠦ ᠪᠤᠯᠢᠶᠠᠯᠳᠣᠨ ᠥᠭᠦᠯᠡᠯᠳᠦᠪᠡᠢ</unicode>
          <definition>ils disputaient entre eux</definition>
        </example>
        <example>
          <unicode>ᠲᠠ ᠬᠣᠶᠠᠷ ᠨᠢᠭᠡᠨ ᠨᠢᠭᠡᠨ ᠢᠶᠡᠨ ᠦᠭᠡᠪᠡᠷ ᠪᠤᠤ ᠪᠤᠯᠢᠶᠠᠯᠳᠣ</unicode>
          <definition>ne disputez pas entre vous deux</definition>
        </example>
      </examples>
