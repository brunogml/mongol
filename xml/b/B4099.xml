      <dico>Lessing</dico>
      <unicode>ᠪᠣᠷᠺᠢᠬᠣ</unicode>
      <uighur>burgiqu</uighur>
      <cyrillic>бургих</cyrillic>
      <transcript>BURGI-</transcript>
      <definition>v, i. To rise in clouds; to whirl (as dust, water, or smoke); to fume with anger, become enraged.</definition>
      <page>138</page>
      <examples>
        <example>
          <unicode>ᠪᠤᠯᠠᠭ ᠤᠨ ᠤᠰᠤ ᠪᠣᠷᠺᠢᠵᠤ ᠪᠠᠶᠢᠮᠤᠢ</unicode>
          <transcript>bulaγ un usu --zu baimui</transcript>
          <definition> The water of the spring wells up.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠭᠤᠰᠤ ᠪᠣᠷᠺᠢᠮᠤᠢ</unicode>
          <transcript>toγusu --mui</transcript>
          <definition> Dust rises in whirls.</definition>
        </example>
        <example>
          <unicode>ᠤᠲᠠᠭ᠎ᠠ ᠳᠡᠭᠡᠭᠰᠢ ᠪᠣᠷᠺᠢᠮᠤᠢ</unicode>
          <transcript>utaγ-a degegsi --mui</transcript>
          <definition> Smoke curls up.</definition>
        </example>
      </examples>
    </entry_item>
