    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠲᠠᠷᠠᠬᠣ</unicode>
      <uighur>butaraqu</uighur>
      <cyrillic>бутрах</cyrillic>
      <transcript>BUTARA-</transcript>
      <definition>v.i. To break to pieces, smash; to disperse, scatter.</definition>
      <page>141</page>
      <examples>
        <example>
          <unicode>ᠪᠣᠲᠠᠷᠠᠨ ᠪᠤᠷᠤᠭᠤᠳᠬᠤ</unicode>
          <transcript>--n buruγudxu, </transcript>
          <definition>To scatter and run away,</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠲᠠᠷᠠᠨ ᠭᠦᠶᠦᠯᠳᠦᠺᠦ</unicode>
          <transcript>--n gyjyldyky</transcript>
          <definition> To scatter in, panic.</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠯᠡ ᠪᠣᠲᠠᠷᠠᠬᠤ</unicode>
          <transcript>egyle --xu</transcript>
          <definition> The clouds disperse.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠪᠤᠳᠠᠷᠠᠬᠤ</unicode>
      <definition>se disperser, se répandre: fuir en désordre.</definition>
      <page>1176</page>
      <examples>
        <example>
          <unicode>ᠡᠭᠦᠯᠡᠰ ᠪᠤᠳᠠᠷᠠᠮᠤᠢ</unicode>
          <definition>les nuages se dispersent, sont chassés par le vent</definition>
        </example>
        <example>
          <unicode>ᠦᠰᠦᠨ ᠢᠨᠤ ᠬᠣᠲᠠᠯᠠ ᠵᠦᠭ ᠤᠳ ᠳ᠋‍‍ᠤ‍ᠷ ᠪᠤᠳᠠᠷᠠᠵᠤ ᠪᠦᠺᠦᠢ ᠦᠵᠡᠪᠡᠢ</unicode>
          <definition>on voyait comme ses cheveux flottaient au vent</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠷᠢᠭ ᠤᠳ ᠪᠤᠳᠠᠷᠠᠨ ᠪᠤᠷᠤᠭᠤᠳᠪᠠᠢ</unicode>
          <definition>les trouppes se sont dispersées de différents côtés</definition>
        </example>
      </examples>
