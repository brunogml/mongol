    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠱᠣᠬ</unicode>
      <uighur>bošuq</uighur>
      <cyrillic>бошог</cyrillic>
      <transcript>BOŠUΓ</transcript>
      <definition>n. Decree of heaven, fate, destiny; prophecy, prediction; word, sentence; command, order, instruction; decision; permission.</definition>
      <page>123</page>
      <examples>
        <example>
          <unicode>ᠪᠣᠱᠣᠬ ᠠᠶᠢᠯᠠᠳᠬᠠᠬᠤ</unicode>
          <transcript>-- ailadxaxu</transcript>
          <definition>To request instructions.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠱᠣᠬ ᠣᠯᠬᠤ</unicode>
          <transcript>-- olxu</transcript>
          <definition>To receive a prophecy,</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠱᠣᠬ ᠥᠭᠺᠦ</unicode>
          <transcript>-- øgky</transcript>
          <definition>To make a prophecy.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠱᠣᠬ ᠬᠠᠯᠠᠬᠤ</unicode>
          <transcript>xalaxu</transcript>
          <definition>To revolt.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠱᠣᠬ ᠦᠵᠡᠭᠦᠯᠺᠦ</unicode>
          <transcript>--yzegylky</transcript>
          <definition>To predict, to foresee.</definition>
        </example>
        <example>
          <unicode>ᠲᠩᠷᠢ ᠎ᠶᠢᠨ ᠪᠣᠱᠣᠬ ᠢᠶᠠᠷ</unicode>
          <transcript>tngri jin -- ijer</transcript>
          <definition>According to the decree of Heaven.</definition>
        </example>
        <example>
          <unicode>ᠲᠩᠷᠢ ᠎ᠶᠢᠨ ᠪᠣᠱᠣᠬ ᠢ ᠰᠠᠺᠢᠬᠤ</unicode>
          <transcript>tngri jin -- i sakim</transcript>
          <definition>To obey Heaven's command.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠪᠤᠱᠣᠬ</unicode>
      <definition>mot, sentence , ordre, ordonnance, mandat. décision. permission , dispense; prédication; prédiction , prophétie.</definition>
      <page>1173</page>
      <examples>
        <example>
          <unicode>ᠤᠴᠢᠷᠠᠯ ᠤᠨ ᠪᠤᠱᠣᠬ ᠢ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <definition>montrer le désir de se revoir dans la renaissance future</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠱᠣᠬ ᠠᠶᠢᠯᠠᠳᠬᠠᠬᠤ</unicode>
          <definition>demander l'instruction, l'ordre, le mandat, la permission</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠱᠣᠬ ᠣᠯᠬᠤ</unicode>
          <definition>recevoir l'instruction ou l'ordre, le mandat, la permission, etc.</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠱᠣᠬ ᠥᠭᠺᠦ</unicode>
          <definition>donner l'instruction, le mandat, la permission, etc. prononcer, prophétiser</definition>
        </example>
        <example>
          <unicode>ᠲᠩᠷᠢ ᠎ᠶᠢᠨ ᠪᠤᠱᠣᠬ ᠢ ᠰᠠᠺᠢᠬᠤ</unicode>
          <definition>garder le mandat du ciel</definition>
        </example>
        <example>
          <unicode>ᠲᠩᠷᠢ ᠎ᠶᠢᠨ ᠪᠤᠱᠣᠬ ᠢᠶᠠᠷ</unicode>
          <definition>d'après le mandat du ciel</definition>
        </example>
      </examples>
