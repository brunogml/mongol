    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠠᠭᠣᠷᠠᠬᠣ</unicode>
      <uighur>baγuraqu</uighur>
      <cyrillic>буурах</cyrillic>
      <transcript>BAГURA-</transcript>
      <definition>v.i. To Decline, fall; to diminish, lower, depreciate, degenerate; to fall Into decadence; to Slump, weaken,</definition>
      <page>72</page>
      <examples>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠎ᠶᠢᠨ ᠲᠠᠮᠢᠷ ᠪᠠᠭᠣᠷᠠᠬᠣ</unicode>
          <transcript>bej-e jin tamir - -xu</transcript>
          <definition>Physical strength declines or fails.</definition>
        </example>
        <example>
          <unicode>ᠨᠡᠷ᠎ᠡ ᠪᠠᠭᠣᠷᠠᠬᠣ</unicode>
          <transcript>ner-e --xu</transcript>
          <definition>Reputation wanes.</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠤᠨ ᠪᠠᠭᠣᠷᠠᠬᠣ</unicode>
          <transcript>orun --xu</transcript>
          <definition>To be demoted, lose one's rank, authority or dignity.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠰᠢᠨ ᠪᠠᠭᠣᠷᠠᠬᠣ</unicode>
          <transcript>sasin --xu</transcript>
          <definition>Religion declines.</definition>
        </example>
        <example>
          <unicode>ᠤᠬᠠᠭᠠᠨ ᠪᠠᠭᠣᠷᠠᠬᠣ</unicode>
          <transcript>uxaγan --xu</transcript>
          <definition>Mental powers fail.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠯᠠᠭᠤᠨ ᠪᠠᠭᠣᠷᠠᠬᠣ</unicode>
          <transcript>xalaγun --xu</transcript>
          <definition>Heat recedes.</definition>
        </example>
      </examples>
    </entry_item>
