      <page>1214</page>
      <examples>
        <example>
          <unicode>ᠪᠤᠷᠣᠭᠠᠨ ᠠᠷᠢᠯᠪᠠ</unicode>
          <definition>la pluie a cessé, le ciel s'est éclairci</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠷᠣᠭᠠᠨ ᠣᠷᠣᠮᠤᠢ</unicode>
          <definition>il pleut</definition>
        </example>
