        <example>
          <unicode>ᠪᠤᠷᠣᠭᠠᠨ ᠲᠠᠭᠠᠪᠠ</unicode>
          <definition>la pluie a pénétré bien la terre</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠷᠣᠭᠠᠨ ᠵᠠᠯᠢᠷᠠᠪᠠ</unicode>
          <definition>arrosé par la pluie</definition>
        </example>
      </examples>
