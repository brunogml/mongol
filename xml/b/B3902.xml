        </example>
        <example>
          <unicode>ᠪᠤᠷᠣᠭᠠᠨ ᠤ ᠪᠢᠯᠵᠣᠬᠠᠢ</unicode>
          <definition>martinet noir (hirundo apus)</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠷᠣᠭᠠᠨ ᠰᠢᠮᠡᠳᠪᠡ</unicode>
          <definition>pluie douce qui imbibe la terre</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠷᠣᠭᠠᠨ ᠤ ᠰᠢᠭᠦᠷ</unicode>
