    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠷᠣᠭ᠎ᠠ ᠪᠣᠷᠤᠭᠠᠨ</unicode>
      <uighur>boruγ-a - boruγan</uighur>
      <cyrillic>бороо(н)</cyrillic>
      <transcript>BORUΓ-A(N)</transcript>
      <definition>n. Rain</definition>
      <page>121</page>
      <examples>
        <example>
          <unicode>ᠪᠣᠷᠣᠭ᠎ᠠ ᠠᠷᠢᠯᠪᠠ</unicode>
          <transcript>-- arilba</transcript>
          <definition>The rain has stopped.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠷᠣᠭ᠎ᠠ ᠴᠢᠳᠬᠤᠬᠤ</unicode>
          <transcript>-- cidxuxu</transcript>
          <definition>Rain pours down.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠷᠣᠭᠠᠨ ᠤ ᠡᠭᠦᠯᠡ</unicode>
          <transcript>--n u egyle</transcript>
          <definition>Rain cloud(s].</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠷᠣᠭ᠎ᠠ ᠣᠷᠤᠵᠤ ᠪᠠᠶᠢᠮᠤᠢ</unicode>
          <transcript>-- oruzu baimui</transcript>
          <definition>It is raining.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠷᠣᠭ᠎ᠠ ᠰᠠᠪᠰᠢᠬᠤ</unicode>
          <transcript>-- sabsixu,</transcript>
          <definition>To rain for a long time</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠷᠣᠭ᠎ᠠ ᠰᠡᠭ ᠺᠢᠺᠦ</unicode>
          <transcript>-- seg kiky</transcript>
          <definition>The rain ceases for a while,</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠷᠣᠭ᠎ᠠ ᠰᠢᠪᠡᠷᠡᠮᠦᠢ</unicode>
          <transcript>-- siberemyi</transcript>
          <definition>It drizzles.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠷᠣᠭ᠎ᠠ ᠰᠢᠮᠡᠳᠪᠡ</unicode>
          <transcript>-- simedbe</transcript>
          <definition>The rain has moistened the. soil.</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠭᠠᠨ ᠪᠣᠷᠣᠭ᠎ᠠ</unicode>
          <transcript>caγan --</transcript>
          <definition>Hail.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠲᠠᠭᠤ ᠪᠣᠷᠣᠭ᠎ᠠ</unicode>
          <transcript>xataγu --</transcript>
          <definition>Hail.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠪᠤᠷᠣᠭᠠᠨ</unicode>
