      <dico>Lessing</dico>
      <unicode>ᠪᠠᠳᠠᠷᠠᠭᠣᠯᠬᠣ</unicode>
      <uighur>badaraγulqu</uighur>
      <cyrillic>бадруулах</cyrillic>
      <transcript>BADARAГUL-</transcript>
      <definition>[v : caus. of badara-] To spread, propagate; to develop; to stir up, inspire.</definition>
      <page>66</page>
      <examples>
        <example>
          <unicode>ᠭᠠᠯ ᠪᠠᠳᠠᠷᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>γal --xu</transcript>
          <definition> To stir the fire into a blaze.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠵᠠᠷ ᠤᠨ ᠠᠰᠢᠭ ᠢ ᠪᠠᠳᠠᠷᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>γazar un asiγ i --xu</transcript>
          <definition> To develop the natural resources, exploit the soll.</definition>
        </example>
        <example>
          <unicode>ᠨᠡᠷ᠎ᠡ ᠪᠠᠳᠠᠷᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>ner-e --xu</transcript>
          <definition> To spread the fame of a person.</definition>
        </example>
      </examples>
    </entry_item>
