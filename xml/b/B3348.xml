    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠯᠣᠯᠴᠠᠬᠣ</unicode>
      <uighur>bolulčaqu</uighur>
      <cyrillic>бололцох</cyrillic>
      <transcript>BOLULCA-</transcript>
      <definition>[v. coop. of bol-] To become (collective), to concur, coincide; to be possible.</definition>
      <page>118</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠢ ᠪᠣᠯᠣᠯᠴᠠᠬᠤ ᠪᠠᠶᠢᠳᠠᠯ</unicode>
          <transcript>ali --xu baidal</transcript>
          <definition> Every appropriate situation, any possible chance.</definition>
        </example>
        <example>
          <unicode>ᠠᠯᠢ ᠪᠣᠯᠣᠯᠴᠠᠬᠤ ᠪᠡᠷ</unicode>
          <transcript>ali --xu ber, </transcript>
          <definition>By all possible means</definition>
        </example>
        <example>
          <unicode>ᠪᠢᠳᠡ ᠨᠥᠺᠦᠷ ᠪᠣᠯᠣᠯᠴᠠᠵᠠ</unicode>
          <transcript>bide nøkyr --ja</transcript>
          <definition> Let us become friends.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠴᠦᠨ ᠪᠣᠯᠣᠯᠴᠠᠬᠤ</unicode>
          <transcript>kycyn --xu</transcript>
          <definition> To help, cooperate .</definition>
        </example>
      </examples>
    </entry_item>
