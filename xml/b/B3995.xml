    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠷᠭᠠᠰᠣ ~ ᠪᠤᠷᠭᠠᠰᠤᠨ</unicode>
      <uighur>burγasu - burγasun</uighur>
      <cyrillic>бургаас(ан), бургас</cyrillic>
      <transcript>BURΓASU(N)</transcript>
      <definition>n. Willow, osier; willow branches; twigs of willow; brushwood.</definition>
      <page>137</page>
      <examples>
        <example>
          <unicode>ᠪᠤᠷᠭᠠᠰᠤᠨ ᠤ ᠭᠥᠯᠦᠭᠡ</unicode>
          <transcript>--n u gølyge</transcript>
          <definition>Shoots of a willow tree; pussy-willow buds.</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠷᠭᠠᠰᠤᠨ ᠤ ᠤᠩᠭᠠᠷᠢᠯ</unicode>
          <transcript>--n u ungγaril</transcript>
          <definition>Catkins of willow.</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠷᠭᠠᠰᠤᠨ ᠬᠠᠰᠢᠶ᠎ᠠ</unicode>
          <transcript>--n xasij-a</transcript>
          <definition>Fence made of osiers</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠷᠤ ᠪᠤᠷᠭᠠᠰᠤ</unicode>
          <transcript>boru --</transcript>
          <definition>Elm tree.</definition>
        </example>
        <example>
          <unicode>ᠤᠯᠠᠭᠠᠨ ᠪᠤᠷᠭᠠᠰᠤ</unicode>
          <transcript>ulaγan --</transcript>
          <definition>Red willow</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
