        <example>
          <unicode>ᠪᠠᠯᠭᠠᠰᠣᠨ ᠤ ᠨᠣᠶᠠᠨ</unicode>
          <transcript>--n u nojan</transcript>
          <definition> Head or mayor of a city or town.</definition>
        </example>
        <example>
          <unicode>ᠡᠪᠳᠡᠷᠺᠡᠢ ᠪᠠᠯᠭᠠᠰᠣ</unicode>
          <transcript>ebderkei --</transcript>
          <definition> Ruins of a city or town.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠭᠠᠨ ᠪᠠᠯᠭᠠᠰᠣ</unicode>
          <transcript>xaγan --</transcript>
          <definition> Imperial city (hist., formerly the Mongolian name of Peking).</definition>
        </example>
      </examples>
