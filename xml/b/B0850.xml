      <cyrillic>балгас</cyrillic>
      <transcript>BALГASU(N)</transcript>
      <definition>n. City, town, ruins, site of .an ancient town.</definition>
      <page>80</page>
      <examples>
        <example>
          <unicode>ᠪᠠᠯᠭᠠᠰᠣᠨ ᠤ ᠡᠭᠦᠳᠡ</unicode>
