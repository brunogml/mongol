      <unicode>ᠪᠣᠭᠣᠬᠳᠠᠯ</unicode>
      <uighur>boγuqdal</uighur>
      <cyrillic>боогдол</cyrillic>
      <transcript>BOΓUΓDAL</transcript>
      <definition>n. Hindrance, obstacle, obstruction; delay, procrastination; break; envelopment, the state of being caught or tied.</definition>
      <page>112</page>
      <examples>
        <example>
          <unicode>ᠪᠣᠭᠣᠬᠳᠠᠯ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition> Without hindrance, obstruction or delay.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠴᠢᠭᠳᠠᠯ ᠪᠣᠭᠣᠬᠳᠠᠯ</unicode>
          <transcript>γaciγdal --</transcript>
