      <dico>Lessing</dico>
      <unicode>ᠪᠣᠬᠴᠠᠯᠠᠬᠣ</unicode>
      <uighur>boqčalaqu</uighur>
      <cyrillic>богцлох</cyrillic>
      <transcript>BOΓCALA-</transcript>
      <definition>v.t. To put into a traveling bag; to make 'a package, put in a package.</definition>
      <page>111</page>
      <examples>
        <example>
          <unicode>ᠪᠣᠬᠴᠠᠯᠠᠵᠤ ᠪᠣᠭᠤᠬᠤ</unicode>
          <transcript>--zu boγuxu, </transcript>
          <definition>To make into packages</definition>
        </example>
        <example>
          <unicode>ᠬᠤᠪᠴᠠᠰᠤ ᠪᠣᠬᠴᠠᠯᠠᠵᠤ ᠬᠤᠷᠢᠶᠠᠬᠤ</unicode>
          <transcript>xubcasu --zu xurijaxu</transcript>
          <definition> To collect and pack clothes for storing.</definition>
        </example>
      </examples>
