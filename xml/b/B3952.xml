      <dico>Lessing</dico>
      <unicode>ᠪᠣᠷᠣᠯᠠᠬᠣ</unicode>
      <uighur>borulaqu</uighur>
      <cyrillic>борлох</cyrillic>
      <transcript>BORULA-</transcript>
      <definition>v.i. To become grey or tanned; to look grey, yellowish-grey, brown; to insist; to force oneself to do something (as when sick).</definition>
      <page>122</page>
      <examples>
        <example>
          <unicode>ᠪᠣᠷᠣᠯᠠᠭᠰᠠᠨ ᠮᠢᠬ᠎ᠠ</unicode>
          <transcript>--γsan mix-a</transcript>
          <definition> Slightly boiled meat, with surface only turned grey.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠷᠣᠯᠠᠭᠰᠠᠨ ᠦᠵᠦᠮ</unicode>
          <transcript>--γsan yzym</transcript>
          <definition> Black grape. [Gu.] Black raisins.</definition>
        </example>
        <example>
          <unicode>ᠠᠪᠤᠨ᠎ᠠ ᠭᠡᠵᠦ ᠪᠣᠷᠣᠯᠠᠬᠤ</unicode>
          <transcript>abun-a gezy --xu</transcript>
          <definition> To insist on having or taking something.</definition>
        </example>
      </examples>
