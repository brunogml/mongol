    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠯᠵᠣᠭ᠎ᠠ</unicode>
      <uighur>bolǰuγ-a</uighur>
      <cyrillic>болзоо</cyrillic>
      <transcript>BOLZUΓ-A</transcript>
      <definition>n. Stipulation, contract, agreement, appointed time, term; rendezvous.</definition>
      <page>119</page>
      <examples>
        <example>
          <unicode>ᠪᠣᠯᠵᠣᠭ᠎ᠠ ᠪᠢᠴᠢᠭ</unicode>
          <transcript>-- bicig</transcript>
          <definition>Contract.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠯᠵᠣᠭ᠎ᠠ ᠪᠢᠴᠢᠺᠦ</unicode>
          <transcript>-- biciky</transcript>
          <definition>To make a written contract.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠯᠵᠣᠭ᠎ᠠ ᠪᠣᠯᠵᠤᠬᠤ</unicode>
          <transcript>-- bolzuxu,</transcript>
          <definition>.To make an agreement</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠯᠵᠣᠭᠠᠨ ᠤ ᠡᠳᠦᠷ</unicode>
          <transcript>--n u edyr</transcript>
          <definition>Appointed day, fixed date.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠯᠵᠣᠭ᠎ᠠ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <transcript>-- talbixu</transcript>
          <definition>To make an appointment or agreement,</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠯᠵᠣᠭ᠎ᠠ ᠲᠣᠭᠲᠠᠬᠤ</unicode>
          <transcript>-- toγtaxu</transcript>
          <definition>To agree on a day or date.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠯᠵᠣᠭ᠎ᠠ ᠬᠣᠶᠢᠰᠢᠯᠠᠭᠤᠯᠬᠤ</unicode>
          <transcript>-- xoisilaγulxu</transcript>
          <definition>To extend a term, delay, defer</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠯᠵᠣᠭ᠎ᠠ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition>Not certain, not limited (as to time), termless; [it] is possible.</definition>
        </example>
        <example>
          <unicode>ᠳᠤᠲᠠᠭᠠᠬᠤ ᠪᠣᠯᠵᠣᠭ᠎ᠠ ᠦᠭᠡᠢ</unicode>
          <transcript>dutaγaxu -- ygei</transcript>
          <definition>[He] might escape</definition>
        </example>
      </examples>
    </entry_item>
