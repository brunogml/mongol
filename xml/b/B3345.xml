    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠯᠣᠯᠲᠠᠢ</unicode>
      <uighur>bolultai</uighur>
      <cyrillic>бололтой</cyrillic>
      <transcript>BOLULTAI</transcript>
      <definition>adj. and adv. Possible, probable; probably, possibly, evidently; it seems to be.</definition>
      <page>118</page>
      <examples>
        <example>
          <unicode>ᠪᠣᠯᠣᠯᠲᠠᠢ ᠪᠣᠯᠤᠯ ᠦᠭᠡᠢ ᠦᠭᠡ ᠺᠡᠯᠡᠺᠦ</unicode>
          <transcript>-- bolul ygei yge keleky</transcript>
          <definition> To talk at random or indiscreetly.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠯᠣᠯᠲᠠᠢ ᠶᠠᠪᠤᠳᠠᠯ</unicode>
          <transcript>-- jabudal</transcript>
          <definition> Something which is possible.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠷᠦᠭᠰᠡᠨ ᠪᠣᠯᠣᠯᠲᠠᠢ</unicode>
          <transcript>kyrygsen --</transcript>
          <definition> May have arrived, seems to have arrived.</definition>
        </example>
        <example>
          <unicode>ᠤᠷᠢᠳ ᠡᠴᠡ ᠮᠡᠳᠡᠭᠰᠡᠨ ᠪᠣᠯᠣᠯᠲᠠᠢ</unicode>
          <transcript>urid ece medegsen --</transcript>
          <definition> Evidently [he] knew [it] beforehand; they obviously. foresaw [it].</definition>
        </example>
      </examples>
    </entry_item>
