    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠣᠯᠢᠶᠠᠬᠣ</unicode>
      <uighur>buliyaqu</uighur>
      <cyrillic>булаах</cyrillic>
      <transcript>BULIJA-</transcript>
      <definition>v.t. To take away, by force, seize, grab, rob, pillage , captivate, ravish.</definition>
      <page>134</page>
      <examples>
        <example>
          <unicode>ᠪᠣᠯᠢᠶᠠᠨ ᠠᠪᠬᠤ</unicode>
          <transcript>--n abxu</transcript>
          <definition> To take away by force; grab.</definition>
        </example>
        <example>
          <unicode>ᠳᠤᠷ᠎ᠠ ᠎ᠶᠢ ᠪᠣᠯᠢᠶᠠᠬᠤ</unicode>
          <transcript>dur-a ji --xu</transcript>
          <definition> To charm, captivate.</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠳᠺᠢᠯ ᠢ ᠪᠣᠯᠢᠶᠠᠬᠤ</unicode>
          <transcript>sedkil i --xu</transcript>
          <definition> To captivate somebody's heart, charm; to instill with enthusiasm.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠭᠠᠨ ᠤ ᠲᠥᠷᠦ ᠎ᠶᠢ ᠪᠣᠯᠢᠶᠠᠬᠤ</unicode>
          <transcript>xaγan u tøry ji --xu</transcript>
          <definition> To usurp the throne.</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠰᠠᠭ ᠤᠨ ᠡᠷᠺᠡ ᠎ᠶᠢ ᠪᠣᠯᠢᠶᠠᠨ ᠠᠪᠬᠤ</unicode>
          <transcript>zasaγ un erke ji --n abxu, </transcript>
          <definition>To seize political power</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
