    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠠᠷᠣᠬᠯᠠᠬᠣ</unicode>
      <uighur>baruqlaqu</uighur>
      <cyrillic>бараглах</cyrillic>
      <transcript>BARUΓLA-</transcript>
      <definition>v.t. and i. To finish almost completely; to estimate, make a guess, surmise, suppose; to have an idea; to come near to, approximate.</definition>
      <page>89</page>
      <examples>
        <example>
          <unicode>ᠪᠠᠷᠣᠬᠯᠠᠪᠠᠰᠤ</unicode>
          <transcript>--basu</transcript>
          <definition>If one estimates; approximately.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠷᠣᠬᠯᠠᠪᠠᠰᠤ ᠭᠤᠷᠪᠠᠨ ᠵᠢᠯ ᠣᠷᠣᠮᠤᠢ</unicode>
          <transcript>--basu γurban zil orumui,</transcript>
          <definition>It will take approximately three years</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠷᠣᠬᠯᠠᠨ ᠮᠡᠳᠡᠺᠦ</unicode>
          <transcript>--n medeky</transcript>
          <definition>To have a general idea of.</definition>
        </example>
        <example>
          <unicode>ᠦᠭᠡ ᠎ᠶᠢ ᠪᠠᠷᠣᠬᠯᠠᠮᠤᠢ</unicode>
          <transcript>yge ji --mui</transcript>
          <definition>I seem to understand (his) words.</definition>
        </example>
        <example>
          <unicode>ᠦᠨ᠎ᠡ ᠪᠠᠷᠣᠬᠯᠠᠬᠤ</unicode>
          <transcript>yn-e --xu</transcript>
          <definition>To estimate the price</definition>
        </example>
      </examples>
    </entry_item>
