    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠠᠶᠢᠴᠠᠭᠠᠬᠣ</unicode>
      <uighur>bayičaγaqu</uighur>
      <cyrillic>байцаах</cyrillic>
      <transcript>BAICAГA-</transcript>
      <definition>v.t. To investigate, inspect, inquire into, check, examine.</definition>
      <page>73</page>
      <examples>
        <example>
          <unicode>ᠪᠠᠶᠢᠴᠠᠭᠠᠨ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <transcript>--n γarγaxu</transcript>
          <definition> To bring out, reveal through inquiry, uncover.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠢᠴᠠᠭᠠᠬᠤ ᠲᠦᠰᠢᠮᠡᠯ</unicode>
          <transcript>--xu tysimel</transcript>
          <definition> Examining official.</definition>
        </example>
        <example>
          <unicode>ᠠᠰᠠᠭᠤᠵᠤ ᠪᠠᠶᠢᠴᠠᠭᠠᠬᠤ</unicode>
          <transcript>asaγuzu --xu</transcript>
          <definition> To question, interrogate, examine.</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠯᠭᠠᠨ ᠪᠠᠶᠢᠴᠠᠭᠠᠬᠤ</unicode>
          <transcript>silγan --xu</transcript>
          <definition> To. verify, check, examine, audit.</definition>
        </example>
        <example>
          <unicode>ᠤᠴᠢᠷ ᠢ ᠪᠠᠶᠢᠴᠠᠭᠠᠬᠤ</unicode>
          <transcript>ucir i --xu</transcript>
          <definition> To investigate the cause.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠪᠠᠶᠢᠴᠠᠭᠠᠬᠤ</unicode>
      <definition>examiner, s'informer de qc., rechercher, réviser, chercher à savoir, demander.</definition>
      <page>1051</page>
      <examples>
        <example>
          <unicode>ᠡᠳ ᠢ ᠪᠠᠶᠢᠴᠠᠭᠠᠬᠤ ᠲᠦᠰᠢᠮᠡᠯ</unicode>
          <definition>fonctionnaire qui vérifie les effets de la couronne, vérificateur, réviseur</definition>
        </example>
        <example>
          <unicode>ᠦᠨᠡᠨ ᠺᠦᠴᠦᠨ ᠢᠶᠡᠷ ᠭᠠᠷᠬᠤ ᠣᠷᠤᠬᠤᠢ ᠎ᠶᠢ ᠺᠡᠨᠠᠨ ᠪᠠᠶᠢᠴᠠᠭᠠᠬᠤ</unicode>
          <definition>vérifier strictement les revenus et les dépenses de la couronne</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠢᠴᠠᠭᠠᠬᠤ ᠦᠵᠡᠭᠴᠢ ᠲᠦᠰᠢᠮᠡᠯ</unicode>
          <definition>procureur de gouvernement</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠢᠴᠠᠭᠠᠬᠤ ᠰᠢᠭᠦᠭᠴᠢ ᠲᠦᠰᠢᠮᠡᠯ</unicode>
          <definition>président du tribunal criminel</definition>
        </example>
        <example>
          <unicode>ᠪᠢᠴᠢᠭ ᠤᠳ ᠤᠨ ᠣᠴᠢᠷ ᠢ ᠪᠠᠶᠢᠴᠠᠭᠠᠬᠤ</unicode>
          <definition>examiner le contenu des papiers</definition>
        </example>
      </examples>
    </entry_item>
