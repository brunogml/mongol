    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠢᠰᠢᠷᠠᠺᠥ</unicode>
      <uighur>bisirekü</uighur>
      <cyrillic>бишрэх</cyrillic>
      <transcript>BISIRE-</transcript>
      <definition>v.t. and i. To believe in, revere, worship; to adore, admire; to respect,. esteem.</definition>
      <page>106</page>
      <examples>
        <example>
          <unicode>ᠪᠢᠰᠢᠷᠠᠢ ᠣᠶᠤᠲᠤ</unicode>
          <transcript>--kyi ojutu</transcript>
          <definition> Pious, devout.</definition>
        </example>
        <example>
          <unicode>ᠪᠢᠰᠢᠷᠠᠺᠦ ᠰᠡᠳᠺᠢᠯ</unicode>
          <transcript>-ky sedkil</transcript>
          <definition> Devout soul or heart, devotion.</definition>
        </example>
        <example>
          <unicode>ᠪᠢᠰᠢᠷᠠᠨ ᠲᠠᠯᠠᠷᠬᠠᠬᠤ</unicode>
          <transcript>---n talarxaxu</transcript>
          <definition> To be grateful.</definition>
        </example>
        <example>
          <unicode>ᠪᠢᠰᠢᠷᠠᠵᠦ ᠲᠣᠭᠠᠬᠤ</unicode>
          <transcript>--zy toγaxu</transcript>
          <definition> - To respect, esteem, admire; to show respect by following.</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠷᠬᠠᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠪᠢᠰᠢᠷᠠᠺᠦ</unicode>
          <transcript>burxan dur --ky</transcript>
          <definition> To believe in the Buddha or the gods.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠨᠳᠦᠯᠡᠨ ᠪᠢᠰᠢᠷᠠᠺᠦ</unicode>
          <transcript>kyndylen --ky</transcript>
          <definition> To worship, adore.</definition>
        </example>
        <example>
          <unicode>ᠨᠣᠮ ᠳ᠋‍‍ᠤ‍ᠷ ᠪᠢᠰᠢᠷᠠᠺᠦ</unicode>
          <transcript>nom dur --ky</transcript>
          <definition> To believe (religiously), be a believer.</definition>
        </example>
      </examples>
    </entry_item>
