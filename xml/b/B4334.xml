          <transcript>--n cidaxu</transcript>
          <definition>To be able to accomplish.</definition>
        </example>
        <example>
          <unicode>ᠪᠥᠲᠥᠺᠠᠨ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <transcript>--n γarγaxu</transcript>
          <definition>To produce.</definition>
        </example>
        <example>
          <unicode>ᠪᠥᠲᠥᠺᠠᠨ ᠥᠭᠺᠦ</unicode>
          <transcript>--n øgky</transcript>
          <definition>To produce, create.</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶᠡᠺᠡᠭᠦᠯᠦᠨ ᠪᠥᠲᠥᠺᠠᠺᠦ</unicode>
          <transcript>bejelegylyn --ky</transcript>
          <definition>To carry out, execute: realize</definition>
        </example>
        <example>
