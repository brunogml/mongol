        </example>
        <example>
          <unicode>ᠪᠥᠲᠥᠺᠠᠭᠰᠡᠨ ᠡᠳ</unicode>
          <transcript>--gsen ed,</transcript>
          <definition>Production, product, merchandise</definition>
        </example>
        <example>
          <unicode>ᠪᠥᠲᠥᠺᠠᠨ ᠪᠠᠶᠢᠭᠤᠯᠬᠤ</unicode>
          <transcript>--n baiγulxu,</transcript>
          <definition>To create, construct</definition>
        </example>
        <example>
