      <dico>Lessing</dico>
      <unicode>ᠪᠥᠺᠰᠢᠺᠥ</unicode>
      <uighur>bögsikü</uighur>
      <cyrillic>бөгших</cyrillic>
      <transcript>BØGSI-</transcript>
      <definition>1 [= bygsi-] v, i To choke with coughing or laughter.</definition>
      <page>126</page>
      <examples>
        <example>
          <unicode>ᠪᠥᠺᠰᠢᠳᠡᠭ ᠬᠠᠨᠢᠶᠠᠳ</unicode>
          <transcript>--deg xanijad</transcript>
          <definition> Whooping cough.</definition>
        </example>
        <example>
          <unicode>ᠪᠥᠺᠰᠢᠨ ᠢᠨᠢᠶᠡᠺᠦ</unicode>
          <transcript>--n inijeky</transcript>
          <definition> To choke with laughter.</definition>
        </example>
        <example>
          <unicode>ᠪᠥᠺᠰᠢᠨ ᠬᠠᠨᠢᠶᠠᠬᠤ</unicode>
          <transcript>--n xanijaxu. </transcript>
          <definition>To choke with coughing.</definition>
        </example>
      </examples>
    </entry_item>
