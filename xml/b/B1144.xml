    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠪᠠᠶᠠᠷ</unicode>
      <uighur>bayar</uighur>
      <cyrillic>баяр</cyrillic>
      <transcript>BAJAR</transcript>
      <definition>n. Joy, happiness, delight, enjoyment; festival, celebration; greeting, congratulation.</definition>
      <page>77</page>
      <examples>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠴᠡᠩᠭᠡᠯ</unicode>
          <transcript>-- cenggel</transcript>
          <definition>Joy, happiness, enjoyment.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠶᠣᠰᠤᠯᠠᠯ</unicode>
          <transcript>-- josulal</transcript>
          <definition>Feast, celebration.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠺᠢᠺᠦ</unicode>
          <transcript>-- kiky</transcript>
          <definition>To celebrate; to congratulate, salute.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠺᠡᠭᠡᠷ</unicode>
          <transcript>-- keger</transcript>
          <definition>Joy, gaiety.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠺᠦᠷᠭᠡᠺᠦ</unicode>
          <transcript>-- kyrgeky</transcript>
          <definition>To greet, congratulate, salute.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠮᠡᠳᠡᠭᠦᠯᠺᠦ</unicode>
          <transcript>-- medegylky</transcript>
          <definition>To present one's congratulations.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠨᠡᠭᠠᠳᠤᠮ</unicode>
          <transcript>-- naγadum,</transcript>
          <definition>Festival</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠤᠨ ᠪᠤᠤ</unicode>
          <transcript>-- un buu</transcript>
          <definition>Gun salute.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠤᠨ ᠴᠢᠷᠠᠢ</unicode>
          <transcript>-- un cirai</transcript>
          <definition>Beaming face, happy expression.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠤᠨ ᠳᠠᠭᠤ</unicode>
          <transcript>-- un daγu,</transcript>
          <definition>Song of joy</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠤᠨ ᠡᠳᠦᠷ</unicode>
          <transcript>-- un edyr</transcript>
          <definition>Holiday, festival.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠤᠨ ᠮᠡᠳᠡᠭᠡ</unicode>
          <transcript>-- un medege</transcript>
          <definition>Good news; gospel.,</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠤᠨ ᠲᠠᠮᠢᠺᠢ ᠪᠠᠷᠢᠬᠤ</unicode>
          <transcript>--un tamiki barixu</transcript>
          <definition>To offer snuff as a symbol of greeting or congratulation.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition>Without joy, disconsolate, despondent.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠵᠢᠷᠭᠠᠯ</unicode>
          <transcript>-- zirγal</transcript>
          <definition>Happiness.</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠨ᠎ᠡ ᠭᠡᠷ ᠤᠨ ᠪᠠᠶᠠᠷ</unicode>
          <transcript>sin-e ger yn --</transcript>
          <definition>Celebration on the occasion of moving into a new house,</definition>
        </example>
      </examples>
