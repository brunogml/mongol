    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠠᠭᠠᠯᠭ᠎ᠠ</unicode>
      <definition>porte de ville ou de maison, porte cochère; n entrée, passage, 3 métaph. relation, rapport, connéxion, liaison; système</definition>
      <page>737</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠭᠠᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠣᠨᠢᠰᠤ</unicode>
          <definition>barre, verrou</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠭᠠᠯᠭ᠎ᠠ ᠦᠭᠡᠢ</unicode>
          <definition>sans porte, sans entrée et sortie; 2 de rien, sans liaison et sans continuation</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠭᠠᠯᠭ᠎ᠠ ᠬᠠᠭᠠᠬᠤ</unicode>
