      <dico>Boberg</dico>
      <unicode>ᠬᠠᠳᠣᠮ</unicode>
      <uighur>qadum</uighur>
      <definition>(d)n. Relatives. Kindred on the husband's side.</definition>
      <page>567</page>
      <examples>
        <example>
          <uighur>qadum aq-a</uighur>
          <definition>n. An elder brother-in-law on the husband's side.</definition>
        </example>
        <example>
          <uighur>qadum eke</uighur>
          <definition>n. Mother-in-law. A husband's mother.</definition>
        </example>
        <example>
          <uighur>qadum ekeči</uighur>
          <definition>n. An elder sister-in-law on the husband's side.</definition>
        </example>
        <example>
          <uighur>qadum ečike</uighur>
          <definition>n. Father-in-law. Father of husband.</definition>
        </example>
      </examples>
