    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠳᠣᠮ</unicode>
      <uighur>qadom</uighur>
      <cyrillic>хадам</cyrillic>
      <transcript>XADUM</transcript>
      <definition>[=xadam] n. In-law relatives from the point of view of the husband or wife.</definition>
      <page>903</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠳᠣᠮ ᠠᠬ᠎ᠠ</unicode>
          <transcript>-- ax-a</transcript>
          <definition> Elder brother-in-law.</definition>
        </example>
        <example>
          <unicode> ᠬᠠᠳᠣᠮ ᠪᠡᠷᠭᠡᠨ</unicode>
          <transcript>-- bergen</transcript>
          <definition> Wife of elder brother-in-law.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠳᠣᠮ ᠎ᠳᠤ ᠭᠠᠷᠬᠤ</unicode>
          <transcript>-- du γarxu</transcript>
          <definition> To marry (of a woman).</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠳᠣᠮ ᠡᠴᠢᠭᠡ</unicode>
          <transcript>-- ecige</transcript>
          <definition> Father-in-law.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠳᠣᠮ ᠡᠭᠡᠴᠢ</unicode>
          <transcript>-- egeci</transcript>
          <definition> Elder sister-in-law.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠳᠣᠮ ᠡᠺᠡ</unicode>
          <transcript>-- eke</transcript>
          <definition> Mother-in-law.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠳᠣᠮ ᠺᠡᠯᠡᠯᠴᠡᠺᠦ</unicode>
          <transcript>-- kelelceky</transcript>
          <definition> To seek in marriage.</definition>
        </example>
      </examples>
    </entry_item>
