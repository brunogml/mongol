    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠣᠪᠢᠯᠭᠠᠬᠣ</unicode>
      <uighur>qubilγaqu</uighur>
      <cyrillic>хувилгах</cyrillic>
      <transcript>XUBILΓA-</transcript>
      <definition>[v. caus. of xubil-] v.t. To transform, change, metamorphose.</definition>
      <page>977</page>
      <examples>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠪᠡᠨ ᠬᠣᠪᠢᠯᠭᠠᠬᠣ</unicode>
          <transcript>bej-e ben --xu</transcript>
          <definition> To transform oneself (as by sorcery).</definition>
        </example>
        <example>
          <unicode>ᠥᠩᠭᠡ ᠬᠣᠪᠢᠯᠭᠠᠬᠣ</unicode>
          <transcript>øngge --xu</transcript>
          <definition> To paint a different color; to change the color.</definition>
        </example>
        <example>
          <unicode>ᠬᠤᠳᠠᠯᠳᠤᠵᠤ ᠬᠣᠪᠢᠯᠭᠠᠬᠣ</unicode>
          <transcript>xudalduzu --xu</transcript>
          <definition> To trade, barter.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠣᠪᠢᠯᠭᠠᠬᠤ</unicode>
      <definition>transformer, métamorphoser, changer d'une forme à une forme: 2 multiplier (arithm.).</definition>
      <page>893</page>
      <examples>
        <example>
          <unicode>ᠥᠩᠭᠡ ᠬᠣᠪᠢᠯᠭᠠᠬᠤ</unicode>
          <definition>changer de couleur, peindr,e teindre</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠭᠡᠨ ᠢᠶᠡᠷ ᠬᠣᠪᠢᠯᠭᠠᠨ ᠬᠤᠪᠢᠶᠠᠬᠤᠢ ᠳ᠋‍‍ᠤ‍ᠷ ᠨᠡᠮᠡᠺᠦ ᠬᠠᠰᠤᠬᠤ ᠦᠭᠡᠢ</unicode>
          <definition>lorsqu'on multiplie ou que l'on divise par un nombre 1, il ne faut rien ajouter, ni rien retrancher</definition>
        </example>
        <example>
          <unicode>ᠬᠤᠳᠠᠯᠳᠤᠵᠤ ᠬᠣᠪᠢᠯᠭᠠᠬᠤ ᠡᠳ ᠦᠭᠡᠢ</unicode>
          <definition>il n'y a point à être changé</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠎ᠪᠡᠨ ᠬᠣᠪᠢᠯᠭᠠᠬᠤ</unicode>
          <definition>se transformer, se métamorphoser. prendre une autre forme, un autre aspect</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠷ ᠢ ᠪᠣᠯᠤᠷ ᠪᠣᠯᠭᠠᠨ ᠬᠣᠪᠢᠯᠭᠠᠬᠤ</unicode>
          <definition>changer une maison en palais de cristal</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠷᠡᠯ ᠢ ᠨᠢᠭᠡᠨ ᠬᠠᠭᠠᠨ ᠬᠣᠪᠢᠯᠭᠠᠪᠠᠢ</unicode>
          <definition>il fit d'un rayon de soleil un prince, il a métamorphosé un rayon de soleil en prince</definition>
        </example>
      </examples>
    </entry_item>
