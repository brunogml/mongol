    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠶᠢᠷᠠᠬᠠᠨ</unicode>
      <uighur>qayiraqan</uighur>
      <cyrillic>хайрхан</cyrillic>
      <transcript>XAIRAXAN</transcript>
      <definition>adj., n., and interj. Merciful, gracious; sacred mountain; a formula introducing or concluding a prayer; also used as an interj. of surprise, astonishment, indignation, etc.</definition>
      <page>914</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠶᠢᠷᠠᠬᠠᠨ ᠭᠤᠷᠪᠠᠨ ᠡᠷᠳᠡᠨᠢ</unicode>
          <transcript>-- γurban erdeni</transcript>
          <definition> Oh, the gracious Three Jewels!.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠶᠢᠷᠠᠬᠠᠨ ᠶᠠᠭᠤᠲᠠᠢ ᠰᠠᠶᠢᠬᠠᠨ</unicode>
          <transcript>-- ! jayutai saixan!. </transcript>
          <definition>Oh, how beautiful!.</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠭᠤᠲᠠᠢ ᠬᠠᠶᠢᠷᠠᠬᠠᠨ</unicode>
          <transcript>jaγutai -- </transcript>
          <definition> What a pity!.</definition>
        </example>
        <example>
          <unicode>ᠤᠷᠤᠲ ᠬᠠᠶᠢᠷᠠᠬᠠᠨ</unicode>
          <transcript>urtu -- </transcript>
          <definition> Snake (euph.).</definition>
        </example>
      </examples>
    </entry_item>
