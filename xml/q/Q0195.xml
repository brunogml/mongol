      <dico>Lessing</dico>
      <unicode>ᠬᠠᠨᠲᠠᠷᠭ᠎ᠠ</unicode>
      <uighur>qandarγ-a</uighur>
      <cyrillic>хантрага</cyrillic>
      <transcript>XANTARΓ-A</transcript>
      <definition>n. Band or strap used for holding something to prevent it from bending or falling.</definition>
      <page>930</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠨᠲᠠᠷᠭ᠎ᠠ ᠴᠢᠯᠪᠤᠭᠤᠷ</unicode>
          <transcript>-- cilbuγur</transcript>
          <definition> A martingale.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠠᠨᠳᠠᠷᠭ᠎ᠠ ᠴᠢᠯᠪᠤᠭᠤᠷ</unicode>
      <definition>une courroie que l'on met dans la bouche d'un cheval et qui passe sous son ventre où l'on attache , pour l'obliger à baisser la tête.</definition>
      <page>724</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠨᠳᠠᠷᠭ᠎ᠠ ᠲᠠᠳᠠᠬᠤ ᠲᠡᠮᠦᠷ</unicode>
