    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠣᠴᠣᠷᠠᠬᠤ</unicode>
      <definition>rester en arrière, rester après les autres; 2 laisser qn. , abandonner, ordonner à qu. de rester derrière: 3 métaph. mourir.</definition>
      <page>941</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠢᠨ ᠬᠣᠴᠣᠷᠠᠬᠤ</unicode>
          <definition>perdre la vie, mourir</definition>
        </example>
        <example>
          <unicode>ᠡᠺᠡ ᠎ᠶᠢᠨ ᠺᠡᠨᠡᠯᠢᠨ᠎ᠡ ᠬᠣᠴᠣᠷᠠᠭᠰᠠᠨ</unicode>
          <definition>(un fils) qui est resté dans le sein de la mère</definition>
        </example>
        <example>
          <unicode>ᠨᠥᠭᠡᠨ ᠤ ᠢᠷᠤᠭᠠᠷ᠎ᠠ ᠬᠣᠴᠣᠷᠠᠪᠠᠢ</unicode>
          <definition>il est resté (fut laissé) au fond du trou</definition>
        </example>
      </examples>
    </entry_item>
