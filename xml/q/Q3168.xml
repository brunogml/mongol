    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠷᠠᠩᠭᠣᠢ</unicode>
      <uighur>qarangγui</uighur>
      <cyrillic>харангуй</cyrillic>
      <transcript>XARANGΓUI</transcript>
      <definition>[= xarangγu, xarangxui] adj. and n. Dark[ness]; dusk</definition>
      <page>935</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠣᠢ ᠠᠷᠢᠯᠭᠠᠬᠤ</unicode>
          <transcript>-- arilγaxu</transcript>
          <definition>To dispel darkness; to enlighten by religious teachings.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠣᠢ ᠪᠠᠯᠠᠷ</unicode>
          <transcript>-- balar</transcript>
          <definition>Ignorant, backward, uncultured, uncivilized</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠣᠢ ᠪᠠᠯᠠᠷ ᠴᠠᠭ</unicode>
          <transcript>-- balar caγ</transcript>
          <definition>Primitive age, dark age.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠣᠢ ᠪᠣᠯᠬᠤ</unicode>
          <transcript>-- bolxu</transcript>
          <definition>To become dark, darken.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠣᠢ ᠪᠦᠳᠦᠭᠦᠯᠢᠭ</unicode>
          <transcript>-- bydygylig</transcript>
          <definition>Ignorant, backward, undeveloped, uncultured.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠣᠢ ᠮᠤᠩᠬᠠᠭ</unicode>
          <transcript>-- mungxaγ</transcript>
          <definition>Stupidity, stupid.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠣᠢ ᠣᠷᠤᠨ</unicode>
          <transcript>-- orun</transcript>
          <definition>Dark place or spot.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠣᠢ ᠰᠥᠨᠢ</unicode>
          <transcript>-- søni</transcript>
          <definition>Dark night.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠣᠢ ᠦᠳᠡᠰᠢ</unicode>
          <transcript>-- ydesi</transcript>
          <definition>Dusk, twilight; at twilight.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠠᠷᠠᠩᠭᠤ ~ ᠬᠠᠷᠠᠩᠭᠤᠢ</unicode>
      <definition>obscurité. ténèbres; sombre , obscur: métaph, les ténèbres de l'ignorance; 3 les enfers.</definition>
      <page>828</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠠᠷᠢᠯᠭᠠᠬᠤ</unicode>
          <definition>dissiper l'obscurité, éclairer; 2 métaph. éclairer surtout par la religion</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠣᠢ</unicode>
          <definition>un bois sombre, une forêt épaisse</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠣᠷᠣᠨ</unicode>
          <definition>endroit sombre; prison; 2 enfer</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠦᠹᠡᠰᠢ</unicode>
          <definition>soirée sombre, pendant l'obscurité du soir; pendant le crépuscule</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠨᠥᠭᠡᠨ</unicode>
          <definition>un trou sombre, caverne, prison</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠎ᠶᠢᠨ ᠪᠠᠯᠠᠷ</unicode>
          <definition>obscurité la plus épaisse; 2 obscurité morale, ignorance</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠎ᠶᠢ ᠪᠠᠷᠢᠭᠴᠢ</unicode>
          <definition>ombreux, qui donne de l'ombrage; 2 épithète de l'arbre tamala</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠪᠦᠲᠡᠺᠦ</unicode>
          <definition>s'obscurcir, être obscurci; 2 être couvert des ténèbres de l'ignorance</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠪᠦᠷᠭᠦᠭᠰᠡᠨ</unicode>
          <definition>couvert de ténèbres; 2 épithète de Vasoudhara-yakchas</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠪᠣᠯᠪᠠ</unicode>
          <definition>il fait sombre, obscur</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠲᠦᠭᠡᠭᠰᠡᠨ</unicode>
          <definition>celui qui répand l'obscurité, tout-à-fait noir, tout noir</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠎ᠶᠢᠨ ᠳᠠᠶᠢᠰᠤᠨ</unicode>
          <definition>ennemi de l'obscurité: soleil</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠎ᠶᠢ ᠭᠡᠭᠡᠷᠡᠭᠦᠯᠦᠭᠰᠡᠨ</unicode>
          <definition>dissipeur des ténèbres: jour</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠭᠡᠷ</unicode>
          <definition>maison sombre, obscure; prison</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤᠢ ᠮᠣᠩᠭᠣᠯ ᠤᠨ ᠭᠠᠵᠠᠷ᠎ᠠ ᠰᠠᠰᠢᠨ ᠤ ᠨᠠᠷᠠᠨ ᠢ ᠣᠷᠭᠤᠭᠤᠯᠬᠤ</unicode>
          <definition>élever le soleil de la religion sur la terre des Mongols ignorants</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠭᠦᠳᠡᠷ ᠢᠶᠡᠷ ᠬᠠᠷᠠᠩᠭᠤᠢ ᠪᠣᠯᠭᠠᠬᠤ</unicode>
          <definition>ombrager</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠮᠦᠨ ᠪᠣᠯᠤᠭᠠᠳ ᠡᠰᠡ ᠰᠤᠷᠪᠠᠰᠤ ᠬᠠᠷᠠᠩᠭᠤᠢ ᠰᠦᠨᠢ ᠶᠠᠪᠤᠬᠤᠢ ᠳ᠋‍‍ᠤ‍ᠷ ᠠᠳᠠᠯᠢ</unicode>
          <definition>un homme sans instruction ressemble à celui qui marche dans l'obscurité de la nuit</definition>
        </example>
      </examples>
    </entry_item>
