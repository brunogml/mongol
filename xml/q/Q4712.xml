    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠣᠪᠢᠯᠬᠣ</unicode>
      <uighur>qubilqu</uighur>
      <cyrillic>хувилах</cyrillic>
      <transcript>XUBIL-</transcript>
      <definition>v. i. To change, be transformed, take another form; to be reincarnated; to form an abscess, become infected; to deteriorate.</definition>
      <page>977</page>
      <examples>
        <example>
          <unicode>ᠬᠣᠪᠢᠯᠬᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>--xu ygei</transcript>
          <definition> Unchangeable, invariable, immutable.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠪᠢᠯᠵᠤ ᠲᠥᠷᠦᠺᠦ</unicode>
          <transcript>--zu tøryky</transcript>
          <definition> To be reborn in another form, become reincarnated.</definition>
        </example>
        <example>
          <unicode>ᠳᠦᠷᠰᠦ ᠬᠣᠪᠢᠯᠬᠣ</unicode>
          <transcript>dyrsy --xu</transcript>
          <definition> To transform, transfigure oneself.</definition>
        </example>
        <example>
          <unicode>ᠡᠪᠦᠭᠡᠨ ᠺᠦᠮᠦᠨ ᠪᠣᠯᠤᠨ ᠬᠣᠪᠢᠯᠬᠣ</unicode>
          <transcript>ebygen kymyn bolun --xu</transcript>
          <definition> To transform oneself into an old man (through magic).</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠭᠤᠷ ᠬᠣᠪᠢᠯᠬᠣ</unicode>
          <transcript>niγur --xu</transcript>
          <definition> To become angry; to break with someone.</definition>
        </example>
        <example>
          <unicode>ᠥᠩᠭᠡ ᠢᠨᠤ ᠬᠣᠪᠢᠯᠬᠣ</unicode>
          <transcript>øngge inu --xu</transcript>
          <definition> For the color to change or fade</definition>
        </example>
        <example>
          <unicode>ᠲᠩᠷᠢ ᠪᠣᠯᠤᠨ ᠬᠣᠪᠢᠯᠬᠣ</unicode>
          <transcript>tngri bolun --xu</transcript>
          <definition> To change into a tngri, q. v.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠣᠪᠢᠯᠵᠤ</unicode>
      <transcript>XUBILZU </transcript>
      <page>1190</page>
      <examples>
        <example>
          <unicode>ᠬᠤᠪᠢᠯᠵᠤ ᠲᠥᠷᠦᠺᠦ</unicode>
          <transcript>tøryky; </transcript>
          <definition>T. brdzus te skye ba; S. aupapaduka. To be born without visible cause or without parents, spontaneously. ED l39 ( upapada, upapaduka, aupapaduka ) differs somewhat.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠣᠪᠢᠯᠬᠤ</unicode>
      <definition>changer, être transformé, se métamorphoser, prendre une autre forme, faire semblant: renaître dans qn.</definition>
      <page>892</page>
      <examples>
        <example>
          <unicode>ᠡᠪᠦᠭᠡᠨ ᠺᠦᠮᠦᠨ ᠪᠣᠯᠤᠨ ᠬᠣᠪᠢᠯᠬᠤ</unicode>
          <definition>se transformer en vieillard, se métamorphoser en vieillard</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠪᠢᠯᠬᠤᠢ ᠺᠢᠤᠵᠠᠭᠠᠨ</unicode>
          <definition>hermaphrodite, qui a les deux sexes</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠪᠢᠯᠵᠤ ᠲᠥᠷᠥᠺᠦ</unicode>
          <definition>la naissance par tansformation, conversion</definition>
        </example>
        <example>
          <unicode>ᠲᠩᠷᠢ ᠪᠣᠯᠬᠤ ᠬᠣᠪᠢᠯᠬᠤ</unicode>
          <definition>se métamorphoser en Tégri</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠷᠢ ᠬᠣᠪᠢᠯᠬᠤ</unicode>
          <definition>prendre l'aspect ou la forme d'un autre; mouvement du corps, geste</definition>
        </example>
      </examples>
    </entry_item>
