    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠶᠢᠯᠠᠬᠣ</unicode>
      <uighur>qayilaqu</uighur>
      <cyrillic>хайлах</cyrillic>
      <transcript>XAILA-</transcript>
      <definition>v.i. To weep, cry, shed tears.</definition>
      <page>912</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠶᠢᠯᠠᠨ ᠺᠦᠢᠯᠡᠨ</unicode>
          <transcript>--n kyilen</transcript>
          <definition> Weeping and crying.</definition>
        </example>
        <example>
          <unicode>ᠤᠶᠢᠯᠠᠬᠤ ᠬᠠᠶᠢᠯᠠᠬᠣ</unicode>
          <transcript>uilaxu --xu</transcript>
          <definition> To weep, cry.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠠᠶᠢᠯᠠᠬᠤ</unicode>
      <definition>pleurer, déplorer, plaindre verser des larmes: 2 passim fondre, liquéfier: brûler (les morts). Cf. s. v. khayloukhou, khaylkhou.</definition>
      <page>708</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠶᠢᠯᠠᠪᠠᠰᠤ ᠦᠯᠦ ᠰᠣᠨᠤᠰᠤᠮ</unicode>
          <definition>nous ne verrons pas (tes) larmes</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠲᠤᠨ ᠦᠷᠡᠰ ᠴᠢᠨᠤ ᠬᠠᠶᠢᠯᠠᠨ ᠺᠦᠢᠯᠡᠨ ᠢᠷᠡᠨᠡᠮ</unicode>
          <definition>la femme et les enfants viendront à ta rencontre avec des larmes</definition>
        </example>
      </examples>
    </entry_item>
