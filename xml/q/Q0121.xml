    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠨᠢᠶᠠᠳᠤ ~ ᠬᠠᠨᠢᠶᠠᠳᠤᠨ</unicode>
      <uighur>qaniyadu - qaniyadun</uighur>
      <cyrillic>ханиад</cyrillic>
      <transcript>XANIJADU(N)</transcript>
      <definition>[=xanijad, xanijadum] n. Cough; grippe, influenza.</definition>
      <page>930</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠨᠢᠶᠠᠳᠤ ᠡᠪᠡᠳᠴᠢᠨ</unicode>
          <transcript>-- ebedcin</transcript>
          <definition> Cold, grippe, influenza; all diseases accompanied by cough.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠨᠢᠶᠠᠳᠤ ᠺᠦᠷᠺᠦ</unicode>
          <transcript>-- kyrky</transcript>
          <definition> To catch a cold or influenza.</definition>
        </example>
        <example>
          <unicode>ᠠᠭᠤᠰᠺᠢᠨ ᠤ ᠬᠠᠨᠢᠶᠠᠳᠤ</unicode>
          <transcript>aγuskin [u] -- </transcript>
          <definition> Tuberculosis; pneumonia.</definition>
        </example>
        <example>
          <unicode>ᠪᠦᠭᠰᠢᠭᠦᠯᠳᠡᠭ ᠬᠠᠨᠢᠶᠠᠳᠤ</unicode>
          <transcript>bygsigyldeg – </transcript>
          <definition>Whooping cough</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠯᠳᠠᠪᠤᠷᠢᠲᠤ ᠬᠠᠨᠢᠶᠠᠳᠤ ᠡᠪᠡᠳᠴᠢᠨ</unicode>
          <transcript>xaldaburitu-- ebedcin</transcript>
          <definition>Epidemic pneumonia.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠭᠤᠯᠠᠢ ᠲᠠᠲᠠᠳᠠᠭ ᠬᠠᠨᠢᠶᠠᠳᠤ</unicode>
          <transcript>xoγulai tatadaγ -- </transcript>
          <definition> Whooping cough.</definition>
        </example>
      </examples>
