  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠣᠭᠣᠯᠬᠣ</unicode>
      <uighur>quγulqu</uighur>
      <cyrillic>хугалах</cyrillic>
      <transcript>XUΓUL-</transcript>
      <definition>[= xaγul-, 2] v.t. To break in two (of long objects), fracture (bone); also used figuratively.</definition>
      <page>981</page>
      <examples>
        <example>
          <unicode>ᠭᠠᠷ ᠢ ᠬᠣᠭᠣᠯᠬᠣ</unicode>
          <transcript>γar i --xu</transcript>
          <definition> To break the arms, fracture the hand or arm</definition>
        </example>
        <example>
          <unicode>ᠮᠥᠴᠢᠷ ᠢ ᠬᠣᠭᠣᠯᠬᠣ</unicode>
          <transcript>møcir i --xu</transcript>
          <definition> To break a branch of a plant.</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠳᠺᠢᠯ ᠢ ᠬᠣᠭᠣᠯᠬᠣ</unicode>
          <transcript>sedkil i --xu</transcript>
          <definition> To disappoint, discourage.</definition>
        </example>
        <example>
          <unicode>ᠤᠷᠮ᠎ᠠ ᠬᠣᠭᠣᠯᠬᠣ</unicode>
          <transcript>urm-a --xu</transcript>
          <definition> To discourage, cause to lose interest</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠷᠢᠭ ᠢ ᠦᠯᠦ ᠬᠣᠭᠣᠯᠬᠣ</unicode>
          <transcript>zoriγ i yly --xu</transcript>
          <definition> Not to discourage one in his zeal or ambition.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠣᠭᠤᠯᠬᠤ ~ ᠬᠠᠭᠤᠯᠬᠤ</unicode>
      <definition>rompre, casser eu deux, briser</definition>
      <page>885</page>
      <examples>
        <example>
          <unicode>ᠦᠷᠮ᠎ᠡ ᠬᠣᠭᠤᠯᠬᠤ</unicode>
          <definition>perdre l'énergie, l'envie ou l'inclination</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠳᠡᠨ ᠰᠢᠳᠦᠨ ᠢ ᠬᠣᠭᠤᠯᠬᠤ</unicode>
          <definition>casser les dents de devant</definition>
        </example>
        <example>
          <unicode>ᠨᠣᠮᠤᠨ ᠬᠣᠭᠤᠯᠬᠤ</unicode>
          <definition>casser, briser l'arc</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠯᠠᠭᠠᠢ ᠺᠢᠪᠡᠰᠦ ᠭᠠᠷ ᠢ ᠬᠣᠭᠤᠯᠬᠤ</unicode>
          <definition>rompre les bras du voleur</definition>
        </example>
        <example>
          <unicode>ᠮᠣᠳᠤᠨ ᠤ ᠮᠥᠵᠢᠷ ᠢ ᠬᠣᠭᠤᠯᠬᠤ</unicode>
          <definition>casser une branche</definition>
        </example>
        <example>
          <unicode>ᠮᠣᠷᠢᠨ ᠤ ᠺᠥᠯ ᠢ ᠬᠣᠭᠤᠯᠬᠤ</unicode>
          <definition>casser la jambe d'un cheval</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠷᠢᠭ ᠦᠯᠦ ᠬᠣᠭᠤᠯᠬᠤ</unicode>
          <definition>ne pas changer d'intention, se diriger constamment vers le même but</definition>
        </example>
      </examples>
