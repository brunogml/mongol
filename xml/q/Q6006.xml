    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠣᠮᠣᠭᠠᠯᠵᠠᠬᠣ</unicode>
      <uighur>qomoγalǰaqu</uighur>
      <cyrillic>хомголзох</cyrillic>
      <transcript>XOMUΓALZA-</transcript>
      <definition>[= xomuγulza-] v. i. To ask importunately pester somebody with requests, solicit, beg, wheedle; to be greedy, mercenary; to covet; to desire something ardently.</definition>
      <page>961</page>
      <examples>
        <example>
          <unicode>ᠪᠤᠰᠤᠳ ᠤᠨ ᠺᠥᠷᠦᠩᠭᠡ ᠎ᠳᠦ ᠬᠣᠮᠣᠭᠠᠯᠵᠠᠬᠣ</unicode>
          <transcript>busud un køryngge dy --xu</transcript>
          <definition> To covet other people's property.</definition>
        </example>
        <example>
          <unicode>ᠣᠯᠵᠠ ᠠᠰᠢᠭ ᠤᠨ ᠲᠥᠯᠦᠭᠡ ᠬᠣᠮᠣᠭᠠᠯᠵᠠᠬᠣ</unicode>
          <transcript>olza asiγ un tølyge --xu</transcript>
          <definition> To be greedy for profit or gain.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠣᠮᠣᠭᠠᠯᠵᠠᠬᠤ ~ ᠬᠣᠮᠣᠭᠣᠯᠭᠠᠬᠤ</unicode>
      <definition>être intéressé, avide de gain, qc. vivement, ardemment, avec ardeur.</definition>
      <page>936</page>
      <examples>
        <example>
          <unicode>ᠬᠣᠮᠣᠭᠠᠯᠵᠠᠬᠤᠢ ᠰᠡᠳᠺᠢᠯ ᠎ᠲᠦ</unicode>
          <definition>avide, intéressé, envieux, insatiable</definition>
        </example>
      </examples>
    </entry_item>
