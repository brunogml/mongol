  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠣᠪᠢᠯᠭᠠᠨ</unicode>
      <uighur>qubilγan</uighur>
      <cyrillic>хувилгаан</cyrillic>
      <transcript>XUBILΓAN</transcript>
      <definition>n. and adj. Transformation, metamorphosis; apparition , phantom; a person, esp. a high lama in whom a buddha, bodhisatva or some saintly person is believed to be incarnated; incarnation, often referred to as "living buddha" by Western writers, after the Chinese huo-fo; transformed, incarnated.</definition>
      <page>978</page>
      <examples>
        <example>
          <unicode>ᠬᠣᠪᠢᠯᠭᠠᠨ ᠦᠵᠡᠭᠦᠯᠺᠦ</unicode>
          <transcript>-- yzegylky</transcript>
          <definition> To manifest or display supernatural power, practice sorcery or magic.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠪᠢ ᠬᠣᠪᠢᠯᠭᠠᠨ</unicode>
          <transcript>ilbi -- </transcript>
          <definition> Magic, sorcery, supernatural power.</definition>
        </example>
      </examples>
    </entry_item>
