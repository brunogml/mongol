    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠪᠢᠲᠠᠭᠣᠯᠬᠣ</unicode>
      <uighur>qabidaγulqu</uighur>
      <cyrillic>хавьтуулах</cyrillic>
      <transcript>XABIDAΓUL-</transcript>
      <definition>[v. caus. of xabida-] To cause or to allow to approach; to suggest indirectly or by covert allusion; to hint.</definition>
      <page>897</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠪᠢᠲᠠᠭᠣᠯᠬᠣ ᠦᠭᠡᠢ ᠪᠠᠶᠢᠬᠤ</unicode>
          <transcript>--xu ygei baixu</transcript>
          <definition> Not to let approach or come near; to flatly refuse.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠵᠢᠭᠤ ᠳᠠᠭᠠᠨ ᠬᠠᠪᠢᠲᠠᠭᠣᠯᠬᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>xaziγu daγan --xu ygei</transcript>
          <definition> Not to let [anyone] approach or come near [oneself].</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
