      <dico>Lessing</dico>
      <unicode>ᠬᠠᠪᠢᠲᠠᠬᠣ</unicode>
      <uighur>qabidaqu</uighur>
      <cyrillic>хавьтах - хавьдах</cyrillic>
      <transcript>XABIDA-</transcript>
      <definition>v.i. To come close, near, come to the side of; to approach.</definition>
      <page>897</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠪᠢᠲᠠᠬᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>--xu ygei</transcript>
          <definition> Way off, not close.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠢᠲᠠᠬᠣ ᠦᠭᠡᠢ ᠶᠡᠺᠡ</unicode>
          <transcript>--xu ygei jeke</transcript>
          <definition> Much more, much greater or bigger</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠭᠦᠨ ᠤ ᠺᠡᠯᠡᠭᠰᠡᠨ ᠦᠭᠡ ᠬᠠᠪᠢᠲᠠᠵᠤ ᠪᠠᠶᠢᠨ᠎ᠠ</unicode>
          <transcript>tegyn y kelegsen yge --zu bain-a</transcript>
          <definition> What he said is almost right.</definition>
        </example>
      </examples>
