      <unicode>ᠬᠠᠵᠢᠭᠣᠯᠠᠬᠣ</unicode>
      <uighur>qaǰiγulaqu</uighur>
      <cyrillic>хажуулах</cyrillic>
      <transcript>XAZIΓULA-</transcript>
      <definition>v. i. and t. To be near some object; to lie on the side; to lie down for a while.</definition>
      <page>948</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠵᠢᠭᠣᠯᠠᠨ ᠰᠠᠭᠤᠬᠤ</unicode>
          <transcript>--n saγuxu </transcript>
          <definition>To sit side by side</definition>
        </example>
        <example>
          <unicode>ᠠᠭᠤᠯᠠ ᠎ᠶᠢ ᠬᠠᠵᠢᠭᠣᠯᠠᠨ ᠨᠡᠭᠦᠺᠦ</unicode>
          <transcript>aγula ji --n negyky</transcript>
          <definition> To nomadize in the neighborhood of a mountain.</definition>
        </example>
      </examples>
