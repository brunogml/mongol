      <dico>Lessing</dico>
      <unicode>ᠭᠠᠯᠠᠪ</unicode>
      <uighur>γalab</uighur>
      <cyrillic>галав</cyrillic>
      <transcript>ΓALAB</transcript>
      <definition>[= galab, S. kalpa, T. skal pa] n. Mythological period of time in Buddhist cosmology, eon, period, age.</definition>
      <page>346</page>
      <examples>
        <example>
          <unicode>ᠭᠠᠯᠠᠪ ᠶᠡᠭᠦᠯᠡᠺᠦ</unicode>
          <transcript>-- jegyleky</transcript>
          <definition>Destruction (end of the world), cataclysm, deluge.</definition>
        </example>
        <example>
          <unicode>ᠮᠥᠰᠦᠨ ᠭᠠᠯᠠᠪ</unicode>
          <transcript>møsyn --</transcript>
          <definition>Ice age.</definition>
        </example>
      </examples>
    </entry_item>
