      <dico>Lessing</dico>
      <unicode>ᠬᠣᠷᠣᠬᠳᠠᠬᠣ</unicode>
      <uighur>qoroqdaqu</uighur>
      <cyrillic>хорогдох</cyrillic>
      <transcript>XORUΓDA-</transcript>
      <definition>[v. pass . of xoru-] To be diminished, to decrease in quantity; to fall (as prices); to die, perish</definition>
      <page>969</page>
      <examples>
        <example>
          <unicode>ᠳᠠᠶᠢᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠬᠣᠷᠣᠬᠳᠠᠬᠣ</unicode>
          <transcript>dain dur --xu</transcript>
          <definition> To be killed in a war.</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯ ᠬᠣᠷᠣᠬᠳᠠᠬᠣ</unicode>
          <transcript>mal --xu</transcript>
          <definition> [For the number of] cattle to decrease.</definition>
        </example>
      </examples>
    </entry_item>
