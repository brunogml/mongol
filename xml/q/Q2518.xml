    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠮᠳᠣᠳᠬᠠᠬᠣ</unicode>
      <uighur>qamdodqaqu</uighur>
      <cyrillic>хамтатгах</cyrillic>
      <transcript>XAMTUDXA-</transcript>
      <definition>[v. caus. of xamtud-] v.t. To combine, unite, unify; to collect; to put or join together</definition>
      <page>925</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠠᠭ᠎ᠠ ᠪᠡᠨ ᠬᠠᠮᠳᠣᠳᠬᠠᠬᠣ</unicode>
          <transcript>alaγ-a ben --xu</transcript>
          <definition> To join the palms of one's hands (as in prayer or greeting).</definition>
        </example>
        <example>
          <unicode>ᠨᠡᠶᠢᠲᠡ ᠬᠠᠮᠳᠣᠳᠬᠠᠬᠣ</unicode>
          <transcript>neite --xu</transcript>
          <definition> To sum up; to total.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠠᠮᠳᠣᠳᠬᠠᠬᠤ</unicode>
      <definition>réunir, joindre, rassembler, former un ensemble, additionner</definition>
      <page>811</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠠᠭᠠᠪᠠᠨ ᠬᠠᠮᠳᠣᠳᠬᠠᠬᠤ</unicode>
          <definition>joindre les paumes</definition>
        </example>
        <example>
          <unicode>ᠨᠠᠶᠢᠲᠠ ᠬᠠᠮᠳᠣᠳᠬᠠᠪᠠᠰᠤ</unicode>
          <definition>au total, en tout, en somme</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠮᠤᠭ ᠵᠠᠭᠤᠮᠠ ᠎ᠶᠢ ᠬᠠᠮᠳᠣᠳᠬᠠᠬᠤ</unicode>
          <definition>entasser tous les effets dans le même endroit</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠮᠳᠣᠳᠬᠠᠬᠤᠢ ᠎ᠶᠢᠨ ᠭᠡᠷ</unicode>
          <definition>jumeaux, signe du zodiaque</definition>
        </example>
        <example>
          <unicode>ᠲᠤᠭ᠎ᠠ ᠎ᠶᠢ ᠬᠠᠮᠳᠣᠳᠬᠠᠬᠤ</unicode>
          <definition>additionner les chiffres, faire les comptes</definition>
        </example>
      </examples>
