      <cyrillic>хоромжт</cyrillic>
      <transcript>XORUMZITU</transcript>
      <definition>adj. Disadvantageous, with loss or damage; necessitating expenditures; unfortunate, wronged</definition>
      <page>969</page>
      <examples>
        <example>
          <unicode>ᠬᠣᠷᠣᠮᠵᠢᠲᠣ ᠶᠠᠭᠤᠮ᠎ᠠ</unicode>
          <transcript>-- jaγum-a</transcript>
          <definition> A costly affair</definition>
        </example>
      </examples>
    </entry_item>
