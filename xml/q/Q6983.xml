      <dico>Lessing</dico>
      <unicode>ᠬᠣᠷᠣᠭᠠᠬᠣ</unicode>
      <uighur>qoroγaqu</uighur>
      <cyrillic>хороох</cyrillic>
      <transcript>XORUΓA-</transcript>
      <definition>1 [v. caus. of xoru-] To diminish, lessen, decrease, retrench, abridge; to destroy, annihilate; to assassinate, commit regicide or patricide; to execute</definition>
      <page>968</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠢᠨ ᠢ ᠬᠣᠷᠣᠭᠠᠬᠣ</unicode>
          <transcript>amin i --xu</transcript>
          <definition> To kill, assassinate; to execute.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠵᠠᠷ ᠬᠣᠷᠣᠭᠠᠬᠣ</unicode>
          <transcript>γazar --xu</transcript>
          <definition> To shorten the distance.</definition>
        </example>
        <example>
          <unicode>ᠨᠠᠰᠤᠨ ᠢ ᠬᠣᠷᠣᠭᠠᠬᠣ</unicode>
          <transcript>nasun i --xu</transcript>
          <definition> To shorten one's life.</definition>
        </example>
      </examples>
    </entry_item>
