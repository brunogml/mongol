      <uighur>qabdaγai</uighur>
      <cyrillic>хавтгай</cyrillic>
      <transcript>XABTAΓAI</transcript>
      <definition>[= xabtaγ-a] adj. and n. Flat, even; wooden board; plane surface; flatness</definition>
      <page>899</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠪᠲᠠᠭᠠᠢ ᠮᠣᠳᠤ</unicode>
          <transcript>-- modu</transcript>
          <definition> Plank, wooden board.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠲᠠᠭᠠᠢ ᠰᠠᠬᠠᠯ</unicode>
          <transcript>---saxal</transcript>
          <definition> A kind of grass (Ch. pai-erh, sha-ts’ao)</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠲᠠᠭᠠᠢ ᠬᠠᠪᠠᠷᠲᠠᠢ</unicode>
          <transcript>-- xabartai</transcript>
          <definition> Flat-nosed</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠲᠠᠭᠠᠢ ᠵᠢᠭᠠᠰᠤ</unicode>
          <transcript>-- ziyasu</transcript>
          <definition> A flat salt water fish with a head like a carp (Ch. pien - yü)</definition>
        </example>
      </examples>
