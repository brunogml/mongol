    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠠᠷᠰᠢᠬᠤ</unicode>
      <definition>empêcher, mettre obstacle, retenir</definition>
      <page>847</page>
      <examples>
