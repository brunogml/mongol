      <dico>Lessing</dico>
      <unicode>ᠬᠠᠨ</unicode>
      <uighur>qaa</uighur>
      <cyrillic>хаан</cyrillic>
      <transcript>XAN</transcript>
      <definition>n. Khan, king, chief Cf. xaγan.</definition>
      <page>926</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠨ ᠪᠠᠶᠠᠨ ᠲᠩᠷᠢ</unicode>
          <transcript>-- bajan tngri</transcript>
          <definition> Shamanistic god of hunting.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠨ ᠢᠵᠠᠭᠤᠷ</unicode>
          <transcript>-- izaγur</transcript>
          <definition> Royal caste. of a royal house.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠨ ᠺᠦᠪᠡᠭᠦᠨ</unicode>
          <transcript>-- kybegyn</transcript>
          <definition> Royal prince.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠨ ᠣᠷᠤᠨ</unicode>
          <transcript>-- orun</transcript>
          <definition> Throne; kingdom.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠨ ᠣᠷᠤᠨ᠎ᠠ ᠰᠠᠭᠤᠯᠭᠠᠬᠤ</unicode>
          <transcript>-- orun-a saγulγaxu</transcript>
          <definition> To install on the throne.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠨ ᠰᠠᠭᠤᠬᠤ</unicode>
          <transcript>-- saγuxu</transcript>
          <definition> To ascend the throne.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠨ ᠰᠢᠷᠡᠭᠡ</unicode>
          <transcript>-- sirege</transcript>
          <definition> Throne.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠨ ᠲᠡᠮᠦᠷ</unicode>
          <transcript>-- temyr</transcript>
          <definition> [Gr.] Peucedanum rigidum (plant).</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠨ ᠲᠥᠷᠦ</unicode>
          <transcript>-- tøry</transcript>
          <definition> Empire, kingdom; monarchy.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠨ ᠲᠥᠷᠦ ᠪᠠᠷᠢᠭᠤᠯᠬᠤ</unicode>
          <transcript>-- tøry bariγulxu</transcript>
          <definition> To entrust the government to somebody; to enthrone.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠨ ᠲᠥᠷᠦ ᠪᠠᠷᠢᠯᠬᠤ</unicode>
          <transcript>-- tøry barixu</transcript>
          <definition> To rule as a king, govern.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠨ ᠤ ᠣᠷᠳᠤ</unicode>
          <transcript>-- u ordu</transcript>
          <definition> King's palace.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠨ ᠤ ᠤᠷᠤᠭ</unicode>
          <transcript>-- u uruγ</transcript>
          <definition> Royal house or family, dynasty.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠨ ᠵᠠᠰᠠᠭ</unicode>
          <transcript>-- zasaγ</transcript>
          <definition> Law; order of the king; monarchic government</definition>
        </example>
      </examples>
