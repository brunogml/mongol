    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠮᠺᠢᠬᠣ</unicode>
      <uighur>qamkiqu</uighur>
      <cyrillic>хамхих</cyrillic>
      <transcript>XAMKI-</transcript>
      <definition>v. t. To shut, close, draw together (in order to close).</definition>
      <page>924</page>
      <examples>
        <example>
          <unicode>ᠠᠨᠢᠰᠬ᠎ᠠ ᠬᠠᠮᠺᠢᠬᠣ</unicode>
          <transcript>anisx-a --xu</transcript>
          <definition> To shut the eyes.</definition>
        </example>
        <example>
          <unicode>ᠠᠨᠠ ᠪᠡᠨ ᠬᠠᠮᠺᠢᠬᠣ</unicode>
          <transcript>ama [ben] --xu</transcript>
          <definition> To shut the mouth, be silent.</definition>
        </example>
        <example>
          <unicode>ᠰᠤᠳᠤᠷ ᠢ ᠬᠠᠮᠺᠢᠬᠣ</unicode>
          <transcript>sudur i --xu</transcript>
          <definition> To close a book.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠠᠮᠺᠢᠬᠤ</unicode>
      <definition>fermer, serrer, joindre: 2 coller, joindre deux parties d'une même chose (p. e, d une porcelaine cassée], réunir.</definition>
      <page>813</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠠᠪᠠᠨ ᠬᠠᠮᠺᠢᠬᠤ</unicode>
          <definition>fermer la bouche</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠤᠭᠤᠯ ᠬᠠᠮᠺᠢᠬᠤ</unicode>
          <definition>serrer les lèvres, fermer la bouche</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠳᠦᠨ ᠤ ᠠᠨᠢᠰᠬᠠ ᠬᠠᠮᠺᠢᠬᠤ</unicode>
          <definition>fermer les paupières, fermer les yeux</definition>
        </example>
        <example>
          <unicode>ᠰᠤᠳᠤᠷ ᠢ ᠬᠠᠮᠺᠢᠬᠤ</unicode>
          <definition>fermer le livre</definition>
        </example>
      </examples>
