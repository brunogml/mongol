      <dico>Lessing</dico>
      <unicode>ᠬᠠᠭᠠᠰᠯᠠᠬᠣ</unicode>
      <uighur>qaγaslaqu</uighur>
      <cyrillic>хагаслах</cyrillic>
      <transcript>XAΓASLA-</transcript>
      <definition>v.t. and i. To divide in half; to do something halfway; to be[come] half -done; to reach a mid-point.</definition>
      <page>907</page>
      <examples>
        <example>
          <unicode>ᠠᠵᠢᠯ ᠬᠠᠭᠠᠰᠯᠠᠪᠠ</unicode>
          <transcript>azil --ba</transcript>
          <definition> The work is half done.</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠮ ᠬᠠᠭᠠᠰᠯᠠᠪᠠ</unicode>
          <transcript>zam --ba</transcript>
          <definition> [We] have traveled halfway</definition>
        </example>
      </examples>
