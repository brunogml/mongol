    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠪᠠᠷ</unicode>
      <uighur>qabar</uighur>
      <cyrillic>хамар</cyrillic>
      <transcript>XABAR</transcript>
      <definition>[= xamar] n. and adj. a) Nose, muzzle, snout, trunk of an elephant. b) Anything suggestive of the nose in shape or structure: spur of a mountain between valleys or ravines; cape; angle; partition (as in a room); adjacent.</definition>
      <page>895</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠪᠠᠷ ᠤᠨ ᠪᠠᠭᠠᠨ᠎ᠠ</unicode>
          <transcript>-- un baγan-a</transcript>
          <definition> Nasal septum.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠠᠷ ᠤᠨ ᠡᠪᠡᠳᠴᠢᠨ</unicode>
          <transcript>-- un ebedcin</transcript>
          <definition> Nasal ailments; glanders.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠠᠷ ᠤᠨ ᠨᠦᠺᠡ</unicode>
          <transcript>-- un nyke</transcript>
          <definition> Nostril.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠠᠷ ᠤᠨ ᠦᠵᠦᠭᠦᠷ</unicode>
          <transcript>-- un yzygyr</transcript>
          <definition> Tip of the nose.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠠᠷ ᠥᠨᠴᠦᠭ</unicode>
          <transcript>-- øncyg</transcript>
          <definition> Opposite angles.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠠᠷ ᠬᠠᠰᠢᠶ᠎ᠠ</unicode>
          <transcript>-- xasij-a</transcript>
          <definition> Adjacent courtyard.</definition>
        </example>
        <example>
          <unicode>ᠠᠭᠤᠯᠠ ᠎ᠶᠢᠨ ᠬᠠᠪᠠᠷ</unicode>
          <transcript>aγula jin -- </transcript>
          <definition> Cape, promontory.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠷᠠᠭᠤᠨ ᠬᠠᠪᠠᠷ</unicode>
          <transcript>baraγun -- </transcript>
          <definition> Adjacent court on the western side.</definition>
        </example>
        <example>
          <unicode>ᠭᠤᠲᠤᠯ ᠤᠨ ᠬᠠᠪᠠᠷ</unicode>
          <transcript>γutul un -- </transcript>
          <definition> Toe of a shoe or boot.</definition>
        </example>
      </examples>
    </entry_item>
