    <entry_item>
      <dico>Schmidt</dico>
      <unicode>ᠬᠠᠪᠠᠷ</unicode>
      <uighur>qabar</uighur>
      <definition>die Nase; bei Gebirgen ein Vorgebirge, ein Vorsprung: beim Bogen die Kerben an den Enden zum Befestigen der Senne.</definition>
      <page>128</page>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠬᠠᠪᠠᠷ</unicode>
      <uighur>qabar</uighur>
      <definition>n. The nose. A cape. The promontory of a mountain-range. A projection.</definition>
      <page>508</page>
      <examples>
        <example>
          <uighur>qabar ebedčin</uighur>
          <definition>n(vet.). Glanders, a horse disease</definition>
        </example>
        <example>
          <uighur>qabar-un nöke</uighur>
          <definition>n. The nostrils.</definition>
        </example>
        <example>
          <uighur>qabar-un baγan-a</uighur>
          <definition>n. The partition between the nostrils.</definition>
        </example>
        <example>
          <uighur>qabar-un γubil</uighur>
          <definition>n. The side or wing of the nose.</definition>
        </example>
        <example>
          <uighur>qabar-un samsa</uighur>
          <definition>n. The cartilage or gristle of the nostrils, the nostrils themselves and their inside covering.</definition>
        </example>
        <example>
          <uighur>qabar uqdulaqu</uighur>
          <definition>v.t. To cut off the nose.</definition>
        </example>
      </examples>
    </entry_item>
