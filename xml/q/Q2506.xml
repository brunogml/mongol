    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠮᠰᠣᠬᠣ</unicode>
      <uighur>qamsoqu</uighur>
      <cyrillic>хамсах</cyrillic>
      <transcript>XAMSU-</transcript>
      <definition>[= xamsa- = xamtu-] v. i. To be united, combined, incorporated; to come together; to be together; to work jointly or collectively.</definition>
      <page>924</page>
      <examples>
        <example>
          <unicode>ᠨᠥᠺᠦᠷ ᠎ᠯᠦᠭᠡ ᠬᠠᠮᠰᠣᠬᠣ</unicode>
          <transcript>nøkyr lyge --xu</transcript>
          <definition> To unite with friends, join comrades.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
