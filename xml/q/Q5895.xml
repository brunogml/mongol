    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠭᠣᠯᠵᠢᠢᠬᠣ</unicode>
      <uighur>γulǰiiqu</uighur>
      <cyrillic>гулжийх</cyrillic>
      <transcript>ΓULZII-</transcript>
      <definition>v. i To be bent down at the end (as branches of a tree); to hang one's head; to yield or bend under a heavy load; to feel weak; to lack liveliness; to be thin, delicate, puny; to wither, fade.</definition>
      <page>367</page>
      <examples>
        <example>
          <unicode>ᠭᠣᠯᠵᠢᠢᠭᠰᠠᠨ ᠲᠣᠯᠤᠭᠠᠶᠢᠲᠠᠢ</unicode>
          <transcript>--γsan toluyaitai</transcript>
          <definition> With drooping head ( as horse).</definition>
        </example>
        <example>
          <unicode>ᠠᠴᠢᠶ᠎ᠠ ᠳᠠᠭᠠᠭᠠᠬᠤ ᠦᠭᠡᠢ ᠭᠣᠯᠵᠢᠢᠬᠤ</unicode>
          <transcript>acij-a daγaγaxu ygei --xu</transcript>
          <definition> To bend under an unbearable burden.</definition>
        </example>
      </examples>
    </entry_item>
