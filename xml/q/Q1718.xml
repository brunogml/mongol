    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠲᠣᠨ</unicode>
      <uighur>qadon</uighur>
      <cyrillic>хатан</cyrillic>
      <transcript>XATUN</transcript>
      <definition>[Cf. Sogdian xwt'ynh] n. Lady, queen, princess; wife (hon.).</definition>
      <page>946</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠲᠣᠨ ᠪᠣᠯᠭᠠᠨ ᠠᠪᠬᠤ</unicode>
          <transcript>-- bolγan abxu</transcript>
          <definition> To marry a woman (hon. ).</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠲᠣᠨ ᠭᠣᠤᠯ</unicode>
          <transcript>-- γoul</transcript>
          <definition> 'Queen river', Mongolian name for the Yellow River</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠲᠣᠨ ᠢ ᠰᠠᠺᠢᠭᠴᠢ</unicode>
          <transcript>-- i sakiγci</transcript>
          <definition> Eunuch, overseer in a harem.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠭ᠎ᠠ ᠬᠠᠲᠣᠨ</unicode>
          <transcript>baγ-a -- </transcript>
          <definition> Second wife; concubine.</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠺᠡ ᠬᠠᠲᠣᠨ</unicode>
          <transcript>erke --</transcript>
          <definition> The first or principal wife.</definition>
        </example>
        <example>
          <unicode>ᠶᠡᠺᠡ ᠬᠠᠲᠣᠨ</unicode>
          <transcript>jeke -- </transcript>
          <definition> Empress, chief consort of an emperor or king; first wife (When there is a second wife).</definition>
        </example>
      </examples>
    </entry_item>
