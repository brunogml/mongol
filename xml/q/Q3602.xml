    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠷᠰᠢᠯᠠᠬᠣ</unicode>
      <uighur>qarsilaqu</uighur>
      <cyrillic>харшлах</cyrillic>
      <transcript>XARSILA-</transcript>
      <definition>1 v. i. To be an obstacle or hindrance; to produce a bad effect; to disagree, contradict; to be contrary or against; to antagonize.</definition>
      <page>940</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠷᠰᠢᠯᠠᠨ ᠦᠭᠦᠯᠡᠺᠦ</unicode>
          <transcript>--n ygyleky</transcript>
          <definition> To speak against; to contradict</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠰᠢᠯᠠᠬᠣ ᠰᠢᠯᠲᠠᠭᠠᠨ</unicode>
          <transcript>--xu siltaγan</transcript>
          <definition> Contrary circumstance or cause; contrary evidence</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠢᠳᠪᠦᠷᠢ ᠳ᠋‍‍ᠤ‍ᠷ ᠬᠠᠷᠰᠢᠯᠠᠬᠣ</unicode>
          <transcript>siidbyri dyr --xu</transcript>
          <definition> To obstruct a decision</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠷᠴᠢᠮ ᠳ᠋‍‍ᠤ‍ᠷ ᠬᠠᠷᠰᠢᠯᠠᠬᠣ</unicode>
          <transcript>zarcim dur --xu</transcript>
          <definition> To be against the principle.</definition>
        </example>
      </examples>
    </entry_item>
