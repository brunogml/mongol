    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠳᠠᠭᠠᠯᠠᠭᠣᠯᠬᠣ</unicode>
      <uighur>qadaγalaγulqu</uighur>
      <cyrillic>хадгалуулах</cyrillic>
      <transcript>XADAΓALAΓUL-</transcript>
      <definition>[v. caus. of xadaγala-] To place in safeguard or custody, deposit for safekeeping.</definition>
      <page>902</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠳᠠᠭᠠᠯᠠᠭᠣᠯᠵᠤ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <transcript>--zu talbixu</transcript>
          <definition> To have guarded by, leave under the safekeeping of.</definition>
        </example>
        <example>
          <unicode>ᠠᠯᠪᠠᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠬᠠᠳᠠᠭᠠᠯᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>alban dur --xu</transcript>
          <definition> To put under official charge or control; to confiscate.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠮᠦᠨ ᠢᠶᠡᠷ ᠬᠠᠳᠠᠭᠠᠯᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>kymyn ijer --xu</transcript>
          <definition> To have somebody or something guarded or kept by someone.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠠᠳᠠᠭᠠᠯᠠᠭᠤᠯᠬᠤ</unicode>
      <definition>ordonner de cacher, de conserver: 2 faire faire de garde, faire garder</definition>
      <page>774</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠪᠠᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠬᠠᠳᠠᠭᠠᠯᠠᠭᠤᠯ</unicode>
          <definition>ordonne de garder ensemble avec les trésors de la couronne, ordonne de confisquer</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠰᠠᠷ ᠢ ᠺᠥᠯᠢᠭᠦᠯᠵᠦ ᠳᠥᠷᠪᠡᠨ ᠺᠦᠮᠦᠨ ᠢᠶᠡᠷ ᠬᠠᠳᠠᠭᠠᠯᠠᠭᠤᠯᠪᠠᠢ</unicode>
          <definition>il ordonna de lier Khassar et confia sa qarde à quatre hommes</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠩ ᠢ ᠬᠠᠳᠠᠭᠠᠯᠠᠭᠤᠯᠬᠤ</unicode>
          <definition>ordonner de garder les trésors</definition>
        </example>
      </examples>
    </entry_item>
