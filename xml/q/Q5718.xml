    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠣᠯᠪᠠᠬᠤ ~ ᠬᠣᠯᠪᠤᠬᠤ</unicode>
      <definition>unir, joindre, lier</definition>
      <page>931</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠢᠨ ᠎ᠯᠤᠭ᠎ᠠ ᠬᠣᠯᠪᠤᠬᠤ</unicode>
          <definition>exposer sa vie au danger, se décider à qc., s'enhardir pour qc. au risque de sa vie</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠯᠪᠤᠵᠤ ᠤᠶᠠᠬᠤ</unicode>
          <definition>lier ensemble</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠯᠪᠤᠭᠰᠠᠨ ᠦᠰᠦᠭ</unicode>
          <definition>lettres réunies, syllabe</definition>
