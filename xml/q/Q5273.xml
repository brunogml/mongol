      <dico>Lessing</dico>
      <unicode>ᠭᠣᠳᠣᠰ</unicode>
      <uighur>γudus</uighur>
      <cyrillic>гудас</cyrillic>
      <transcript>ΓUDUS</transcript>
      <definition>adv. Along, lengthwise; on the way; in the middle of; downward.</definition>
      <page>365</page>
      <examples>
        <example>
          <unicode>ᠭᠣᠳᠣᠰ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>-- jabuxu</transcript>
          <definition> To go along (a road).</definition>
        </example>
        <example>
          <unicode>ᠭᠣᠳᠣᠰ ᠺᠢᠺᠦ</unicode>
          <transcript>-- kiky</transcript>
          <definition> To make a sudden downward movement.</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠳᠡ ᠎ᠶᠢᠨ ᠭᠣᠳᠣᠰ</unicode>
          <transcript>egyde jin --</transcript>
          <definition> On the doorway.</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠮ ᠤᠨ ᠭᠣᠳᠣᠰ</unicode>
          <transcript>zam [un] - -</transcript>
          <definition> On the road, all along the road, during the whole journey.</definition>
        </example>
      </examples>
    </entry_item>
