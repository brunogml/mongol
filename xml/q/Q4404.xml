    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠭᠣᠬᠠᠳᠠᠬᠣ</unicode>
      <uighur>γoqadaqu</uighur>
      <cyrillic>гохдох</cyrillic>
      <transcript>ΓOXADA-</transcript>
      <definition>[=γoxala-] v. t. To [catch with a] hook; to hook the opponent's leg with one's own (wrestling).</definition>
      <page>363</page>
      <examples>
        <example>
          <unicode>ᠭᠣᠬ᠎ᠠ ᠪᠡᠷ ᠭᠣᠬᠠᠳᠠᠬᠣ</unicode>
          <transcript>γox-a ber --xu</transcript>
          <definition> To fasten or seize with a hook.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠲᠠᠵᠤ ᠭᠣᠬᠠᠳᠠᠬᠣ</unicode>
          <transcript>tatazu --xu</transcript>
          <definition> To pull, drag with a hook.</definition>
        </example>
        <example>
          <unicode>ᠵᠢᠭᠠᠰᠤᠨ ᠭᠣᠬᠠᠳᠠᠬᠣ</unicode>
          <transcript>ziγasun --xu</transcript>
          <definition> To hook fish.</definition>
        </example>
      </examples>
    </entry_item>
