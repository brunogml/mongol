  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠮᠢᠶᠠᠷᠠᠬᠣ</unicode>
      <uighur>qamiyaraqu</uighur>
      <cyrillic>хамаарах</cyrillic>
      <transcript>XAMIJARA-</transcript>
      <definition>v.t. To concern oneself with; to interfere; to have a relation or connection with; to care; to fulfill a charge, discharge a duty. Cf. xabijara-.</definition>
      <page>924</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠮᠢᠶᠠᠷᠠᠭᠰᠠᠨ ᠡᠯᠴᠢᠨ ᠰᠠᠶᠢᠳ</unicode>
          <transcript>--γsan [elcin] said</transcript>
          <definition> Charge d'affaires.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠮᠢᠶᠠᠷᠠᠭᠰᠠᠨ ᠡᠲᠡᠭᠡᠳ</unicode>
          <transcript>--γsan eteged</transcript>
          <definition> Those concerned or involved.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠮᠢᠶᠠᠷᠠᠨ ᠣᠷᠤᠯᠴᠠᠬᠤ</unicode>
          <transcript>--n orulcaxu</transcript>
          <definition> To step in, interfere, be involved.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠮᠢᠶᠠᠷᠠᠬᠣ ᠣᠷᠤᠨ</unicode>
          <transcript>--xu orun</transcript>
          <definition> Comitative case (gram. ).</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠮᠢᠶᠠᠷᠠᠬᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>--xu ygei</transcript>
          <definition> Not interfering, caring, or minding; [I] do not care.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠠᠮᠢᠶᠠᠷᠠᠬᠤ</unicode>
      <definition>appartenir à qc., se rapporter à, avoir une importance relative:, 2 gérer les affaires provisoirement; être admis à un emploi, tenir la place de qu.</definition>
      <page>806</page>
      <examples>
        <example>
          <unicode>ᠺᠡᠷᠡᠭ ᠬᠠᠮᠢᠶᠠᠷᠠᠬᠤ ᠪᠯᠠᠮ᠎ᠠ ᠎ᠨᠠᠷ</unicode>
          <definition>des lamas qui remplissent des fonctions publiques</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠷᠡᠭ ᠳ᠋‍‍ᠤ‍ᠷ ᠬᠠᠮᠢᠶᠠᠷᠠᠭᠰᠠᠨ ᠲᠦᠰᠢᠮᠡᠯ</unicode>
          <definition>gérant les affaires, qui remplit quelque charge provisoirement</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠬᠠᠮᠢᠶᠠᠷᠠᠬᠣ</unicode>
      <uighur>qamiyaraqu ügei</uighur>
      <definition>Don't mind. Don't care. Does not concern. No matter! To disregard.</definition>
      <page>530</page>
    </entry_item>
  </entries>
</entry>
