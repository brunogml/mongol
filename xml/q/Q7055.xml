    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠣᠷᠣᠮᠬᠠᠨ</unicode>
      <uighur>quromqan</uighur>
      <cyrillic>хурамхан</cyrillic>
      <transcript>XURUMXAN</transcript>
      <definition>[= xorumxan] n. The shortest space of time, moment, instant.</definition>
      <page>991</page>
      <examples>
        <example>
          <unicode>ᠬᠣᠷᠣᠮᠬᠠᠨ᠎ᠠ</unicode>
          <transcript>-- -a </transcript>
          <definition> Instantly, in a flash.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠷᠣᠮᠬᠠᠨ ᠢᠶᠠᠷ</unicode>
          <transcript>-- ijer</transcript>
          <definition> Instantly, in a flash.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠷᠣᠮᠬᠠᠨ ᠲᠡᠳᠦᠢ</unicode>
          <transcript>-- tedyi</transcript>
          <definition> Only a little while.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠷᠣᠮᠬᠠᠨ ᠵᠠᠭᠤᠷ᠎ᠠ</unicode>
          <transcript>-- zaγur-a</transcript>
          <definition> Instant[ly], in a flash.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠣᠷᠣᠮᠬᠠᠨ</unicode>
      <definition>le plus petit espace de temps. un clin d'oeil, moment. instant</definition>
      <page>966</page>
      <examples>
        <example>
          <unicode>ᠡᠨᠡ ᠨᠠᠰᠤᠨ ᠬᠣᠷᠣᠮᠬᠠᠨ ᠲᠡᠳᠦᠢ ᠪᠤᠢ</unicode>
          <definition>notre vie ne dure qu'un moment</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠷᠣᠮᠬᠠᠨ ᠲᠡᠳᠦᠢ</unicode>
          <definition>un clin d'oeil, un petit moment, un instant, dans le moment</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠷᠣᠮᠬᠠᠨ ᠵᠠᠭᠤᠷᠠ</unicode>
          <definition>dans le moment, à l'instant, tout-à-l'heure</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠷᠣᠮᠬᠠᠨ ᠢᠶᠠᠷ ᠺᠦᠷᠺᠦ</unicode>
          <definition>arriver à l'instant</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠷᠣᠮᠬᠠᠨ᠎ᠠ ᠦᠯᠦ ᠬᠠᠭᠠᠴᠠᠬᠤ ᠎ᠶᠢ ᠲᠠᠭᠠᠯᠠᠮᠤ</unicode>
          <definition>je désire de ne pas me séparer (de lui) pour un seul moment</definition>
        </example>
      </examples>
    </entry_item>
