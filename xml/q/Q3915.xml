      <dico>Lessing</dico>
      <unicode>ᠬᠣᠣᠷᠠᠯᠠᠬᠣ</unicode>
      <uighur>qooralaqu</uighur>
      <cyrillic>хорлох</cyrillic>
      <transcript>XOURALA-</transcript>
      <definition>[= xourla-] v.t. To harm, cause evil; to poison, kill, hurt, injure; to play a bad joke on someone.</definition>
      <page>973</page>
      <examples>
        <example>
          <unicode>ᠬᠣᠣᠷᠠᠯᠠᠨ ᠰᠦᠢᠳᠺᠡᠭᠴᠢ</unicode>
          <transcript>--n syidkegci</transcript>
          <definition> Saboteur, wrecker.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠣᠷᠠᠯᠠᠨ ᠰᠦᠢᠳᠺᠡᠺᠦ</unicode>
          <transcript>--n syidkeky</transcript>
          <definition> To harm, wreck, inflict injury.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠣᠷᠠᠯᠠᠬᠣ ᠰᠡᠳᠺᠢᠯ</unicode>
          <transcript>--xu sedkil</transcript>
          <definition> Harmful or evil thoughts.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠣᠷᠠᠯᠠᠬᠣ ᠦᠭᠡ</unicode>
          <transcript>--xu yge</transcript>
          <definition> Harmful words.</definition>
        </example>
        <example>
          <unicode>ᠠᠮᠢ ᠬᠣᠣᠷᠠᠯᠠᠬᠣ</unicode>
          <transcript>ami --xu</transcript>
          <definition> To kill, murder.</definition>
        </example>
