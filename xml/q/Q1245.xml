      <dico>Lessing</dico>
      <unicode>ᠬᠠᠪᠵᠢᠺᠢᠨᠠᠬᠣ</unicode>
      <uighur>qabǰikinaqu</uighur>
      <cyrillic>хавжигнах</cyrillic>
      <transcript>XABZIGINA-</transcript>
      <definition>v.i. To shiver, shake, tremble ; to gnash one's teeth.</definition>
      <page>901</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠪᠵᠢᠺᠢᠨᠠᠨ ᠺᠡᠯᠡᠺᠦ</unicode>
          <transcript>--n keleky</transcript>
          <definition> To speak tremblingly.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠵᠢᠺᠢᠨᠠᠨ ᠬᠠᠪᠲᠤᠭᠤᠨᠠᠨ</unicode>
          <transcript>--n xabtuγunan</transcript>
          <definition> Trembling (as with cold).</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠳᠦ ᠪᠡᠨ ᠬᠠᠪᠵᠢᠺᠢᠨᠠᠬᠣ</unicode>
          <transcript>sidy ben --xu</transcript>
          <definition> For the teeth to chatter.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠬᠠᠪᠵᠢᠺᠢᠨᠠᠬᠣ</unicode>
