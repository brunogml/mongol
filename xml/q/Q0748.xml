      <examples>
        <example>
          <unicode>ᠬᠠᠭᠣᠴᠢᠷᠠᠭᠰᠠᠨ ᠪᠠᠷᠠᠭ᠎ᠠ</unicode>
          <transcript>--γsan baraγ-a</transcript>
          <definition> Shop-worn merchandise, spoiled or deteriorated goods.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠭᠣᠴᠢᠷᠠᠭᠰᠠᠨ ᠰᠠᠷᠠ</unicode>
          <transcript>--γsan sara</transcript>
