      <dico>Lessing</dico>
      <unicode>ᠭᠣᠯᠠᠳᠬᠣ</unicode>
      <uighur>γuladqu</uighur>
      <cyrillic>гулдах</cyrillic>
      <transcript>ΓULAD-</transcript>
      <definition>[= γulid-, γulud-] v.i. To roll or tumble down, fall down a precipice, precipitate.</definition>
      <page>366</page>
      <examples>
        <example>
          <unicode>ᠭᠣᠯᠠᠳᠴᠤ ᠦᠺᠦᠺᠦ</unicode>
          <transcript>--cu ykyky</transcript>
          <definition> To roll into an abyss and die.</definition>
        </example>
        <example>
          <unicode>ᠭᠣᠯᠠᠳᠤᠨ ᠤᠨᠠᠬᠤ</unicode>
          <transcript>--un unaxu</transcript>
          <definition> To fall into an abyss.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
