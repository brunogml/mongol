    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠭᠠᠴᠠᠬᠣ</unicode>
      <uighur>qaγačaqu</uighur>
      <cyrillic>хагацах</cyrillic>
      <transcript>XAΓACA-</transcript>
      <definition>v.i. and t. To separate, to part with; to get rid of; to take leave of; to be separated; to be deprived of; to break away from; to abstain from; to become free from, get rid of.</definition>
      <page>905</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠢ ᠨᠠᠰᠤᠨ ᠬᠠᠭᠠᠴᠠᠬᠣ</unicode>
          <transcript>ami nasun --xu</transcript>
          <definition> To die ,</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠭᠠᠵᠠ ᠡᠴᠡ ᠬᠠᠭᠠᠴᠠᠬᠣ</unicode>
          <transcript>caγaza ece --xu</transcript>
          <definition> To break a law.</definition>
        </example>
        <example>
          <unicode>ᠡᠴᠢᠭᠡ ᠡᠺᠡ ᠡᠴᠡ ᠬᠠᠭᠠᠴᠠᠬᠣ</unicode>
          <transcript>ecige eke ecee xu </transcript>
          <definition>To be separated from one's parents</definition>
        </example>
        <example>
          <unicode>ᠢᠳᠡᠰᠢ ᠡᠴᠡ ᠬᠠᠭᠠᠴᠠᠬᠣ</unicode>
          <transcript>idesi ece --xu</transcript>
          <definition> To abstain from food</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠴᠦᠨ ᠡᠴᠡ ᠬᠠᠭᠠᠴᠠᠭᠰᠠᠨ</unicode>
          <transcript>kycyn ece –γsan </transcript>
          <definition>Deprived of strength, force or power</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠯᠵᠤ ᠬᠠᠭᠠᠴᠠᠬᠣ</unicode>
          <transcript>salzu --xu</transcript>
          <definition> To separate, break up.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠩᠭᠠᠷᠢᠭ ᠡᠴᠡ ᠬᠠᠭᠠᠴᠠᠬᠣ</unicode>
          <transcript>tangγariγ ece --xu</transcript>
          <definition> To break a vow.</definition>
        </example>
        <example>
          <unicode>ᠦᠺᠦᠯ ᠡᠴᠡ ᠬᠠᠭᠠᠴᠠᠬᠣ</unicode>
          <transcript>ykyl ece --xu</transcript>
          <definition> To be liberated from death.</definition>
        </example>
      </examples>
    </entry_item>
