    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠣᠭᠤᠯᠠᠶᠢᠳᠤ</unicode>
      <definition>ayant le gosier, un cou, une voix.</definition>
      <page>884</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠠᠬ ᠬᠣᠭᠤᠯᠠᠶ ᠳᠤ</unicode>
          <definition>nom de Mahêçvara</definition>
        </example>
        <example>
          <unicode>ᠠᠷᠪᠠᠨ ᠬᠣᠭᠤᠯᠠᠶ ᠎ᠳᠤ</unicode>
          <definition>nom du roi des Rakchasas de l'île de Lanka (Ceylon)</definition>
        </example>
        <example>
          <unicode>ᠠᠷᠪᠠᠨ ᠬᠣᠭᠤᠯᠠᠶ ᠎ᠲᠤ ᠎ᠶᠢᠨ ᠳᠠᠶᠢᠰᠤᠨ</unicode>
          <definition>épithète du roi Ramana qui était en guerre avec les Rakchas à l'île de Lanka</definition>
        </example>
        <example>
          <unicode>ᠤᠳᠠᠰᠤᠨ ᠬᠣᠭᠤᠯᠠᠶ ᠎ᠳᠤ</unicode>
          <definition>épithète de Brahmane</definition>
        </example>
        <example>
          <unicode>ᠤᠯᠠᠭᠠᠨ ᠬᠣᠭᠤᠯᠠᠶ ᠎ᠲᠤ</unicode>
          <definition>cou rouge: nom de Rakchas</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠺᠡ ᠬᠣᠭᠤᠯᠠᠶ ᠎ᠲᠤ</unicode>
          <definition>ayant un cou bleu: l'épithète de Mahêçvara (Civa), de paon, etc.</definition>
        </example>
      </examples>
    </entry_item>
  </entries>
</entry>
