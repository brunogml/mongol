      <dico>Lessing</dico>
      <unicode>ᠬᠣᠵᠢᠮᠳᠠᠬᠣ</unicode>
      <uighur>qoǰimdaqu</uighur>
      <cyrillic>хожимдох</cyrillic>
      <transcript>XOZIMDA-</transcript>
      <definition>[= xozida-] v. i. To be or come late, lag behind, be tardy; to be behind others.</definition>
      <page>975</page>
      <examples>
        <example>
          <unicode>ᠠᠵᠢᠯ ᠡᠴᠡ ᠬᠣᠵᠢᠮᠳᠠᠬᠣ</unicode>
          <transcript>azil ece --xu</transcript>
          <definition> To be late for work.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠮᠰᠢᠪᠡᠰᠦ ᠪᠡᠷ ᠬᠣᠵᠢᠮᠳᠠᠬᠣ ᠪᠣᠯᠠᠢ</unicode>
          <transcript>gemsibesy ber --xu bolai</transcript>
          <definition> Repentance will come too late.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
