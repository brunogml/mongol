    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠣᠨᠵᠢᠬᠣ</unicode>
      <uighur>qonǰiqu</uighur>
      <cyrillic>хонжих</cyrillic>
      <transcript>XONZI-</transcript>
      <definition>[= xongzi- = xozi-, 2] v. t. To win a game; to win at gambling; to profit, gain.</definition>
      <page>964</page>
      <examples>
        <example>
          <unicode>ᠬᠣᠨᠵᠢᠬᠣᠢ ᠬᠤᠳᠠᠯᠳᠤᠭ᠎ᠠ</unicode>
          <transcript>--xui xudalduγ-a</transcript>
          <definition> Profitable trade.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠨᠵᠢᠵᠤ ᠰᠢᠩᠭᠡᠭᠦᠯᠺᠦ</unicode>
          <transcript>--zu singgegylky</transcript>
          <definition> To misappropriate.</definition>
        </example>
        <example>
          <unicode>ᠮᠥᠯᠵᠢᠵᠦ ᠬᠣᠨᠵᠢᠬᠣ</unicode>
          <transcript>mølzizy --xu</transcript>
          <definition> To speculate, exploit.</definition>
        </example>
        <example>
          <unicode>ᠦᠭᠡ ᠪᠡᠷ ᠬᠣᠨᠵᠢᠬᠣ</unicode>
          <transcript>yge ber --xu</transcript>
          <definition> To win an argument by a clever remark</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠣᠨᠵᠢᠬᠤ</unicode>
      <definition>faire le commerce de, tirer parti de, obtenir un rabais; usurper, s'approprier mal-à-propos les choses d' un autre, retenir qe. de la paie d'autrui: tromper, frustrer, etc.</definition>
      <page>869</page>
      <examples>
        <example>
          <unicode>ᠬᠣᠨᠵᠢᠬᠤᠢ ᠬᠤᠳᠠᠯᠳᠤᠭᠠᠨ</unicode>
          <definition>commerce lucratif, avantageux</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠨᠵᠢᠵᠤ ᠰᠢᠩᠭᠡᠭᠦᠯᠺᠦ</unicode>
          <definition>commettre des abus</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠨᠵᠢᠭᠰᠠᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠢᠳᠡᠭᠡᠵᠦ ᠭᠡᠷ ᠠᠵᠤ ᠲᠥᠷᠦᠺᠦ</unicode>
