    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠣᠳᠠ</unicode>
      <uighur>quda</uighur>
      <cyrillic>худ</cyrillic>
      <transcript>XUDA</transcript>
      <definition>n. The heads of two families related through marriage of their children; father of one's son-in-law or daughter-in-law (also aterm of address ). Cf. xuduγui.</definition>
      <page>979</page>
      <examples>
        <example>
          <unicode>ᠬᠣᠳᠠ ᠪᠣᠯᠤᠭᠰᠠᠨ ᠥᠺᠢᠨ</unicode>
          <transcript>-- boluγsan pkin</transcript>
          <definition> Engaged girl.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠳᠠ ᠪᠣᠯᠬᠤ</unicode>
          <transcript>-- bolxu</transcript>
          <definition> To be[come] related through marriage.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠳᠠ ᠤᠷᠤᠭ</unicode>
          <transcript>-- uruγ</transcript>
          <definition> Relatives through the marriage of their children.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠳᠠ ᠬᠤᠳᠤᠭᠤᠢ</unicode>
          <transcript>-- xuduγui</transcript>
          <definition> Parents of a married couple in relation to the parents of the other couple.</definition>
        </example>
      </examples>
    </entry_item>
