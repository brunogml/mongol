      <dico>Lessing</dico>
      <unicode>ᠬᠣᠣᠷ᠎ᠠ</unicode>
      <uighur>qoor-a</uighur>
      <cyrillic>хор</cyrillic>
      <transcript>XOUR-A</transcript>
      <definition>n. Harm, evil, malice; embitterment; poison.</definition>
