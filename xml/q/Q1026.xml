      <uighur>qabirγ-a - qabirγan</uighur>
      <cyrillic>хавирга</cyrillic>
      <transcript>XABIRΓ-A(N)</transcript>
      <definition>n. Rib; side, flank, wing; spur of a mountain between two valleys.</definition>
      <page>898</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠪᠢᠷᠭ᠎ᠠ ᠪᠡᠷ ᠤᠨᠠᠬᠤ</unicode>
          <transcript>-- ber unaxu</transcript>
          <definition>To fall on one's side.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠢᠷᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠠᠩᠭᠢ</unicode>
          <transcript>-- jin anggi</transcript>
          <definition>Flank of an army.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠢᠷᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠺᠦᠮᠦᠨ</unicode>
          <transcript>-- jin kymyn</transcript>
          <definition>Flanker (person on the flank in battle, etc.).</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠢᠷᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠬᠠᠳᠬᠤᠯᠭ᠎ᠠ</unicode>
          <transcript>-- jin xadxulγ-a</transcript>
          <definition>Stabbing pain in the side.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠢᠷᠭ᠎ᠠ ᠨᠢᠷᠤᠭᠤ</unicode>
          <transcript>-- niruγu</transcript>
          <definition>Tie beams, girders.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠢᠷᠭᠠᠨ ᠰᠠᠷᠠ</unicode>
          <transcript>--n sara</transcript>
          <definition>Crescent.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠢᠷᠭᠠᠨ ᠵᠠᠪᠰᠠᠷ</unicode>
          <transcript>--n zabsar</transcript>
          <definition>Intercostal part or space.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠪᠢᠷᠭ᠎ᠠ ᠲᠠᠰᠢᠭᠤ ᠰᠠᠯᠺᠢᠨ</unicode>
