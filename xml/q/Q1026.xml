      <dico>Boberg</dico>
      <unicode>ᠬᠠᠪᠢᠷᠭ᠎ᠠ</unicode>
      <uighur>qabirγ-a</uighur>
      <definition>n. The ribs. The side. The slope or side of a mountain.</definition>
      <page>509</page>
      <examples>
        <example>
          <uighur>qabirγ-a-yin anggi</uighur>
          <definition>n. The flanks of an army.</definition>
        </example>
        <example>
          <uighur>qabirγ-a-yin kereg</uighur>
          <definition>A side issue.</definition>
        </example>
        <example>
          <uighur>qabirγ-a niruγu</uighur>
          <definition>n. A cross-beam.</definition>
        </example>
        <example>
          <uighur>qabirγ-a qarsi</uighur>
          <definition>n. Wing (of a building), an out-building.</definition>
        </example>
