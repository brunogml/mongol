  <entries>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠬᠠᠶᠢᠯᠣᠬᠤ ~ ᠬᠠᠶᠢᠯᠠᠬᠤ</unicode>
      <definition>fondre, liquéfier: 2 brûler (les morts).</definition>
      <page>709</page>
      <examples>
        <example>
          <unicode>ᠡᠨᠡ ᠵᠢᠷᠲᠢᠨᠴᠦ ᠬᠤᠵᠢᠷ ᠠᠨᠤ ᠤᠰᠤᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠬᠠᠶᠢᠯᠣᠭᠰᠠᠨ ᠮᠡᠲᠦ ᠦᠭᠡᠢ ᠪᠣᠯᠤᠮᠤᠢ</unicode>
          <definition>ce monde disparaît comme le sel (qui fond) dans l'eau</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠶᠢᠯᠣᠭᠰᠠᠨ ᠠᠯᠲᠠᠨ</unicode>
          <definition>or fondu</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠶᠢᠯᠣᠭᠰᠠᠨ ᠲᠤᠰᠤᠨ</unicode>
          <definition>beurre fondu</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠶᠢᠯᠣᠬᠤᠢ ᠮᠠᠬᠠᠪᠤᠳ</unicode>
          <definition>métaux qui peuvent être fondus, métaux fondus</definition>
        </example>
        <example>
          <unicode>ᠲᠤᠰᠤᠨ ᠺᠢᠵᠦ ᠭᠠᠯ ᠎ᠶᠢᠠᠷ ᠬᠠᠶᠢᠯᠣᠬᠤ</unicode>
          <definition>en ajoutant du beurre brûler dans le feu</definition>
        </example>
        <example>
          <unicode>ᠮᠥᠯᠰᠫᠨ ᠢ ᠬᠠᠶᠢᠯᠣᠬᠤ</unicode>
          <definition>fondre la glace</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠭᠦᠷ ᠬᠠᠶᠢᠯᠣᠬᠤ</unicode>
          <definition>brûler les cadavres</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠭᠦᠷ ᠬᠠᠶᠢᠯᠣᠬᠤᠢ ᠭᠠᠵᠠᠷ</unicode>
          <definition>lieu où l'on brûle les cadavres</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠵᠢᠰ ᠤᠨ ᠮᠣᠳᠤᠨ ᠢᠶᠠᠷ ᠬᠠᠶᠢᠯᠵᠤ ᠲᠠᠺᠢᠪᠠᠢ</unicode>
          <definition>il l'a brûlé sur un bûcher odoriférant</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Schmidt</dico>
      <unicode>ᠬᠠᠶᠢᠯᠣᠬᠣ</unicode>
      <uighur>qayiloqu</uighur>
      <definition>schmelzen, zerschmelzen; verbrennen (eine Leiche)</definition>
      <page>125</page>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠬᠠᠶᠢᠯᠣᠬᠣ</unicode>
      <uighur>qayiluqu</uighur>
      <definition>v.i. To melt. To absorb. To fuse metals.</definition>
      <page>497</page>
    </entry_item>
