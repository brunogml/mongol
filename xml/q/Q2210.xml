    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠬᠠᠯᠲᠣᠷᠢᠬᠣ</unicode>
      <uighur>qaldoriqu</uighur>
      <cyrillic>хальтрах - халтирах</cyrillic>
      <transcript>XALTURI-</transcript>
      <definition>v.i. To glide, slide, slip.</definition>
      <page>921</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠯᠲᠣᠷᠢᠵᠤ ᠤᠨᠠᠬᠤ</unicode>
          <transcript>--zu unaxu</transcript>
          <definition> To slip and fall down.</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠯᠡ ᠬᠠᠯᠲᠣᠷᠢᠬᠣ</unicode>
          <transcript>kele --xu </transcript>
          <definition>To talk in a confused, inarticulate manner; to be confused</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠯ ᠬᠠᠯᠲᠣᠷᠢᠬᠣ</unicode>
          <transcript>køl --xu </transcript>
          <definition>To slip, trip</definition>
        </example>
      </examples>
    </entry_item>
