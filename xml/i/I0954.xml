    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠢᠴᠠᠺᠥᠷᠢ</unicode>
      <uighur>ičegüri</uighur>
      <cyrillic>ичүүр</cyrillic>
      <transcript>ICEGYRI</transcript>
      <definition>[= icigyr, icigyri] n. Shame, disgrace, ignominy; embarrassment.</definition>
      <page>397</page>
      <examples>
        <example>
          <unicode>ᠢᠴᠠᠺᠥᠷᠢ ᠪᠡᠨ ᠠᠯᠳᠠᠬᠤ</unicode>
          <transcript>-- ben aldaxu</transcript>
          <definition> To disgrace oneself</definition>
        </example>
        <example>
          <unicode>ᠢᠴᠠᠺᠥᠷᠢ ᠪᠡᠨ ᠭᠡᠭᠡᠺᠦ</unicode>
          <transcript>-- ben gegeky</transcript>
          <definition> To disgrace oneself.</definition>
        </example>
        <example>
          <unicode>ᠢᠴᠠᠺᠥᠷᠢ ᠡᠴᠡ ᠬᠠᠭᠠᠴᠠᠭᠰᠠᠨ</unicode>
          <transcript>-- ece xaγacaγsan</transcript>
          <definition> Shameless, impudent.</definition>
        </example>
        <example>
          <unicode>ᠢᠴᠠᠺᠥᠷᠢ ᠰᠣᠩᠵᠢᠭᠤᠷᠢ</unicode>
          <transcript>-- songziγuri</transcript>
          <definition> Shame, disgrace.</definition>
        </example>
        <example>
          <unicode>ᠢᠴᠠᠺᠥᠷᠢ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition> Shameless, impudent.</definition>
        </example>
        <example>
          <unicode>ᠢᠴᠠᠺᠥᠷᠢ ᠦᠭᠡᠢ ᠠᠭᠠᠰᠢᠯᠠᠬᠤ</unicode>
          <transcript>-- ygei aγasilaxu</transcript>
          <definition> To act shamefully or impudently,</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠢᠴᠡᠺᠦᠷᠢ ~ ᠢᠴᠢᠭᠦᠷᠢ</unicode>
      <definition>honte, vergogne, rougeur, ignominie : pudeur, chasteté, grande modestie</definition>
      <page>312</page>
      <examples>
        <example>
          <unicode>ᠢᠴᠡᠺᠦᠷᠢ ᠦᠭᠡᠢ</unicode>
          <definition>impudent, dehonté, effronté</definition>
        </example>
        <example>
          <unicode>ᠢᠴᠡᠺᠦᠷᠢ ᠮᠡᠳᠡᠺᠴᠢ</unicode>
          <definition>qui sait rougir, qui a de la pudeur, modeste</definition>
        </example>
        <example>
          <unicode>ᠢᠴᠡᠺᠦᠷᠢ ᠮᠡᠳᠡᠺᠦᠢ ᠎ᠶᠢᠨ ᠬᠤᠪᠴᠠᠰᠤᠨ ᠢᠶᠠᠷ ᠪᠦᠷᠺᠦᠺᠦ</unicode>
          <definition>faire mettre à quelqu'un l'habit de pudeur</definition>
        </example>
        <example>
          <unicode>ᠢᠴᠡᠺᠦᠷᠢ᠎ᠡᠴᠡ ᠬᠠᠭᠠᠴᠠᠬᠰᠠᠨ</unicode>
          <definition>impudent, dehonté, effronté.</definition>
        </example>
        <example>
          <unicode>ᠢᠴᠡᠺᠦᠷᠢ ᠎ᠪᠡᠨᠠᠴᠠ ᠺᠡᠺᠡᠺᠦ</unicode>
          <definition>perdre la honte, devenir déhontê, effronté</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠨᠡᠭ ᠺᠦᠮᠦᠨ ᠰᠣᠷᠬᠤᠢ ᠵᠤᠭᠠᠨ ᠢᠴᠢᠭᠦᠷᠢ ᠺᠡᠮᠡᠮᠦ</unicode>
          <definition>ce n est qu un sot; qui a honte d'apprendre</definition>
        </example>
      </examples>
    </entry_item>
