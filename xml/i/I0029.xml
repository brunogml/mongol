    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠢᠨᠠᠬᠰᠢ</unicode>
      <uighur>inaqsi</uighur>
      <cyrillic>янагш</cyrillic>
      <transcript>INAΓSI</transcript>
      <definition>[=naγasi] adv. Hither, to this place, here (with verbs of motion); since, until now, to date.</definition>
      <page>410</page>
      <examples>
        <example>
          <unicode>ᠢᠨᠠᠬᠰᠢ ᠴᠢᠨᠠᠭᠰᠢ</unicode>
          <transcript>-- cinaγsi</transcript>
          <definition> Back and forth; .to and fro, both ways.</definition>
        </example>
        <example>
          <unicode>ᠢᠨᠠᠬᠰᠢ ᠴᠢᠨᠠᠭᠰᠢ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>-- cinaγsi jabuxu</transcript>
          <definition> To walk to and fro; to have social intercourse.</definition>
        </example>
        <example>
          <unicode>ᠢᠨᠠᠬᠰᠢ ᠢᠷᠡᠺᠦ</unicode>
          <transcript>-- ireky</transcript>
          <definition> To come here.</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠶᠨ ᠡᠴᠡ ᠢᠨᠠᠬᠰᠢ</unicode>
          <transcript>egyn ece --</transcript>
          <definition> Henceforth; henceforward, for the future.</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠲᠡᠨ ᠡᠴᠡ ᠢᠨᠠᠬᠰᠢ</unicode>
          <transcript>erten ece -- </transcript>
          <definition>From ancient times</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠭᠦᠨ ᠡᠴᠡ ᠢᠨᠠᠬᠰᠢ</unicode>
          <transcript>tegyn ece --</transcript>
          <definition> Since then, ever since,</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠢᠨᠠᠬᠰᠢ</unicode>
      <definition>ici, plus près, jusque, jusque là; dès, depuis, d'ici, de là.</definition>
      <page>276</page>
      <examples>
        <example>
          <unicode>ᠡᠭᠦᠨᠴᠡ ᠢᠨᠠᠬᠰᠢ</unicode>
          <definition>depuis ce temps, à l'avenir.</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠳᠡᠨ᠎ᠡᠴᠡ ᠢᠨᠠᠬᠰᠢ</unicode>
          <definition>depuis les temps anciens jusqu'à ce moment, jusqu'à présent.</definition>
        </example>
        <example>
          <unicode>ᠢᠨᠠᠬᠰᠢ ᠢᠷᠡᠺᠦ</unicode>
          <definition>venir ici.</definition>
        </example>
        <example>
          <unicode>ᠢᠨᠠᠬᠰᠢ ᠴᠢᠨᠠᠬᠰᠢ</unicode>
          <definition>et par-ci et par-là; des deux côtés.</definition>
        </example>
        <example>
          <unicode>ᠢᠨᠠᠬᠰᠢ ᠴᠢᠨᠠᠬᠰᠢ ᠶᠠᠪᠤᠬᠤ</unicode>
          <definition>marcher en avant et en arrière; se promener</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠭᠦᠨᠴᠡ ᠢᠨᠠᠬᠰᠢ</unicode>
          <definition>depuis ce temps, depuis cette époque.</definition>
        </example>
      </examples>
    </entry_item>
