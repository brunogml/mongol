    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠢᠷᠥᠺᠠᠺᠥ</unicode>
      <uighur>irükekü</uighur>
      <cyrillic>ерөөх</cyrillic>
      <transcript>IRYGE-</transcript>
      <definition>v, t. and i . To wish well, bless, pray; to felicitate; to propose a toast.</definition>
      <page>415</page>
      <examples>
        <example>
          <unicode>ᠢᠷᠦᠭᠡᠯ ᠢᠷᠥᠺᠠᠺᠥ</unicode>
          <transcript>lrygel --ky </transcript>
          <definition>To give a blessing, offer felicitations</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠮᠦᠨ ᠢ ᠢᠷᠥᠺᠠᠺᠥ</unicode>
          <transcript>kymyn i --ky</transcript>
          <definition> To give somebody a blessing.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠷᠢᠨ ᠢᠷᠥᠺᠠᠺᠥ</unicode>
          <transcript>zorin --ky</transcript>
          <definition> To wish good-luck or success.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
