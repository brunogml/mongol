    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠢᠳᠠᠮᠳᠠᠬᠣ</unicode>
      <uighur>idamdaqu</uighur>
      <cyrillic>ядамдах</cyrillic>
      <transcript>IDAMDA-</transcript>
      <definition>v.t. To make a libation to the idam by flicking a few drops of a beverage (tea, brandy, milk, etc. ) on the ground with the ring finger (see xuruγu).</definition>
      <page>398</page>
      <examples>
        <example>
          <unicode>ᠴᠠᠢ ᠢᠳᠠᠮᠳᠠᠵᠤ ᠰᠠᠴᠤᠬᠤ</unicode>
          <transcript>cai - -zu sacuxu</transcript>
          <definition> To make a libation by flicking a few drops of tea on the ground.</definition>
        </example>
      </examples>
    </entry_item>
