    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠢᠵᠠᠭᠣᠷᠲᠠᠨ</unicode>
      <uighur>iǰaγurdan</uighur>
      <cyrillic>язгууртан</cyrillic>
      <transcript>IZAΓURTAN</transcript>
      <definition>n. and adj. Those who belong to a noble family or clan; aristocrats; illustrious, noble or celebrated (of a plurality of persons).</definition>
      <page>418</page>
      <examples>
        <example>
          <unicode>ᠢᠵᠠᠭᠣᠷᠲᠠᠨ ᠤ ᠺᠦᠪᠡᠭᠦᠨ</unicode>
          <transcript>-- u kybegyn</transcript>
          <definition>Young man of noble birth.</definition>
        </example>
        <example>
          <unicode>ᠳᠡᠭᠡᠳᠦ ᠢᠵᠠᠭᠣᠷᠲᠠᠨ</unicode>
          <transcript>degedy --</transcript>
          <definition>Member[s] of the noblest family or families.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Lessing</dico>
