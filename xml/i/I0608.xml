      <cyrillic>илэрхий</cyrillic>
      <transcript>ILERKEI</transcript>
      <definition>adj. Evident, clear, distinct; open, obvious, conspicuous, public; distinctive, concrete.</definition>
      <page>405</page>
      <examples>
        <example>
          <unicode>ᠢᠯᠠᠷᠺᠠᠢ ᠪᠡᠷ</unicode>
