      <dico>Lessing</dico>
      <unicode>ᠢᠯᠡᠳᠳᠡ</unicode>
      <uighur>iledte</uighur>
      <cyrillic>илтэд</cyrillic>
      <transcript>ILEDTE</transcript>
      <definition>[= ilete] adj. and adv. Open[ly], manifest[ly], evident[ly], obvious[ly], concrete[ly], distinct[ly], clear[ly].</definition>
      <page>404</page>
      <examples>
        <example>
          <unicode>ᠢᠯᠡᠳᠳᠡ ᠪᠣᠯᠭᠠᠬᠤ</unicode>
          <transcript>-- bolγaxu</transcript>
          <definition> To manifest, disclose, make public.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠡᠳᠳᠡ ᠭᠠᠷᠬᠤ</unicode>
          <transcript>-- γarxu</transcript>
          <definition> To appear, originate, become incarnated.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠡᠳᠳᠡ ᠮᠡᠳᠡᠭᠴᠢ = ᠢᠯᠡᠳᠳᠡ ᠦᠵᠡᠭᠴᠢ</unicode>
          <transcript>-- medegct = -- yzegci</transcript>
          <definition> Clairvoyant.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠡᠳᠳᠡ ᠮᠡᠳᠡᠺᠦ</unicode>
          <transcript>-- medeky</transcript>
          <definition> To know precisely or exactly.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠡᠳᠳᠡ ᠲᠣᠳᠤᠷᠬᠠᠢ</unicode>
          <transcript>-- todurxai</transcript>
          <definition> Perfectly clear, manifest or distinct way, manner or degree.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠡᠳᠳᠡ ᠬᠠᠷᠠᠭᠴᠢ</unicode>
          <transcript>-- xaraγci</transcript>
          <definition> Clairvoyant.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
