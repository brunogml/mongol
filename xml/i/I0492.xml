    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠢᠯᠠᠬᠣ</unicode>
      <uighur>ilaqu</uighur>
      <cyrillic>ялах</cyrillic>
      <transcript>ILA-</transcript>
      <definition>v.t. To conquer, defeat, vanquish, win a victory; to overcome, surpass, distinguish, surmount.</definition>
      <page>401</page>
      <examples>
        <example>
          <unicode>ᠢᠯᠠᠵᠤ ᠳᠠᠪᠠᠬᠤ</unicode>
          <transcript>--zu dabaxu</transcript>
          <definition> To conquer, vanquish, defeat, overcome.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠵᠤ ᠳᠡᠶᠢᠯᠡᠺᠦ</unicode>
          <transcript>--zu deileky</transcript>
          <definition> To conquer, vanquish, defeat, overcome.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠢᠯᠳᠤᠭᠠᠨ ᠢᠶᠠᠷ ᠢᠯᠠᠬᠤ</unicode>
          <transcript>bailduγan ijer --xu</transcript>
          <definition> To conquer, defeat, be victorious in battle.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠭᠠᠳ ᠪᠣᠷᠤᠮᠲᠠ ᠎ᠶᠢ ᠢᠯᠠᠵᠤ ᠳᠡᠶᠢᠯᠡᠺᠦ</unicode>
          <transcript>saγad borumta ji --zu deileky</transcript>
          <definition> To overcome obstacles.</definition>
        </example>
      </examples>
    </entry_item>
