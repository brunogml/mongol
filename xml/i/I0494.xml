    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠢᠯᠠᠭᠣᠬᠣ</unicode>
      <uighur>ilaγuqu</uighur>
      <cyrillic>ялгуух</cyrillic>
      <transcript>ILAΓU-</transcript>
      <definition>[=ilaγa-, 1.] v . t. To vanquish, surpass, overcome, win a victory.</definition>
      <page>402</page>
      <examples>
        <example>
          <unicode>ᠢᠯᠠᠭᠣᠭᠴᠢ</unicode>
          <transcript>--γci</transcript>
          <definition>Victor, victorious.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠭᠣᠭᠰᠠᠨ ᠪᠠᠶᠠᠷ</unicode>
          <transcript>--γsan bajar</transcript>
          <definition>Triumph.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠨ ᠡᠴᠡ ᠢᠯᠠᠭᠣᠬᠤ</unicode>
          <transcript>dain ece --xu</transcript>
          <definition>To conquer the enemy, win a battle or war.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠢᠯᠠᠭᠣᠬᠤ</unicode>
      <definition>surmonter, surpasser, remporter la victoire sur l'ennemi, vaincre</definition>
      <page>295</page>
      <examples>
        <example>
          <unicode>ᠡᠷᠳᠡᠨᠢ ᠢᠯᠠᠭᠤᠬᠰᠠᠨ</unicode>
          <definition>qui surpasse toute chose précieuse, majesté ou altesse {titre).</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠭᠤᠨ ᠡᠺᠡ ᠎ᠶᠢᠨ ᠺᠥᠪᠡᠭᠦᠨ</unicode>
          <definition>fils d'une reine ou d'une princesse; ; 2 nom de la planète Saturne.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠭᠤᠨ ᠦᠯᠡᠺᠴᠢ</unicode>
          <definition>nom d'un chef des Ters (infidèles)</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠭᠤᠬᠰᠠᠨ</unicode>
          <definition>celui qui a été victorieux. vainqueur: 2 majesté , altesse (titre); 3 pouvoir suprême; 4 nom de la 31-me année dans le cycle sexagénairef; année de l'arbre et du cheval, 5 l'épithète des bouddhas, des arbats, des rois, de l'arbre bodbi (ficus indica).</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠭᠤᠬᠰᠠᠨ ᠤ ᠡᠺᠡ</unicode>
          <definition>la mère du vainqueur: l'épithète de Dâra-éké</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠭᠤᠬᠰᠠᠨ ᠤ ᠣᠷᠤ</unicode>
          <definition>gouverneur, lieutenant d'une province: 2 Maytreya.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠭᠤᠬᠰᠠᠨ ᠤ ᠤᠬ</unicode>
          <definition>origine du vainqueur: bodhisattva.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠭᠤᠬᠰᠠᠨ ᠦᠷ᠎ᠡ</unicode>
          <definition>fruit des vainqueurs: nom dune fleur kournouda (nyinphaea esculenta).</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠭᠤᠬᠰᠠᠨ ᠤ ᠨᠤᠬᠤᠭ᠎ᠠ</unicode>
          <definition>germe du vainqueur: bodbisattva.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠭᠤᠬᠰᠠᠨ ᠤ ᠴᠢᠮᠡᠭ</unicode>
          <definition>insignes de la victoire; une espèce d'étendard ou d'ornement d'étendard, en forme de cylindre.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠭᠤᠬᠰᠠᠨ ᠤ ᠴᠢᠺᠢᠨ</unicode>
          <definition>oreille du vainqueur: nom de Vardjrapani bodbisattva.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠭᠤᠬᠰᠠᠨ ᠤ ᠺᠡᠯᠡᠨ</unicode>
          <definition>langue du vainqueur: nom d'Avalokiteçvara-bodbisattva.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠭᠤᠬᠰᠠᠨ ᠤ ᠺᠥᠪᠡᠭᠦᠨ</unicode>
          <definition>fils d'un roi, prince; 2 saint, bodhisattva</definition>
        </example>
      </examples>
    </entry_item>
