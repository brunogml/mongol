      <dico>Lessing</dico>
      <unicode>ᠢᠰᠺᠠᠺᠥ</unicode>
      <uighur>iskekü</uighur>
      <cyrillic>эсгэх - исгэх</cyrillic>
      <transcript>ISKE-</transcript>
      <definition>[v. caus. of is-] To allow or cause to ferment, turn sour or curdle; to leaven.</definition>
      <page>416</page>
      <examples>
        <example>
          <unicode>ᠢᠰᠺᠠᠺᠥ ᠡᠺᠡ</unicode>
          <transcript>--ky eke</transcript>
          <definition> Yeast, barm.</definition>
        </example>
        <example>
          <unicode>ᠢᠰᠺᠠᠺᠥ ᠺᠥᠷᠦᠩᠭᠡ</unicode>
          <transcript>--ky køryngge</transcript>
          <definition> Ferment, leaven.</definition>
        </example>
        <example>
          <unicode>ᠭᠤᠯᠢᠷ ᠢᠰᠺᠠᠺᠥ</unicode>
          <transcript>γulir --ky </transcript>
          <definition>To set dough for rising</definition>
        </example>
        <example>
          <unicode>ᠰᠦᠨ ᠢᠰᠺᠠᠺᠥ</unicode>
          <transcript>syn --ky </transcript>
          <definition>To allow the milk to sour</definition>
        </example>
      </examples>
