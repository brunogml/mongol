      <dico>Lessing</dico>
      <unicode>ᠯᠠᠪᠰᠢᠺᠥ</unicode>
      <uighur>lebsikü</uighur>
      <cyrillic>лэвших</cyrillic>
      <transcript>LEBSI-</transcript>
      <definition>v.i. To penetrate or seep through; to ooze, percolate</definition>
      <page>516</page>
      <examples>
        <example>
          <unicode>ᠯᠠᠪᠰᠢᠵᠦ ᠤᠭᠤᠯᠭᠠᠬᠤ</unicode>
          <transcript>--zy uγulγaxu</transcript>
          <definition> To pour a liquid into the mouth (as of a sick person).</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠵᠠ ᠯᠠᠪᠰᠢᠵᠦ ᠭᠣᠭᠤᠵᠢᠬᠤ</unicode>
          <transcript>taza --zy yoyuzixu</transcript>
          <definition> For water to seep through the ceiling.</definition>
        </example>
      </examples>
    </entry_item>
