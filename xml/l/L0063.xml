      <dico>Lessing</dico>
      <unicode>ᠯᠠᠬᠱᠠᠨ</unicode>
      <uighur>laqšan</uighur>
      <cyrillic>лагшин</cyrillic>
      <transcript>LAΓŠAN</transcript>
      <definition>[S. lakshana] n, Mark, sign, characteristic, visible quality, mark of preference; health; body, person ( hon.).</definition>
      <page>515</page>
      <examples>
        <example>
          <unicode>ᠯᠠᠬᠱᠠ ᠪᠡᠯᠭᠡ</unicode>
          <transcript>-- belge</transcript>
          <definition>Mark[s], esp. bodily marks.</definition>
        </example>
        <example>
          <unicode>ᠯᠠᠬᠱᠠ ᠪᠡᠯᠭᠡᠰ ᠎ᠯᠦᠭᠡ ᠲᠡᠭᠦᠯᠳᠡᠷ</unicode>
          <transcript>-- belges lyge tegylder</transcript>
          <definition>Possessing all the signs of perfection or beauty</definition>
        </example>
        <example>
          <unicode>ᠯᠠᠬᠱᠠ ᠴᠢᠮᠡᠭ</unicode>
          <transcript>-- cimeg</transcript>
          <definition>Distinctive ornament, characteristic</definition>
        </example>
        <example>
          <unicode>ᠯᠠᠬᠱᠠ ᠨᠠᠶᠢᠷᠠᠭ</unicode>
          <transcript>-- nairaγ</transcript>
          <definition>Body beautiful; visible marks and proportions of the body</definition>
        </example>
      </examples>
    </entry_item>
