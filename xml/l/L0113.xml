    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠯᠠᠪᠲᠠ</unicode>
      <uighur>labda</uighur>
      <cyrillic>лавт</cyrillic>
      <transcript>LABTA</transcript>
      <definition>adv. Exactly, precisely; effectively; indubitably; sincerely.</definition>
      <page>514</page>
      <examples>
        <example>
          <unicode>ᠯᠠᠪᠲᠠ ᠴᠢ ᠲᠡᠭᠦᠨ ᠎ᠯᠦᠭᠡ ᠤᠴᠢᠷᠠᠬᠤ ᠸᠤᠢ ᠎ᠶ᠎ᠠ</unicode>
          <transcript>-- ci tegyn lyge uciraxu bui z-a</transcript>
          <definition> You will meet with him beyond doubt</definition>
        </example>
        <example>
          <unicode>ᠯᠠᠪᠲᠠ ᠮᠢᠨᠤ ᠺᠥᠪᠡᠭᠦᠨ ᠪᠤᠶᠤ</unicode>
          <transcript>-- minu kybegyn buju</transcript>
          <definition> He is my own son; he is truly my son.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠯᠠᠪᠳᠠ</unicode>
      <definition>exactement, précisément, effectivement , indubitablement. sincèrement.</definition>
      <page>1959</page>
      <examples>
        <example>
          <unicode>ᠯᠠᠪᠳᠠ ᠦᠭᠡᠢ</unicode>
          <definition>inexactement, sans précision, superficiellement, avec doute</definition>
        </example>
        <example>
          <unicode>ᠯᠠᠪᠳᠠ ᠪᠠᠶᠠᠰᠬᠤ</unicode>
          <definition>se réjouir sincèrement</definition>
        </example>
        <example>
          <unicode>ᠯᠠᠪᠳᠠ ᠮᠡᠳᠡᠺᠦ</unicode>
          <definition>savoir exactement</definition>
        </example>
        <example>
          <unicode>ᠯᠠᠪᠳᠠ ᠮᠢᠨᠤ ᠺᠥᠪᠡᠭᠦᠨ ᠪᠤᠶᠤ</unicode>
          <definition>c'est mon vrai fils</definition>
        </example>
        <example>
          <unicode>ᠯᠠᠪᠳᠠ ᠴᠢ ᠲᠡᠭᠦᠨ ᠎ᠯᠦᠭᠡ ᠤᠴᠢᠷᠠᠬᠤ ᠪᠤᠢ ᠎ᠶ᠎ᠠ</unicode>
          <definition>tu le verras, sans doute</definition>
        </example>
      </examples>
