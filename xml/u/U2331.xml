  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠣᠶᠢ᠍ᠳᠬᠠᠷ</unicode>
      <uighur>uyidqar</uighur>
      <cyrillic>уйтгар</cyrillic>
      <transcript>UIDXAR</transcript>
      <definition>[= uidxari] n. Loneliness, despondency, low spirits, melancholy, boredom.</definition>
      <page>866</page>
      <examples>
        <example>
          <unicode>ᠣᠶᠢ᠍ᠳᠬᠠᠷ ᠭᠠᠰᠢᠭᠤᠨ</unicode>
          <transcript>-- γasiγun</transcript>
          <definition> Sadness, melancholy.</definition>
        </example>
        <example>
          <unicode>ᠣᠶᠢ᠍ᠳᠬᠠᠷ ᠢ ᠠᠷᠢᠯᠭᠠᠬᠤ</unicode>
          <transcript>-- i arilγaxu</transcript>
          <definition> To dissipate boredom, melancholy.</definition>
        </example>
        <example>
          <unicode>ᠣᠶᠢ᠍ᠳᠬᠠᠷ ᠢ ᠠᠷᠢᠯᠭᠠᠬᠤ</unicode>
          <transcript>-- i arilγaxu</transcript>
          <definition> To dissipate boredom, melancholy or sadness.</definition>
        </example>
        <example>
          <unicode>ᠣᠶᠢ᠍ᠳᠬᠠᠷ ᠢᠶᠠᠨ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <transcript>-- ijen γarγaxu</transcript>
          <definition> To free oneself from one's worries, amuse oneself.</definition>
        </example>
        <example>
          <unicode>ᠣᠶᠢ᠍ᠳᠬᠠᠷ ᠺᠦᠷᠺᠦ</unicode>
          <transcript>-- kyrky</transcript>
          <definition> To become lonely, sad, or bored.</definition>
        </example>
        <example>
          <unicode>ᠣᠶᠢ᠍ᠳᠬᠠᠷ ᠰᠡᠷᠭᠡᠭᠡᠺᠦ</unicode>
          <transcript>-- sergegeky</transcript>
          <definition> To relieve loneliness or depression, cheer up.</definition>
        </example>
        <example>
          <unicode>ᠣᠶᠢ᠍ᠳᠬᠠᠷ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition> Without worries, happy; happily.</definition>
        </example>
        <example>
          <unicode>ᠣᠶᠢ᠍ᠳᠬᠠᠷ ᠵᠣᠪᠠᠯᠠᠩ</unicode>
          <transcript>-- zobalang</transcript>
          <definition> Worry, anxiety.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠣᠶᠢᠳᠬᠠᠷ</unicode>
      <definition>serrement du coeur, chagrin, affliction, tristesse, douleur</definition>
      <page>331</page>
      <examples>
        <example>
          <unicode>ᠣᠶᠢᠳᠬᠠᠷ ᠢ ᠠᠷᠢᠯᠭᠠᠬᠤ</unicode>
          <definition>chasse l'ennui, le chagrin, la tristessse, consoler, égayer</definition>
        </example>
        <example>
          <unicode>ᠣᠶᠢᠳᠬᠠᠷ ᠦᠭᠡᠢ</unicode>
          <definition>calme, quiétude; qui n'a pas de chagrin: 2 épithète des saints, des bien-heureux</definition>
        </example>
        <example>
          <unicode>ᠣᠶᠢᠳᠬᠠᠷ ᠦᠭᠡᠢ ᠎ᠶᠢᠨ ᠢᠳᠡᠺᠡᠯ</unicode>
          <definition>l'espoir du salut; l'épithète de Hormousda</definition>
        </example>
        <example>
          <unicode>ᠣᠶᠢᠳᠬᠠᠷ ᠰᠡᠷᠺᠡᠯᠺᠡ</unicode>
          <definition>égayement, consolation, encouragement.</definition>
        </example>
        <example>
          <unicode>ᠣᠶᠢᠳᠬᠠᠷ ᠰᠡᠷᠺᠡᠷ᠎ᠡ ᠶᠠᠪᠤᠬᠤ</unicode>
          <definition>aller se désennuyer, s'égayer, se distraire</definition>
        </example>
        <example>
          <unicode>ᠣᠶᠢᠳᠬᠠᠷ ᠰᠡᠷᠺᠡᠺᠡᠺᠦ</unicode>
          <definition>chasser le chagrin, distraire, consoler</definition>
        </example>
      </examples>
    </entry_item>
