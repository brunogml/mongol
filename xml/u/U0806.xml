      <page>603</page>
      <examples>
        <example>
          <unicode>ᠣᠭᠣᠷᠬᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>--xu ygei</transcript>
          <definition> Without neglecting</definition>
