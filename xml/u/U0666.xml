      <dico>Lessing</dico>
      <unicode>ᠣᠭᠣᠬᠣ</unicode>
      <uighur>uγoqu</uighur>
      <cyrillic>уух</cyrillic>
      <transcript>UΓU-</transcript>
      <definition>[= uu-, aγu-, 2, uuγu-] v.t. To drink; to eat liquid food; to absorb liquids; to smoke tobacco</definition>
      <page>864</page>
      <examples>
        <example>
          <unicode>ᠣᠭᠣᠬᠣ ᠤᠰᠤ</unicode>
          <transcript>--xu usu</transcript>
          <definition> Drinking water.</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠺᠡ ᠣᠭᠣᠳᠠᠭ ᠴᠠᠭᠠᠰᠤ</unicode>
          <transcript>beke --daγ caγasu</transcript>
          <definition> Blotting paper</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠢ ᠣᠭᠣᠬᠣ</unicode>
          <transcript>cai --xu</transcript>
          <definition> To drink tea.</definition>
        </example>
        <example>
          <unicode>ᠡᠮ ᠣᠭᠣᠬᠣ</unicode>
          <transcript>em --xu</transcript>
          <definition> To take medicine.</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠯᠦ ᠣᠭᠣᠬᠣ</unicode>
          <transcript>sily --xu, </transcript>
          <definition>To eat soup</definition>
        </example>
      </examples>
    </entry_item>
