    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠣᠳᠬᠣ</unicode>
      <uighur>odqu</uighur>
      <cyrillic>одох</cyrillic>
      <transcript>OD-</transcript>
      <definition>a) v.i. To go to, proceed to. b) aux. v. indicating the direction "away from a given point" if preceded by other verbs of motion. c) aux. v. indicating the completion of action expressed by the preceding verb</definition>
      <page>600</page>
      <examples>
        <example>
          <unicode>ᠣᠳᠤᠷᠤᠨ ᠬᠣᠶᠢᠨᠠ</unicode>
          <transcript>--urun xoina</transcript>
          <definition> After having gone (precl. ).</definition>
        </example>
        <example>
          <unicode>ᠴᠢ ᠬᠠᠮᠢᠭ᠎ᠠ ᠣᠳᠤᠮᠤᠢ</unicode>
          <transcript>ci xamiγ-a --umui?</transcript>
          <definition> Where are you going?.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠭᠠᠵᠤ ᠣᠳᠬᠤ</unicode>
          <transcript>daγazu --xu</transcript>
          <definition> To follow.</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠳᠴᠦ ᠣᠳᠬᠤ</unicode>
          <transcript>niscy –xu </transcript>
          <definition>To fly away</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠯ ᠰᠥᠨᠦᠵᠦ ᠣᠳᠪᠠᠢ</unicode>
          <transcript>γal sønyzy --bai </transcript>
          <definition>The fire is extinguished</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
