    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠣᠷᠺᠢᠯᠠᠭᠣᠯᠬᠣ</unicode>
      <uighur>orkilaγulqu</uighur>
      <cyrillic>оргилуулах</cyrillic>
      <transcript>ORGILAΓUL-</transcript>
      <definition>[v. caus. of origil-] To make boil, etc. ; to arouse ( as enthusiasm).</definition>
      <page>618</page>
      <examples>
        <example>
          <unicode>ᠪᠢᠯᠢᠭ ᠣᠶᠤᠨ ᠢ ᠣᠷᠺᠢᠯᠠᠭᠣᠯᠤᠨ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <transcript>bilig ojun i --un γarγaxu</transcript>
          <definition> To display one's knowledge or talents.</definition>
        </example>
        <example>
          <unicode>ᠡᠺᠡ ᠣᠷᠤᠨᠴᠢ ᠦᠵᠡᠯ ᠢ ᠣᠷᠺᠢᠯᠠᠭᠣᠯᠬᠤ</unicode>
          <transcript>eke orunci yzel i --xu</transcript>
          <definition> To arouse patriotism.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠨᠠᠭᠠᠴᠢᠯᠠᠭ᠎ᠠ ᠎ᠶᠢ ᠣᠷᠺᠢᠯᠠᠭᠣᠯᠬᠤ</unicode>
          <transcript>sanaγacilaγ-a ji --xu</transcript>
          <definition> To stimulate an idea or ideas, provoke thoughts.</definition>
        </example>
      </examples>
    </entry_item>
