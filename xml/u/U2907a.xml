      <dico>Lessing</dico>
      <unicode>ᠣᠷᠣᠶᠢᠲᠠᠬᠣ</unicode>
      <uighur>oruyidaqu</uighur>
      <cyrillic>оройтох</cyrillic>
      <transcript>ORUITA-</transcript>
      <definition>[= oruitu-] v. i. To be (too) late, be delayed, be behind schedule</definition>
      <page>621</page>
      <examples>
        <example>
          <unicode>ᠴᠠᠭ ᠣᠷᠣᠶᠢᠲᠠᠵᠤ ᠪᠠᠶᠢᠨ᠎ᠠ</unicode>
          <transcript>caγ --zu bain-a </transcript>
          <definition>It is getting late</definition>
        </example>
        <example>
          <unicode>ᠣᠳᠤ ᠶᠠᠪᠤᠬᠤ ᠦᠭᠡᠢ ᠪᠣᠯᠪᠠᠰᠤ ᠣᠷᠣᠶᠢᠲᠠᠮᠤᠢ</unicode>
          <transcript>odu jabuxu ygei bolbasu --mui</transcript>
          <definition> If [I, etc.] do not go now, [I, etc.] will be late</definition>
        </example>
      </examples>
