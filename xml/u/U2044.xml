    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠣᠮᠲᠠᠷᠠᠬᠣ</unicode>
      <uighur>umdaraqu</uighur>
      <cyrillic>унтрах</cyrillic>
      <transcript>UMTARA-</transcript>
      <definition>[= untara-] v. i. To be extinguished, go out (of fire or light); to stall ( of an engine); to stop, come to a standstill; to become numb. [A.G.] To sleep.</definition>
      <page>875</page>
      <examples>
        <example>
          <unicode>ᠠᠵᠢ ᠯᠣᠮᠲᠠᠷᠠᠪᠠ</unicode>
          <transcript>azil --ba</transcript>
          <definition> Work has come to a standstill.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠯ ᠣᠮᠲᠠᠷᠠᠪᠠ</unicode>
          <transcript>γal --ba</transcript>
          <definition> The fire has gone out.</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠯ ᠣᠮᠲᠠᠷᠠᠪᠠ</unicode>
          <transcript>køl --ba</transcript>
          <definition> Communication or traffic has ceased.</definition>
        </example>
      </examples>
    </entry_item>
