    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠣᠷᠣᠳᠣᠰᠤ ~ ᠣᠷᠣᠳᠣᠰᠤᠨ</unicode>
      <uighur>orodosu - orodosun</uighur>
      <cyrillic>ордос</cyrillic>
      <transcript>ORUDUSU(N)</transcript>
      <definition>n. Illness, suffering; pain. [Mo.] Evil spirit Which enters the human body causing illness.</definition>
      <page>621</page>
      <examples>
        <example>
          <unicode>ᠣᠷᠣᠳᠣᠰᠤ ᠨᠠᠮᠬᠠᠷᠠᠪᠠ</unicode>
          <transcript>-- namxaraba</transcript>
          <definition> The pain has lessened</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠣᠷᠣᠳᠣᠰᠣᠨ</unicode>
      <definition>mal, malaise, maladie; accès d'une maladie, paroxysme: 2 souffrance, douleur,</definition>
      <page>456</page>
      <examples>
        <example>
          <unicode>ᠣᠷᠣᠳᠣᠰᠣᠨ ᠨᠠᠮᠠᠬᠷᠠᠬᠤ</unicode>
          <definition>cessation de souffrance, diminution d'une douleur</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠣᠳᠣᠰᠣᠨ᠎ᠠᠴᠠ ᠬᠠᠭᠠᠴᠠᠬᠰᠠᠨ</unicode>
          <definition>bien-portant , celui qui a recouvré la santé, qui ne souffre plus.</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠣᠳᠣᠰᠣᠨ ᠳᠠᠰᠣᠯᠠᠬᠤ</unicode>
          <definition>faire cesser la maladie ou la souffrance</definition>
        </example>
      </examples>
    </entry_item>
