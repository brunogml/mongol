        </example>
        <example>
          <unicode>ᠣᠷᠢᠳᠤ ᠵᠢᠯ</unicode>
          <definition>l'année passée, l'année précédente.</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠢᠳᠤ ᠵᠦᠭ</unicode>
          <definition>coté du devant. sud</definition>
