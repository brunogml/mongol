    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠣᠷᠢᠳᠣ</unicode>
      <uighur>uridu</uighur>
      <cyrillic>урд</cyrillic>
      <transcript>URIDU</transcript>
      <definition>[cf. urid, urida] adj. Former, past, preceding, old; southern; front.</definition>
      <page>883</page>
      <examples>
        <example>
          <unicode>ᠣᠷᠢᠳᠣ ᠪᠡᠶ᠎ᠡ</unicode>
          <transcript>-- bej-e</transcript>
          <definition> Front of the body.</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠢᠳᠣ ᠴᠠᠭ ᠎ᠲᠤ</unicode>
          <transcript>-- caγ tu</transcript>
          <definition> Once upon a time, in former times.</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠢᠳᠣ ᠴᠠᠭ ᠤᠨ</unicode>
          <transcript>-- caγ un</transcript>
          <definition> Old (of time), ancient.</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠢᠳᠣ ᠡᠴᠡ</unicode>
          <transcript>-- ece</transcript>
          <definition> In advance, from the front of.</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠢᠳᠣ ᠡᠴᠡ ᠡᠰᠡᠷᠭᠦᠴᠡᠺᠦ</unicode>
          <transcript>-- ece esergyceky</transcript>
          <definition> To repulse, resist.</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠢᠳᠣ ᠡᠳᠦᠷ</unicode>
          <transcript>-- edyr</transcript>
          <definition> The past day, the day before yesterday; the day before, on the eve of.</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠢᠳᠣ ᠎ᠶᠢᠨ ᠺᠦᠮᠦᠨ</unicode>
          <transcript>-- jin kymyn</transcript>
          <definition> Old-timer (lit.: </definition>
        </example>
        <example>
          <unicode>ᠣᠷᠢᠳᠣ ᠎ᠶᠢᠨ ᠣᠷᠢᠳᠣ ᠰᠠᠷ᠎ᠠ</unicode>
          <transcript>-- jin -- sar-a</transcript>
          <definition> The month before last.</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠢᠳᠣ ᠺᠢ</unicode>
          <transcript>-- ki</transcript>
          <definition> See uridaki</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠢᠳᠣ ᠲᠠᠯ᠎ᠠ</unicode>
          <transcript>-- tal-a</transcript>
          <definition> Southern region or side.</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠢᠳᠣ ᠲᠥᠷᠦᠭᠰᠡᠨ</unicode>
          <transcript>-- tørygsen</transcript>
          <definition> Earlier-born, older, elder.</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠢᠳᠣ ᠵᠢᠯ</unicode>
          <transcript>-- zil</transcript>
          <definition> Last year</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠢᠳᠣ ᠵᠦᠭ</unicode>
          <transcript>-- zyg</transcript>
          <definition> South, southern side or region, front side</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠣᠷᠢᠳᠤ</unicode>
      <definition>précédent, antérieur, passé, ancien.</definition>
