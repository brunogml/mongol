    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠣᠳᠣᠬᠣ</unicode>
      <uighur>uduqu</uighur>
      <cyrillic>утах</cyrillic>
      <transcript>UTU-</transcript>
      <definition>v.t. To smoke, fumigate, cure with smoke; to smoke out; to force animals into the open with smoke; to cense.</definition>
      <page>888</page>
      <examples>
        <example>
          <unicode>ᠣᠳᠣᠭᠰᠠᠨ ᠮᠢᠬ᠎ᠠ</unicode>
          <transcript>--γsan mix-a</transcript>
          <definition> Smoked meat.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠷᠪᠠᠭ᠎ᠠ ᠣᠳᠣᠬᠣ</unicode>
          <transcript>tarbaγ-a --xu</transcript>
          <definition> To smoke out tarbayans.</definition>
        </example>
        <example>
          <unicode>ᠤᠲᠤᠯᠭ᠎ᠠ ᠪᠡᠷ ᠣᠳᠣᠬᠣ</unicode>
          <transcript>utulγ-a ber --xu</transcript>
          <definition> To fumigate with incense (for treatment or ritualistic purification)</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
