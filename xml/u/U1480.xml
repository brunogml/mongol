    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠣᠳᠬᠠᠳᠠᠢ</unicode>
      <uighur>udqadai</uighur>
      <cyrillic>утгатай</cyrillic>
      <transcript>UDXATAI</transcript>
      <definition>[= udxatu] adj. Having sense or meaning; significant.</definition>
      <page>863</page>
      <examples>
        <example>
          <unicode>ᠣᠳᠬᠠᠳᠠᠢ ᠦᠭᠡ</unicode>
          <transcript>-- yge</transcript>
          <definition>Meaningful word; word[s] with a hidden meaning.</definition>
        </example>
        <example>
          <unicode>ᠡᠨᠡ ᠶᠠᠮᠪᠠᠷ ᠣᠳᠬᠠᠳᠠᠢ ᠦᠭᠡ ᠪᠤᠢ</unicode>
          <transcript>ene jambar -- yge bui?</transcript>
          <definition>What is the meaning of this word?.</definition>
        </example>
        <example>
          <unicode>... ᠺᠡᠮᠡᠭᠰᠡᠨ ᠣᠳᠬᠠᠳᠠᠢ</unicode>
          <transcript>.. kemegsen -- .</transcript>
          <definition>It has (such and such) meaning.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠣᠳᠬᠠᠲᠤ ~ ᠤᠳᠬᠠᠲᠠᠢ</unicode>
      <definition>signifiant, qui a du sens, conforme au sens, sensé; ayant une cause ou un fondement; réel.</definition>
      <page>390</page>
      <examples>
        <example>
          <unicode>ᠺᠡᠺᠡᠨ ᠤᠳᠬᠠᠲᠠᠢ</unicode>
          <definition>qui a une intelligence claire.</definition>
        </example>
      </examples>
    </entry_item>
