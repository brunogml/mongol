      <unicode>ᠣᠶᠢᠷᠠᠲᠠᠬᠣ</unicode>
      <uighur>oyiradaqu</uighur>
      <definition>v.i. To draw near, to approach, to get close to.</definition>
      <page>167</page>
      <examples>
        <example>
          <uighur>oyiradaqu ügei</uighur>
          <definition>v.i. Unable to get close to.</definition>
        </example>
