    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠣᠴᠢᠷᠠᠬᠣ</unicode>
      <uighur>učiraqu</uighur>
      <cyrillic>учрах</cyrillic>
      <transcript>UCIRA-</transcript>
      <definition>[= ucara-] v.t. and i. To meet, come across; to be confronted; to happen to be; to meet during the cycle of transmigration (Buddh. ).</definition>
      <page>859</page>
      <examples>
        <example>
          <unicode>ᠣᠴᠢᠷᠠᠭᠰᠠᠨ ᠵᠠᠶᠠᠭ᠎ᠠ</unicode>
          <transcript>---γsan zajay-a</transcript>
          <definition> Destiny, fate.</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠭᠤᠷ ᠣᠴᠢᠷᠠᠬᠣ</unicode>
          <transcript>niγur --xu</transcript>
          <definition> To meet personally.</definition>
        </example>
        <example>
          <unicode>ᠦᠺᠦᠯ ᠎ᠯᠦᠭᠡ ᠣᠴᠢᠷᠠᠬᠣ</unicode>
          <transcript>ykyl lyge --xu</transcript>
          <definition> To meet with death.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠪᠠᠯᠠᠩ ᠳ᠋‍‍ᠤ‍ᠷ ᠣᠴᠢᠷᠠᠬᠣ</unicode>
          <transcript>zobalang dur --xu</transcript>
          <definition> To be subject or exposed to suffering.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠣᠴᠢᠷᠠᠬᠤ ~ ᠣᠴᠠᠷᠠᠬᠤ</unicode>
      <definition>rencontrer qn., 2 arriver.</definition>
      <page>418</page>
      <examples>
        <example>
          <unicode>ᠦᠺᠦᠯ ᠎ᠯᠦᠭᠡ ᠦᠯᠦ ᠣᠴᠢᠷᠠᠶᠤ</unicode>
          <definition>il ne rencontrera pas la mort, c.à.d. il ne mourra pas.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠪᠢᠯᠵᠤ ᠪᠣᠯᠬᠤᠢ ᠵᠠᠮᠪᠠᠷ ᠠᠮᠢᠲᠠᠨ ᠣᠴᠢᠷᠠᠮᠣᠢ</unicode>
          <definition>dans quel être je serai maintenant metamorphosé?</definition>
        </example>
        <example>
          <unicode>ᠬᠤᠳᠠᠯᠳᠣᠴᠢᠨ ᠵᠠᠮ ᠳ᠋‍‍ᠤ‍ᠷ ᠣᠴᠢᠷᠠᠬᠤ</unicode>
          <definition>rencontrer des marchands sur la route.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
