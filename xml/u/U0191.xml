      <dico>Lessing</dico>
      <unicode>ᠣᠨᠣᠬᠣ</unicode>
      <uighur>unoqu</uighur>
      <cyrillic>унах</cyrillic>
      <transcript>UNU-</transcript>
      <definition>v.t. To sit or ride astride; to mount ( as a horse)</definition>
      <page>877</page>
      <examples>
        <example>
          <unicode>ᠣᠨᠣᠬᠣ ᠮᠣᠷᠢ</unicode>
          <transcript>--xu mori</transcript>
          <definition> Saddle horse.</definition>
        </example>
        <example>
          <unicode>ᠳᠤᠭᠤᠢ ᠣᠨᠣᠬᠣ</unicode>
          <transcript>duγui --xu</transcript>
          <definition> To ride a bicycle.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠷᠡᠮ ᠣᠨᠣᠬᠣ</unicode>
          <transcript>kerem --xu</transcript>
          <definition> To sit astride a wall.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠵᠦᠭᠦᠨ ᠳᠡᠭᠡᠷ᠎ᠡ ᠣᠨᠣᠬᠣ</unicode>
          <transcript>kyzygyn deger-e --xu</transcript>
          <definition> To ride on someone's neck (actually or fig.); to take advantage</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠰᠢᠨ ᠣᠨᠣᠬᠣ</unicode>
          <transcript>masin --xu</transcript>
          <definition> To ride in an automobile (neol. ).</definition>
        </example>
        <example>
          <unicode>ᠮᠣᠷᠢ ᠣᠨᠣᠬᠣ</unicode>
          <transcript>mori --xu</transcript>
          <definition> To ride on horseback.</definition>
        </example>
