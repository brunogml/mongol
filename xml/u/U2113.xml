    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠣᠴᠢᠷᠠᠭᠣᠯᠬᠣ</unicode>
      <uighur>učiraγulqu</uighur>
      <cyrillic>учруулах</cyrillic>
      <transcript>UCIRAΓUL-</transcript>
      <definition>[v. caus. of ucira-] To cause to meet, bring together; to arrange an interview; to subject to, expose to; to cause, bring about.</definition>
      <page>859</page>
      <examples>
        <example>
          <unicode>ᠣᠴᠢᠷᠠᠭᠣᠯᠤᠭᠰᠠᠨ ᠬᠣᠺᠢᠷᠠᠯ ᠰᠦᠢᠳᠺᠡᠯ ᠢ ᠨᠥᠺᠦᠨ ᠲᠡᠯᠦᠭᠦᠯᠺᠦ</unicode>
          <transcript>--uγsan xokiral syidkel i nøkyn telygylky</transcript>
          <definition> To ask compensation for loss sustained.</definition>
        </example>
        <example>
          <unicode>ᠠᠶᠤᠯ ᠣᠴᠢᠷᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>ajul --xu</transcript>
          <definition> To endanger, jeopardize.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠭᠠᠳ ᠲᠣᠳᠬᠠᠷ ᠣᠴᠢᠷᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>saγad todxar --xu</transcript>
          <definition> To hinder, handicap.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠺᠢᠷᠠᠯ ᠰᠦᠢᠳᠺᠡᠯ ᠢ ᠣᠴᠢᠷᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>xokiral syidkeli --xu</transcript>
          <definition> To cause damage, harm or injury.</definition>
        </example>
      </examples>
    </entry_item>
