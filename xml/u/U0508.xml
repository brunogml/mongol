    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠣᠩᠬᠣᠶᠢᠬᠣ</unicode>
      <uighur>ongqoyiqu</uighur>
      <cyrillic>онхойх</cyrillic>
      <transcript>ONGXUI-</transcript>
      <definition>v. i. To live in solitude, be alone; to be inactive, idle.</definition>
      <page>614</page>
      <examples>
        <example>
          <unicode>ᠣᠩᠬᠣᠶᠢᠨ ᠰᠠᠭᠤᠬᠤ</unicode>
          <transcript>--n saγuxu</transcript>
          <definition> To live in solitude; to be inert, inactive; to be sorrowful.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠣᠩᠬᠤᠶᠢᠨ</unicode>
      <definition>isolé, séparé, qe: reste en retraite, qui est assis tranquillement, seul, tout seul</definition>
      <page>351</page>
      <examples>
        <example>
          <unicode>ᠣᠩᠬᠤᠶᠢᠨ ᠰᠠᠭᠤᠬᠤ</unicode>
          <definition>rester seul, desoeuvre; se chagrine</definition>
        </example>
        <example>
          <unicode>ᠣᠩᠬᠤᠶᠢᠨ ᠵᠣᠬᠰᠤᠪᠠ</unicode>
          <definition>il s'arreta seul; séparé des autres.</definition>
        </example>
      </examples>
    </entry_item>
