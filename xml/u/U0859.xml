      <dico>Boberg</dico>
      <unicode>ᠣᠬᠲᠠᠷᠭᠣᠢ</unicode>
      <uighur>oqtarγui</uighur>
      <definition>(o)n. The sky, the firmament. Heavens.</definition>
      <page>191</page>
      <examples>
        <example>
          <uighur>oqtarγui-yin sorgil</uighur>
          <definition>(o) The zenith.</definition>
        </example>
        <example>
          <uighur>oqtarγui-yin uyutal</uighur>
          <definition>The Milky Way or Galaxy.</definition>
        </example>
        <example>
          <uighur>oqtarγui-yin qurmai</uighur>
          <definition>The apparent junction of earth and sky. The horizon.</definition>
        </example>
        <example>
          <uighur>oqtarγui-yin daγu</uighur>
          <definition>n. Thunder, thunderstorm.</definition>
        </example>
        <example>
          <uighur>oqtarγui-yin döb</uighur>
          <definition>n. The centre of the firmament.</definition>
        </example>
      </examples>
