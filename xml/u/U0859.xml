    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠣᠬᠲᠠᠷᠭᠣᠢ</unicode>
      <transcript>OΓTARΓUI </transcript>
      <definition>T. bar snang; S. antariksha. Space, spatial ether, heaven, the space where the evoked deity appears. .</definition>
      <page>1179</page>
      <examples>
        <example>
          <unicode>ᠣᠭᠲᠠᠷᠭᠤᠢ ᠪᠡᠷ ᠶᠠᠪᠤᠭᠴᠢ</unicode>
          <transcript>+++ -- ber jabuγci; </transcript>
          <definition>T. mkhah hgro; S.daka. The male counterpart of a dagini. </definition>
        </example>
        <example>
          <unicode>ᠣᠭᠲᠠᠷᠭᠤᠢ ᠎ᠶᠢᠨ ᠣᠷᠤᠨ</unicode>
          <transcript>++ -- jin orun;</transcript>
          <definition> T. nam khahi khams; S. akipa-dhātū . Spatial ether (not included in the four elements).</definition>
        </example>
        <example>
          <unicode>ᠡᠮᠦᠨᠡᠺᠢ ᠣᠭᠲᠠᠷᠭᠤᠢ</unicode>
          <transcript>+ +++ emyneki --; </transcript>
          <definition>T. mdun gyi nam mkhah; s. antariksha. The part of the sky in front of the bytygelcin where he expects the evoked deities to appear</definition>
        </example>
      </examples>
    </entry_item>
