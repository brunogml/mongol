    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠣᠪᠣᠷᠢᠬᠣ</unicode>
      <uighur>čuburiqu</uighur>
      <cyrillic>цуврих</cyrillic>
      <transcript>CUBURI-</transcript>
      <definition>[= cubura-] v.i To move one after another; to drip.</definition>
      <page>204</page>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠴᠣᠪᠤᠷᠢᠬᠤ</unicode>
      <definition>1 couler sans cesse (eau, larmes, sang): &#13;
2 suivre l'un après l'autre dans un ordre non interrompu, aller l'un après l'autre: &#13;
3 tirer, traîner l'un après l'autre.</definition>
      <page>2202</page>
      <examples>
        <example>
          <unicode>ᠤᠰᠤᠨ ᠴᠤᠪᠤᠷᠢᠬᠤ</unicode>
          <definition>le découlement d'eau, goutte à goutte</definition>
        </example>
        <example>
          <unicode>ᠦᠭᠡᠷᠢ ᠴᠤᠪᠤᠷᠢᠬᠤ</unicode>
          <definition>le découlement du pus d'un ulcère</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠯᠪᠤᠰᠤᠨ ᠴᠤᠪᠤᠷᠢᠬᠤ</unicode>
          <definition>le larmoiement</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠷᠢ ᠺᠦᠭᠡᠨ ᠡᠴᠡ ᠰᠦᠨ ᠴᠤᠪᠤᠷᠢᠮᠤᠢ</unicode>
          <definition>le lait découle des mamelles</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠰᠤᠨ ᠠᠮᠠᠨ ᠡᠴᠡ ᠴᠤᠪᠤᠷᠢᠮᠤᠢ</unicode>
          <definition>le sang coule de la bouche</definition>
        </example>
        <example>
          <unicode>ᠴᠤᠪᠤᠳ ᠴᠤᠪᠤᠷᠢᠬᠤ</unicode>
          <definition>couler sans cesse</definition>
        </example>
        <example>
          <unicode>ᠴᠤᠪᠤᠷᠢᠬᠤᠢ ᠰᠢᠭᠡᠰᠦᠨ</unicode>
          <definition>urine qui découle</definition>
        </example>
        <example>
          <unicode>ᠴᠤᠪᠤᠷᠢᠭᠴᠢ ᠪᠡᠯᠭᠡ</unicode>
          <definition>partie génitale</definition>
        </example>
        <example>
          <unicode>ᠴᠤᠪᠤᠷᠢᠭᠴᠢ ᠮᠣᠳᠤᠨ</unicode>
          <definition>nom de l'arbre dalbergia oujeinensis, Roxb., tinis (vulg.)</definition>
        </example>
      </examples>
