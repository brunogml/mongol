    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠥᠯᠪᠠᠺᠥ</unicode>
      <uighur>čölbekü</uighur>
      <cyrillic>цөлбөх</cyrillic>
      <transcript>CØLBE-</transcript>
      <definition>[= cøble-, cølme-] v.t. To pick up here and there, collect objects scattered on the ground, peck.</definition>
      <page>202</page>
      <examples>
        <example>
          <unicode>ᠴᠥᠯᠪᠠᠵᠦ ᠢᠳᠡᠺᠦ</unicode>
          <transcript>--zy ideky</transcript>
          <definition> To browse.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠷᠢᠶ᠎ᠠ ᠴᠥᠯᠪᠠᠺᠦ</unicode>
          <transcript>tarij-a --ky </transcript>
          <definition>To glean grain</definition>
        </example>
        <example>
          <unicode>ᠲᠦᠯᠢᠶ᠎ᠡ ᠴᠥᠯᠪᠠᠺᠦ</unicode>
          <transcript>tylij-e --ky </transcript>
          <definition>To gather fuel</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠷᠤᠬᠠᠢ ᠴᠥᠯᠪᠠᠵᠦ ᠢᠳᠡᠺᠦ</unicode>
          <transcript>xoruxai --zy ideky</transcript>
          <definition> To pick up worms or insects and eat them.</definition>
        </example>
      </examples>
    </entry_item>
