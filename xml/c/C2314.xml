  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠢᠷᠠᠶᠢᠯᠠᠬᠣ</unicode>
      <uighur>čirayilaqu</uighur>
      <cyrillic>царайлах</cyrillic>
      <transcript>CIRAILA-</transcript>
      <definition>v . i. and t. To look; to look in the face; to have a certain expression on the face.</definition>
      <page>191</page>
      <examples>
        <example>
          <unicode>ᠪᠤᠷᠤᠭᠤ ᠴᠢᠷᠠᠶᠢᠯᠠᠬᠣ</unicode>
          <transcript>buruγu --xu</transcript>
          <definition>To look the other way.</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠭᠤ ᠴᠢᠷᠠᠶᠢᠯᠠᠬᠣ</unicode>
          <transcript>maγu --xu</transcript>
          <definition>To show displeasure in one's face.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠴᠢᠷᠠᠶᠢᠯᠠᠬᠤ</unicode>
      <definition>regarder eu face, contempler la figure (d'une personne auguste).</definition>
      <page>2184</page>
      <examples>
        <example>
          <unicode>ᠪᠢᠳᠡᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠢᠯᠡᠷᠭᠡᠢ ᠡ ᠴᠢᠷᠠᠶᠢᠯᠠᠨ ᠦᠵᠡᠭᠳᠡᠭᠰᠡᠨ ᠮᠥᠨ</unicode>
          <definition>il nous apparût</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠷᠤᠭᠤ ᠴᠢᠷᠠᠶᠢᠯᠠᠵᠤ ᠨᠠᠮᠠᠶᠢ ᠦᠯᠦ ᠲᠠᠭᠠᠯᠠᠮᠤᠢ</unicode>
          <definition>je ne veux pas qu'il me regarde d'un mauvais oeil (qu'il se fâche contre moi)</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
