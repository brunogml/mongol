      <dico>Lessing</dico>
      <unicode>ᠴᠢᠯᠠᠺᠥ</unicode>
      <uighur>čilekü</uighur>
      <cyrillic>чилэх</cyrillic>
      <transcript>CILE-</transcript>
      <definition>v, i. To be[come] ill, indisposed, weary (hon.); to be[come] tired, exhausted; to grow numb.</definition>
      <page>182</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠠ ᠴᠢᠯᠠᠲᠡᠯ᠎ᠡ ᠺᠡᠯᠡᠺᠦ</unicode>
          <transcript>ama --tel-e keleky</transcript>
          <definition>To talk until the mouth becomes dry.</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠴᠢᠯᠠᠺᠦ</unicode>
          <transcript>bej-e --ky</transcript>
          <definition>To become physically tired; to become ill (hon),</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠯ ᠴᠢᠯᠠᠺᠦ</unicode>
          <transcript>køl --ky</transcript>
          <definition>For the legs to become numb.</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠳᠦ ᠴᠢᠯᠠᠲᠡᠯᠡ ᠬᠠᠷᠠᠬᠤ</unicode>
          <transcript>nidy --tel-e xaraxu</transcript>
          <definition>To look until the eyes get tired.</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠳᠺᠢᠯ ᠴᠢᠯᠠᠺᠦ</unicode>
          <transcript>sedkil - -ky</transcript>
          <definition>To worry (hon.).</definition>
        </example>
      </examples>
    </entry_item>
