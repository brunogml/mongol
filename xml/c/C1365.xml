    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠢᠨᠠᠬᠰᠢ</unicode>
      <uighur>činaqsi</uighur>
      <cyrillic>чанагш - цааш</cyrillic>
      <transcript>CINAΓSI</transcript>
      <definition>[=caγasi] adv, Away from; farther, beyond; from a certain time on, in the future.</definition>
      <page>187</page>
      <examples>
        <example>
          <unicode>ᠴᠢᠨᠠᠬᠰᠢ ᠪᠡᠨ</unicode>
          <transcript>-- ben</transcript>
          <definition>Away!. Get away !.</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠨᠠᠬᠰᠢ ᠪᠡᠨ ᠪᠣᠶᠢᠬᠤ</unicode>
          <transcript>-- ben boixu</transcript>
          <definition>To move still farther away.</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠨᠠᠬᠰᠢ ᠪᠣᠯᠪᠠᠰᠤᠷᠠᠬᠤ</unicode>
          <transcript>-- bolbasuraxu</transcript>
          <definition>To develop further; to further one's education.</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠨᠠᠬᠰᠢ ᠪᠣᠯᠬᠤ</unicode>
          <transcript>-- bolxu</transcript>
          <definition>To go farther away.</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠨᠠᠬᠰᠢ ᠎ᠳᠤ</unicode>
          <transcript>-- du</transcript>
          <definition>In the future.</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠨᠠᠬᠰᠢ ᠢᠨᠠᠭᠰᠢ</unicode>
          <transcript>-- inaγsi</transcript>
          <definition>Back and forth, to and fro,</definition>
        </example>
        <example>
          <unicode>ᠪᠦᠷᠢ ᠴᠢᠨᠠᠬᠰᠢ ᠪᠡᠨ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>byri -- ben jabuxu</transcript>
          <definition>To go still farther.</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠨ ᠡᠴᠡ ᠴᠢᠨᠠᠬᠰᠢ</unicode>
          <transcript>egyn ece --</transcript>
          <definition>From here on.</definition>
        </example>
        <example>
          <unicode>ᠡᠨᠡ ᠡᠳᠦᠷ ᠡᠴᠡ ᠴᠢᠨᠠᠬᠰᠢ</unicode>
          <transcript>ene edyr ece --</transcript>
          <definition>From today on.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠭᠦᠨ ᠡᠴᠡ ᠴᠢᠨᠠᠬᠰᠢ</unicode>
          <transcript>tegyn ece --</transcript>
          <definition>From there on, beyond that point.</definition>
        </example>
      </examples>
    </entry_item>
