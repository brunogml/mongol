  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠣ</unicode>
      <uighur>Cu</uighur>
      <cyrillic>ч</cyrillic>
      <transcript>CU, CY</transcript>
      <definition>An intensifying and concessive particle with a general meaning of "even," and "as for. "</definition>
      <page>203</page>
      <examples>
        <example>
          <unicode>ᠪᠢ  ᠮᠡᠳᠡᠺᠦ ᠦᠭᠡᠢ</unicode>
          <transcript>bi cy medeky ygei</transcript>
          <definition>I don't know.</definition>
        </example>
        <example>
          <unicode>ᠴᠣ ᠴᠣ / ᠴᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>… cu / cy ygei</transcript>
          <definition>Not even ...</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠭᠠᠺᠢᠭᠰᠠᠨ ᠴᠣ</unicode>
          <transcript>jaγakiγsan cu</transcript>
          <definition>No matter what.</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠭᠠᠺᠢᠭᠰᠠᠨ ᠴᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>jaγakiγsan cu ygei</transcript>
          <definition>Nothing happened.</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠮᠪᠠᠷ ᠴᠣ</unicode>
          <transcript>jambar cu</transcript>
          <definition>Whatever</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠨ ᠴᠣ</unicode>
          <transcript>ken cy</transcript>
          <definition>Whoever.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠦᠺᠡᠳ ᠴᠣ ᠮᠡᠳᠡᠮᠦᠢ</unicode>
          <transcript>keyked cy medemyi</transcript>
          <definition>Even children know [it].</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠭᠡ ᠺᠦᠮᠦᠨ ᠴᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>nige kymyn cy ygei</transcript>
          <definition>There is not a single person.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠡ ᠴᠣ ᠲᠡᠶᠢᠮᠦ</unicode>
          <transcript>tere cy teimy</transcript>
          <definition>[As for that] it is correct.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠴᠤ</unicode>
      <definition>et même, aussi, et encore, de plus, pareillement, de même manière; 2 quoique, quand, quand même, cependant, pourtant: 3. vinaigre (en chin. tsou).</definition>
      <page>2190</page>
      <examples>
        <example>
          <unicode>ᠰᠠᠶᠢᠨ ᠴᠤ ᠪᠤᠰᠤ᠃ ᠮᠠᠭᠤ ᠴᠤ ᠪᠤᠰᠤ</unicode>
          <definition>ni bien, ni mal</definition>
        </example>
        <example>
          <unicode>ᠴᠤ ᠪᠣᠯᠪᠠ = ᠪᠣᠯᠪᠠᠴᠤ</unicode>
          <definition>quoique, cependant, d'ailleurs, mais</definition>
        </example>
      </examples>
    </entry_item>
