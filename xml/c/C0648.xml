  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠠᠶᠢᠯᠭᠠᠬᠣ</unicode>
      <uighur>čayilγaqu</uighur>
      <cyrillic>цайлгах</cyrillic>
      <transcript>CAILΓA-</transcript>
      <definition>[v. caus. of cai-.] To make white, whitewash, : bleach; to thresh, shell; to clean; to remove nuts from a cone; to explain, interpret; to clear up; to clear oneself of suspicion.</definition>
      <page>161</page>
      <examples>
        <example>
          <unicode>ᠴᠠᠶᠢᠯᠭᠠᠨ ᠪᠤᠳᠤᠬᠤ</unicode>
          <transcript>--n buduxu</transcript>
          <definition>To whitewash.</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠶᠢᠯᠭᠠᠵᠤ ᠪᠢᠴᠢᠺᠦ</unicode>
          <transcript>--zu biciky</transcript>
          <definition>To make a neat copy.</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠪᠡᠨ ᠴᠠᠶᠢᠯᠭᠠᠬᠤ</unicode>
          <transcript>bej-e ben --xu</transcript>
          <definition>To clear oneself of suspicion or an accusation.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠷᠡᠭ ᠴᠠᠶᠢᠯᠭᠠᠬᠤ</unicode>
          <transcript>kereg --xu</transcript>
          <definition>To clear up an affair or a case.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠷᠢᠶᠠᠨ ᠢ ᠴᠠᠶᠢᠯᠭᠠᠬᠤ</unicode>
          <transcript>tarijan i --xu</transcript>
          <definition>To clean or thresh grain.</definition>
        </example>
        <example>
          <unicode>ᠦᠷ ᠴᠠᠶᠢᠯᠭᠠᠬᠤ</unicode>
          <transcript>yr --xu</transcript>
          <definition>To wait till dawn; to do something till dawn; to stay awake till dawn.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠴᠠᠶᠢᠯᠭᠠᠬᠤ</unicode>
      <definition>blanchir, rendre blanc: 2 nettoyer, éclaircir, rendre clair; éclairer, instruire; 3 moudre; monder les grains</definition>
      <page>2076</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠮᠤᠭ ᠲᠥᠪᠡᠳ ᠢ ᠭᠡᠶᠢᠭᠦᠯᠦᠨ ᠴᠠᠶᠢᠯᠭᠠᠬᠤ</unicode>
          <definition>éclairer tous les Tibétains</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠠᠩᠭᠤ ᠲᠢᠪ ᠢ ᠴᠠᠶᠢᠯᠭᠠᠬᠤ</unicode>
          <definition>éclairer la partie sombre de la terre</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠷᠢᠶᠠᠨ ᠢ ᠴᠠᠶᠢᠯᠭᠠᠬᠤ</unicode>
          <definition>monder les grains, moudre</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠶᠢᠯᠭᠠᠨ ᠪᠤᠳᠤᠭᠰᠠᠨ ᠭᠡᠷᠡᠮ</unicode>
          <definition>mur blanchi</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠯᠡᠨ ᠨᠣᠭᠤᠳ ᠢ ᠲᠠᠶᠢᠯᠠᠨ ᠴᠠᠶᠢᠯᠭᠠᠬᠤᠢ</unicode>
          <definition>le don d'interpréter les langues</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
