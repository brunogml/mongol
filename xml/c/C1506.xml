    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠢᠩᠭᠠᠳᠬᠠᠬᠣ</unicode>
      <uighur>čingγadqaqu</uighur>
      <cyrillic>чангатгах</cyrillic>
      <transcript>CINGΓADXA-</transcript>
      <definition>[v. caus. of cingγad-] To tighten; to exercise strict supervision.</definition>
      <page>189</page>
      <examples>
        <example>
          <unicode>ᠺᠢᠨᠠᠯᠲᠠ ᠎ᠶᠢ ᠴᠢᠩᠭᠠᠳᠬᠠᠬᠣ</unicode>
          <transcript>kinalta ji - -xu,</transcript>
          <definition>To tighten control</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠺᠢᠯᠭ᠎ᠠ ᠪᠠᠲᠤ ᠎ᠶᠢ ᠴᠢᠩᠭᠠᠳᠬᠠᠬᠣ</unicode>
          <transcript>sakilγ-a batu ji --xu</transcript>
          <definition>To tighten discipline</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠴᠢᠩᠭᠠᠳᠬᠠᠬᠤ</unicode>
      <definition>1 affermir, consolider, rendre ferme: 
2 être sévère. rigoureux, exigeant: examiner de près, s'enquêter, s'informer exactement: 
3 s'obliger, s'engager.</definition>
      <page>2140</page>
      <examples>
        <example>
          <unicode>ᠰᠠᠶᠢᠨ ᠮᠥᠷ ᠢᠶᠠᠷ ᠴᠢᠩᠭᠠᠳᠬᠠᠬᠤ ᠤᠨ ᠰᠠᠭᠠᠵᠠ ᠎ᠶᠢ ᠪᠠᠺᠢᠯᠠ ᠴᠢᠩᠭᠠᠳᠬᠠ</unicode>
          <definition>par de bonnes mesures, consolide les règlements de la religion</definition>
        </example>
      </examples>
    </entry_item>
