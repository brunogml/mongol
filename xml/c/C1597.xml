    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠢᠬᠣᠯᠳᠠᠬᠣ</unicode>
      <uighur>čiquldaqu</uighur>
      <cyrillic>цухалдах</cyrillic>
      <transcript>CIXULDA-</transcript>
      <definition>[=cuxulda-] v . i, To be narrow.; to be crowded; to be pressed; to be in straitened or difficult circumstances; to be irritable, nervous or angry; to despair, be despondent, lose hope.</definition>
      <page>193</page>
      <examples>
        <example>
          <unicode>ᠴᠢᠬᠣᠯᠳᠠᠵᠤ ᠪᠣᠭᠤᠵᠤ ᠦᠺᠦᠺᠦ</unicode>
          <transcript>--zu boγuzu ykyky</transcript>
          <definition> To hang oneself from despair.</definition>
        </example>
        <example>
          <unicode>ᠳᠣᠲᠤᠷ᠎ᠠ ᠴᠢᠬᠣᠯᠳᠠᠬᠤ</unicode>
          <transcript>dotur-a - -xu, </transcript>
          <definition>To be nervous or irritable</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠭᠠᠷᠠᠬᠤ ᠴᠢᠬᠣᠯᠳᠠᠬᠤ</unicode>
          <transcript>jaγarazu --xu</transcript>
          <definition> To hurry desperately.</definition>
        </example>
      </examples>
    </entry_item>
