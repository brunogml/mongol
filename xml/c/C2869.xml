    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠴᠣᠪᠣᠷᠢᠯ</unicode>
      <uighur>čuburil</uighur>
      <definition>n. The act of following one after another. The act of pouring out drops.</definition>
      <page>1336</page>
      <examples>
        <example>
          <uighur>čuburil-i bariqu</uighur>
          <definition>To stop the act of succession. To step out of the act of providence (the end of transmigration of souls.). Buddh.</definition>
        </example>
      </examples>
    </entry_item>
