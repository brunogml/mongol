    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠣᠪᠣᠷᠢᠯ</unicode>
      <transcript>CUBURIL</transcript>
      <definition>T. zag pa; S. āsrava ( āçrava). Evil influence defilement through passions</definition>
      <page>1166</page>
      <examples>
        <example>
          <unicode>ᠴᠤᠪᠤᠷᠢᠯ ᠪᠠᠷᠠᠭᠰᠠᠨ</unicode>
          <transcript>++ -- baraγsan;</transcript>
          <definition>T. zag (pa) med (pa); S. kshānāsrava, āsrava-kshaya. Having exhausted, being free from, defilement</definition>
        </example>
        <example>
          <unicode>ᠴᠤᠪᠤᠷᠢᠯ ᠵᠠᠭ ᠫᠠ</unicode>
          <transcript>++++ --</transcript>
          <definition>T.  zag pa; S. āsrava. Oozing, dripping, the defiling 'influence' of the nisvanis</definition>
        </example>
      </examples>
    </entry_item>
