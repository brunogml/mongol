    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠠᠯᠠᠭᠠᠷ</unicode>
      <uighur>čalaγar</uighur>
      <cyrillic>цалгар</cyrillic>
      <transcript>CALAΓAR</transcript>
      <definition>[= calγar] n. and adj. Error, fault, omission, inaccuracy, negligence; inaccurate, negligent; wide mouthed.</definition>
      <page>162</page>
      <examples>
        <example>
          <unicode>ᠴᠠᠯᠠᠭᠠᠷ ᠠᠮᠠᠲᠠᠢ</unicode>
          <transcript>-- amatai</transcript>
          <definition> Wide-mouthed, having a wide opening; loose-tongued, babbling.</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠯᠠᠭᠠᠷ ᠡᠪᠡᠷᠲᠡᠢ</unicode>
          <transcript>-- ebertei</transcript>
          <definition> Having wide-spread horns.</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠯᠠᠭᠠᠷ ᠨᠠᠵᠠᠭᠠᠢ</unicode>
          <transcript>-- nazaγai, </transcript>
          <definition>Negligent and slow</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠯᠠᠭᠠᠷ ᠤᠰᠤᠨ</unicode>
          <transcript>-- usun</transcript>
          <definition> A wide, shallow sheet of water.</definition>
        </example>
      </examples>
    </entry_item>
