      <definition>v.t. To make a hole with a red-hot pin or awl, pierce with a hot iron.</definition>
      <page>198</page>
      <examples>
        <example>
          <unicode>ᠴᠣᠷᠺᠢᠵᠤ ᠴᠣᠭᠤᠯᠬᠤ</unicode>
          <transcript>--zu coγulxu</transcript>
          <definition>To burn a hole in something with a red-hot needle, etc.</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠷ᠎ᠠ ᠴᠣᠷᠺᠢᠬᠤ</unicode>
          <transcript>jar-a --xu</transcript>
