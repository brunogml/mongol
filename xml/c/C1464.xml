      <uighur>čing</uighur>
      <cyrillic>чин</cyrillic>
      <transcript>CING</transcript>
      <definition>2 adj. and adv, Firm[ly], unshakable [-bly]; truthfu1[ly], sincere[ly].</definition>
      <page>188</page>
      <examples>
        <example>
          <unicode>ᠴᠢᠩ ᠪᠠᠲᠤ</unicode>
          <transcript>-- batu</transcript>
          <definition>Firm, unshakable; loyal; truthful.</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠩ ᠪᠢᠰᠢᠷᠡᠯ</unicode>
          <transcript>-- bisirel</transcript>
          <definition>Unshakable or true faith.</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠩ ᠨᠤᠲᠠ</unicode>
          <transcript>-- nuta</transcript>
