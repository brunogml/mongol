    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠠᠺᠠᠷᠯᠠᠺᠥ</unicode>
      <uighur>čegerlekü</uighur>
      <cyrillic>цээрлэх</cyrillic>
      <transcript>CEGERLE-</transcript>
      <definition>v.t. and i, To taboo; to prohibit; to quarantine, to abstain.</definition>
      <page>169</page>
      <examples>
        <example>
          <unicode>ᠴᠠᠺᠠᠷᠯᠠᠨ ᠺᠡᠯᠡᠭᠰᠡᠨ ᠦᠭᠡ</unicode>
          <transcript>--n kelegsen yge</transcript>
          <definition> A word used as a substitute for a taboo word, euphemism.</definition>
        </example>
        <example>
          <unicode>ᠠᠮᠢᠨ ᠴᠠᠺᠠᠷᠯᠠᠺᠦ</unicode>
          <transcript>amin --ky</transcript>
          <definition> To abstain from killing.</definition>
        </example>
        <example>
          <unicode>ᠠᠷᠠᠺᠢ ᠎ᠶᠢᠨ ᠴᠠᠺᠠᠷᠯᠠᠺᠦ</unicode>
          <transcript>araki jin --ky </transcript>
          <definition>To abstain from liquor</definition>
        </example>
        <example>
          <unicode>ᠴᠡᠭᠡᠷ ᠴᠠᠺᠠᠷᠯᠠᠺᠦ</unicode>
          <transcript>ceger --ky</transcript>
          <definition> To observe mourning.</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠳᠡᠨ ᠴᠠᠺᠠᠷᠯᠠᠺᠦ</unicode>
          <transcript>egyden --ky</transcript>
          <definition> To keep people away from one's door (because of illness in the house),</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠯ ᠴᠠᠺᠠᠷᠯᠠᠺᠦ</unicode>
          <transcript>køl --ky </transcript>
          <definition>To keep away visitors</definition>
        </example>
        <example>
          <unicode>ᠨᠡᠷ᠎ᠡ ᠴᠠᠺᠠᠷᠯᠠᠺᠦ</unicode>
          <transcript>ner-e --ky</transcript>
          <definition> To place a taboo on or refrain from using a name (as names of certain places, one's parents and teachers, etc.).</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
