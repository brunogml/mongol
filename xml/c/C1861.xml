      <unicode>ᠴᠢᠯᠡᠭᠡ</unicode>
      <uighur>čilege</uighur>
      <cyrillic>чилээ</cyrillic>
      <transcript>CILEGE</transcript>
      <definition>n. Indisposition, illness (hon.); exhaustion, tiredness; numbness.</definition>
      <page>182</page>
      <examples>
        <example>
          <unicode>ᠴᠢᠯᠡᠭᠡ ᠠᠮᠤᠷᠯᠢᠬᠤ</unicode>
          <transcript>-- amurlixu</transcript>
          <definition>To recover from illness (hon.},</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠯᠡᠭᠡ ᠪᠡᠷ ᠣᠷᠤᠰᠢᠬᠤ</unicode>
          <transcript>-- ber orusixu,</transcript>
          <definition>To be continuously ill</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠯᠡᠭᠡ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <transcript>-- γarγaxu</transcript>
          <definition>To rid oneself of numbness in the extremities.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠨᠳᠦ ᠴᠢᠯᠡᠭᠡ</unicode>
