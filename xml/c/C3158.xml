    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠣᠴᠠᠷᠠᠬᠣ</unicode>
      <uighur>čučaraqu</uighur>
      <cyrillic>цуцрах</cyrillic>
      <transcript>CUCARA-</transcript>
      <definition>v.i. To come lose (of anything plaited, tied, or rolled up), fall to pieces, become disjointed or disentangled; to spread, unfold, open; to be destroyed or ruined; to be out of order; to fall; to be tired, weary, exhausted.</definition>
      <page>205</page>
      <examples>
        <example>
          <unicode>ᠴᠣᠴᠠᠷᠠᠭᠰᠠᠨ ᠣᠩᠭᠤᠴᠠ</unicode>
          <transcript>--γsan ongγuca</transcript>
          <definition>A wrecked boat.</definition>
        </example>
        <example>
          <unicode>ᠡᠪᠳᠡᠷᠡᠨ ᠴᠣᠴᠠᠷᠠᠭᠰᠠᠨ</unicode>
          <transcript>ebderen --γsan</transcript>
          <definition>Ruined, destroyed; ruins.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠴᠣᠴᠠᠷᠠᠬᠤ</unicode>
      <definition>1 se rompre en plusieurs morceaux, se briser, se ruiner, se fendre, se crevasser: 
2 fig. être fatigué, être las, se fatiguer.</definition>
