  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠢᠷᠺᠥ</unicode>
      <uighur>čirkü</uighur>
      <cyrillic>чирэх</cyrillic>
      <transcript>CIR-</transcript>
      <definition>[= sire-] v.t. To drag, haul, pull along, trail along the ground; to delay, postpone, defer: procrastinate; to draw into, allure; to implicate, involve into something unpleasant</definition>
      <page>191</page>
      <examples>
        <example>
          <unicode>ᠴᠢᠷᠴᠦ ᠠᠪᠴᠢᠷᠠᠬᠤ</unicode>
          <transcript>--cy abciraxu</transcript>
          <definition>To bring by dragging; haul in.</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠷᠴᠦ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <transcript>--cy γarγaxu</transcript>
          <definition>To drag or pull out or away.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠷ ᠡᠴᠡ ᠪᠠᠷᠢᠨ ᠴᠢᠷᠺᠦ</unicode>
          <transcript>γar ece barin - -ky</transcript>
          <definition>To pull by the hand.</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠯ ᠢᠶᠡᠨ ᠴᠢᠷᠺᠦ</unicode>
          <transcript>køl ijen --ky,</transcript>
          <definition>To drag one's foot</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠭᠡ ᠴᠢᠷᠺᠦ</unicode>
          <transcript>terge --ky</transcript>
          <definition>To pull a cart</definition>
        </example>
      </examples>
    </entry_item>
