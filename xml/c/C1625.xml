    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠢᠪ</unicode>
      <uighur>čib</uighur>
      <cyrillic>чив</cyrillic>
      <transcript>CIB</transcript>
      <definition>Intensifying particle used before certain adjectives and adverbs beginning with the syllable ci.</definition>
      <page>174</page>
      <examples>
        <example>
          <unicode>ᠴᠢᠪ ᠴᠢᠺᠡ</unicode>
          <transcript>-- cike</transcript>
          <definition>Quite straight; exactly, precisely.</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠪ ᠴᠢᠮᠡᠭᠡ ᠦᠭᠡᠢ</unicode>
          <transcript>-- cimege ygei</transcript>
          <definition>Without any sound without the slightest noise.</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠪ ᠴᠢᠮᠡᠭᠡ ᠦᠭᠡᠢ ᠪᠣᠯᠬᠤ</unicode>
          <transcript>-- cimege ygei bolxu</transcript>
          <definition>To become absolutely silent; to vanish without a trace, be missing.</definition>
        </example>
      </examples>
    </entry_item>
