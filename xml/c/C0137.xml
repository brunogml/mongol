    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠴᠠᠭᠠᠯᠠᠬᠣ</unicode>
      <uighur>čaγalaqu</uighur>
      <cyrillic>цагаалах</cyrillic>
      <transcript>CAΓALA-</transcript>
      <definition>1 v.t. To bleach, whiten, whitewash; to peel, take off the skin, clean; to clear up; to write neatly; to make a neat copy; to make' a final draft of a manuscript; . to be in mourning, wear white mourning garments.</definition>
      <page>157</page>
      <examples>
        <example>
          <unicode>ᠴᠠᠭᠠᠯᠠᠭᠰᠠᠨ ᠪᠢᠴᠢᠭ</unicode>
          <transcript>--γsan bicig</transcript>
          <definition>Neat copy, good copy.</definition>
        </example>
        <example>
          <unicode>ᠠᠯᠢᠮ᠎ᠠ ᠴᠠᠭᠠᠯᠠᠬᠤ</unicode>
          <transcript>alim-a --xu</transcript>
          <definition>To peel an apple.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠵᠠᠷ ᠴᠠᠭᠠᠯᠠᠬᠤ</unicode>
          <transcript>γazar --xu</transcript>
          <definition>To clean virgin soil of vegetation for, cultivation.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠷᠡᠭ ᠴᠠᠭᠠᠯᠠᠬᠤ</unicode>
          <transcript>kereg --xu</transcript>
          <definition>To clear up a case or a crime.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
