      <definition>v.t. To help, aid, assist.</definition>
      <page>845</page>
      <examples>
        <example>
          <unicode>ᠲᠣᠰᠠᠯᠠᠬᠣ ᠴᠡᠷᠢᠭ</unicode>
          <transcript>--xu cerig</transcript>
          <definition> Auxiliary troops; troop reinforcements</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠰᠠᠯᠠᠬᠣ ᠦᠢᠯᠡ ᠦᠭᠡ</unicode>
          <transcript>--xu yile yge</transcript>
          <definition> Auxiliary verb.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠴᠦᠨ ᠲᠣᠰᠠᠯᠠᠬᠣ</unicode>
          <transcript>kycyn --xu</transcript>
          <definition> To reinforce; to give physical assistance</definition>
        </example>
      </examples>
    </entry_item>
