    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠳᠠᠰᠢᠯᠠᠬᠣ</unicode>
      <uighur>dasilaqu</uighur>
      <cyrillic>дашлах</cyrillic>
      <transcript>DASILA-</transcript>
      <definition>v.t. and i. To put or place under, join, add; to border, edge, trim; to adjoin, border on, be alongside of, be together with; to be designated for a post in advance before it is vacated.</definition>
      <page>236</page>
      <examples>
        <example>
          <unicode>ᠳᠠᠰᠢᠯᠠᠨ ᠠᠶᠢᠯᠠᠳᠬᠠᠬᠤ ᠪᠢᠴᠢᠭ</unicode>
          <transcript>--n ailadxaxu bicig</transcript>
          <definition> Attached report.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠰᠢᠯᠠᠨ ᠰᠢᠯᠭᠠᠭᠴᠢ ᠲᠦᠰᠢᠮᠡᠯ</unicode>
          <transcript>--n silγaγci tysimel</transcript>
          <definition> Assistant to the examiner</definition>
        </example>
        <example>
          <unicode>ᠡᠪᠦᠳᠦᠭ ᠳᠠᠰᠢᠯᠠᠨ ᠰᠠᠭᠤᠬᠤ</unicode>
          <transcript>ebydyg --n saγuxu</transcript>
          <definition> To sit next to.</definition>
        </example>
        <example>
          <unicode>ᠣᠶᠢᠷ᠎ᠠ ᠳᠠᠰᠢᠯᠠᠨ ᠰᠠᠭᠤᠭᠰᠠᠨ ᠭᠡᠷ</unicode>
          <transcript>oir-a --n saγuγsan ger</transcript>
          <definition> Adjacent house.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠠᠰᠢᠯᠠᠬᠤ</unicode>
      <definition>mettre ou placer dessous; joindre, ajouter: 2 border, garnir: 3 être l'aide ou l'adjoint de qn.</definition>
      <page>1620</page>
      <examples>
        <example>
          <unicode>ᠡᠪᠦᠳᠦᠭ ᠳᠠᠰᠢᠯᠠᠨ ᠰᠠᠭᠤᠬᠤ</unicode>
          <definition>être assis les jambes croisées l'un auprès de l'autre</definition>
        </example>
        <example>
          <unicode>ᠣᠶᠢᠷᠠ ᠳᠠᠰᠢᠯᠠᠨ ᠰᠠᠭᠤᠭᠰᠠᠨ ᠭᠡᠷ</unicode>
          <definition>maison voisine</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠰᠢᠯᠠᠨ ᠠᠶᠢᠯᠠᠳᠬᠠᠬᠤ ᠪᠢᠴᠢᠭ</unicode>
          <definition>copie d'un rapport incluse dans un autre rapport pour être présentée</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠰᠢᠯᠠᠬ ᠰᠢᠯᠭᠠᠭᠴᠢ ᠲᠦᠰᠢᠮᠡᠯ</unicode>
          <definition>l'adjoint d'un examinateur</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠰᠢᠯᠠᠭᠰᠠᠨ ᠲᠦᠰᠢᠮᠡᠯ</unicode>
          <definition>mandarin par droit de succession</definition>
        </example>
      </examples>
