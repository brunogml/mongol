    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠦᠰᠢᠳᠺᠡᠺᠦ</unicode>
      <uighur>tüsidkekü</uighur>
      <cyrillic>түвшитгэх</cyrillic>
      <transcript>TYSIDKE-</transcript>
      <definition>[v.caus. of tybsid-] v. t. To plane, smooth ; to pacify</definition>
      <page>849</page>
      <examples>
        <example>
          <unicode>ᠲᠦᠰᠢᠳᠺᠡᠨ ᠲᠣᠭᠲᠠᠨᠢᠭᠤᠯᠬᠤ</unicode>
          <transcript>--n toγtaniγulxu</transcript>
          <definition> To pacify.</definition>
        </example>
        <example>
          <unicode>ᠳᠡᠯᠡᠺᠡᠢ ᠳᠠᠺᠢᠨ ᠢ ᠲᠦᠰᠢᠳᠺᠡᠺᠦ</unicode>
          <transcript>delekei dakin i --ky</transcript>
          <definition> To establish universal peace and order</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠮᠠᠭᠤᠨ ᠢ ᠲᠦᠰᠢᠳᠺᠡᠺᠦ</unicode>
          <transcript>samaγun i --ky</transcript>
          <definition> To quell the disturbance, restore peace and order.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠦᠪᠰᠢᠳᠺᠡᠺᠦ</unicode>
      <definition>applanir , raboter pour rendre qc. uni; redresser; 2 apaiser, tâcher de radoucir les esprits irrités , vouloir se reconcilier avec des gens qui nous veulent mal.</definition>
      <page>1908</page>
      <examples>
        <example>
          <unicode>ᠪᠠᠯᠪᠤ ᠨᠠᠷ ᠲᠡᠷᠢᠭᠦᠲᠡᠨ ᠮᠡᠳᠡᠺᠦᠢ ᠢᠷᠭᠡᠨ ᠳᠦᠪᠰᠢᠳᠺᠡᠨ ᠡᠰᠡ ᠴᠢᠳᠠᠪᠠᠢ</unicode>
          <definition>les connaisseurs de Népal et ceux d'autres pays ne purent redresser (la statue)</definition>
        </example>
        <example>
          <unicode>ᠳᠦᠪᠰᠢᠳᠺᠡᠨ ᠲᠤᠭᠳᠠᠨᠠᠭᠤᠯᠤᠭᠰᠠᠨ ᠬᠤᠳᠤᠩ</unicode>
          <definition>les habitants de Turquestan apaisés</definition>
        </example>
      </examples>
    </entry_item>
