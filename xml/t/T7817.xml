    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠣᠷᠭᠠᠬᠣ</unicode>
      <uighur>torγaqu</uighur>
      <cyrillic>торгох</cyrillic>
      <transcript>TORΓA-</transcript>
      <definition>[= torγu- , v.caus. of tor-] To stop, hold, catch; to retard, impede; to entangle; to confuse; to tack, secure, fasten, or attach loosely or hastily; to fine, penalize.</definition>
      <page>826</page>
      <examples>
        <example>
          <unicode>ᠲᠣᠷᠭᠠᠵᠤ ᠠᠪᠬᠤ</unicode>
          <transcript>--zu abxu</transcript>
          <definition> Collected as a fine.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠷᠭᠠᠵᠤ ᠣᠶᠤᠬᠤ</unicode>
          <transcript>--zu ojuxu</transcript>
          <definition> To baste, sew loosely.</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠯᠠ ᠲᠣᠷᠭᠠᠬᠣ</unicode>
          <transcript>jala --xu</transcript>
          <definition> To impose a penalty, punishment.</definition>
        </example>
        <example>
          <unicode>ᠮᠥᠩᠭᠦ ᠲᠣᠷᠭᠠᠵᠤ ᠠᠪᠬᠤ</unicode>
          <transcript>møpnggy --zu abxu</transcript>
          <definition> To collect a fine.</definition>
        </example>
        <example>
          <unicode>ᠣᠨᠢ ᠎ᠶᠢ ᠺᠥᠪᠴᠢᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠲᠣᠷᠭᠠᠬᠣ</unicode>
          <transcript>oni ji købcin dyr --xu</transcript>
          <definition> To put the nock of an arrow against the string.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠳᠠᠰᠤᠨ ᠡᠴᠡ ᠲᠣᠷᠭᠠᠬᠣ</unicode>
          <transcript>xadasun ece --xu</transcript>
          <definition> To hang, suspend from a nail.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠤᠷᠭᠠᠬᠤ ~ ᠳᠤᠷᠭᠣᠬᠤ</unicode>
      <definition>arrêter, retenir; donner contre, accrocher: 2 chercher chicane à, agacer, piquer qn., attraper qn. par la ruse: 3 condamner à une amende.</definition>
      <page>1892</page>
      <examples>
