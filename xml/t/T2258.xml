      <dico>Lessing</dico>
      <unicode>ᠲᠠᠺᠢᠭᠠᠷ</unicode>
      <uighur>takiγar</uighur>
      <cyrillic>тахигар</cyrillic>
      <transcript>TAKIΓAR</transcript>
      <definition>[= takir] adj. and n. Crippled, maimed (of limbs); crooked; a cripple; invective addressed to a person who has lost the use of an arm or hand.</definition>
      <page>770</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠺᠢᠭᠠᠷ ᠪᠣᠯᠬᠤ</unicode>
          <transcript>-- bolxu</transcript>
          <definition> To be[come] crippled.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠺᠢᠭᠠᠷ ᠭᠠᠷ</unicode>
          <transcript>-- γar</transcript>
          <definition> Crippled hand or arm.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠺᠢᠭᠠᠷ ᠺᠥᠯ</unicode>
          <transcript>-- køl</transcript>
          <definition> Crippled leg or foot.</definition>
        </example>
      </examples>
    </entry_item>
