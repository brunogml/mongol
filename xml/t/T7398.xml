    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠳᠣᠺᠢᠶ ᠠ</unicode>
      <uighur>dokiy-a</uighur>
      <cyrillic>дохио(н)</cyrillic>
      <transcript>DOKIJ-A(N)</transcript>
      <definition>n. Sign, signal, gesture, hint, allusion, symbol.</definition>
      <page>258</page>
      <examples>
        <example>
          <unicode>ᠳᠣᠺᠢᠶ ᠠ ᠪᠡᠷ ᠶᠠᠷᠢᠯᠠᠴᠠᠬᠤ</unicode>
          <transcript>-- ber jarilacaxu</transcript>
          <definition>To communicate with each other by signs; to pantomime.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠷ ᠢᠶᠠᠷ ᠳᠣᠺᠢᠶ ᠠ ᠥᠭᠺᠦ</unicode>
          <transcript>γar ijer -- øgky</transcript>
          <definition>To make a signal or gesture with the hand.</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠳᠦᠨ ᠤ ᠳᠣᠺᠢᠶ ᠠ</unicode>
          <transcript>nidyn y - -</transcript>
          <definition>Signal with the eyes, blinking, winking.</definition>
        </example>
      </examples>
    </entry_item>
