    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠷᠨᠢ</unicode>
      <uighur>tarni</uighur>
      <cyrillic>тарни</cyrillic>
      <transcript>TARNI</transcript>
      <definition>[S. dhāranī, translated into Mongolian as toγtaγal] n. Magic spells mostly consisting of Sanskrit syllables or words and/or unintelligible phonetic units used in religious and quasi-religious rites; charms, dharani, mantra.</definition>
      <page>781</page>
    </entry_item>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠷᠨᠢ</unicode>
      <uighur>tarnis</uighur>
      <transcript>TARNIS</transcript>
      <definition>Plural of darni</definition>
      <page>781</page>
    </entry_item>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠷᠨᠢ</unicode>
      <definition>TARNI T. snags; S. mantra. Mantra, "magic" formula or spell.     </definition>
      <page>1185</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠷᠨᠢ ᠎ᠶᠢᠨ ᠺᠦᠷᠳᠦᠨ</unicode>
          <transcript>+++ -- jin kyrydn; </transcript>
          <definition>T. sngags hchor; S. dhārani-cakra. A tarni whose syllables are arranged in form of a wheel or circle, esp. for magic purposes and prayer wheels; the vision of tarni syllables arranged in two circles of which one is moving clockwise and the other counterclockwise before the eyes of the bytygelcin engaged in performing the act of bytygel yn arγ-a. </definition>
        </example>
        <example>
          <unicode>ᠠᠮᠤᠷᠯᠢᠩᠭᠤᠢ ᠎ᠶᠢᠨ ᠲᠠᠷᠨᠢ</unicode>
          <transcript>+++ amurlingyui jin --; </transcript>
          <definition>T. zhi bahi sngags. Spell of propitiation.</definition>
        </example>
        <example>
          <unicode>ᠳᠡᠯᠭᠡᠷᠡᠩᠭᠦᠢ ᠎ᠶᠢᠨ ᠲᠠᠷᠨᠢ</unicode>
          <transcript>+++ delgerengyyi jin --; </transcript>
          <definition>T. rgyas pahi sngags; S.paushtikadharani. Spell to insure prosperity.</definition>
        </example>
        <example>
          <unicode>ᠳᠣᠭᠰᠢᠨ ᠲᠠᠷᠨᠢ</unicode>
          <transcript>+++ doγsin --; </transcript>
          <definition>T. drag pohi sngags; S. abhi-caruka. Coercing spell.</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠺᠡ ᠎ᠶᠢᠨ ᠲᠠᠷᠨᠢ</unicode>
          <transcript>+++ erke jin --; T. </transcript>
          <definition>dbang gi sngags; S. vacikara-mantra. Overpowering spell.</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠭᠤᠴᠠ ᠲᠠᠷᠨᠢ</unicode>
          <transcript>+++ niγuca --; </transcript>
          <definition>T. gsang sngags; S. guhya-mantra. Secret spells.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
