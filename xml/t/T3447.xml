    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠪᠠᠷᠢᠺᠥ</unicode>
      <uighur>teberikü</uighur>
      <cyrillic>тэврэх</cyrillic>
      <transcript>TEBERI-</transcript>
      <definition>v.t. To encircle, encompass with or carry in one's arms; to embrace, press or clasp against one's breast.</definition>
      <page>790</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠪᠠᠷᠢᠭᠡᠳ ᠠᠪᠬᠤ</unicode>
          <transcript>--ged abxu</transcript>
          <definition> To embrace, clasp, or gird.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠪᠠᠷᠢᠨ ᠦᠨᠦᠰᠺᠦ</unicode>
          <transcript>--n ynysky</transcript>
          <definition> To embrace and kiss.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠪᠠᠷᠢᠨ ᠵᠣᠯᠭᠠᠬᠤ</unicode>
          <transcript>--n zolγaxu</transcript>
          <definition> To greet with an embrace.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠪᠠᠷᠢᠵᠦ ᠡᠷᠭᠦᠺᠦ</unicode>
          <transcript>--zy ergyky</transcript>
          <definition> To lift up with an embrace.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠵᠦᠨ ᠢ ᠲᠠᠪᠠᠷᠢᠺᠦ</unicode>
          <transcript>kyzyn i --ky</transcript>
          <definition> To throw one's arms around somebody's neck.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠦᠷ ᠎ᠲᠤᠷ ᠲᠠᠪᠠᠷᠢᠺᠦ</unicode>
          <transcript>øbyr tyr --ky</transcript>
          <definition> To clasp to one's breast.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠡᠪᠡᠷᠢᠺᠦ</unicode>
      <definition>embrasser, presser entre ses bras, saisir, contenir</definition>
      <page>1700</page>
      <examples>
        <example>
          <unicode>ᠡᠪᠦᠷ ᠎ᠲᠤᠷ ᠳᠡᠪᠡᠷᠢᠺᠦ</unicode>
          <definition>presser sur le sein</definition>
        </example>
        <example>
          <unicode>ᠦᠨᠦᠰᠦᠨ ᠳᠡᠪᠡᠷᠢᠺᠦ</unicode>
          <definition>flairer et embrasser</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠷᠬᠠᠨ ᠤ ᠺᠥᠯ ᠭᠠᠷ ᠡᠴᠡ ᠳᠡᠪᠡᠷᠢᠺᠦ</unicode>
          <definition>saisir les pieds et les bras du bouddha</definition>
        </example>
        <example>
          <unicode>ᠳᠡᠪᠡᠷᠢᠵᠦ ᠡᠷᠭᠦᠺᠦ</unicode>
          <definition>prendre qn. sur ses bras</definition>
        </example>
        <example>
          <unicode>ᠳᠡᠪᠡᠷᠢᠨ ᠵᠣᠯᠭᠠᠬᠤ</unicode>
          <definition>embrasser qn. à la rencontre</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠪᠡᠭᠦᠨ ᠎ᠵᠦᠭᠡᠨ ᠺᠦᠵᠦᠭᠦᠨ ᠢ ᠳᠡᠪᠡᠷᠢᠺᠦ</unicode>
          <definition>embrasser son fils par le cou</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠯ ᠢ ᠳᠡᠪᠡᠷᠢᠺᠦ</unicode>
          <definition>embrasser les pieds</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
