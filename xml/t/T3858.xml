    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠳᠠᠯᠠᠳᠺᠥ</unicode>
      <uighur>deledkü</uighur>
      <cyrillic>дэлдэх</cyrillic>
      <transcript>DELED-</transcript>
      <definition>v.t. To strike, beat, knock; cf. deles-</definition>
      <page>248</page>
      <examples>
        <example>
          <unicode>ᠴᠢᠯᠠᠭᠤ ᠪᠡᠷ ᠳᠠᠯᠠᠳᠺᠦ</unicode>
          <transcript>cilaγu ber -- </transcript>
          <definition> To throw stones, beat with stones</definition>
        </example>
        <example>
          <unicode>ᠡᠪᠴᠢᠭᠦᠦ ᠪᠡᠨ ᠳᠠᠯᠠᠳᠺᠥ</unicode>
          <transcript>ebcigyy ben --ky</transcript>
          <definition> To beat one's breast.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠩᠭᠡᠷᠭᠡ ᠎ᠶᠢ ᠳᠠᠯᠠᠳᠺᠥ</unicode>
          <transcript>kenggerge ji --ky</transcript>
          <definition> To beat the drum.</definition>
        </example>
        <example>
          <unicode>ᠮᠣᠳᠤ ᠪᠡᠷ ᠳᠠᠯᠠᠳᠺᠥ</unicode>
          <transcript>modu ber --ky</transcript>
          <definition> To hit with a stick.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠭᠠᠯᠭ᠎ᠠ ᠎ᠶᠢ ᠳᠠᠯᠠᠳᠺᠥ</unicode>
          <transcript>xaγalγ-a ji --ky</transcript>
          <definition> To knock at the gate.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠡᠯᠡᠳᠺᠦ</unicode>
      <definition>battre, frapper, faire du bruit, monnayer.</definition>
      <page>1717</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠭᠠᠯᠭ᠎ᠠ ᠎ᠶᠢ ᠳᠡᠯᠡᠳᠺᠦ</unicode>
          <definition>frapper à la porte cochère</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠶᠠᠷ ᠭᠠᠷ ᠢᠶᠠᠷ ᠡᠪᠴᠢᠭᠦᠪᠡᠨ ᠳᠡᠯᠡᠳᠺᠦ</unicode>
          <definition>se déchirer la poitrine à deux mains</definition>
        </example>
        <example>
          <unicode>ᠪᠢᠷᠠᠮᠠᠨ ᠤ ᠨᠢᠭᠤᠷ ᠢ ᠠᠯᠠᠭᠠᠨ ᠪᠡᠷ ᠳᠡᠯᠡᠳᠺᠦ</unicode>
          <definition>donner un soufflet au brahmane</definition>
        </example>
        <example>
          <unicode>ᠮᠡᠰᠡ ᠪᠡᠷ ᠳᠡᠯᠡᠳᠺᠦ</unicode>
          <definition>frapper du glaive</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠯᠠᠭᠤᠪᠠᠷ ᠳᠡᠯᠡᠳᠺᠦ</unicode>
          <definition>lancer une pierre</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠩᠭᠡᠷᠭᠡ ᠎ᠶᠢ ᠳᠡᠯᠡᠳᠺᠦ</unicode>
          <definition>battre le tambour</definition>
        </example>
      </examples>
