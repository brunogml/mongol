      <dico>Lessing</dico>
      <unicode>ᠲᠠᠪᠠᠳᠠᠺᠥ</unicode>
      <uighur>tebedekü</uighur>
      <cyrillic>тэвдэх</cyrillic>
      <transcript>TEBEDE-</transcript>
      <definition>v.i. To have difficulty in doing something; to hurry, hasten; to act carelessly; to be confused or perplexed.</definition>
      <page>789</page>
      <examples>
        <example>
          <unicode>ᠰᠠᠨᠠᠭ᠎ᠠ ᠲᠠᠪᠠᠳᠠᠺᠥ</unicode>
          <transcript>sanaγ -a --ky</transcript>
          <definition> To be perplexed; thoughts are confused (as from fear).</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠡ ᠲᠠᠪᠠᠳᠠᠵᠦ ᠪᠠᠶᠢᠮᠤᠢ</unicode>
          <transcript>tere --zy baimui</transcript>
          <definition> He is having difficulty.</definition>
        </example>
      </examples>
    </entry_item>
