    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠳᠠᠩᠰᠠᠯᠺᠥ</unicode>
      <uighur>dengselkü</uighur>
      <cyrillic>дэнслэх</cyrillic>
      <transcript>DENGSEL-</transcript>
      <definition>v.i. To vaccillate, oscillate, waver, totter, tremble; to doubt, be irresolute; to be[come] excited.</definition>
      <page>252</page>
      <examples>
        <example>
          <unicode>ᠳᠠᠩᠰᠠᠯᠦᠨ ᠺᠥᠳᠡᠯᠺᠦ</unicode>
          <transcript>--yn kodelky</transcript>
          <definition> To shake, quake.</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠳᠺᠢᠯ ᠎ᠳᠡᠭᠡᠨ ᠳᠠᠩᠰᠠᠯᠺᠦ</unicode>
          <transcript>sedkil degen --ky</transcript>
          <definition> To waver, be irresolute, hesitate</definition>
        </example>
      </examples>
    </entry_item>
