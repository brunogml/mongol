      <uighur>tamaki - tamakin</uighur>
      <cyrillic>тамхи</cyrillic>
      <transcript>TAMAKI(N)</transcript>
      <definition>[= tamiki] n. Tobacco.</definition>
      <page>774</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠮᠠᠺᠢ ᠡᠴᠡ ᠭᠠᠷᠬᠤ</unicode>
          <transcript>-- ece γarxu</transcript>
          <definition> To give up smoking.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠮᠠᠺᠢ ᠎ᠶᠢᠨ ᠺᠥᠭᠡᠷᠭᠡ</unicode>
          <transcript>u jin køgerge</transcript>
          <definition> Snuffbottle</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠮᠠᠺᠢᠨ ᠎ᠳᠤ ᠣᠷᠤᠬᠤ</unicode>
          <transcript>--n du oruxu</transcript>
          <definition> To become a smoker of tobacco; to become an opium addict</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠮᠠᠺᠢᠨ ᠤ ᠰᠠᠪᠠ</unicode>
          <transcript>--n u saba</transcript>
          <definition> Tobacco pouch.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠮᠠᠺᠢ ᠰᠣᠷᠤᠬᠤ</unicode>
          <transcript>-- soruxu</transcript>
          <definition> To smoke tobacco.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠮᠠᠺᠢ ᠲᠠᠲᠠᠬᠤ</unicode>
          <transcript>-- tataxu</transcript>
          <definition> To smoke tobacco; to greet another by offering one's snuffbottle; to exchange snuffbottles in greeting.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠮᠠᠺᠢ ᠤᠭᠤᠬᠤ</unicode>
          <transcript>-- uγuxu</transcript>
          <definition> To smoke.</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠭᠠᠰᠤᠨ ᠲᠠᠮᠠᠺᠢ</unicode>
          <transcript>caγasun -- - </transcript>
          <definition>Cigarettes</definition>
        </example>
