      <dico>Lessing</dico>
      <unicode>ᠳᠥᠲᠠᠯᠠᠺᠥ</unicode>
      <uighur>dötelekü</uighur>
      <cyrillic>дөтлөх</cyrillic>
      <transcript>DØTELE-</transcript>
      <definition>[= døtyle-] v.i. and t. To take a short cut, go the easy. way; to approach; to abridge.</definition>
      <page>269</page>
      <examples>
        <example>
          <unicode>ᠦᠰᠡ ᠳᠥᠲᠠᠯᠠᠵᠦ ᠺᠡᠯᠡᠺᠦ</unicode>
          <transcript>yse --zy keleky </transcript>
          <definition>To give an abridged account, condense a speech</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
