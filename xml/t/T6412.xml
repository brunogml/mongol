        </example>
        <example>
          <unicode>ᠳᠤᠰᠠᠭᠠᠷ ᠰᠠᠭᠤᠭᠰᠠᠨ</unicode>
          <definition>qui vit séparément; un particulier</definition>
        </example>
        <example>
          <unicode>ᠳᠤᠰᠠᠭᠠᠷ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <definition>mettre de côté, mettre à l'écart</definition>
        </example>
        <example>
          <unicode>ᠳᠤᠰᠠᠭᠠᠷ ᠲᠠᠴᠢᠶᠠᠯ</unicode>
          <definition>éducation dans la maison d'autrui</definition>
        </example>
        <example>
          <unicode>ᠳᠤᠰᠠᠭᠠᠷ ᠵᠣᠺᠢᠶᠠᠭᠰᠠᠨ</unicode>
