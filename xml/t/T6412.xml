    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠣᠰᠠᠭᠠᠷ</unicode>
      <uighur>tusaγar</uighur>
      <cyrillic>тусгаар</cyrillic>
      <transcript>TUSAΓAR</transcript>
      <definition>[= tusγar] adv. and adj. Separate[ly], apart, aside; independent[ly]; different, strange; odd, peculiar.</definition>
      <page>845</page>
      <examples>
        <example>
          <unicode>ᠲᠣᠰᠠᠭᠠᠷ ᠪᠠᠶᠢᠭᠤᠯᠬᠤ</unicode>
          <transcript>-- baiγulxu</transcript>
          <definition> To set up or establish separately.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠰᠠᠭᠠᠷ ᠪᠣᠯᠭᠠᠬᠤ</unicode>
          <transcript>-- bolγaxu</transcript>
          <definition> To segregate; to put aside.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠰᠠᠭᠠᠷ ᠺᠡᠷᠡᠭ</unicode>
          <transcript>-- kereg</transcript>
          <definition> Separate matter.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠰᠠᠭᠠᠷ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <transcript>-- talbixu</transcript>
          <definition> To lay aside, put separately.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠰᠠᠭᠠᠷ ᠲᠣᠭᠲᠠᠨᠢᠭᠰᠠᠨ</unicode>
          <transcript>-- toγtaniγsan</transcript>
          <definition> Independent, sovereign.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠰᠠᠭᠠᠷ ᠲᠣᠭᠲᠠᠨᠢᠭᠰᠠᠨ ᠪᠠᠶᠢᠳᠠᠯ</unicode>
          <transcript>--toγtaniγsan baidal</transcript>
          <definition> Political independence.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠰᠠᠭᠠᠷ ᠲᠣᠭᠲᠠᠨᠢᠯ</unicode>
          <transcript>-- toγtanil</transcript>
          <definition> Independence.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠰᠠᠭᠠᠷ ᠲᠣᠭᠲᠠᠨᠢᠬᠤ</unicode>
          <transcript>-- toγtsnixu</transcript>
          <definition> To win independence, become independent.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠰᠠᠭᠠᠷ ᠵᠣᠭᠰᠤᠬᠤ</unicode>
          <transcript>-- zoγsuxu</transcript>
          <definition> To be[come] independent.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠮᠦᠨ ᠡᠴᠡ ᠲᠣᠰᠠᠭᠠᠷ</unicode>
          <transcript>kymyn ece -- </transcript>
          <definition> Different from others; independent of others.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠤᠰᠠᠭᠠᠷ</unicode>
      <definition>séparément, à part, de côté, à l'écart: 2 un autre, différent, d'autrui: 3 spontanément.</definition>
