    <entry_item>
      <dico>lamrd</dico>
      <unicode>ᠲᠣᠰᠠᠭᠠᠷ</unicode>
      <cyrillic>ТУСГААР</cyrillic>
      <definition>1. отдельный, самостоятельный; незављcимый; бие биеэс тусгаар изолљрованный друг от друга; өөртөө тусгаар самостоятельный, незављсимый; тусгаар байдал особое положение, особенность; тусгаар биеэ даасан самостоятельный, незављсимый, суверенный; тусгаар болох обособляться, определяться; стать самостоятельным; тусгаар гэр отдельная юрта; тусгаар тогтнох быть незављсимым; незављсимость; тусгаар тогтнох эрх право на самоопределение; тусгаар тогтносон незављсимый, суверенный; тусгаар улс самостоятельное государство; незављсимое государство; 2. отдельно, самостоятельно; незављсимо; ангид тусгаар отдельно. </definition>
      <page>0</page>
    </entry_item>
    <entry_item>
