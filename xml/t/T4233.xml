    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠵᠢᠶᠠᠺᠥ</unicode>
      <uighur>teǰiyekü</uighur>
      <cyrillic>тэжээх</cyrillic>
      <transcript>TEZIJE-</transcript>
      <definition>[s tezige-] v.t. To feed, rear, keep, raise ( as animals); to bring up (as children); to nourish, support; to treat (medically)</definition>
      <page>808</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠵᠢᠶᠠᠭᠰᠡᠨ ᠡᠴᠢᠭᠡ ᠡᠺᠡ</unicode>
          <transcript>--gsen ecige eke</transcript>
          <definition> Foster parents.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠵᠢᠶᠠᠭᠰᠡᠨ ᠺᠦᠪᠡᠭᠦᠨ</unicode>
          <transcript>--gsen kybegyn</transcript>
          <definition> Foster son.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠵᠢᠶᠠᠺᠦᠢ ᠤᠬᠠᠭᠠᠨ</unicode>
          <transcript>--kyi uxaγan</transcript>
          <definition> Medical science (obs.).</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠵᠢᠶᠠᠨ ᠵᠠᠰᠠᠬᠤ</unicode>
          <transcript>--n zasaxu</transcript>
          <definition> To treat medically.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠵᠢᠶᠠᠵᠦ ᠥᠰᠺᠡᠺᠦ</unicode>
          <transcript>--zy øskeky</transcript>
          <definition> To bring up.</definition>
        </example>
        <example>
          <unicode>ᠠᠮᠢᠨ ᠢᠶᠠᠨ ᠲᠠᠵᠢᠶᠠᠺᠦ</unicode>
          <transcript>amin [ijen] --ky</transcript>
          <definition> To make a living.</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠪᠡᠨ ᠲᠠᠵᠢᠶᠠᠺᠦ</unicode>
          <transcript>bej-e ben --ky</transcript>
          <definition> To feed or nourish oneself.</definition>
        </example>
        <example>
          <unicode>ᠡᠪᠡᠳᠴᠢᠲᠡᠨ ᠢ ᠲᠠᠵᠢᠶᠠᠨ ᠵᠠᠰᠠᠬᠤ</unicode>
          <transcript>ebedciten i --n zasaxu</transcript>
          <definition> To treat or take care of the sick.</definition>
        </example>
        <example>
          <unicode>ᠨᠠᠰᠤᠲᠠᠢ ᠺᠦᠮᠦᠰ ᠢ ᠲᠠᠵᠢᠶᠠᠺᠦ ᠭᠠᠵᠠᠷ</unicode>
          <transcript>nasutai kymys i --ky γazar</transcript>
          <definition> Home for the aged</definition>
        </example>
      </examples>
    </entry_item>
