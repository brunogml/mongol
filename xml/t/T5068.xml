    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠳᠢᠶᠠᠨ</unicode>
      <uighur>diyan</uighur>
      <definition>An inn. Contemplation, meditation. Abstraction. Nameof the four great divisions: Heaven, Revelation, The region of Brahmas, The regions of Buddha.</definition>
      <page>1109</page>
      <examples>
        <example>
          <uighur>diyan aγulqu</uighur>
          <definition>To sit in fixed contemplation.</definition>
        </example>
        <example>
          <uighur>diyan-dur saγuqu</uighur>
          <definition>To sit in abstraction. To sit in abstracted contemplation (Buddh. priests)</definition>
        </example>
      </examples>
    </entry_item>
