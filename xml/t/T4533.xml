    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠺᠥᠰᠺᠠᠺᠥ</unicode>
      <uighur>tegüskekü</uighur>
      <cyrillic>төгсгөх</cyrillic>
      <transcript>TEGYSKE-</transcript>
      <definition>[v.caus. of tegys-] To conclude, finish, terminate, complete, perfect, fulfill; to decide in court</definition>
      <page>796</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠠᠯᠠᠭᠰᠠᠨ ᠬᠤᠭᠤᠴᠠᠭᠠᠨ ᠎ᠳᠠᠭᠠᠨ ᠲᠠᠺᠥᠰᠺᠠᠺᠥ</unicode>
          <transcript>amalaγsan xuγucaγan daγan --ky</transcript>
          <definition> To finish by the promised time</definition>
        </example>
        <example>
          <unicode>ᠠᠩᠬᠠᠳᠤᠭᠠᠷ ᠱᠠᠲᠤ ᠲᠠᠺᠥᠰᠺᠠᠺᠥ</unicode>
          <transcript>angxaduγar šatu --ky</transcript>
          <definition> To complete the initial step</definition>
        </example>
        <example>
          <unicode>ᠰᠤᠷᠭᠠᠭᠤᠯᠢ ᠲᠠᠺᠥᠰᠺᠠᠭᠴᠢ</unicode>
          <transcript>surγaγuli --gci</transcript>
          <definition> Graduating student, graduate</definition>
        </example>
        <example>
          <unicode>ᠰᠤᠷᠭᠠᠭᠤᠯᠢ ᠎ᠶᠢ ᠲᠠᠺᠥᠰᠺᠠᠺᠥ</unicode>
          <transcript>surγaγuli ji --ky</transcript>
          <definition> To graduate from school</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠯᠦᠪᠯᠡᠭᠡ ᠎ᠶᠢ ᠲᠠᠺᠥᠰᠺᠠᠺᠥ</unicode>
          <transcript>tølyblege ji --ky</transcript>
          <definition> To complete a plan, project</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
