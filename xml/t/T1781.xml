    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠳᠠᠯᠣ</unicode>
      <uighur>dalu</uighur>
      <cyrillic>дал</cyrillic>
      <transcript>DALU</transcript>
      <definition>n. Shoulder blade, scapula; scapula of a sheep used in scapulimancy.</definition>
      <page>226</page>
      <examples>
        <example>
          <unicode>ᠳᠠᠯᠣ ᠪᠠᠷᠢᠬᠤ</unicode>
          <transcript>-- barixu</transcript>
          <definition>To foretell the future by sticking the flat end of the shoulder blade of a sheep into the fire and interpreting the cracks thus produced according to certain rules.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠯᠣ ᠪᠡᠨ ᠬᠠᠪᠴᠢᠬᠤ</unicode>
          <transcript>-- ben xabcixu</transcript>
          <definition>To draw one's shoulder blades together ( as when stretching) one's body.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠯᠣ ᠎ᠶᠢᠨ ᠮᠥᠴᠢ</unicode>
          <transcript>-- jin møci</transcript>
          <definition>Joint of the shoulder blade.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠯᠣ ᠎ᠶᠢᠨ ᠲᠣᠯᠢ</unicode>
          <transcript>-- jin toli</transcript>
          <definition>Flat side of a shoulder blade.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠯᠣ ᠮᠥᠷᠡᠨ</unicode>
          <transcript>-- møren</transcript>
          <definition>‘Shoulder[s].</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠯᠣ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <transcript>-- talbixu</transcript>
          <definition>To divine or foretell the future with a shoulder blade.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠯᠣ ᠲᠥᠯᠭᠡ</unicode>
          <transcript>-- tølge</transcript>
          <definition>Scapulimancy, divination with the shoulder blades of a sheep.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠯᠣ ᠲᠥᠯᠭᠡᠳᠡᠺᠦ</unicode>
          <transcript>-- tølgedeky</transcript>
          <definition>To divine with the shoulder blade</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠯᠣ ᠲᠦᠯᠡᠺᠦ</unicode>
          <transcript>-- tyleky</transcript>
          <definition>To burn the shoulder blade for divination.</definition>
        </example>
      </examples>
    </entry_item>
