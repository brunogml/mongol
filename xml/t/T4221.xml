    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠵᠢᠶᠠᠪᠥᠷᠢ</unicode>
      <uighur>teǰiyebüri</uighur>
      <cyrillic>тэжээвэр</cyrillic>
      <transcript>TEZIJEBYRI</transcript>
      <definition>n. and adj. Rearing, feeding; domestic, tame (animal or bird); adopted, foster.</definition>
      <page>808</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠵᠢᠶᠠᠪᠥᠷᠢ ᠠᠮᠢᠲᠠᠨ</unicode>
          <transcript>-- amitan</transcript>
          <definition> Domestic animal.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠵᠢᠶᠠᠪᠥᠷᠢ ᠎ᠶᠢᠨ ᠮᠠᠯ</unicode>
          <transcript>-- jin mal</transcript>
          <definition> Domestic animal (usually a young or weak animal fed at home for a certain period without letting it out to pasture).</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠵᠢᠶᠠᠪᠥᠷᠢ ᠺᠦᠨᠡᠭᠦᠨ</unicode>
          <transcript>-- kybegyn</transcript>
          <definition> Foster son, adopted son.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠵᠢᠶᠠᠪᠥᠷᠢ ᠺᠦᠮᠦᠨ</unicode>
          <transcript>-- kymyn</transcript>
          <definition> A dependent.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠵᠢᠶᠠᠪᠥᠷᠢ ᠰᠢᠪᠠᠭᠤ</unicode>
          <transcript>-- sibaγu</transcript>
          <definition> Domestic fowl.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠵᠢᠶᠠᠪᠥᠷᠢ ᠦᠷ᠎ᠡ</unicode>
          <transcript>-- yr-e</transcript>
          <definition> Adopted child, foster child.</definition>
        </example>
      </examples>
    </entry_item>
