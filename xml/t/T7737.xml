    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠳᠣᠷᠣᠬᠰᠢ</unicode>
      <uighur>doruqsi</uighur>
      <cyrillic>дорогш</cyrillic>
      <transcript>DORUΓSI</transcript>
      <definition>[= doraγsi] adv. Downward, down; below, under, less than (with abl. ).</definition>
      <page>263</page>
      <examples>
        <example>
          <unicode>ᠳᠣᠷᠣᠬᠰᠢ ᠪᠠᠭᠤᠯᠭᠠᠬᠤ</unicode>
          <transcript>-- baγulγaxu</transcript>
          <definition> To make go down, bring down, haul down</definition>
        </example>
        <example>
          <unicode>ᠳᠣᠷᠣᠬᠰᠢ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>-- jabuxu</transcript>
          <definition> To go downward.</definition>
        </example>
        <example>
          <unicode>ᠳᠣᠷᠣᠬᠰᠢ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition> Not less, not less than.</definition>
        </example>
        <example>
          <unicode>ᠳᠣᠯᠤᠭ᠎ᠠ ᠨᠠᠶᠢᠮᠠ ᠤᠳᠠᠭ᠎ᠠ ᠡᠴᠡ ᠳᠣᠷᠣᠬᠰᠢ ᠦᠭᠡᠢ</unicode>
          <transcript>doluγ-a naima udaγ-a ece -- ygei</transcript>
          <definition> Not less than seven or eight tlmes.</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠨ ᠡᠴᠡ ᠳᠣᠷᠣᠬᠰᠢ</unicode>
          <transcript>egyn ece -- </transcript>
          <definition> Below this, less than this.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠶᠠᠷ ᠰᠠᠷᠠ ᠡᠴᠡ ᠳᠣᠷᠣᠬᠰᠢ ᠦᠭᠡᠢ</unicode>
          <transcript>xojar sara ece -- ygei</transcript>
          <definition> Not less than two months, at least two months.</definition>
        </example>
      </examples>
    </entry_item>
