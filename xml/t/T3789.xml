    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠳᠥᠶᠢᠺᠠᠨ</unicode>
      <uighur>tedüyiken</uighur>
      <cyrillic>төдийхөн - тэдүйхэн</cyrillic>
      <transcript>TEDYIKEN</transcript>
      <definition>adj. Such a little, so small, insignificant or mediocre.</definition>
      <page>792</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠳᠥᠶᠢᠺᠠᠨ ᠺᠡᠷᠡᠭ</unicode>
          <transcript>-- kereg</transcript>
          <definition> Such a trifle, trifling matter,</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠳᠥᠶᠢᠺᠠᠨ ᠺᠡᠷᠡᠭ ᠎ᠲᠤᠷ ᠶᠠᠭᠤᠨ ᠎ᠳᠤ ᠵᠣᠪᠠᠨ᠎ᠠ</unicode>
          <transcript>-- kereg tyr jaγun du zoban-a</transcript>
          <definition> Why worry about such a trifling matter?.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠳᠥᠶᠢᠺᠠᠨ ᠮᠥᠩᠭᠦ ᠪᠡᠷ ᠪᠢ ᠶᠠᠭᠠᠺᠢᠨ ᠠᠮᠢᠳᠤᠷᠠᠮᠤᠢ</unicode>
          <transcript>-- mønggy ber bi jaγakin amiduramui?</transcript>
          <definition> How can I live on so little money?.</definition>
        </example>
        <example>
          <unicode>ᠦᠭᠡ ᠎ᠶᠢᠨ ᠲᠠᠳᠥᠶᠢᠺᠠᠨ</unicode>
          <transcript>yge jin -- </transcript>
          <definition> Nothing but words; only in words.</definition>
        </example>
      </examples>
    </entry_item>
