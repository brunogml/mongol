    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠭ᠎ᠠ</unicode>
      <uighur>taγ-a</uighur>
      <cyrillic>таа</cyrillic>
      <transcript>TAΓ-A</transcript>
      <definition>n. Wish, will, pleasure (hon.).</definition>
      <page>763</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠭ᠎ᠠ ᠪᠡᠷ</unicode>
          <transcript>-- ber</transcript>
          <definition> At one‘s discretion; without haste, unhurriedly.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠭ᠎ᠠ ᠠᠵᠢᠯᠠᠬᠤ</unicode>
          <transcript>-- ber azillaxu</transcript>
          <definition> To work leisurely; to work at one's own discretion</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠭ᠎ᠠ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition> To dislike; to be disliked; to be disagreeable, inconvenient; to be indisposed, not to feel well.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠨ ᠤ ᠪᠡᠶ᠎ᠡ ᠲᠠᠭ᠎ᠠ ᠦᠭᠡᠢ ᠪᠠᠶᠢᠨ᠎ᠠ ᠣᠣ</unicode>
          <transcript>tan u bej-e -- ygei bain-a uu?</transcript>
          <definition> Are you not feeling well?.</definition>
        </example>
        <example>
          <unicode>ᠲᠠ ᠲᠠᠭ᠎ᠠ ᠪᠡᠷ ᠢᠶᠡᠨ ᠪᠣᠯ</unicode>
          <transcript>ta -- ber ijen bol!</transcript>
          <definition> Please do as you wish!. (hon.)</definition>
        </example>
        <example>
          <unicode>ᠲᠠ ᠲᠠᠭ᠎ᠠ ᠪᠡᠷ ᠢᠶᠡᠨ ᠵᠣᠭᠤᠭᠯᠠ</unicode>
          <transcript>[ta] -- ber ijen zoγuγla!</transcript>
          <definition> Please eat and drink whatever you like (inviting a guest to feel at home)</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠡ ᠨᠠᠳᠤᠷ ᠲᠠᠭ᠎ᠠ ᠦᠭᠡᠢ</unicode>
          <transcript>tere nadur -- ygei</transcript>
          <definition> He dislikes me.</definition>
        </example>
      </examples>
