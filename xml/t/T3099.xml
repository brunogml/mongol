    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠨᠢᠢᠺᠥ</unicode>
      <uighur>teniikü</uighur>
      <cyrillic>тэнийх</cyrillic>
      <transcript>TENII-</transcript>
      <definition>[= tenei-] v. i. To unbend, become straight, stretch, extend; to smoothen; to calm down; to become fine again (as weather).</definition>
      <page>804</page>
      <examples>
        <example>
          <unicode>ᠪᠠᠶᠠᠷ ᠤᠨ ᠮᠠᠩᠯᠠᠢ ᠢᠨᠤ ᠲᠠᠨᠢᠢᠪᠡ</unicode>
          <transcript>bajar un manglai inu --be</transcript>
          <definition> The wrinkles on the forehead have smoothed (lit: stretched) with joy.</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠳᠺᠢᠯ ᠲᠠᠨᠢᠢᠺᠥ</unicode>
          <transcript>sedkil --ky</transcript>
          <definition> To calm down, relax.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
