    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠭᠣᠯᠬᠣ</unicode>
      <uighur>taγulqu</uighur>
      <cyrillic>туулах</cyrillic>
      <transcript>TAΓUL-</transcript>
      <definition>1 [= toγul-, tuγul-] v. t. To pass; to surmount, overcome; go through, penetrate</definition>
      <page>766</page>
      <examples>
        <example>
          <unicode>ᠭᠣᠤᠯ ᠢ ᠲᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>γoul i --xu</transcript>
          <definition> To ford a river.</definition>
        </example>
        <example>
          <unicode>ᠤᠰᠤᠭᠠᠯ ᠢ ᠴᠤ ᠲᠠᠭᠣᠯᠰᠤᠭᠠᠢ ᠪᠢ</unicode>
          <transcript>usuγal i cu -- suγai bi!</transcript>
          <definition> I shall even go through fire and water!.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠪᠠᠯᠠᠩ ᠢ ᠲᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>zobalang i --xu</transcript>
          <definition> To go through suffering.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠪᠠᠯᠠᠩ ᠢ ᠲᠠᠭᠣᠯᠬᠣ ᠦᠭᠡᠢ ᠪᠣᠯᠪᠠᠰᠤ ᠺᠡᠷᠺᠢᠨ ᠵᠢᠷᠭᠠᠯᠠᠩ ᠢ ᠮᠡᠳᠡᠶ᠎ᠡ</unicode>
          <transcript>zobalang i --xu ygei bolbasu kerkin zirγalang i medej-e</transcript>
          <definition> If one does not suffer, how will he know what happiness is ?</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠪᠠᠯᠠᠩ ᠢ ᠲᠠᠭᠣᠯᠬᠣ ᠦᠭᠡᠢ ᠪᠣᠯᠪᠠᠰᠤ ᠺᠡᠷᠺᠢᠨ ᠵᠢᠷᠭᠠᠯᠠᠩ ᠢ ᠮᠡᠳᠡᠶ᠎ᠡ</unicode>
          <transcript>zobalang i --xu ygei bolbasu kerkin zirγalang i medej-e</transcript>
          <definition> If one does not suffer, how will he know what happiness is ?</definition>
        </example>
      </examples>
