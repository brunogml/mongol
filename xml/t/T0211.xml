    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠠᠩᠭᠠᠷᠢᠬ</unicode>
      <definition>serment, voeau: 2 sainteté: 3 prière, oraison: 4 sacrement</definition>
      <page>1565</page>
      <examples>
        <example>
          <unicode>ᠪᠠᠭᠰᠢ ᠎ᠶᠢᠨ ᠳᠠᠩᠭᠠᠷᠢᠬ ᠎ᠲᠤᠷ ᠣᠷᠤᠰᠢᠬᠤ</unicode>
          <definition>faire serment à son maître; 2 être initié aux mystères par son maître</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠩᠭᠠᠷᠢᠬ ᠢ ᠡᠪᠳᠡᠺᠦ</unicode>
          <definition>violer le serment</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠩᠭᠠᠷᠢᠬ ᠢ ᠡᠪᠳᠡᠭᠴᠢ</unicode>
          <definition>parjure</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠩᠭᠠᠷᠢᠬ ᠤᠨ ᠡᠳ</unicode>
          <definition>chose sacrée ou sainte</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠩᠭᠠᠷᠢᠬ ᠡᠴᠡᠭᠠᠨ ᠲᠠᠪᠠᠬᠤ</unicode>
          <definition>violer son serment</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠩᠭᠠᠷᠢᠬ ᠤᠨ ᠤᠰᠤᠨ</unicode>
          <definition>eau bénie</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠩᠭᠠᠷᠢᠬ ᠎ᠲᠤᠷ ᠣᠷᠤᠭᠤᠯᠬᠤ</unicode>
          <definition>faire prêter serment</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠩᠭᠠᠷᠢᠬ ᠢ ᠬᠠᠷᠰᠢᠯᠠᠬᠤ</unicode>
          <definition>violer serment</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠩᠭᠠᠷᠢᠬ ᠪᠠᠭᠤᠷᠠᠬᠤ</unicode>
          <definition>faux serment, parjure</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠩᠭᠠᠷᠢᠬ ᠤᠨ ᠰᠠᠪ</unicode>
          <definition>faux serment, parjure</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠩᠭᠠᠷᠢᠬ ᠢ ᠲᠥᠭᠦᠷᠭᠡᠺᠦ</unicode>
          <definition>accomplir le voeu</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠩᠭᠠᠷᠢᠬ ᠤᠨ ᠮᠦᢐᠷ᠎ᠠ = ᠳᠠᠩᠭᠠᠷᠢᠬ ᠤᠨ ᠲᠠᠮᠠᠭ᠎ᠠ</unicode>
          <definition>'sceau du  serment', loi suprême ou serment le plus sacré</definition>
        </example>
      </examples>
