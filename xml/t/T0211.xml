    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠩᠭᠠᠷᠢᠬ</unicode>
      <uighur>tangγariq</uighur>
      <cyrillic>тангараг - тангариг</cyrillic>
      <transcript>TANGΓARIΓ</transcript>
      <definition>n. Solemn promise, oath, vow, pledge.</definition>
      <page>776</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠩᠭᠠᠷᠢᠬ ᠳᠠᠪᠠᠬᠤ</unicode>
          <transcript>-- dabaxu</transcript>
          <definition> To violate an oath.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠩᠭᠠᠷᠢᠬ ᠡᠪᠳᠡᠺᠦ</unicode>
          <transcript>-- ebdeky</transcript>
          <definition> To break a solemn promise, violate an oath.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠩᠭᠠᠷᠢᠬ ᠺᠢᠺᠦ</unicode>
          <transcript>-- kiky</transcript>
          <definition> To take an oath, make a vow, pledge.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠩᠭᠠᠷᠢᠬ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <transcript>-- talbixu</transcript>
          <definition> To swear an oath.</definition>
        </example>
        <example>
          <unicode>ᠠᠮᠠᠨ ᠲᠠᠩᠭᠠᠷᠢᠬ ᠢᠶᠠᠨ ᠥᠭᠺᠦ</unicode>
          <transcript>aman -- ijen øgky</transcript>
          <definition> To give one's oath.</definition>
        </example>
      </examples>
    </entry_item>
