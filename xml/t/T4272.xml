      <dico>Lessing</dico>
      <unicode>ᠲᠠᠺᠠᠰᠢ</unicode>
      <uighur>tekesi</uighur>
      <cyrillic>тээш - тийш</cyrillic>
      <transcript>TEGESI</transcript>
      <definition>1 [= teisi, tesi] postpos. Towards, in the direction of; that way, thither</definition>
      <page>793</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠺᠠᠰᠢ ᠶᠠᠪᠤᠭᠰᠠᠨ</unicode>
          <transcript>-- jabuγsan </transcript>
