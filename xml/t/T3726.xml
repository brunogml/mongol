      <page>806</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠰᠪᠥᠷᠢ ᠶᠡᠺᠡᠲᠡᠢ</unicode>
          <transcript>-- jeketei </transcript>
          <definition> Having great patience, long-suffering.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠰᠪᠥᠷᠢ ᠮᠠᠭᠤᠲᠠᠢ</unicode>
          <transcript>-- maγutai</transcript>
