    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠯᠠᠥᠯᠠᠺᠥ</unicode>
      <uighur>teleülkü - teleülekü</uighur>
      <cyrillic>тэлүүлэх</cyrillic>
      <transcript>TELEYL[E]-</transcript>
      <definition>[cf. telegyl-, temegyl-] v.i. To try to pull or tear away, struggle oneself free; to strain or pull at a leash, chain, or reins; to strive hard towards a goal.</definition>
      <page>798</page>
      <examples>
        <example>
          <unicode>ᠶᠠᠪᠤᠬᠤ ᠭᠡᠵᠦ ᠲᠠᠯᠠᠥᠯᠠᠳᠡᠭ ᠮᠣᠷᠢ</unicode>
          <transcript>jabuxu gezy --deg mori</transcript>
          <definition> A horse that always tries to break loose.</definition>
        </example>
        <example>
          <unicode>ᠤᠶᠠᠭᠠᠲᠠᠢ ᠨᠣᠬᠠᠢ ᠲᠠᠯᠠᠥᠯᠠᠵᠦ ᠪᠠᠶᠢᠨ᠎ᠠ</unicode>
          <transcript>ujaγatai noxai --zy bain-a</transcript>
          <definition> The leashed dog is trying to break loose.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
