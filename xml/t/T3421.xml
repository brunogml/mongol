    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠪᠠᠺᠠᠷᠠᠺᠥ</unicode>
      <uighur>tebekerekü</uighur>
      <cyrillic>тэвээрэх</cyrillic>
      <transcript>TEBEGERE-</transcript>
      <definition>v. i. To become vigorous; to regain one's health or strength; to recuperate; to become well off; to become plentiful or abundant.</definition>
      <page>790</page>
      <examples>
        <example>
          <unicode>ᠡᠪᠡᠳᠴᠢᠲᠡᠢ ᠺᠦᠮᠦᠨ ᠲᠠᠪᠠᠺᠠᠷᠠᠵᠡᠢ</unicode>
          <transcript>ebedcitei kymyn --zei</transcript>
          <definition> The sick person has regained his strength.</definition>
        </example>
        <example>
          <unicode>ᠡᠪᠡᠰᠦ ᠲᠠᠪᠠᠺᠠᠷᠠᠺᠥ</unicode>
          <transcript>ebesy --ky</transcript>
          <definition> Grass becomes plentiful.</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠯ ᠲᠠᠪᠠᠺᠠᠷᠠᠵᠦ ᠰᠠᠶᠢᠨ ᠪᠠᠶᠢᠮᠤᠢ</unicode>
          <transcript>mal --zy sain baimui</transcript>
          <definition> The animals are becoming strong and healthy; it is good that the animals are regaining their strength.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠡ ᠠᠶᠢᠯ ᠲᠠᠪᠠᠺᠠᠷᠠᠵᠡᠢ</unicode>
          <transcript>tere ail --zeil </transcript>
          <definition>That family has become well off </definition>
        </example>
      </examples>
    </entry_item>
