    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠳᠥᠩᠰᠥᠶᠢᠺᠥ</unicode>
      <uighur>düngsüyikü</uighur>
      <cyrillic>дүнсийх</cyrillic>
      <transcript>DYNGSYI-</transcript>
      <definition>v.i. To be silent, maintain one's silence ( as from shame); to be morose, sulky, pensive, melancholic; to look askance.</definition>
      <page>281</page>
      <examples>
        <example>
          <unicode>ᠳᠥᠩᠰᠥᠶᠢᠨ</unicode>
          <transcript>--n</transcript>
          <definition> Silently, morosely.</definition>
        </example>
        <example>
          <unicode>ᠳᠥᠩᠰᠥᠶᠢᠵᠦ ᠰᠠᠭᠤᠬᠤ</unicode>
          <transcript>--zy saγuxu</transcript>
          <definition> To sit still and silently.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠦᠩᠰᠦᠶᠢᠺᠦ</unicode>
      <definition>se taire, garder le silence (de honte).</definition>
      <page>1903</page>
    </entry_item>
    <entry_item>
      <dico>Chinese</dico>
      <unicode>ᠳᠦᠩᠰᠦᠢᠬᠦ</unicode>
      <cyrillic>дүнсийх</cyrillic>
      <definition>〔动〕①（天气）变阴晦，变阴沉，变得阴翳不明；②（转）心情郁闷，无精打采，脸色阴沉下来，默然不语.</definition>
      <page>455</page>
