    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠺᠥᠺᠥ</unicode>
      <uighur>tegükü</uighur>
      <cyrillic>түүх</cyrillic>
      <transcript>TEGY-</transcript>
      <definition>v. t. To pick up scattered objects, collect, gather; to select.</definition>
      <page>794</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠺᠥᠭᠰᠡᠨ ᠦᠭᠡᠰ</unicode>
          <transcript>--gsen yges</transcript>
          <definition> Extracts, selected sayings.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠺᠥᠵᠦ ᠠᠪᠬᠤ</unicode>
          <transcript>--zy abxu</transcript>
          <definition> To pick up.</definition>
        </example>
        <example>
          <unicode>ᠴᠡᠴᠡᠭ ᠲᠠᠺᠥᠺᠦ</unicode>
          <transcript>ceceg --ky</transcript>
          <definition> To pick flowers.</definition>
        </example>
        <example>
          <unicode>ᠶᠡᠺᠡ ᠎ᠶᠢ ᠨᠢ ᠲᠠᠺᠥᠵᠦ ᠠᠪ</unicode>
          <transcript>jeke ji ni --zy ab!</transcript>
          <definition> Pick the big ones!.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠡᠺᠦᠺᠦ</unicode>
      <definition>cueillir par peu, ramasser qc qui serait tombé par terre (ramasser les cendres ou les os d'un mort pour les rapporter dans le lieu de sa sépulture); sarcler des herbes , arracher des herbes qu'on a choisies.</definition>
      <page>1757</page>
      <examples>
        <example>
          <unicode>ᠣᠯᠠᠨ ᠰᠤᠳᠤᠷ ᠡᠴᠡ ᠳᠡᠺᠦᠴᠤ ᠪᠢᠴᠢᠺᠦ</unicode>
          <definition>faire une compilation des plusieurs soutras</definition>
        </example>
        <example>
          <unicode>ᠬᠤᠸᠠᠩᠭᠡᠦ ᠪᠡᠶ᠎ᠡ ᠪᠡᠷ ᠢᠯᠮ᠎ᠠ ᠳᠡᠺᠦᠮᠦᠢ</unicode>
          <definition>l'impératrice elle-même s'occupe de la culture des vers à soie</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠴᠡᠩ ᠳᠡᠺᠦᠺᠦ</unicode>
          <definition>cueillir des fleurs</definition>
        </example>
        <example>
          <unicode>ᠳᠡᠺᠦᠭᠰᠡᠨ ᠦᠭᠡ</unicode>
          <definition>un extrait, sommaire, contenu, la teneur</definition>
        </example>
        <example>
          <unicode>ᠳᠦᠷᠦᠦ ᠳᠡᠺᠦᠺᠦ</unicode>
          <definition>glaner, ramasser les épis</definition>
        </example>
        <example>
          <unicode>ᠮᠣᠳᠤᠨ ᠳᠡᠺᠦᠺᠦ</unicode>
          <definition>ramasser le bois</definition>
        </example>
        <example>
          <unicode>ᠵᠢᠮᠢᠰ ᠳᠡᠺᠦᠺᠦ</unicode>
          <definition>ramasser les fruits</definition>
        </example>
      </examples>
    </entry_item>
