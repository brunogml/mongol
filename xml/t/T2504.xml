    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠶᠢᠯᠭ᠎ᠠ</unicode>
      <uighur>tayilγ-a</uighur>
      <cyrillic>тайлга</cyrillic>
      <transcript>TAILΓ-A</transcript>
      <definition>[cf. takily-a] n. Offering, sacrifice.</definition>
      <page>769</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠶᠢᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠪᠢᠴᠢᠭ</unicode>
          <transcript>-- jin bicig</transcript>
          <definition> Ritual text for sacrifices; a funeral oration or address which is read and burned in honor of the deceased.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠶᠢᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠺᠡᠷᠡᠭ</unicode>
          <transcript>--jin kereg</transcript>
          <definition> Ceremonial affairs (ritual, sacrifice, offering, etc.).</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠶᠢᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠣᠷᠤᠨ</unicode>
          <transcript>-- jin orun </transcript>
          <definition>A place of religious worship</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠶᠢᠯᠭ᠎ᠠ ᠲᠠᠺᠢᠬᠤ</unicode>
          <transcript>-- takixu </transcript>
          <definition>To make an offering</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠠᠶᠢᠯᠭ᠎ᠠ</unicode>
      <definition>offrande, sacrifice</definition>
      <page>1554</page>
      <examples>
        <example>
          <unicode>ᠳᠠᠶᠢᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠡᠵᠡᠨ</unicode>
          <definition>seigneur du sacrifice: lamas</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠯᠭ᠎ᠠ ᠎ᠶᠢ ᠢᠳᠡᠭᠴᠢ</unicode>
          <definition>celui qui se nourrit des offrandes: tngri</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠣᠷᠣᠨ</unicode>
          <definition>lieu du sacrifice: temple, pagode</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠪᠢᠴᠢᠭ</unicode>
          <definition>rituel des sacrifices</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠮᠠᠯ ᠳᠡᠵᠢᠭᠡᠺᠦ ᠠᠶᠢᠯ</unicode>
