        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠯᠭ᠎ᠠ ᠳᠠᠭᠢᠬᠤ</unicode>
          <definition>offrire les sacrifices</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠯᠭ᠎ᠠ ᠡᠴᠡ ᠲᠥᠷᠥᠭᠰᠡᠨ</unicode>
          <definition>celui qui est provenu du sacrifice: Viçnou; le génie du feu</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠳᠠᠶᠢᠰᠤᠨ</unicode>
          <definition>ennemi du sacrifice: Assoura</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠴᠠᠯᠮ᠎ᠠ ᠎ᠲᠤ</unicode>
          <definition>épithète du génie de l'eau</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠴᠢᠮᠡᠭ</unicode>
          <definition>ornement d'une offrande: herbe sacrée kuça</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠺᠡᠰᠢᠭᠦᠨ</unicode>
          <definition>une branche du sacrifice: figuier sauvage</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠺᠡᠷᠡᠭ ᠢ ᠲᠠᠭᠠᠭᠠᠭᠰᠠᠨ ᠪᠠᠯᠭᠠᠳ</unicode>
          <definition>commité dirigeant les sacrifices</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠺᠡᠷᠡᠭᠯᠡᠯ ᠲᠠᠷᠢᠶᠠᠯᠠᠩ</unicode>
          <definition>un terrain où l'on ensemence le blé qui doit être offert en sacrifice</definition>
        </example>
      </examples>
