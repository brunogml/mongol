    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠳᠠᠯᠳᠠᠯᠠᠬᠣ</unicode>
      <uighur>daldalaqu</uighur>
      <cyrillic>далдлах</cyrillic>
      <transcript>DALDALA-</transcript>
      <definition>[= daldal-] v.t. To hide, conceal; to cover, shelter, mask, veil, camouflage.</definition>
      <page>226</page>
      <examples>
        <example>
          <unicode>ᠳᠠᠯᠳᠠᠯᠠᠨ ᠨᠢᠭᠤᠬᠤ</unicode>
          <transcript>--n niγuxu</transcript>
          <definition> To hide, conceal, cover up; to mask, veil.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠮ ᠎ᠲᠦ ᠺᠡᠷᠡᠭ ᠢᠶᠡᠨ ᠳᠠᠯᠳᠠᠯᠠᠬᠤ</unicode>
          <transcript>gem ty kereg ijen --xu</transcript>
          <definition> To cover up one's fault, guilt, or crime.</definition>
        </example>
        <example>
          <unicode>ᠨᠠᠷᠠ ᠳᠠᠯᠳᠠᠯᠠᠬᠤ</unicode>
          <transcript>nara --xu</transcript>
          <definition> To obstruct the sun's light, shield from sunlight.</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠭᠤᠨ ᠳᠠᠯᠳᠠᠯᠠᠵᠤ</unicode>
          <transcript>niγun --zu</transcript>
          <definition> Secretly, illegally.</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠰᠢᠨ ᠤ ᠨᠡᠷᠡᠶᠢᠳᠦᠯ ᠢᠶᠡᠷ ᠳᠠᠯᠳᠠᠯᠠᠬᠤ</unicode>
          <transcript>šasin u nereidyl ijer --xu</transcript>
          <definition> To cover with the cloak of religion.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠯᠬᠠᠯᠠᠨ ᠳᠠᠯᠳᠠᠯᠠᠬᠤ</unicode>
          <transcript>xalxalan --xu</transcript>
          <definition> To cover, hide, mask.</definition>
        </example>
        <example>
          <unicode>ᠦᠭᠡ ᠳᠠᠯᠳᠠᠯᠠᠵᠤ ᠨᠢᠭᠤᠬᠤ</unicode>
          <transcript>yge --zu niγuxu</transcript>
          <definition> To hide the truth.</definition>
        </example>
      </examples>
    </entry_item>
