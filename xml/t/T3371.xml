    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠩᠺᠠᠷᠺᠥ</unicode>
      <uighur>tengkerkü - tengkerekü</uighur>
      <cyrillic>тэнхрэх</cyrillic>
      <transcript>TENGKER[E]-</transcript>
      <definition>[= tengkyr[e]-] v. i. To endure; to recover strength, health or consciousness; to be[come] enduring, hardy, robust.</definition>
      <page>803</page>
      <examples>
        <example>
          <unicode>ᠡᠪᠡᠳᠴᠢᠨ ᠡᠴᠡ ᠲᠠᠩᠺᠠᠷᠦᠭᠰᠡᠨ ᠦᠭᠡᠢ</unicode>
          <transcript>ebedcin ece --ygsen ygei</transcript>
          <definition> [He] did not recover from the illness.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠡ ᠪᠠᠰᠠ ᠲᠠᠩᠺᠠᠷᠦᠭᠡ ᠡᠳᠦᠢ</unicode>
          <transcript>tere basa --yge edyi</transcript>
          <definition> He has not yet recovered.</definition>
        </example>
      </examples>
