      <dico>Lessing</dico>
      <unicode>ᠲᠠᠷᠴᠢᠯᠠᠬᠣ</unicode>
      <uighur>tarčilaqu</uighur>
      <cyrillic>тарчлах</cyrillic>
      <transcript>TARCILA-</transcript>
      <definition>[= tercile-, = darcila-] v. i. To suffer, be tormented; to squirm or toss from side to side; to stagger, waver</definition>
      <page>780</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠢ ᠲᠠᠷᠴᠢᠯᠠᠬᠣ</unicode>
          <transcript>ami --xu</transcript>
          <definition> To be in agony of death</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠷᠪᠠᠯᠵᠠᠨ ᠲᠠᠷᠴᠢᠯᠠᠬᠣ</unicode>
          <transcript>sarbalzan --xu</transcript>
          <definition> To writhe in agony.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
