    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠯᠪᠢᠭᠤ ~ ᠲᠠᠯᠪᠢᠭᠤᠨ</unicode>
      <uighur>talbiγu - talbiγun</uighur>
      <cyrillic>талвиу</cyrillic>
      <transcript>TALBIΓU(N)</transcript>
      <definition>adj. Bread, wide. vast. gentle; calm</definition>
      <page>773</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠯᠪᠢᠭᠤ ᠭᠠᠵᠠᠷ</unicode>
          <transcript>-- γazar</transcript>
          <definition> Open field, piain; vast plain; gently sloping terrain.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠯᠪᠢᠭᠤ ᠰᠠᠶᠢᠬᠠᠨ</unicode>
          <transcript>-- saixan</transcript>
          <definition> Nice and spacious, nice and quiet.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠯᠪᠢᠭᠤ ᠤᠷᠤᠰᠬᠤ</unicode>
          <transcript>-- urusxu</transcript>
          <definition> To flow gently.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠯᠪᠢᠭᠤ ᠵᠠᠩ ᠎ᠲᠠᠢ ᠺᠦᠮᠦᠨ</unicode>
          <transcript>-- zang tai kymyn</transcript>
          <definition> Calm person.</definition>
        </example>
        <example>
          <unicode>ᠠᠭᠤᠤ ᠲᠠᠯᠪᠢᠭᠤ</unicode>
          <transcript>aγuu -- </transcript>
          <definition>Vast and wide</definition>
        </example>
        <example>
          <unicode>ᠨᠠᠶᠢᠷ ᠲᠠᠯᠪᠢᠭᠤ</unicode>
          <transcript>nair -- </transcript>
          <definition> Concord, agreement</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
