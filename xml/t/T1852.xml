    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠲᠠᠯᠪᠢᠭᠣ</unicode>
      <uighur>talbiγu</uighur>
      <definition>adj. Loose, slack. Gentle, mild, yielding. Giving way, compliant. Reposing leisurely.</definition>
      <page>916</page>
