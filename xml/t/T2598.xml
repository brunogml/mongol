      <dico>Lessing</dico>
      <unicode>ᠲᠠᠷᠠᠭᠣᠣ</unicode>
      <uighur>tarγou</uighur>
      <cyrillic>таруу</cyrillic>
      <transcript>TARAΓUU</transcript>
      <definition>adj. and adv. Scattered, dispersed; sparse[ly].</definition>
      <page>779</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠷᠠᠭᠣᠣ ᠮᠣᠳᠤ</unicode>
          <transcript>-- modu</transcript>
          <definition> Thin forest, scattered trees.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠷᠠᠭᠣᠣ ᠨᠢᠭᠡᠨ ᠺᠡᠳᠦᠨ ᠠᠶᠢᠯ ᠪᠠᠶᠢᠨ᠎ᠠ</unicode>
          <transcript>-- nigen kedyn ail bain-a</transcript>
          <definition> There are a few scattered families.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠷᠠᠭᠣᠣ ᠰᠠᠭᠤᠬᠤ</unicode>
          <transcript>-- saγuxu</transcript>
          <definition> To live or sit scattered about.</definition>
        </example>
      </examples>
