      <examples>
        <example>
          <unicode>ᠡᠪᠡᠴᠢᠨ ᠡᠴᠡ ᠳᠤᠨᠢᠯᠬᠤ</unicode>
          <definition>se délivrer d'une maladie, guérir</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠶᠢᠨ ᠺᠦ ᠳᠤᠨᠢᠯᠬᠤ</unicode>
          <definition>se délivrer entièrement, s'émanciper totalement</definition>
        </example>
        <example>
          <unicode>ᠳᠤᠨᠢᠯᠬᠤᠢ ᠮᠥᠷ</unicode>
          <definition>voie de l'émancipation, du salut</definition>
        </example>
        <example>
          <unicode>ᠳᠤᠨᠢᠯᠬᠤᠢ ᠮᠥᠷ ᠎ᠲᠤᠷ ᠤᠷᠤᠭᠤᠯᠬᠤ</unicode>
          <definition>mettre qn dans la voie de l'émancipation</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠭᠠᠵᠠ ᠡᠴᠡ ᠳᠤᠨᠢᠯᠬᠤ</unicode>
          <definition>se délivrer du suppllice</definition>
        </example>
        <example>
          <unicode>ᠴᠢ ᠥᠪᠡᠷ ᠤᠨ ᠭᠤᠯᠤᠮᠲᠠ ᠡᠴᠡ ᠳᠤᠨᠢᠯᠪᠠᠰᠤ ᠭᠡᠷ ᠪᠣᠯᠬᠤ</unicode>
          <definition>qu'arrivera-t-il quand tu quitteras la maison?</definition>
        </example>
      </examples>
