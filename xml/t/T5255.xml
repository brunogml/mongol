    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠣᠨᠢᠯᠬᠣ</unicode>
      <uighur>tonilqu</uighur>
      <cyrillic>тонилох</cyrillic>
      <transcript>TONIL-</transcript>
      <definition>v.i. To be saved, delivered, rescued; to escape (as from sufferings); to get out, go away, scram (coll. ).</definition>
      <page>825</page>
      <examples>
        <example>
          <unicode>ᠲᠣᠨᠢᠯᠬᠣᠢ ᠮᠥᠷ</unicode>
          <transcript>--xui mør</transcript>
          <definition> The way of salvation.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠨᠢᠯᠵᠤ ᠪᠤᠯᠲᠠᠬᠤ</unicode>
          <transcript>--zu bultaxu</transcript>
          <definition> To escape from, avoid.</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠭᠠᠵᠠ ᠡᠴᠡ ᠲᠣᠨᠢᠯᠬᠣ</unicode>
          <transcript>caγaza ece --xu</transcript>
          <definition> To be saved from capital punishment.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠤᠨᠢᠯᠬᠤ</unicode>
      <definition>être émancipé, sauvé, se délivrer.</definition>
