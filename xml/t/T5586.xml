      <dico>Lessing</dico>
      <unicode>ᠲᠣᠭᠠᠭᠠᠬᠣ</unicode>
      <uighur>toγaγaqu</uighur>
      <cyrillic>тоох</cyrillic>
      <transcript>TOΓAΓA-</transcript>
      <definition>[= toγa-] v.t. To esteem; to value.</definition>
      <page>814</page>
      <examples>
        <example>
          <unicode>ᠲᠣᠭᠠᠭᠠᠬᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>--xu ygei</transcript>
          <definition> To disregard; to belittle.</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠪᠡᠨ ᠲᠣᠭᠠᠭᠠᠬᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>bej-e ben -- ygei</transcript>
          <definition> To belittle oneself.</definition>
        </example>
        <example>
          <unicode>ᠪᠢᠰᠢᠷᠡᠵᠦ ᠲᠣᠭᠠᠭᠠᠬᠣ</unicode>
          <transcript>bisirezy --xu</transcript>
          <definition> To esteem highly.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠡ ᠺᠡᠨ ᠢ ᠴᠦ ᠦᠯᠦ ᠲᠣᠭᠠᠭᠠᠮᠤᠢ</unicode>
          <transcript>tere ken i cy yly --mui</transcript>
          <definition> He has no esteem for anyone.</definition>
        </example>
      </examples>
