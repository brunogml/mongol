      <dico>Lessing</dico>
      <unicode>ᠳᠥᠩᠺᠠᠺᠥ</unicode>
      <uighur>dönggekü</uighur>
      <cyrillic>дөнгөх</cyrillic>
      <transcript>DØNGGE-</transcript>
      <definition>v.i. To be barely able to do something; to barely manage; to do something poorly or carelessly.</definition>
      <page>268</page>
      <examples>
        <example>
          <unicode>ᠳᠥᠩᠺᠠᠵᠦ</unicode>
          <transcript>--zy</transcript>
          <definition> Barely, hardly, scarcely, somehow.</definition>
        </example>
        <example>
          <unicode>ᠳᠥᠩᠺᠠᠵᠦ ᠠᠮᠢᠳᠤᠷᠠᠬᠤ</unicode>
          <transcript>--zy amiduraxu</transcript>
          <definition> To barely manage to exist</definition>
        </example>
      </examples>
    </entry_item>
