    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠥᠢᠳᠺᠥ</unicode>
      <uighur>düidkü</uighur>
      <cyrillic>түйдэх - түйтэх</cyrillic>
      <transcript>TYID-</transcript>
      <definition>v.t. and i. To hinder, obstruct, hold back, to be hindered, held back.</definition>
      <page>279</page>
      <examples>
        <example>
          <unicode>ᠲᠥᠢᠳᠴᠦ ᠰᠠGAᢎ ᠻIᠻÜ</unicode>
          <transcript>--cy saγad kiky</transcript>
          <definition> To throw obstacles in a person's way.</definition>
        </example>
        <example>
          <unicode>ᠮᠤᠩᠬᠠᠭ᠎ᠠ ᠲᠥᠢᠳᠺᠦ</unicode>
          <transcript>mungxaγ-a --ky</transcript>
          <definition> To be blinded by ignorance.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠶᠢᠨ ᠶᠠᠪᠤᠳᠠᠯ ᠢ ᠲᠥᠢᠳᠺᠦ</unicode>
          <transcript>sain jabudal i --ky</transcript>
          <definition> To obstruct a good deed or act.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠦᠢᠳᠺᠦ</unicode>
      <definition>être arrêté, retenu: 2 être restreint: 3 être obscurci, ébloui; s'obscurcir, ternir, s'éclipser</definition>
      <page>1900</page>
      <examples>
        <example>
          <unicode>ᠰᠠᠷᠠ ᠳᠦᠢᠳᠳᠠᠪᠠ</unicode>
