    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠪᠣᠨᠠᠩ</unicode>
      <uighur>tabunang</uighur>
      <cyrillic>тавнан</cyrillic>
      <transcript>TABUNANG</transcript>
      <definition>n. Son-in-law of an emperor, prince, or nobleman</definition>
      <page>761</page>
      <examples>
        <example>
          <unicode>ᠲᠥᠷᠦ ᠎ᠶᠢᠨ ᠲᠠᠪᠣᠨᠠᠩ</unicode>
          <transcript>tøry jin -- </transcript>
          <definition> Son-in-law of a prince of second or third order</definition>
        </example>
        <example>
          <unicode>ᠤᠯᠤᠰ ᠤᠨ ᠲᠠᠪᠣᠨᠠᠩ</unicode>
          <transcript>ulus un -- </transcript>
          <definition> Son-in-law of the emperor.</definition>
        </example>
        <example>
          <unicode>xᠣᠰᠢᠭᠤᠨ ᠤ ᠲᠠᠪᠣᠨᠠᠩ</unicode>
          <transcript>xosiγun u -- </transcript>
          <definition> Son-in-law of a prince of fourth order.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠱᠤᠢ ᠲᠠᠪᠣᠨᠠᠩ</unicode>
          <transcript>xošui -- </transcript>
          <definition> Son-in-law of a prince of first order.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠠᠪᠤᠨᠠᠩ</unicode>
      <definition>le gendre, mari de la fille d'un régulo, d'un comte, mari d'une fille de l'empereur</definition>
      <page>1601</page>
      <examples>
        <example>
          <unicode>ᠤᠯᠤᠰ ᠤᠨ ᠳᠠᠪᠤᠨᠠᠩ</unicode>
          <definition>gendre de l'empereur chinois</definition>
        </example>
        <example>
          <unicode>ᠬᠤᠰᠢᠭᠤᠨ ᠤ ᠳᠠᠪᠤᠨᠠᠩ</unicode>
          <definition>gendre du prince de quatrième ordre</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠱᠣᠢ ᠳᠠᠪᠤᠨᠠᠩ</unicode>
          <definition>gendre d'un régulo, ou d'un des parents de l'empereur chinois</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠷᠦ ᠎ᠶᠢᠨ ᠳᠠᠪᠤᠨᠠᠩ</unicode>
          <definition>gendre d'un régulo du second et troisième ordre</definition>
        </example>
      </examples>
    </entry_item>
