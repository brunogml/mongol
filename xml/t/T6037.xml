    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠣᠭᠣᠷᠴᠠᠬ</unicode>
      <uighur>toγurčaq</uighur>
      <cyrillic>тоорцог</cyrillic>
      <transcript>TOΓURCAΓ</transcript>
      <definition>[= toγurcuγ] n. Bud or calyx of a flower; hair tied together on the top of the head, coiffure; cone of a coniferous tree; the button on top of a small cone-shaped hat; small cap with a button on top.</definition>
      <page>817</page>
      <examples>
        <example>
          <unicode>ᠲᠣᠭᠣᠷᠴᠠᠬ ᠺᠡᠩᠭᠡᠷᠭᠡ</unicode>
          <transcript>-- kenggerge</transcript>
          <definition> A large drum (Ch. to-lo-ku)</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠭᠣᠷᠴᠠᠬ ᠮᠠᠯᠠᠭᠠᠢ</unicode>
          <transcript>-- malaγai</transcript>
          <definition> A cap with a button on top.</definition>
        </example>
        <example>
          <unicode>ᠯᠢᠩᠬᠤ᠎ᠠ ᠎ᠶᠢᠨ ᠲᠣᠭᠣᠷᠴᠠᠬ</unicode>
          <transcript>lingxu-a jin -- </transcript>
          <definition> Lotus bud,</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠤᠭᠤᠷᠴᠠᠬ ~ ᠳᠤᠭᠣᠷᠴᠤᠬ</unicode>
      <definition>le coeur de la fleur, le calice de la fleur: 2 fleurs odoriférantes de l'arbre mimusops elengi , dont on orne la tête: 3 cheveux liés ensemble sur le sommet de la tète : 4 coiffure.</definition>
      <page>1817</page>
      <examples>
        <example>
          <unicode>ᠳᠤᠭᠤᠷᠴᠠᠬ ᠮᠠᠯᠠᠭᠠᠢ</unicode>
          <definition>bonnet de peau qu in'a point de bord</definition>
        </example>
        <example>
          <unicode>ᠳᠤᠭᠤᠷᠴᠠᠬ ᠭᠡᠩᠭᠡᠷᠭᠡ</unicode>
          <definition>un grand tambour, large tambour</definition>
        </example>
        <example>
          <unicode>ᠳᠤᠭᠤᠷᠴᠠᠬ ᠢᠶᠠᠷ ᠭᠡᠷᠦᠯᠳᠡᠭᠴᠢ</unicode>
          <definition>arbre mangifera</definition>
        </example>
        <example>
          <unicode>ᠯᠢᠩᠬᠤ᠎ᠠ ᠎ᠶᠢᠨ ᠳᠤᠭᠤᠷᠴᠠᠬ</unicode>
          <definition>le coeur de la fleur langkoa</definition>
        </example>
      </examples>
    </entry_item>
