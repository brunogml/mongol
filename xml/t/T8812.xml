      <dico>Lessing</dico>
      <unicode>ᠲᠥᠯᠺᠠ</unicode>
      <uighur>tölke</uighur>
      <cyrillic>төлөг</cyrillic>
      <transcript>TØLGE</transcript>
      <definition>n. Fortune-telling, divination; also a device used for divination; omen, portent.</definition>
      <page>833</page>
      <examples>
        <example>
          <unicode>ᠲᠥᠯᠺᠠ ᠪᠠᠷᠢᠬᠤ</unicode>
          <transcript>-- barixu </transcript>
          <definition>To practice divination</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠯᠺᠠ ᠭᠤᠶᠤᠬᠤ</unicode>
          <transcript>-- γujuxu</transcript>
          <definition> To consult an oracle.</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠯᠺᠠ ᠰᠢᠨᠵᠢᠺᠦ</unicode>
          <transcript>-- sinziky</transcript>
          <definition> To examine the portents divine</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠯᠺᠠ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <transcript>-- talbixu</transcript>
          <definition> To practice fortunetelling.</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠯᠺᠠ ᠦᠵᠡᠺᠦ</unicode>
          <transcript>-- yzeky</transcript>
          <definition> To divine, draw lots, tell fortunes, consult a book of divination</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠭᠤ ᠲᠥᠯᠺᠠ</unicode>
          <transcript>maγu -- </transcript>
          <definition> Bad portent (obtained through divination)</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠶᠢᠨ ᠲᠥᠯᠺᠠ ᠭᠠᠪᠤᠬᠤ</unicode>
          <transcript>sain -- baγuxu</transcript>
          <definition> A good portent appears.</definition>
        </example>
      </examples>
    </entry_item>
