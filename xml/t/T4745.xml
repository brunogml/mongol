    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠡᠶᠢᠯᠡᠺᠦ</unicode>
      <definition>avoir plus de force; surpasser, remporter la victoire sur l'ennemi, vaincre: 2 gagner au jeu</definition>
      <page>1686</page>
      <examples>
        <example>
          <unicode>ᠳᠡᠶᠢᠯᠦᠭᠰᠡᠨ ᠪᠣᠯᠪᠠᠰᠤ ᠮᠥᠨ ᠺᠢᠷᠢ ᠳ᠋‍‍ᠤ‍ᠷ ᠨᠢᠭᠡᠨ ᠠᠩᠲᠠᠢ ᠳᠤᠷᠭ᠎ᠠ ᠱᠠᠩᠨᠠ</unicode>
          <definition>chacun qui remportera la victoire sur son adversaire sera récompensé d'une pièce d'étoffe</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠷᠭᠤ ᠳᠡᠶᠢᠯᠡᠺᠦ</unicode>
          <definition>gagner son procès</definition>
        </example>
      </examples>
