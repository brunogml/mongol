    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠲᠥᠺᠳᠥᠶᠢᠺᠥ</unicode>
      <uighur>tükdüyikü</uighur>
      <definition>To get bulged out. To be lifted up (e.g. piecces of ice over stones in a river). The sprouts pushing up the earth. Piling itself up. Towering up.</definition>
      <page>1029</page>
      <examples>
        <example>
          <uighur>tükdüyiǰü köldükü</uighur>
          <definition>To freeze together one piece of ice on the top of another.</definition>
        </example>
      </examples>
    </entry_item>
