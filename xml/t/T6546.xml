  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠣᠰᠬᠠᠬᠣ</unicode>
      <uighur>tusqaqu</uighur>
      <cyrillic>тусгах - тусаах</cyrillic>
      <transcript>TUSXA-</transcript>
      <definition>[v. caus. of tus-] To cause to hit the mark; to cause to aim, direct; to assess, allot, fix (as dues, shares, etc.).</definition>
      <page>846</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠪᠠ ᠲᠣᠰᠬᠠᠬᠣ</unicode>
          <transcript>alba --xu</transcript>
          <definition> To assess taxes or duties.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠮᠦᠨ ᠪᠦᠷᠢ ᠳ᠋‍‍ᠤ‍ᠷ ᠨᠢᠵᠡᠭᠡᠳ ᠲᠣᠰᠬᠠᠬᠣ</unicode>
          <transcript>kymyn byri dyr nizeged --xu</transcript>
          <definition> To distribute one to everybody.</definition>
        </example>
        <example>
          <unicode>ᠰᠤᠮᠤᠨ ᠢ ᠲᠣᠰᠬᠠᠬᠣ</unicode>
          <transcript>sumun i --xu</transcript>
          <definition> To shoot the arrow into the target.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠷᠢᠯᠭ᠎ᠠ ᠲᠣᠰᠬᠠᠬᠣ</unicode>
          <transcript>zorilγ-a --xu</transcript>
          <definition> To direct one's thoughts toward an object.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠤᠰᠬᠠᠬᠤ</unicode>
      <definition>faire atteindre le but, ordonner de viser; diriger le canon; 2 métaph, diriger ses pensées: 3 partager qc. parmi plusieurs; répartir; rendre à chacun ce qui lui est dû</definition>
      <page>1831</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠪᠠ ᠳᠤᠰᠬᠠᠬᠤ</unicode>
          <definition>charger d'impôts</definition>
        </example>
        <example>
          <unicode>ᠪᠦᠯᠦᠭ ᠳ᠋‍‍ᠤ‍ᠷ ᠳᠤᠰᠬᠠᠬᠤ</unicode>
          <definition>viser, mirer</definition>
        </example>
        <example>
          <unicode>ᠰᠤᠮᠤᠨ ᠢ ᠳᠤᠰᠬᠠᠬᠤ</unicode>
          <definition>lancer la flèche dans la cible</definition>
        </example>
        <example>
          <unicode>ᠮᠡᠰᠡ ᠳᠤᠰᠬᠠᠬᠤ</unicode>
          <definition>percer du glaive, assassiner avec un glaive</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠷᠢᠯᠭ᠎ᠠ ᠳᠤᠰᠬᠠᠬᠤ</unicode>
          <definition>diriger ses pensées vers l'objet</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
