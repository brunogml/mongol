    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠲᠣᠰᠬᠠᠬᠣ</unicode>
      <uighur>tusqaqu</uighur>
      <definition>v.t. To cause to hit by a gun or cannon. To cause to come to hand. To apportion duties. To appoint.</definition>
      <page>1017</page>
      <examples>
        <example>
          <uighur>tusqaqu kerebči</uighur>
          <definition>n. A searchlight.</definition>
        </example>
