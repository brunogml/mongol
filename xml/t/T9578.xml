    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠥᠷᠺᠢᠺᠥ</unicode>
      <uighur>türkikü</uighur>
      <cyrillic>түрхэх</cyrillic>
      <transcript>TYRKI-</transcript>
      <definition>v.t. To smear, annoint, put on, apply ( as cosmetics); to rub on.</definition>
      <page>855</page>
      <examples>
        <example>
          <unicode>ᠲᠥᠷᠺᠢᠺᠥ ᠡᠮ</unicode>
          <transcript>--ky em</transcript>
          <definition> Ointment, unguent, liniment, salve.</definition>
        </example>
        <example>
          <unicode>ᠣᠤ᠎ᠠ ᠲᠥᠷᠺᠢᠺᠥ</unicode>
          <transcript>ou-a --ky</transcript>
          <definition> To apply facial powder.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠰᠤ ᠲᠥᠷᠺᠢᠺᠥ</unicode>
          <transcript>tosu --ky</transcript>
          <definition> To apply oil or cream; to put butter on.</definition>
        </example>
      </examples>
    </entry_item>
