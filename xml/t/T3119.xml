      <dico>Lessing</dico>
      <unicode>ᠲᠠᠨᠥᠺᠥ</unicode>
      <uighur>tenükü</uighur>
      <cyrillic>тэнэх</cyrillic>
      <transcript>TENY-</transcript>
      <definition>v.i. To roam, rove, wander aimlessly, go astray; to be confused; to be at a loss; to lose one's mind.</definition>
      <page>804</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠨᠥᠭᠰᠡᠨ ᠮᠤᠩᠬᠠᠬ ᠠᠮᠢᠲᠠᠨ</unicode>
