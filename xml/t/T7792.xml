    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠳᠣᠷᠣᠶᠢᠲᠠᠬᠣ</unicode>
      <uighur>doruyidaqu</uighur>
      <cyrillic>доройтох</cyrillic>
      <transcript>DORUITA-</transcript>
      <definition>v.i. To become weak or worse, decay, degenerate, be degraded; to fall into misery or poverty, be mined.</definition>
      <page>263</page>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠤᠷᠣᠶᠢᠳᠠᠬᠤ</unicode>
      <definition>s'affaiblir, s'abaisser, baisser: 2 être vaincu, surmonté, perdre la bataille: 3 devenir pauvre, se ruiner de fond en comble</definition>
      <page>1886</page>
      <examples>
