    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠷᠮᠣᠬᠣ</unicode>
      <uighur>tarmoqu</uighur>
      <cyrillic>тармах</cyrillic>
      <transcript>TARMU-</transcript>
      <definition>v. t. To rake (as hay); to take a bit here and a bit there; to know something partially.</definition>
      <page>781</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠷᠮᠣᠬᠣ ᠎ᠶᠢᠨ ᠲᠡᠳᠦᠢ ᠮᠡᠳᠡᠮᠦᠢ</unicode>
          <transcript>--xu jin tedyi medemyi</transcript>
          <definition> [He] only knows a few points here and there: [he] knows only superficially</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠷᠮᠣᠵᠤ ᠢᠳᠡᠺᠦ</unicode>
          <transcript>--zu ideky</transcript>
          <definition> To nibble here and there (as an animal)</definition>
        </example>
        <example>
          <unicode>ᠣᠯᠠᠨ ᠶᠠᠭᠤᠮ᠎ᠠ ᠎ᠶᠢ ᠲᠠᠷᠮᠣᠬᠣ</unicode>
          <transcript>olan jaγm-a ji --xu </transcript>
          <definition>To start many things at the same time</definition>
        </example>
      </examples>
