    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠥᠺᠡᠷᠢᠺᠥ</unicode>
      <uighur>tökerikü</uighur>
      <cyrillic>төөрөх</cyrillic>
      <transcript>TØGERI-</transcript>
      <definition>v. i. To be lost, miss one's way; to fall into disorder, be at a loss; to be confused, be mistaken; to wander astray</definition>
      <page>832</page>
      <examples>
        <example>
          <unicode>ᠲᠥᠺᠡᠷᠢᠵᠦ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>--zy jabuxu</transcript>
          <definition> To wander about.</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠨᠤ ᠤᠬᠠᠭᠠᠨ ᠲᠥᠺᠡᠷᠢᠭᠰᠡᠨ ᠪᠤᠶᠤᠵ᠎ᠠ</unicode>
          <transcript>cinu uxaγan --gsen buju-z-a</transcript>
          <definition> You must have lost your mind</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠳᠺᠢᠯ ᠲᠥᠺᠡᠷᠢᠺᠥ</unicode>
          <transcript>sedkil -- </transcript>
          <definition> To lose one's memory; to wander (as the mind); to become distracted.</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠮ ᠲᠥᠺᠡᠷᠢᠺᠥ</unicode>
          <transcript>zam --ky</transcript>
          <definition> To lose one's way, one's bearings.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠦᠺᠡᠷᠢᠺᠦ</unicode>
      <definition>errer çà et là, rôder.</definition>
      <page>1929</page>
      <examples>
        <example>
          <unicode>ᠨᠢᠳᠦᠨ ᠦᠭᠡᠢ ᠬᠠᠷᠠᠩᠭᠤᠢ ᠳ᠋‍‍ᠤ‍ᠷ ᠳᠦᠺᠡᠷᠢᠺᠦ</unicode>
          <definition>errer dans les ténèbres</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠰᠤ ᠤᠯᠤᠰ ᠎ᠲᠤᠷ ᠳᠦᠺᠡᠷᠢᠵᠦ ᠣᠳᠬᠤ</unicode>
          <definition>errer dans un pays étranger</definition>
        </example>
        <example>
          <unicode>ᠪᠯᠠᠮ᠎ᠠ ᠨᠣᠬᠠᠢ ᠮᠡᠲᠦ ᠳᠦᠺᠡᠷᠢᠮᠦ</unicode>
          <definition>le lama rôde ça et là comme un chien</definition>
        </example>
        <example>
          <unicode>ᠳᠦᠺᠡᠷᠢᠺᠦᠢ ᠣᠷᠣᠨ</unicode>
          <definition>désert</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠨᠤ ᠤᠬᠠᠭᠠᠨ ᠳᠦᠺᠡᠷᠢᠭᠰᠡᠨ ᠪᠤᠶᠤ ᠎ᠶ᠎ᠡ</unicode>
          <definition>n'as tu pas perdu ta raison?</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
