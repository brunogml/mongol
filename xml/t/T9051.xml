    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠥᠺᠥᠺᠡᠢ</unicode>
      <uighur>tükükei</uighur>
      <cyrillic>түүхий</cyrillic>
      <transcript>TYGYKEI</transcript>
      <definition>adj. and n. Raw, uncooked; not ripe; immature; unworked; crude; untrained, unskilled, inexperienced; eczema, impetigo.</definition>
      <page>850</page>
      <examples>
        <example>
          <unicode>ᠲᠥᠺᠥᠺᠡᠢ ᠠᠷᠪᠠᠢ</unicode>
          <transcript>-- arbai</transcript>
          <definition> Unroasted barley.</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠺᠥᠺᠡᠢ ᠡᠳ</unicode>
          <transcript>-- ed</transcript>
          <definition> Raw materials.</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠺᠥᠺᠡᠢ ᠢᠳᠡᠭᠡᠨ</unicode>
          <transcript>-- idegen</transcript>
          <definition> Uncooked food.</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠺᠥᠺᠡᠢ ᠶᠠᠪᠤᠳᠠᠯ</unicode>
          <transcript>-- jabudal</transcript>
          <definition> Untried or unfamiliar matter.</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠺᠥᠺᠡᠢ ᠮᠢᠬ᠎ᠠ</unicode>
          <transcript>-- mix-a</transcript>
          <definition> Raw meat; proud flesh.</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠺᠥᠺᠡᠢ ᠰᠦᠨ</unicode>
          <transcript>-- syn</transcript>
          <definition> Fresh or unboiled milk.</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠺᠥᠺᠡᠢ ᠲᠦᠷᠭᠡᠨ</unicode>
          <transcript>-- tyrgen</transcript>
          <definition> Hasty and imperfect.</definition>
        </example>
      </examples>
    </entry_item>
