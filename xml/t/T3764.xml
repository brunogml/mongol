      <dico>Lessing</dico>
      <unicode>ᠲᠠᠳᠠᠨᠠᠶᠢᠺᠢ</unicode>
      <uighur>tedeneyiki</uighur>
      <cyrillic>тэднийх</cyrillic>
      <transcript>TEDENEIKI</transcript>
      <definition>[= teden y ki] poss.pron. Theirs; something belonging to them, their house, their people, etc</definition>
      <page>791</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠳᠠᠨᠠᠶᠢᠺᠢ  ᠮᠣᠷᠢ ᠪᠡᠨ ᠪᠠᠷᠢᠭᠠᠳ ᠢᠷᠡᠴᠢᠵᠡᠢ</unicode>
          <transcript>-- mori ben bariγad irecizei</transcript>
          <definition> They (their people) have brought their horse[s]</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠡ ᠮᠣᠷᠢ ᠮᠠᠨᠠᠶᠢᠺᠢ ᠪᠢᠪᠢ ᠲᠠᠳᠠᠨᠠᠶᠢᠺᠢ</unicode>
          <transcript>tere mori manaiki bisi -- </transcript>
          <definition> That horse is not ours but theirs</definition>
        </example>
      </examples>
    </entry_item>
