      <dico>Lessing</dico>
      <unicode>ᠳᠣᠰᠣᠭᠠᠬᠣ</unicode>
      <uighur>dusuγaqu</uighur>
      <cyrillic>дусаах</cyrillic>
      <transcript>DUSUΓA-</transcript>
      <definition>[v. caus. of dusu-] To make drip, drop, pour in drops; to sprinkle; to spill.</definition>
      <page>276</page>
      <examples>
        <example>
          <unicode>ᠠᠷᠠᠺᠢ ᠳᠣᠰᠣᠭᠠᠬᠣ</unicode>
          <transcript>araki --xu</transcript>
          <definition> To perform a libation of an alcoholic beverage.</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠳᠦᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠡᠮ ᠳᠣᠰᠣᠭᠠᠬᠣ</unicode>
          <transcript>nidyn dyr em --xu</transcript>
          <definition> To put a drop ( or drops) of medicine into the eye.</definition>
        </example>
      </examples>
    </entry_item>
