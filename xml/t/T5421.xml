    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠣᠩᠭᠠᠯᠠᠬ</unicode>
      <uighur>tungγalaq</uighur>
      <cyrillic>тунгалаг</cyrillic>
      <transcript>TUNGΓALAΓ</transcript>
      <definition>adj. Clear, pure; limpid, transparent; light.</definition>
      <page>842</page>
      <examples>
        <example>
          <unicode>ᠲᠣᠩᠭᠠᠯᠠᠬ ᠪᠣᠯᠤᠷ</unicode>
          <transcript>-- bolur</transcript>
          <definition> Pure or transparent crystal.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠩᠭᠠᠯᠠᠬ ᠴᠠᠢ</unicode>
          <transcript>-- cai</transcript>
          <definition> Plain tea (without milk).</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠩᠭᠠᠯᠠᠬ ᠡᠳᠦᠷ</unicode>
          <transcript>-- edyr</transcript>
          <definition> Clear or bright day.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠩᠭᠠᠯᠠᠬ ᠨᠠᠭᠤᠷ</unicode>
          <transcript>-- naγur</transcript>
          <definition> Clear lake.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠩᠭᠠᠯᠠᠬ ᠣᠭᠲᠠᠷᠭᠤᠢ</unicode>
          <transcript>-- oγtarγui</transcript>
          <definition> Clear sky.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠩᠭᠠᠯᠠᠬ ᠰᠠᠶᠢᠬᠠᠨ</unicode>
          <transcript>-- saixan</transcript>
          <definition> Bright and clear.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠩᠭᠠᠯᠠᠬ ᠰᠡᠳᠺᠢᠯ</unicode>
          <transcript>-- sedkil</transcript>
          <definition> Pure heart, clean thought.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠩᠭᠠᠯᠠᠬ ᠤᠰᠤ</unicode>
          <transcript>-- usu</transcript>
          <definition> Clear and pure water.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠩᠭᠠᠯᠠᠬ ᠤᠬᠠᠭᠠᠨ</unicode>
          <transcript>-- uxaγan</transcript>
          <definition> Clear intellect, clear mind, clear thought[s]</definition>
        </example>
        <example>
          <unicode>ᠠᠷᠢᠭᠤᠨ ᠲᠣᠩᠭᠠᠯᠠᠬ</unicode>
          <transcript>ariγun -- </transcript>
          <definition> Pure, clear; good (of health, hon.)</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠭᠡᠨ ᠲᠣᠩᠭᠠᠯᠠᠬ</unicode>
          <transcript>gegegen – </transcript>
          <definition>Lustrous, illustrious (said of health or mind); bright and shiny</definition>
        </example>
        <example>
          <unicode>ᠯᠠᠭᠱᠠᠨ ᠲᠣᠩᠭᠠᠯᠠᠬ</unicode>
          <transcript>laγšan -- </transcript>
          <definition> In good health (hon.).</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠨ ᠤ ᠪᠡᠶ᠎ᠡ ᠯᠠᠭᠱᠠᠨ ᠠᠷᠢᠭᠤᠨ ᠲᠣᠩᠭᠠᠯᠠᠬ ᠪᠠᠶᠢᠮᠤᠢ᠎ᠠ = ᠲᠠᠨ ᠤ ᠪᠡᠶ᠎ᠡ ᠯᠠᠭᠱᠠᠨ ᠭᠡᠭᠡᠭᠡᠨ ᠲᠣᠩᠭᠠᠯᠠᠬ ᠪᠠᠶᠢᠮᠤᠢ᠎ᠠ</unicode>
          <transcript>tan u bej-e laγšan ariγun (or gegegen) -- baimui-a </transcript>
          <definition>[I] presume you are in excellent health ( epist , hon. ).</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
