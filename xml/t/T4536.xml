    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠭᠥᠰᠺᠥ</unicode>
      <uighur>tegüskü</uighur>
      <cyrillic>төгсөх</cyrillic>
      <transcript>TEGYS-</transcript>
      <definition>v. i. To come to an end; to be finished, fulfilled, carried out, completed; to be perfect, complete.</definition>
      <page>796</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠭᠥᠰᠦᠭᠰᠡᠨ</unicode>
          <transcript>--ygsen</transcript>
          <definition> Perfect, accomplished, achieved; in complete possession of; completed, finished</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠭᠥᠰᠦᠭᠰᠡᠨ ᠺᠦᠮᠦᠨ</unicode>
          <transcript>--ygsen kymyn</transcript>
          <definition> A perfect man or person.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠨ ᠲᠠᠭᠥᠰᠦᠭᠰᠡᠨ ᠤ ᠳᠠᠷᠠᠭ᠎ᠠ</unicode>
          <transcript>dain --ygsen y daraγ-a</transcript>
          <definition> After the war.</definition>
        </example>
        <example>
          <unicode>ᠭᠦᠢᠴᠡᠳᠺᠡᠨ ᠲᠠᠭᠥᠰᠺᠦ</unicode>
          <transcript>gyicedken --ky</transcript>
          <definition> To finish, complete.</definition>
        </example>
        <example>
          <unicode>ᠤᠬᠠᠭᠠᠨ ᠪᠢᠯᠢᠭ ᠲᠠᠭᠥᠰᠦᠭᠰᠡᠨ</unicode>
          <transcript>uxaγan bilig --ygsen</transcript>
          <definition> Possessing wisdom and intellect</definition>
        </example>
        <example>
          <unicode>ᠤᠬᠠᠭᠠᠨ ᠤ  ᠨᠫᠮ ᠳ᠋‍‍ᠤ‍ᠷ ᠲᠠᠭᠥᠰᠦᠭᠰᠡᠨ</unicode>
          <transcript>uxaγan u nom dur --ygsen</transcript>
          <definition> Learned, erudite, scholarly.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠲᠠᠯᠠ ᠲᠠᠭᠥᠰᠦᠭᠰᠡᠨ</unicode>
          <transcript>xotala --ygsen</transcript>
          <definition> Accomplished, perfect.</definition>
        </example>
        <example>
          <unicode>ᠬᠤᠭᠤᠴᠠᠭ᠎ᠠ ᠲᠠᠭᠥᠰᠺᠦ</unicode>
          <transcript>xuγucaγ-a --ky</transcript>
          <definition> To finish one's term.</definition>
        </example>
        <example>
          <unicode>ᠦᠨᠦᠷ ᠎ᠯᠦᠭᠡ ᠲᠠᠭᠥᠰᠦᠭᠰᠡᠨ</unicode>
          <transcript>ynyr lyge --ygsen</transcript>
          <definition> Full of aroma.</definition>
        </example>
        <example>
          <unicode>ᠦᠵᠡᠵᠦ ᠲᠠᠭᠥᠰᠺᠦ</unicode>
          <transcript>yzezy --ky</transcript>
          <definition> To finish reading; to read from beginning to end.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠡᠭᠦᠰᠺᠦ</unicode>
      <definition>se terminer , s'achever, s'accomplir: être accompli; être doué de. 2 se perfectionner, s'améliorer: 3 se remplir ; 4 être terminê , décidé, arrêté.</definition>
      <page>1753</page>
      <examples>
        <example>
          <unicode>ᠤᠬᠠᠭᠠᠨ ᠤ ᠨᠣᠮ ᠳ᠋‍‍ᠤ‍ᠷ ᠳᠡᠭᠦᠰᠦᠭᠰᠡᠨ</unicode>
          <definition>savant, érudit</definition>
        </example>
        <example>
          <unicode>ᠥᠨᠦᠷ ᠎ᠯᠦᠭᠡ ᠳᠡᠭᠦᠰᠦᠭᠰᠡᠨ ᠴᠡᠴᠡᠭ</unicode>
          <definition>la fleur aromatique</definition>
        </example>
        <example>
          <unicode>ᠦᠵᠡᠵᠦ ᠳᠡᠭᠦᠰᠺᠦ</unicode>
          <definition>examiner, lire d'un bout à l'autre</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠲᠠᠯᠠ ᠳᠡᠭᠦᠰᠦᠭᠰᠡᠨ ᠵᠠᠯᠠᠭᠤ ᠬᠠᠨ</unicode>
          <definition>un jeune khan (parfait) accompli</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠯᠭᠡᠰ ᠦᠯᠢᠭᠡᠷ ᠳᠡᠭᠦᠰᠦᠭᠰᠡᠨ</unicode>
          <definition>doué d'indices de la perfection</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠯᠭᠡ ᠪᠢᠯᠢᠭ ᠤᠨ ᠨᠢᠳᠦᠨ ᠎ᠯᠦᠭᠡ ᠳᠡᠭᠦᠰᠦᠭᠰᠡᠨ</unicode>
          <definition>doué d'un oeil de la sagesse</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠭᠱᠠᠪᠠᠳ ᠦᠨᠡᠭᠡᠷ ᠳᠡᠭᠦᠰᠦᠭᠰᠡᠨ</unicode>
          <definition>d'une bonne conduite, doué d'une conduite morale; qui s'est imposé les devoirs moraux; qui a fait un voeu</definition>
        </example>
        <example>
          <unicode>ᠳᠡᠭᠦᠰᠦᠭᠰᠡᠨ ᠺᠦᠮᠦᠨ</unicode>
          <definition>un homme parfait</definition>
        </example>
        <example>
          <unicode>ᠳᠡᠭᠦᠰᠪᠡᠢ</unicode>
          <definition>c'est terminé (p.e. un ouvrage), la fin d'un ouvrage, etc.</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠭ ᠤᠨ ᠨᠣᠮ ᠎ᠯᠤᠭ᠎ᠠ ᠳᠡᠭᠦᠰᠺᠦ</unicode>
          <definition>i.e. mourir</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠰᠡᠯ ᠎ᠯᠦᠭᠡ ᠳᠡᠭᠦᠰᠦᠭᠰᠡᠨ</unicode>
          <definition>qui désire, qui a envie de, avide, qui est passionné pour</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠮ ᠎ᠯᠦᠭᠡ ᠳᠡᠭᠦᠰᠦᠭᠰᠡᠨ</unicode>
          <definition>pernicieux, pécheur, coupable</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠴᠦᠨ ᠳᠡᠭᠦᠰᠦᠭᠰᠡᠨ</unicode>
          <definition>fort, robuste, vigoureux, puissant</definition>
        </example>
      </examples>
    </entry_item>
