    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠣᠷᠬᠣ</unicode>
      <uighur>torqu</uighur>
      <cyrillic>торох</cyrillic>
      <transcript>TOR-</transcript>
      <definition>v. i. To get stuck; to be stopped, delayed; to become embroiled, tangled up in something.</definition>
      <page>825</page>
      <examples>
        <example>
          <unicode>ᠲᠣᠷᠴᠤ ᠲᠦᠳᠡᠺᠦ</unicode>
          <transcript>--cu tydeky</transcript>
          <definition> To get stuck.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠷᠤᠯ ᠦᠭᠡᠢ</unicode>
          <transcript>--ul ygei</transcript>
          <definition> Without delay, without obstacle.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠷᠬᠣ ᠲᠦᠳᠡᠺᠦ ᠦᠭᠡᠢ</unicode>
          <transcript>--xu tydeky ygei</transcript>
          <definition> Without any obstacle, without a hitch.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠷᠬᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>--xu ygei</transcript>
          <definition> Without obstacle or delay; freely.</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠰᠠᠭ ᠎ᠲᠤᠷ ᠲᠣᠷᠬᠣ</unicode>
          <transcript>zasaγ tur --xu</transcript>
          <definition> To violate the law.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠤᠷᠬᠤ</unicode>
