    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠳᠣᠷᠣᠮᠵᠢᠯᠠᠬᠣ</unicode>
      <uighur>dorumǰilaqu</uighur>
      <cyrillic>доромжлох</cyrillic>
      <transcript>DORUMZILA-</transcript>
      <definition>v.t. and i. To consider as inferior, despise; to blaspheme; to humiliate, insult.</definition>
      <page>263</page>
      <examples>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠪᠡᠨ ᠳᠣᠷᠣᠮᠵᠢᠯᠠᠬᠣ</unicode>
          <transcript>bej-e ben --xu</transcript>
          <definition> To humble oneself, swallow one's pride.</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠷᠬᠠᠨ ᠢ ᠳᠣᠷᠣᠮᠵᠢᠯᠠᠬᠣ</unicode>
          <transcript>burxan i --xu</transcript>
          <definition> To blaspheme a god.</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠭᠤ ᠦᠭᠡᠰ ᠢᠶᠡᠷ ᠳᠣᠷᠣᠮᠵᠢᠯᠠᠬᠣ</unicode>
          <transcript>maγu yges ijer --xu</transcript>
          <definition> To insult with words.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠤᠷᠣᠮᠵᠢᠯᠠᠬᠤ ~ ᠳᠣᠤᠷᠠᠮᠵᠢᠯᠠᠬᠤ</unicode>
      <definition>humilier. mépriser, rendre méprisable, outrager, insulter, blâmer.</definition>
      <page>1888</page>
      <examples>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠢ ᠮᠠᠭᠲᠠᠨ ᠪᠤᠰᠤᠳ ᠢ ᠳᠤᠷᠣᠮᠵᠢᠯᠠᠬᠤ</unicode>
          <definition>louer soi-même et abaisser les autres</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠭᠤᠷ ᠎ᠲᠤᠷ ᠳᠤᠷᠣᠮᠵᠢᠯᠠᠬᠤ</unicode>
          <definition>blâmer en face</definition>
        </example>
        <example>
          <unicode>ᠪᠯᠠᠮ᠎ᠠ ᠎ᠶᠢ ᠮᠠᠭᠤ ᠦᠭᠡᠰ ᠢᠶᠡᠷ ᠳᠤᠷᠣᠮᠵᠢᠯᠠᠬᠤ</unicode>
          <definition>injurier le lama</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
