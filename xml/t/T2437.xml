    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠳᠠᠶᠢᠰᠣᠨ</unicode>
      <uighur>dayisun</uighur>
      <cyrillic>дайсан</cyrillic>
      <transcript>DAISUN</transcript>
      <definition>n. Enemy, foe, adversary; menace</definition>
      <page>222</page>
      <examples>
        <example>
          <unicode>ᠳᠠᠶᠢᠰᠣᠨ ᠳᠠᠷᠤᠬᠤ</unicode>
          <transcript>-- daruxu</transcript>
          <definition> To conquer, defeat the enemy.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠰᠣᠨ ᠡᠲᠡᠭᠡᠳ</unicode>
          <transcript>-- eteged</transcript>
          <definition> Hostile elements.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠰᠣᠨ ᠢ ᠠᠷᠢᠯᠭᠠᠬᠤ</unicode>
          <transcript>-- i arilγaxu</transcript>
          <definition> To annihilate the enemy.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠰᠣᠨ ᠢ ᠳᠣᠪᠲᠤᠯᠬᠤ</unicode>
          <transcript>-- i dobtulxu</transcript>
          <definition> To attack the enemy.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠰᠣᠨ ᠲᠣᠳᠬᠤᠷ</unicode>
          <transcript>-- todxur</transcript>
          <definition> Evil spirit; hindrance.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠰᠣᠨ ᠤ ᠡᠮᠦᠨ᠎ᠡ ᠪᠠᠭᠤᠬᠤ</unicode>
          <transcript>-- u emyn-e baγuxu</transcript>
          <definition> To capitulate.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠳᠠᠶᠢᠰᠣᠨ</unicode>
      <transcript>DAISUN </transcript>
      <page>1167</page>
      <examples>
        <example>
          <unicode>ᠳᠠᠶᠢᠰᠤᠨ ᠢ ᠳᠠᠷᠤᠭᠰᠠᠨ</unicode>
          <transcript>i daruγsan; </transcript>
          <definition>T. dgra bcom pa; S. arhat. Killer of enemies, i.e., the passions; metaph. for arhat, Pali arihan (the latter wrongly etymologized as ari 'enemy' and han 'killer,' the enemies being the nisvanis.</definition>
        </example>
      </examples>
