    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠯᠴᠢᠯᠠᠺᠦ</unicode>
      <uighur>telčilekü</uighur>
      <cyrillic>тэлчлэх</cyrillic>
      <transcript>TELCILE-</transcript>
      <definition>v. i. To move or toss the limbs while lying down; to suffer</definition>
      <page>797</page>
      <examples>
        <example>
          <unicode>ᠺᠥᠯ ᠭᠠᠷ ᠢᠶᠠᠨ ᠲᠠᠯᠴᠢᠯᠠᠵᠦ ᠶᠡᠺᠡ ᠵᠣᠪᠠᠵᠤ ᠪᠠᠶᠢᠨ᠎ᠠ</unicode>
          <transcript>køl γar ijen --zy jeke zobazu bain-a</transcript>
          <definition> He is tossing his hands and feet, suffering terribly</definition>
        </example>
        <example>
          <unicode>ᠤᠨᠠᠭ᠎ᠠ ᠪᠣᠰᠬᠤ ᠭᠡᠵᠦ ᠲᠠᠯᠴᠢᠯᠠᠺᠥᠵᠦ ᠪᠠᠶᠢᠨ᠎ᠠ</unicode>
          <transcript>unaγ-a bosxu gezy --zu bain-a</transcript>
          <definition> The colt is kicking his feet trying to stand up.</definition>
        </example>
      </examples>
    </entry_item>
