      <page>776</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠨ ᠳ᠋‍‍ᠤ‍ᠷ</unicode>
          <transcript>-- dur</transcript>
          <definition> Dative-locative of ta, q.v.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠨ ᠤ</unicode>
          <transcript>-- u</transcript>
          <definition> Gen. of ta.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠨ</unicode>
      <uighur>tan</uighur>
      <cyrillic>тан</cyrillic>
      <transcript>TAN</transcript>
      <definition>2 An honorific used after titles in addressing or referring to persons of rank.</definition>
      <page>776</page>
      <examples>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠎ ᠲᠠᠨ</unicode>
          <transcript>gegen -- </transcript>
          <definition> Your eminence (addressing a xubilγan, q.v.).</definition>
        </example>
        <example>
          <unicode>ᠨᠣᠶᠠᠨ ᠎ᠲᠠᠨ</unicode>
          <transcript>nojan -- </transcript>
          <definition> Your (or his) Highness; your (or his) Excellency.</definition>
        </example>
      </examples>
    </entry_item>
