      <transcript>TAILBURILA-</transcript>
      <definition>v. t. To explain, elucidate, interpret, comment.</definition>
      <page>769</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠶᠢᠯᠪᠣᠷᠢᠯᠠᠨ ᠲᠠᠨᠢᠭᠤᠯᠬᠤ</unicode>
          <transcript>--n taniγulxu</transcript>
          <definition> To explain and make known, comment upon.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠶᠢᠯᠪᠣᠷᠢᠯᠠᠬᠤ ᠠᠨᠤ</unicode>
          <transcript>--xu anu </transcript>
          <definition> . . Note: (introducing an explanatory note),</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠶᠢᠯᠪᠣᠷᠢᠯᠠᠵᠤ ᠥᠭᠺᠦ</unicode>
          <transcript>--zu øgky</transcript>
          <definition> To explain to somebody.</definition>
        </example>
      </examples>
    </entry_item>
