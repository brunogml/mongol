    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠳᠠᠯᠠᠶᠢᠬᠣ</unicode>
      <uighur>dalayiqu</uighur>
      <cyrillic>далайх</cyrillic>
      <transcript>DALAI-</transcript>
      <definition>v.t. and i. To raise the hand -in order to strike; to brandish, swing, wield.</definition>
      <page>224</page>
      <examples>
        <example>
          <unicode>ᠳᠠᠯᠠᠶᠢᠵᠤ ᠴᠠᠪᠴᠢᠬᠤ</unicode>
          <transcript>--zu cabcixu</transcript>
          <definition> To hack, hew, or chop vigorously.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠳᠦᠨ ᠢ ᠳᠠᠶᠢᠰᠤᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠳᠠᠯᠠᠶᠢᠬᠤ</unicode>
          <transcript>ildyn i daisun dur; --xu</transcript>
          <definition> To brandish a sword against the enemy.</definition>
        </example>
      </examples>
    </entry_item>
