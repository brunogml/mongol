    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠣᠩ</unicode>
      <uighur>tong</uighur>
      <cyrillic>тон</cyrillic>
      <transcript>TONG</transcript>
      <definition>[= tung, 2] adv. Extremely, very, very much (often indicates superlative); (with negative) not at all, not in the least.</definition>
      <page>824</page>
      <examples>
        <example>
          <unicode>ᠲᠣᠩ ᠪᠣᠯᠬᠤ ᠦᠭᠡᠢ</unicode>
          <transcript>-- bolxu ygei</transcript>
          <definition> It is absolutely impossible.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠩ ᠴᠢᠬᠤᠯᠠ</unicode>
          <transcript>-- cixula</transcript>
          <definition> Most important, most relevant.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠩ ᠴᠤ</unicode>
          <transcript>-- cu</transcript>
          <definition> Completely, entirely, fully.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠩ ᠭᠠᠭᠴᠠᠬᠠᠨ</unicode>
          <transcript>-- γaγcaxan</transcript>
          <definition> All alone, unique.</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠩ ᠮᠡᠳᠡᠺᠦ ᠦᠭᠡᠢ</unicode>
          <transcript>-- medeky ygei</transcript>
          <definition> [He] knows absolutely nothing</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠩ ᠬᠠᠷᠠᠭᠳᠠᠬᠤ ᠦᠭᠡᠢ</unicode>
          <transcript>-- xaraγdaxu ygei</transcript>
          <definition> Absolutely invisible.</definition>
        </example>
      </examples>
    </entry_item>
