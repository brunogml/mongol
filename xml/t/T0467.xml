    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠭᠠᠯᠠᠬᠣ</unicode>
      <uighur>taγalaqu</uighur>
      <cyrillic>таалах</cyrillic>
      <transcript>TAΓALA-</transcript>
      <definition>v. t. To desire, love, find pleasure in something; to be pleased with or have sympathy for; to have or express a thought or opinion (hon.); to fondle, caress, kiss.</definition>
      <page>763</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠭᠠᠯᠠᠭᠰᠠᠨ ᠺᠡᠷᠡᠭ</unicode>
          <transcript>--γsan kereg</transcript>
          <definition> Something wished for, wish, desire (hon.)</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠶᠢᠰᠢᠶᠠᠨ ᠲᠠᠭᠠᠯᠠᠬᠤ</unicode>
          <transcript>saisijan --xu</transcript>
          <definition> To praise and love.</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠰᠢᠨ᠎ᠠ ᠲᠠᠭᠠᠯᠠ</unicode>
          <transcript>šasin-a –xu </transcript>
          <definition>To be devout</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠶᠢᠷᠠᠯᠠᠨ ᠲᠠᠭᠠᠯᠠᠬᠤ</unicode>
          <transcript>xairalan –xu </transcript>
          <definition>To love and be pleased (with someone)</definition>
        </example>
        <example>
          <unicode>ᠦᠨᠦᠰᠦᠨ ᠲᠠᠭᠠᠯᠠᠬᠤ</unicode>
          <transcript>ynysyn --xu</transcript>
          <definition> To kiss.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠠᠭᠠᠯᠠᠬᠤ</unicode>
      <definition>désirer, aimer: trouver du plaisir dans qc., s'attacher à qc.: 2 trouver hon, se plaire à.</definition>
      <page>1576</page>
      <examples>
        <example>
          <unicode>ᠠᠨᠠᠨᠳᠠ ᠲᠡᠷᠡ ᠺᠥᠪᠡᠭᠦᠨ ᠡᠴᠢᠭᠡ ᠡᠺᠡ ᠎ᠵᠦᠭᠡᠨ ᠺᠦᠨᠳᠦᠯᠡᠨ ᠦᠵᠡᠵᠦ ᠮᠠᠰᠢ ᠰᠠᠶᠢᠰᠢᠠᠨ ᠳᠠᠭᠠᠯᠠᠪᠠᠢ</unicode>
          <definition>Ananda, ayant remarqué dans ce jeune homme le respect qu'il témoigne à ses parents, fit son éloge avec plaisir</definition>
        </example>
        <example>
          <unicode>ᠡᠺᠡ ᠎ᠯᠦᠭᠡ ᠬᠠᠮᠲᠤ ᠨᠢᠭᠡ᠎ᠡ ᠰᠠᠭᠤᠬᠤᠢ ᠎ᠶᠢ ᠳᠠᠭᠠᠯᠠᠬᠤ</unicode>
          <definition>désirer vivre ensemble avec sa mère</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠺᠢᠮᠵᠢ ᠎ᠶᠢ ᠮᠢᠨᠤ ᠳᠠᠭᠠᠯᠠᠪᠠᠰᠤ ᠣᠷᠺᠢᠮᠵᠢ ᠎ᠶᠢ ᠮᠢᠨᠤ ᠠᠪ</unicode>
          <definition>si mon écharpe te plait, prends la</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠰᠢᠨ᠎ᠠ ᠳᠠᠭᠠᠯᠠᠬᠤ</unicode>
          <definition>être zélé pour la religion, protéger la religion</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠭᠠᠯᠠᠬᠤᠢ</unicode>
          <definition>plaisir, désir sensuel</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠭᠠᠯᠠᠬᠤᠢ ᠠᠮᠠᠷᠠᠭ ᠺᠥᠪᠡᠭᠦᠨ</unicode>
          <definition>fils bien aimé</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠭᠠᠯᠠᠭᠰᠠᠨ ᠺᠡᠷᠡᠭ ᠪᠦᠲᠦᠺᠦ</unicode>
          <definition>accomplissement d'un désir</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠰᠢᠳᠠ ᠳᠠᠭᠠᠯᠠᠬᠤᠢ ᠴᠢᠮᠡᠭ</unicode>
          <definition>ornement qui plait beaucoup</definition>
        </example>
        <example>
          <unicode>ᠮᠢᠨᠤ ᠡᠴᠢᠭᠡ ᠨᠠᠮᠠᠶᠢ ᠬᠠᠶᠢᠷᠠᠯᠠ ᠳᠠᠭᠠᠯᠠᠮᠤᠢ</unicode>
          <definition>mon père m'aime</definition>
        </example>
      </examples>
    </entry_item>
