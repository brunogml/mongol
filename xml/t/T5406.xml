  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠣᠩᠭᠠᠭᠠᠬᠣ</unicode>
      <uighur>tungγaγaqu</uighur>
      <cyrillic>тунгаах</cyrillic>
      <transcript>TUNGΓAΓA-</transcript>
      <definition>[= tungγa-] v.t. To let a liquid settle; to strain; to refine metal; to purify; to know, think, judge (elevated style).</definition>
      <page>842</page>
      <examples>
        <example>
          <unicode>ᠲᠣᠩᠭᠠᠭᠠᠨ ᠠᠶᠢᠯᠠᠳᠬᠤ</unicode>
          <transcript>--n ailadxu</transcript>
          <definition> To deign to pass judgment or give consideration (hon. ).</definition>
        </example>
        <example>
          <unicode>ᠠᠯᠲᠠ ᠲᠣᠩᠭᠠᠭᠠᠬᠣ</unicode>
          <transcript>alta --xu</transcript>
          <definition>. To refine gold.</definition>
        </example>
        <example>
          <unicode>ᠤᠰᠤ ᠲᠣᠩᠭᠠᠭᠠᠬᠣ</unicode>
          <transcript>usu --xu</transcript>
          <definition> To let the water settle; to strain or filter water</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
