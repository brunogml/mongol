    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠥᠯᠥᠺᠠᠯᠠᠺᠥ</unicode>
      <uighur>tölükelekü</uighur>
      <cyrillic>төлөөлөх</cyrillic>
      <transcript>TØLYGELE-</transcript>
      <definition>v.t. To represent, be a representative or delegate; to substitute for or replace someone, take someone's place.</definition>
      <page>834</page>
      <examples>
        <example>
          <unicode>ᠲᠥᠯᠥᠺᠠᠯᠠᠨ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>--n jabuxu</transcript>
          <definition> To go in place of another.</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠯᠥᠺᠠᠯᠠᠨ ᠦᠢᠯᠡᠳᠺᠦ</unicode>
          <transcript>--n yiledky</transcript>
          <definition> To do something in the place of another; to substitute.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
