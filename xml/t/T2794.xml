    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠲᠠᠷᠬᠠᠭᠠᠬᠣ</unicode>
      <uighur>tarqaγaqu</uighur>
      <cyrillic>тархаах</cyrillic>
      <transcript>TARXAΓA-</transcript>
      <definition>[v. caus. of tarxa-] v. t. To order to scatter, disperse, chase into different directions; to dismiss; to spread, disseminate; to issue, promulgate, distribute.</definition>
      <page>782</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠷᠬᠠᠭᠠᠬᠣ ᠪᠢᠴᠢᠭ</unicode>
          <transcript>--xu bicig</transcript>
          <definition> Circular (communication).</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠷᠬᠠᠭᠠᠵᠤ ᠬᠠᠶᠠᠬᠤ</unicode>
          <transcript>--zu xajaxu</transcript>
          <definition> To scatter, throw about.</definition>
        </example>
        <example>
          <unicode>ᠳᠡᠯᠭᠡᠷᠡᠭᠦᠯᠦᠨ ᠲᠠᠷᠬᠠᠭᠠᠬᠣ</unicode>
          <transcript>delgeregylyn --xu</transcript>
          <definition> To spread or disseminate (as idea)</definition>
        </example>
        <example>
          <unicode>... ᠡᠴᠡ ᠲᠠᠷᠬᠠᠭᠠᠮᠤᠢ</unicode>
          <transcript> . . ece --mui. </transcript>
          <definition>Is/are distributed by . . .</definition>
        </example>
        <example>
          <unicode>ᠦᠭᠡ ᠴᠤᠤᠷᠬᠠᠯ ᠢ ᠲᠠᠷᠬᠠᠭᠠᠬᠣ</unicode>
          <transcript>yge cuurxal i --xu</transcript>
          <definition> To spread rumors.</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠷᠯᠢᠭ ᠲᠠᠷᠬᠠᠭᠠᠬᠣ</unicode>
          <transcript>zarliγ --xu</transcript>
          <definition> To issue an edict.</definition>
        </example>
        <example>
          <unicode>ᠵᠡᠭᠡᠯ ᠡᠯᠭᠡ ᠎ᠶᠢ ᠲᠠᠷᠬᠠᠭᠠᠬᠣ</unicode>
          <transcript>zegel elge ji --xu</transcript>
          <definition> To float a loan.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠠᠷᠬᠠᠭᠠᠬᠤ</unicode>
      <definition>ordonner de se séparer; de s'en aller, de dissiper: 2 propager, répandre, divulguer, promulguer, publier, faire savoir.</definition>
      <page>1677</page>
      <examples>
        <example>
          <unicode>ᠠᠶᠤᠯ ᠢ ᠳᠠᠷᠬᠠᠭᠠᠬᠤ</unicode>
          <definition>dissiper la frayeur, sauver du danger</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠷᠬᠠᠭᠠᠬᠤ ᠵᠠᠷᠯᠢᠬ</unicode>
          <definition>édit publié, manifeste</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠷᠯᠢᠬ ᠳᠠᠷᠬᠠᠭᠠᠬᠤ</unicode>
          <definition>publier un édit ou manifeste</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠪᠠᠯᠠᠩ ᠢ ᠳᠠᠷᠬᠠᠭᠠᠬᠤ</unicode>
          <definition>délivrer des tourments</definition>
        </example>
      </examples>
