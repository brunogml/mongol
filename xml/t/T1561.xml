      <uighur>tadaburi</uighur>
      <cyrillic>татвар</cyrillic>
      <transcript>TATABURI</transcript>
      <definition>n. a) The act of tata-. b) Tax, levy, excise, toll, customs duty. c) Concubine. d) Half-breed, mongrel.</definition>
      <page>786</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠲᠠᠪᠣᠷᠢ ᠪᠣᠯᠭᠠᠭᠤ ᠠᠪᠬᠤ</unicode>
          <transcript>-- bolyagu abxu</transcript>
          <definition> To collect in lieu of tax (see under c).</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠲᠠᠪᠣᠷᠢ ᠬᠤᠷᠢᠶᠠᠬᠤ</unicode>
          <transcript>-- xurijaxu</transcript>
          <definition> To collect taxes, imposts, etc.</definition>
        </example>
        <example>
          <unicode>ᠠᠯᠪᠠᠨ ᠲᠠᠲᠠᠪᠣᠷᠢ</unicode>
          <transcript>alban -- </transcript>
          <definition> Impost, tax.</definition>
        </example>
        <example>
          <unicode>ᠠᠰᠢᠭ ᠣᠷᠤᠯᠭ᠎ᠠ ᠎ᠶᠢᠨ ᠲᠠᠲᠠᠪᠣᠷᠢ</unicode>
          <transcript>asiγ orulγ-a jin -- </transcript>
          <definition> Income tax.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠵᠠᠷ ᠤᠨ ᠲᠠᠲᠠᠪᠣᠷᠢ</unicode>
          <transcript>γazar un -- </transcript>
          <definition> Land tax.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠰᠢᠭᠦᠨ ᠤᠨ ᠲᠠᠲᠠᠪᠣᠷᠢ</unicode>
          <transcript>gesigyn y -- </transcript>
          <definition> Membership fee or dues.</definition>
        </example>
        <example>
          <unicode>ᠭᠦᠢᠯᠡᠭᠡᠨ ᠤ ᠲᠠᠲᠠᠪᠣᠷᠢ</unicode>
          <transcript>gyilgegen y -- </transcript>
          <definition> Sales tax.</definition>
        </example>
        <example>
          <unicode>ᠣᠨᠴᠠ ᠡᠷᠺᠡ ᠎ᠶᠢᠨ ᠲᠠᠲᠠᠪᠣᠷᠢ</unicode>
          <transcript>onca erke jin -- </transcript>
          <definition> Tax on monopolized goods</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠤᠨ ᠨᠤᠲᠤᠭ ᠤᠨ ᠲᠠᠲᠠᠪᠣᠷᠢ</unicode>
          <transcript>orun nutuγ un -- </transcript>
          <definition> Local tax[es].</definition>
        </example>
        <example>
          <unicode>ᠤᠯᠤᠰ ᠤᠨ ᠲᠠᠲᠠᠪᠣᠷᠢ</unicode>
          <transcript>ulus un -- </transcript>
          <definition> National tax[es].</definition>
        </example>
        <example>
          <unicode>ᠤᠯᠤᠰ ᠤᠨ ᠵᠠᠮ ᠤᠨ ᠲᠠᠲᠠᠪᠣᠷᠢ</unicode>
          <transcript>ulus un zam un -- </transcript>
          <definition> Public-road toll.</definition>
        </example>
        <example>
          <unicode>ᠵᠢᠰᠠ ᠎ᠶᠢᠨ ᠲᠠᠲᠠᠪᠣᠷᠢ</unicode>
          <transcript>zisa jin -- </transcript>
          <definition> Tax imposed on monasteries</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠲᠠᠪᠣᠷᠢ ᠪᠣᠯᠭᠠᠬᠤ ᠠᠪᠬᠤ</unicode>
          <transcript>-- bolγazu abxu</transcript>
          <definition> To take as a concubine (see also under b).</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠲᠠᠪᠣᠷᠢ ᠎ᠶᠢᠨ ᠺᠦᠪᠡᠭᠦᠨ</unicode>
          <transcript>-- jin kybegyn</transcript>
          <definition> Son of a concubine.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠲᠠᠪᠣᠷᠢ ᠵᠤᠯᠵᠠᠭᠠᠨ</unicode>
          <transcript>-- zulzaγan</transcript>
          <definition> Young half-breed or mongrel.</definition>
        </example>
