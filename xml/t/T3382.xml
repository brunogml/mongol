      <dico>Lessing</dico>
      <unicode>ᠲᠠᠪ</unicode>
      <uighur>teb</uighur>
      <cyrillic>тэв</cyrillic>
      <transcript>TEB</transcript>
      <definition>lntensifying particle used before certain adj. or adv. beginning with the syllable te.</definition>
      <page>789</page>
      <examples>
        <example>
          <unicode>ᠲᠠᠪ ᠲᠡᠭᠰᠢ</unicode>
          <transcript>-- tegsi</transcript>
          <definition> Completely even, equal, or uniform.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠪ ᠲᠡᠨᠡᠭ</unicode>
          <transcript>-- teneg</transcript>
          <definition> Complete fool.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠳᠡᠪ</unicode>
      <definition>une particule dont on se sert pour renforcer la signification du mot suivant.</definition>
