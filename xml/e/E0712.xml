    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠠᠳᠥᠺᠥᠯᠺᠥ</unicode>
      <uighur>edügülkü</uighur>
      <definition>To cause or permit someone to perform or carry out.</definition>
      <page>130</page>
