    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠳᠥᠺᠥᠯᠺᠥ</unicode>
      <uighur>edügülkü</uighur>
      <cyrillic>өдүүлэх</cyrillic>
      <transcript>EDYGYL-</transcript>
      <definition>[v. caus. of edy-] To begin, start, lay a foundation, produce, originate, devise, commit; to induce, prompt.</definition>
      <page>295</page>
      <examples>
        <example>
          <unicode>ᠠᠷᠭ᠎ᠠ ᠡᠳᠥᠺᠥᠯᠺᠥ</unicode>
          <transcript>arγ-a --ky </transcript>
          <definition>To devise means, a scheme or artifice</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠶᠠᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠡᠳᠥᠺᠥᠯᠺᠥ</unicode>
          <transcript>bujan dur --kyo </transcript>
          <definition>To cause one to perform good deeds, encourage to virtue</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠨ ᠢ ᠡᠳᠥᠺᠥᠯᠺᠥ</unicode>
          <transcript>dain i - -ky</transcript>
          <definition> To plot a war.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠮᠲᠦ ᠺᠡᠷᠡᠭ ᠡᠳᠥᠺᠥᠯᠺᠥ</unicode>
          <transcript>gemty kereg --kyo ,</transcript>
          <definition>To commit a crime</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠭᠤ ᠰᠠᠨᠠᠭ᠎ᠠ ᠡᠳᠥᠺᠥᠯᠺᠥ</unicode>
          <transcript>mayγ sanaγ-a --ky </transcript>
          <definition>To conceive a wicked idea, make an evil plot</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠡᠳᠦᠭᠦᠯᠺᠦ</unicode>
      <definition>ordonner de s'occuper de qc., de faire, de produire, d'accomplir: 2 ordonner de corriger; 3 ordonner d'ériger, de construire; 4 exciter. animer, encourager.</definition>
      <page>201</page>
      <examples>
        <example>
          <unicode>ᠮᠠᠭᠤ ᠰᠠᠨᠠᠭ᠎ᠠ ᠡᠳᠦᠭᠦᠯᠺᠦ</unicode>
          <definition>exciter la haine, le dégoût.</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠶᠠᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠡᠳᠦᠭᠦᠯᠺᠦ</unicode>
          <definition>encourager a la vertu, ordonner d'accomplir de bonnes actions</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Schmidt</dico>
      <unicode>ᠠᠳᠥᠺᠥᠯᠺᠥ</unicode>
      <uighur>edügülkü</uighur>
      <definition>errichten lassen u. s. w.</definition>
