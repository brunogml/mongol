    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠶᠢᠨ</unicode>
      <uighur>eyin</uighur>
      <cyrillic>ийн</cyrillic>
      <transcript>EIN</transcript>
      <definition>adv. so, thus, in this way or manner.</definition>
      <page>304</page>
      <examples>
        <example>
          <unicode>ᠡᠶᠢᠨ ᠺᠡᠯᠡᠷᠦᠨ</unicode>
          <transcript>-- keleryn</transcript>
          <definition> Said thus: ...</definition>
        </example>
        <example>
          <unicode>ᠡᠶᠢᠨ ᠺᠡᠮᠡᠨ</unicode>
          <transcript>-- kemen</transcript>
          <definition> So saying, with these words.</definition>
        </example>
        <example>
          <unicode>ᠡᠶᠢᠨ ᠺᠦ</unicode>
          <transcript>-- ky</transcript>
          <definition> Such, such a one, just so, so then; in this manner,</definition>
        </example>
        <example>
          <unicode>ᠡᠶᠢᠨ ᠺᠦ ᠪᠣᠯᠪᠠᠰᠤ</unicode>
          <transcript>- ky bolbasu</transcript>
          <definition> If it is so; assuming this to be so.</definition>
        </example>
        <example>
          <unicode>ᠡᠶᠢᠨ ᠲᠡᠶᠢᠨ ᠦᠭᠡ ᠺᠡᠯᠡᠴᠡᠺᠦ</unicode>
          <transcript>-- tein yge kelelceky</transcript>
          <definition> To talk about this and that.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠡᠶᠢᠨ</unicode>
      <definition>ainsi, de cette manière, tel</definition>
      <page>165</page>
      <examples>
        <example>
          <unicode>ᠬᠠᠨ ᠺᠥᠪᠡᠭᠦᠨ ᠪᠠᠶᠠᠰᠴᠤ ᠡᠶᠢᠨ ᠵᠠᠷᠯᠢᠬ ᠪᠣᠯᠤᠷᠤᠨ</unicode>
          <definition>le fils du khan réjouit parla ainsi</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠨᠠᠶᠢᠺᠢ ᠡᠶᠢᠨ ᠺᠡᠪᠡᠢ</unicode>
          <definition>il m'a mis dans une telle position</definition>
        </example>
        <example>
          <unicode>ᠡᠶᠢᠨ ᠲᠡᠶᠢᠨ</unicode>
          <definition>comme ci comme ca, par-ci par là, ca la, ici et là-bas</definition>
        </example>
        <example>
          <unicode>ᠡᠶᠢᠨ ᠲᠡᠶᠢᠨ ᠦᠵᠡᠺᠦ</unicode>
          <definition>regarder ça et là, regarder d un côté et d'autre.</definition>
        </example>
        <example>
          <unicode>ᠡᠶᠢᠨ ᠲᠡᠶᠢᠨ ᠶᠠᠪᠤᠬᠤ</unicode>
          <definition>aller et venir; courir de tous côtés: - ne savoir que faire</definition>
        </example>
        <example>
          <unicode>ᠡᠶᠢᠨ ᠲᠡᠶᠢᠨ ᠺᠦᠢᠺᠦ</unicode>
          <definition>courir de tous côtes.</definition>
        </example>
        <example>
          <unicode>ᠡᠶᠢᠨ ᠺᠡᠮᠡᠨ</unicode>
          <definition>Parlant ainsi; en ces mots</definition>
        </example>
        <example>
          <unicode>ᠡᠶᠢᠨ ᠺᠦ</unicode>
          <definition>(chez les aut. modern.) c'est encore comme cela, comme auparavant, comme autrefois, encore, ainsi</definition>
        </example>
        <example>
          <unicode>ᠡᠶᠢᠨ ᠪᠣᠯᠪᠠᠰᠤ</unicode>
          <definition>si c'est ainsi; posons, que c'est ainsi.</definition>
        </example>
      </examples>
