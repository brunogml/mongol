    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠭᠦᠯᠡ ~ ᠡᠭᠦᠯᠡᠨ</unicode>
      <uighur>egüle - egülen</uighur>
      <cyrillic>үүл(эн)</cyrillic>
      <transcript>EGYLE(N)</transcript>
      <definition>n, and adj. Cloud; cloud-like pattern or design; cataract of the eye.</definition>
      <page>300</page>
      <examples>
        <example>
          <unicode>ᠡᠭᠦᠯᠡ ᠳᠠᠯᠳᠠᠬᠤ</unicode>
          <transcript>-- daldalaxu</transcript>
          <definition>To be hidden by clouds; to die ( hon.).</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠯᠡ ᠳᠡᠭᠳᠡᠺᠦ</unicode>
          <transcript>-- degdeky</transcript>
          <definition>For clouds to form or gather.</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠯᠡᠨ ᠠᠯᠠᠭ ᠮᠣᠷᠢ</unicode>
          <transcript>--n alaγ mori,</transcript>
          <definition>Skewbald horse (With dapples resembling clouds)</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠯᠡᠨ ᠴᠢᠯᠠᠭᠤ</unicode>
          <transcript>--n cilaγu</transcript>
          <definition>A kind of marble (With cloud pattern).</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠯᠡᠨ ᠤ ᠴᠢᠯᠠᠭᠤᠨ</unicode>
          <transcript>--n y cilaγun</transcript>
          <definition>Hail (lit. : stones of the cloud).</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠯᠡ ᠰᠠᠭᠤᠬᠤ</unicode>
          <transcript>-- saγuxu</transcript>
          <definition>For a cataract to develop on the eye.</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠯᠡ ᠰᠠᠷᠨᠢᠯᠬᠤ</unicode>
          <transcript>-- sarnilxu</transcript>
          <definition>For clouds to scatter.</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠯᠡ ᠰᠡᠺᠦᠺᠦ</unicode>
          <transcript>-- sekyky</transcript>
          <definition>For clouds to disperse.</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠯᠦᠡ ᠤᠨᠠᠬᠤ</unicode>
          <transcript>-- unaxu</transcript>
          <definition>For a cataract or growth to form or develop on the eye.</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠯᠡ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition>Without a cloud, cloudless.</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠮᠡᠵᠢᠨ ᠡᠭᠦᠯᠡ</unicode>
          <transcript>semezin --</transcript>
          <definition>Fleecy clouds, cirri.</definition>
        </example>
      </examples>
