    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠯᠠᠺᠳᠠᠺᠥ</unicode>
      <uighur>elegdekü</uighur>
      <cyrillic>элэгдэх</cyrillic>
      <transcript>ELEGDE-</transcript>
      <definition>[v . pass. of ele-] To be worn out; to weather.</definition>
      <page>308</page>
      <examples>
        <example>
          <unicode>ᠡᠯᠡᠭᠳᠡᠭᠡᠨ</unicode>
          <transcript>--gsen</transcript>
          <definition> Worn-out, shabby, threadbare.</definition>
        </example>
        <example>
          <unicode>ᠡᠯᠡᠭᠳᠡᠨ ᠴᠣᠭᠤᠷᠠᠬᠤ</unicode>
          <transcript>--n coγuraxu</transcript>
          <definition> To develop holes through wear.</definition>
        </example>
        <example>
          <unicode>ᠭᠤᠲᠤᠯ ᠤᠨ ᠤᠯᠠ ᠡᠯᠡᠭᠳᠡᠭᠰᠡᠨ</unicode>
          <transcript>γutul un ula --gsen </transcript>
          <definition>The sole of the shoe is worn through</definition>
        </example>
      </examples>
    </entry_item>
