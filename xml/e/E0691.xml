    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠳᠥᠺᠠ</unicode>
      <uighur>edüge</uighur>
      <cyrillic>өдөө - эдүүгээ</cyrillic>
      <transcript>EDYGE</transcript>
      <definition>[=odu] adv. and adj. Now, at present.</definition>
      <page>294</page>
      <examples>
        <example>
          <unicode>ᠡᠳᠥᠺᠠ ᠴᠠᠭ</unicode>
          <transcript>-- caγ</transcript>
          <definition> Present day, modern times; present tense (gram.).</definition>
        </example>
        <example>
          <unicode>ᠡᠳᠥᠺᠠ ᠳᠠᠷᠤᠢ</unicode>
          <transcript>-- darui</transcript>
          <definition> Right away, immediately, at once.</definition>
        </example>
        <example>
          <unicode>ᠡᠳᠥᠺᠠ ᠎ᠳᠡᠭᠡᠨ</unicode>
          <transcript>-- degen</transcript>
          <definition> At present, right at this moment.</definition>
        </example>
        <example>
          <unicode>ᠡᠳᠥᠺᠠ ᠎ᠶᠢᠨ</unicode>
          <transcript>-- jin, </transcript>
          <definition>Present, contemporary, actual</definition>
        </example>
        <example>
          <unicode>ᠡᠳᠥᠺᠠ ᠦᠶ᠎ᠡ ᠎ᠳᠦ</unicode>
          <transcript>-- yj-e [dy]</transcript>
          <definition> At this time, at present.</definition>
        </example>
        <example>
          <unicode>ᠡᠳᠥᠺᠠ ᠦᠶ᠎ᠡ ᠎ᠶᠢᠨ</unicode>
          <transcript>-- [yj-e] jin</transcript>
          <definition> Present, actual, contemporary, current.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
