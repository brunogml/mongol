    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠳᠥᠺᠠᠺᠥ</unicode>
      <uighur>edügekü</uighur>
      <cyrillic>өдөөх</cyrillic>
      <transcript>EDYGE-</transcript>
      <definition>[= ødyge-, V. caus. of edy-] v.t. To instigate, provoke, incite; to lure, allure.</definition>
      <page>294</page>
      <examples>
        <example>
          <unicode>ᠳᠠᠶᠢᠰᠤᠨ ᠢ ᠡᠳᠥᠺᠠᠺᠥ</unicode>
          <transcript>daisun i --ky </transcript>
          <definition>To provoke the enemy</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠷᠡᠭᠦᠯ ᠡᠳᠥᠺᠠᠺᠥ</unicode>
          <transcript>keregyl --ky </transcript>
          <definition>To start a quarrel</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠳᠬᠤᠨ ᠡᠳᠥᠺᠠᠺᠥ</unicode>
          <transcript>xadxun --ky </transcript>
          <definition>To bait, provoke, instigate</definition>
        </example>
      </examples>
    </entry_item>
