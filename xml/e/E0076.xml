  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠨᠳᠠᠺᠥ</unicode>
      <uighur>endekü</uighur>
      <cyrillic>эндэх</cyrillic>
      <transcript>ENDE-</transcript>
      <definition>v. i To err, fall into error, be mistaken, blunder; to go astray; to die. Cf. anda -.</definition>
      <page>315</page>
      <examples>
        <example>
          <unicode>ᠡᠨᠳᠠᠺᠦ ᠦᠭᠡᠢ</unicode>
          <transcript>--ky ygei</transcript>
          <definition>Without mistake or fail; without going astray; infallible, faultless.</definition>
        </example>
        <example>
          <unicode>ᠡᠨᠳᠠᠵᠦ ᠠᠯᠠᠬᠤ</unicode>
          <transcript>--zy alaxu.</transcript>
          <definition>To kill by mistake</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠶᠢᠨ ᠎ᠳᠤ ᠡᠨᠳᠠᠺᠦ</unicode>
          <transcript>dain du --ky</transcript>
          <definition>To die in battle</definition>
        </example>
        <example>
          <unicode>ᠮᠥᠷ ᠡᠨᠳᠠᠺᠦ</unicode>
          <transcript>mør --ky</transcript>
          <definition>To go astray, Close track</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠮ ᠡᠨᠳᠠᠺᠦ</unicode>
          <transcript>zam --ky</transcript>
          <definition>To stray; to err, make a mistake.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠡᠨᠳᠡᠺᠦ</unicode>
      <definition>se tromper, être coupable commettre une faute; s'égarer (du chemin droit, dans la route du bien), errer, être en erreur, se méprendre; :2 métaphor. mourir, déceder.</definition>
      <page>170</page>
      <examples>
        <example>
          <unicode>ᠡᠨᠳᠡᠺᠦ ᠦᠭᠡᠢ</unicode>
          <definition>ne pas se tromper, ne pas commettre de faute; ne pas s'écarter du chemin droit; savoir bien, connaître parfaitement, distînguer sans faute.</definition>
        </example>
        <example>
          <unicode>ᠮᠥᠷ ᠡᠳᠡᠺᠦ</unicode>
          <definition>s'écarter de la route, perdre la trace.</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠮ ᠡᠳᠡᠺᠦ</unicode>
          <definition>perdre son chemin</definition>
        </example>
      </examples>
    </entry_item>
