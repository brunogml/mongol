    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠷᠺᠢᠴᠠᠺᠥᠯᠺᠥ</unicode>
      <uighur>ergičegülkü</uighur>
      <cyrillic>эргэцүүлэх</cyrillic>
      <transcript>ERGICEGYL-</transcript>
      <definition>[v. caus. of ergice-] To turn over; to consider, think over, examine; to walk (v. t., as a horse or dog); to work at, be busy with.</definition>
      <page>324</page>
      <examples>
        <example>
          <unicode>ᠡᠷᠺᠢᠴᠠᠺᠥᠯᠦᠨ ᠪᠣᠳᠤᠬᠤ</unicode>
          <transcript>--yn boduxu</transcript>
          <definition> To think through, compare or consider from various angles, weigh; to imagine, suppose.</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠺᠢᠴᠠᠺᠥᠯᠦᠨ ᠨᠢᠭᠲᠠᠯᠠᠬᠤ</unicode>
          <transcript>--yn nrrtalaxu</transcript>
          <definition> To examine from all side, look over.</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠺᠢᠴᠠᠺᠥᠯᠦᠨ ᠰᠠᠨᠠᠬᠤ</unicode>
          <transcript>--yn sanaxu</transcript>
          <definition> To think over, consider, ponder, imagine.</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠳᠺᠢᠯ ᠎ᠳᠡᠭᠡᠨ ᠡᠷᠺᠢᠴᠠᠺᠥᠯᠺᠦ</unicode>
          <transcript>sedkil degen --ky </transcript>
          <definition>To contemplate, ponder</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠡᠷᠺᠢᠴᠠᠺᠥᠯᠺᠥ</unicode>
      <uighur>erkičegülkü</uighur>
      <definition>faire tourner; 2 ordonner (à la sentinelle) de faire le tour: 3 penser, réfléchir</definition>
      <page>271</page>
      <examples>
        <example>
          <unicode>ᠡᠷᠺᠢᠴᠡᠭᠦᠯᠦᠨ ᠨᠠᠶᠢᠳᠠᠯᠠᠬᠤ</unicode>
          <definition>examiner de tous les côtés, regarder tout autour</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠺᠢᠴᠡᠭᠦᠯᠦᠨ ᠰᠠᠨᠠᠬᠤ</unicode>
          <definition>penser, réfléchir; imaginer</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
