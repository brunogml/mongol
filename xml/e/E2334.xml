    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠷᠺᠠᠲᠠᠢ</unicode>
      <uighur>erkedei</uighur>
      <cyrillic>эрхтэй</cyrillic>
      <transcript>ERKETEI</transcript>
      <definition>[= erkety] adj. Having power, rights, privileges, or jurisdiczion; being free.</definition>
      <page>330</page>
      <examples>
        <example>
          <unicode>ᠡᠷᠺᠠᠲᠠᠢ ᠺᠦᠪᠡᠭᠦᠨ</unicode>
          <transcript>-- kybegyn</transcript>
          <definition>Spoiled boy, a boy brought up too permissively, delicately brought up.</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠺᠠᠲᠠᠢ ᠺᠦᠮᠦᠨ</unicode>
          <transcript>-- kymyn</transcript>
          <definition>Powerful person; privileged person.</definition>
        </example>
        <example>
          <unicode>ᠪᠦᠷᠢᠨ ᠡᠷᠺᠠᠲᠠᠢ</unicode>
          <transcript>byrin --</transcript>
          <definition>Fully empowered or authorized; (=tusaγar toγtaniγsan) independent, sovereign.</definition>
        </example>
        <example>
          <unicode>ᠪᠦᠷᠢᠨ ᠡᠷᠺᠠᠲᠠᠢ ᠰᠠᠶᠢᠳ</unicode>
          <transcript>byrin -- said</transcript>
          <definition>Minister plenipotentiary.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠰᠤᠯᠬᠤ ᠡᠷᠺᠠᠲᠠᠢ</unicode>
          <transcript>tasulxu --</transcript>
          <definition>Having the right to vote or make decisions.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠭᠰᠢ ᠡᠷᠺᠠᠲᠠᠢ</unicode>
          <transcript>tegsi --</transcript>
          <definition>Having equal power[s] or right[s]</definition>
        </example>
        <example>
          <unicode>ᠵᠥᠪᠯᠡᠺᠦ ᠡᠷᠺᠠᠲᠠᠢ</unicode>
          <transcript>zøbleky --</transcript>
          <definition>Having the right to deliberate.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
