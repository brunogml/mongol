    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠷᠠᠮᠰᠢᠺᠥ</unicode>
      <uighur>eremsikü</uighur>
      <cyrillic>эрэмших</cyrillic>
      <transcript>EREMSI-</transcript>
      <definition>To hope, rely upon; to take courage; to give oneself airs, be haughty, arrogant; to become accustomed to; to act with impunity taking undue advantage of one's wealth or connections.</definition>
      <page>323</page>
      <examples>
        <example>
          <unicode>ᠡᠷᠠᠮᠰᠢᠺᠦ ᠰᠡᠳᠺᠢᠯ</unicode>
          <transcript>--ky sedkil</transcript>
          <definition> Pride, haughtiness, swagger.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠴᠦᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠢᠶᠡᠷ ᠪᠦᠦ ᠡᠷᠠᠮᠰᠢ</unicode>
          <transcript>kycyn dyr ijen byy --!</transcript>
          <definition> Do not take undue advantage of your strength!.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠴᠦᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠢᠶᠡᠨ ᠡᠷᠠᠮᠰᠢ</unicode>
          <transcript>kycyn dyr ijen --ky </transcript>
          <definition>To rely on one's strength</definition>
        </example>
      </examples>
    </entry_item>
