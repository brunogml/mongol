      <dico>Lessing</dico>
      <unicode>ᠡᠯᠳᠠᠺᠥ</unicode>
      <uighur>eldekü</uighur>
      <cyrillic>элдэх</cyrillic>
      <transcript>ELDE-</transcript>
      <definition>1 v.t. To dress, curry, prepare, soften, tan (of leather); to knead; to roll or flatten (of dough); to beat, drub.</definition>
      <page>307</page>
      <examples>
        <example>
          <unicode>ᠡᠯᠳᠡᠭᠰᠡᠨ ᠲᠠᠮᠠᠺᠢ</unicode>
          <transcript>--gsen tamaki</transcript>
          <definition> Ground tobacco.</definition>
        </example>
        <example>
          <unicode>ᠠᠷᠠᠰᠤᠨ ᠡᠯᠳᠡᠺᠦ ᠺᠦᠮᠦᠨ</unicode>
          <transcript>arasun --ky kymyn</transcript>
          <definition> Currier, leather-dresser, tanner.</definition>
        </example>
        <example>
          <unicode>ᠭᠤᠯᠢᠷ ᠡᠯᠳᠡᠺᠦ</unicode>
          <transcript>γulir --ky </transcript>
          <definition>To knead flour, make dough</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠮᠦᠨ ᠢ ᠡᠯᠳᠡᠺᠦ</unicode>
          <transcript>kymyn i --ky  </transcript>
          <definition>To give somebody a severe thrashing</definition>
        </example>
        <example>
          <unicode>ᠰᠤᠷ ᠡᠯᠳᠡᠺᠦ</unicode>
          <transcript>sur --ky </transcript>
          <definition>To soften a leather strap</definition>
        </example>
