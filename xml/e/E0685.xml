    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠳᠥᠢ</unicode>
      <uighur>edüi</uighur>
      <cyrillic>өдий - -дүй</cyrillic>
      <transcript>EDYI</transcript>
      <definition>1 post pos. Not yet (usually preceded by nomen imperfecti ).</definition>
      <page>295</page>
      <examples>
        <example>
          <unicode>ᠢᠷᠡᠭᠡ ᠡᠳᠥᠢ ᠴᠠᠭ</unicode>
          <transcript>irege -- caγ</transcript>
          <definition> Time which has not yet come, future.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠡ ᠶᠠᠪᠤᠲᠠᠯ᠎ᠠ ᠡᠳᠥᠢ</unicode>
          <transcript>tere jabutal-a --</transcript>
          <definition> It is still too early for him to go.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠲᠠᠨ ᠎ᠳᠤ ᠺᠦᠷᠺᠦ ᠡᠳᠥᠢ</unicode>
          <transcript>xotan du kyrky --</transcript>
          <definition> It is still a long way to the city; it will still take a long time to reach the city.</definition>
        </example>
        <example>
          <unicode>ᠦᠵᠡᠭᠡ ᠡᠳᠥᠢ</unicode>
          <transcript>yzege --</transcript>
          <definition> Have not seen yet, unseen before.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
