    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠰᠠ</unicode>
      <uighur>ese</uighur>
      <cyrillic>эс</cyrillic>
      <transcript>ESE</transcript>
      <definition>Negation used before all indicative forms of verbs, nomen perfecti, conditional and concessive converbs; may take verbal suffixes; see next entry. Not, no.</definition>
      <page>333</page>
      <examples>
        <example>
          <unicode>ᠡᠰᠠ ᠪᠣᠯᠬᠤ</unicode>
          <transcript>-- bolxu</transcript>
          <definition>To be of no avail, come to naught; to decline, reject.</definition>
        </example>
        <example>
          <unicode>ᠡᠰᠠ ᠪᠦᠭᠡᠰᠦ</unicode>
          <transcript>-- bygesy</transcript>
          <definition>If not, otherwise, or else.</definition>
        </example>
        <example>
          <unicode>ᠡᠰᠠ ᠡᠭᠦᠳᠦᠭᠰᠡᠨ</unicode>
          <transcript>-- egydygsen</transcript>
          <definition>Not created; sell-existent; simple, not complicated.</definition>
        </example>
        <example>
          <unicode>ᠡᠰᠠ ᠡᠵᠡᠯᠡᠭᠰᠡᠨ</unicode>
          <transcript>-- ezelegsen</transcript>
          <definition>Invincible, unconquerable, unharmed, incorruptible, safe.</definition>
        </example>
        <example>
          <unicode>ᠡᠰᠠ ᠢᠯᠠᠭᠳᠠᠭᠰᠠᠨ</unicode>
          <transcript>-- ilaγdaγsan</transcript>
          <definition>Invincible, unconquerable, victorious.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠭᠰᠢ ᠡᠰᠠ ᠢᠷᠡᠪᠡ</unicode>
          <transcript>baγsi -- irebe</transcript>
          <definition>The teacher did not come.</definition>
        </example>
        <example>
          <unicode>ᠲᠠ ᠡᠰᠠ ᠢᠷᠡᠪᠡᠰᠦ</unicode>
          <transcript>ta -- irebesy</transcript>
          <definition>If you will not come.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠰᠠ</unicode>
      <transcript>ESE</transcript>
      <definition>Not. Negative expressions formed with ese have often been listed under their positive forms</definition>
      <page>1169</page>
      <examples>
        <example>
          <unicode>ᠡᠰᠡ ᠢᠯᠠᠭᠳᠠᠭᠰᠠᠨ</unicode>
          <transcript>+++ ,-- ilaγdaγsan;</transcript>
          <definition>T. ma pham pa; S. ajita. The unconquerable one, special ep. of Maidari, but also frequent with other divinities.</definition>
        </example>
        <example>
          <unicode>ᠡᠰᠡ ᠥᠭᠭᠦᠭᠰᠡᠨ ᠢ ᠠᠪᠤᠯᠭ᠎ᠠ</unicode>
          <transcript>+++ -- oggygsen i abulga;</transcript>
          <definition>T. ma byin (par) len pa; S. adatt-ādāyika. Taking what has not been given, stealing.</definition>
        </example>
        <example>
          <unicode>ᠡᠰᠡ ᠲᠥᠷᠦᠭᠰᠡᠨ ᠳᠠᠶᠢᠰᠤᠨ</unicode>
          <transcript>+++ -- tøirygsen daisun;</transcript>
          <definition>T. ma skyes dgra; Sa. Ajataçatru. 'Unborn enemy,' King of Magadha, at first hostile to Šagjamuni.</definition>
        </example>
        <example>
          <unicode>ᠡᠰᠡ ᠬᠣᠯᠢᠴᠠᠯᠳᠤᠭᠰᠠᠨ ᠠᠷᠪᠠᠨ ᠨᠠᠶᠢᠮᠠᠨ ᠨᠣᠮ</unicode>
          <transcript>++ -- xolicalduγsan arban naiman nom;</transcript>
          <definition>T. chos ma hdres pa; S. avenika-dharmah.The eighteen exclusive qualities of the Bu.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠡᠰᠡ</unicode>
      <definition>non, ne, partic. négative qui se place ordinairement devant les temps passés des verbes et des participes</definition>
      <page>190</page>
      <examples>
        <example>
          <unicode>ᠡᠰᠡ ᠡᠵᠡᠯᠡᠺᠰᠡᠨ</unicode>
          <definition>invincible, non endommagé, incorruptible, sauf.</definition>
        </example>
        <example>
          <unicode>ᠡᠰᠡ ᠡᠭᠦᠳᠦᠺᠰᠡᠨ</unicode>
          <definition>non creé, existant par lui-même; 2 simple, non composé.</definition>
        </example>
        <example>
          <unicode>ᠡᠰᠡ ᠢᠯᠠᠬᠳᠠᠬᠰᠠᠨ</unicode>
          <definition>invincible, victorieux, triomphant: 2 épithète de Maytreya bodhisattva</definition>
        </example>
        <example>
          <unicode>ᠡᠰᠡ ᠥᠭᠺᠦᠺᠰᠡᠨ ᠢ ᠠᠪᠤᠬᠴᠢ</unicode>
          <definition>celui qui prend ce qu on ne lui donne pas, voleur</definition>
        </example>
        <example>
          <unicode>ᠡᠰᠡ ᠨᠡᠺᠡᠺᠴᠢ ᠵᠢᠷᠦᠺᠡᠨ</unicode>
          <definition>épithète de çâkyamouui bouddha.</definition>
        </example>
        <example>
          <unicode>ᠡᠰᠡ ᠲᠥᠷᠥᠺᠰᠡᠨ ᠳᠠᠶᠢᠰᠤᠨ</unicode>
          <definition>qui n'engendre pas de haine. Ab. Rém. 2 Adjâtacatru roi de Magadha.</definition>
        </example>
        <example>
          <unicode>ᠡᠰᠡ ᠪᠦᠭᠡᠰᠦ . ᠡᠰᠡᠪᠡᠰᠦ</unicode>
          <definition>ou (dans les propositions interrogatives, et s'il est répété) soit-soit</definition>
        </example>
      </examples>
