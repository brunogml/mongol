      <dico>Lessing</dico>
      <unicode>ᠡᠺᠠᠰᠢᠺ</unicode>
      <uighur>egesik</uighur>
      <cyrillic>эгшиг</cyrillic>
      <transcript>EGESIG</transcript>
      <definition>n. Musical sound or tone; euphony, melody, song; modulation of voice; pronunciation; vowel.</definition>
      <page>299</page>
      <examples>
        <example>
          <unicode>ᠡᠺᠠᠰᠢᠺ ᠠᠪᠢᠶ᠎ᠠ</unicode>
          <transcript>-- abij-a</transcript>
          <definition> Vowel sound.</definition>
        </example>
        <example>
          <unicode>ᠡᠺᠠᠰᠢᠺ ᠠᠶᠠᠯᠭᠤ</unicode>
          <transcript>-- ajalγu</transcript>
          <definition> Musical tones; vowel sounds.</definition>
        </example>
        <example>
          <unicode>ᠡᠺᠠᠰᠢᠺ ᠠᠶᠠᠯᠭᠤ ᠎ᠶᠢᠨ ᠰᠤᠷᠤᠯᠭ᠎ᠠ</unicode>
          <transcript>-- ajalγu jin surulγ-a</transcript>
          <definition> Phonetics.</definition>
        </example>
        <example>
          <unicode>ᠡᠺᠠᠰᠢᠺ ᠳᠠᠭᠤᠨ</unicode>
          <transcript>-- daγun</transcript>
          <definition> Harmony; melody; vowel.</definition>
        </example>
        <example>
          <unicode>ᠡᠺᠠᠰᠢᠺ ᠳᠠᠭᠤᠨ ᠤ ᠲᠠᠭᠠᠷᠠᠯ</unicode>
          <transcript>-- daγun u taγaral</transcript>
          <definition> Vowel harmony.</definition>
        </example>
        <example>
          <unicode>ᠡᠺᠠᠰᠢᠺ ᠺᠥᠭᠵᠢᠮ</unicode>
          <transcript>-- køgzim</transcript>
          <definition> Tune melody, music.</definition>
        </example>
        <example>
          <unicode>ᠡᠺᠠᠰᠢᠺ ᠨᠡᠶᠢᠯᠡᠭᠦᠯᠦᠨ ᠳᠠᠭᠤᠯᠠᠬᠤ</unicode>
          <transcript>-- neilegylyn daγulaxu</transcript>
          <definition> To sing with a melodious voice.</definition>
        </example>
        <example>
          <unicode>ᠡᠺᠠᠰᠢᠺ ᠲᠠᠲᠠᠬᠤ</unicode>
          <transcript>-- tataxu</transcript>
