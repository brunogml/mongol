      <dico>Lessing</dico>
      <unicode>ᠡᠳᠯᠠᠺᠥᠯᠺᠥ</unicode>
      <uighur>edlegülkü</uighur>
      <cyrillic>эдлүүлэх</cyrillic>
      <transcript>EDLEGYL-</transcript>
      <definition>[v. caus. of edle-] To allow to or let use; to entrust, charge with, allow to control; to cause to bear, let suffer.</definition>
      <page>294</page>
      <examples>
        <example>
          <unicode>ᠡᠷᠺᠡ ᠎ᠶᠢ ᠡᠳᠯᠠᠺᠥᠯᠺᠥ</unicode>
          <transcript>erke ji --ky</transcript>
          <definition>To confer the right or power</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠰᠢᠭᠤᠨ ᠢ ᠡᠳᠯᠠᠺᠥᠯᠺᠥ</unicode>
          <transcript>γasiγun i --ky </transcript>
          <definition>To subject a person to sufferings</definition>
        </example>
      </examples>
    </entry_item>
