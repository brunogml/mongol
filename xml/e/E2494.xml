  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠷᠺᠥᠮᠵᠢᠯᠠᠺᠥ</unicode>
      <uighur>ergümǰilekü</uighur>
      <cyrillic>өргөмжлөх</cyrillic>
      <transcript>ERGYMZILE-</transcript>
      <definition>v. t. To raise, elevate (as to a rank.); to confer, grant; or bestow a rank, title, dignity, etc.; to show respect toward.</definition>
      <page>326</page>
      <examples>
        <example>
          <unicode>ᠡᠷᠺᠥᠮᠵᠢᠯᠠᠨ ᠣᠯᠭᠤᠬᠤ</unicode>
          <transcript>-n olγuxu</transcript>
          <definition> To grant (as a title or rank).</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠺᠥᠮᠵᠢᠯᠠᠵᠦ ᠪᠢᠴᠢᠺᠦ</unicode>
          <transcript>--zy biciky</transcript>
          <definition> To begin a new line and elevate the first word in that line above the margin (as a token of respect).</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠮᠦᠨ ᠢ ᠡᠷᠺᠥᠮᠵᠢᠯᠠᠺᠦ</unicode>
          <transcript>kymyn i --ky </transcript>
          <definition>To show respect to a person</definition>
        </example>
        <example>
          <unicode>ᠨᠡᠺᠡᠵᠦ ᠡᠷᠺᠥᠮᠵᠢᠯᠠᠺᠦ</unicode>
          <transcript>nekezy --ky </transcript>
          <definition>To confer a posthumous title</definition>
        </example>
        <example>
          <unicode>ᠸᠠᠩ ᠺᠡᠷᠭᠡᠮ ᠡᠷᠺᠥᠮᠵᠢᠯᠠᠺᠦ</unicode>
          <transcript>vang kergem --ky </transcript>
          <definition>To confer the dignity of prince upon somebody</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠡᠷᠺᠥᠮᠵᠢᠯᠠᠺᠥ</unicode>
      <uighur>ergümǰilekü</uighur>
      <definition>créer un mandarin, élever quelqu'un à une dignité, conferer à quelqu'un une dignité, un rang.</definition>
      <page>273</page>
      <examples>
        <example>
          <unicode>ᠸᠠᠩ ᠺᠡᠷᠺᠡᠮ ᠡᠷᠭᠦᠮᠵᠢᠯᠡᠪᠡ</unicode>
          <definition>il conféra la dignité de Wang (prince)</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Schmidt</dico>
      <unicode>ᠡᠷᠺᠥᠮᠵᠢᠯᠠᠺᠥ</unicode>
      <uighur>ergümkilekü</uighur>
      <definition>belohnen, erheben, erhöhen</definition>
      <page>32</page>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠡᠷᠺᠥᠮᠵᠢᠯᠠᠺᠥ</unicode>
      <uighur>ergümǰilekü</uighur>
      <definition>v.t. To bestow honours, to confer nobility, to reward, to recompense (by honouring). To magnify, to elevate, to exalt, to extol.</definition>
      <page>125</page>
    </entry_item>
    <entry_item>
      <dico>Chinese</dico>
      <unicode>ᠡᠷᠺᠥᠮᠵᠢᠯᠠᠺᠥ</unicode>
      <cyrillic>өргөмжлөх</cyrillic>
      <definition>〔动〕①封诰，加封；封号，封赠，授予荣誉称号：нэхэж ~ 追封，追赠以…称号，给谥号；нэмж ~ 加封；дэвшүүлэн ~ 晋封；~н олгох 授予；②提拔，提升，晋升；③关怀，照料，照顾.</definition>
      <page>857</page>
    </entry_item>
    <entry_item>
      <dico>lamrd</dico>
      <unicode>ᠡᠷᠺᠥᠮᠵᠢᠯᠠᠺᠥ</unicode>
      <cyrillic>ӨРГӨМЖЛӨХ</cyrillic>
      <definition>возвышать, возводить в сан; присваивать почётное звание; провозглашать кем-л.; величать; чествовать; гүнгийн зэрэг өргөмжлөх возвести в достоинство гун, возвести в графское достоинство; нэхэн өргөмжлөх присваивать посмертно звание; тэнгэрт тултал өргөмжлөх возносить до небес. </definition>
      <page>0</page>
    </entry_item>
