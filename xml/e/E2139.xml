    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠷᠢᠶᠠᠯᠠᠺᠥ</unicode>
      <uighur>eriyelekü</uighur>
      <cyrillic>эрээлэх</cyrillic>
      <transcript>ERIJELE-</transcript>
      <definition>v. t. and i. To variegate; to dapple, make spotted, striped; to be or appear variegated, striped, or streaky.</definition>
      <page>327</page>
      <examples>
        <example>
          <unicode>ᠡᠯᠳᠡᠪ ᠪᠤᠳᠤᠭ ᠢᠶᠠᠷ ᠡᠷᠢᠶᠠᠯᠠᠺᠥ</unicode>
          <transcript>eldeb buduγ ijer --ky</transcript>
          <definition>To variagate with different colors</definition>
        </example>
        <example>
          <unicode>ᠮᠥᠷ ᠡᠷᠢᠶᠠᠯᠠᠨ ᠪᠠᠶᠢᠮᠤᠢ</unicode>
          <transcript>mør --n baimui</transcript>
          <definition>The tracks go criscross.</definition>
        </example>
      </examples>
    </entry_item>
