    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠵᠠᠷᠺᠠᠺᠥ</unicode>
      <uighur>eǰerkekü</uighur>
      <cyrillic>эзэрхэх</cyrillic>
      <transcript>EZERKE-</transcript>
      <definition>v.i. and t. To act arbitrarily, highhandedly, despotically; to act like an autocrat; to seize other people's property, usurp,</definition>
      <page>337</page>
      <examples>
        <example>
          <unicode>ᠡᠵᠠᠷᠺᠠᠺᠴᠢ</unicode>
          <transcript>--gci anggi</transcript>
          <definition> Ruling class.</definition>
        </example>
        <example>
          <unicode>ᠡᠵᠠᠷᠺᠠᠨ ᠠᠪᠬᠤ</unicode>
          <transcript>--n abxu, </transcript>
          <definition>To occupy, seize, usurp</definition>
        </example>
        <example>
          <unicode>ᠡᠵᠠᠷᠺᠠᠵᠦ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>--zy jabuxu</transcript>
          <definition> To act arbitrarily.</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠺᠡ ᠡᠵᠠᠷᠺᠠᠺᠥ</unicode>
          <transcript>erke --ky </transcript>
          <definition>To take the law in one's own hands, take by force</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
