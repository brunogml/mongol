    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠺᠥᠰᠺᠠᠺᠥ</unicode>
      <uighur>egüsgekü</uighur>
      <cyrillic>үүсгэх</cyrillic>
      <transcript>EGYSKE-</transcript>
      <definition>[v. caus. of, egys-] To lay the ground or foundation, make begin, cause to originate, produce; to make, start (as a war); to set in motion, give an impetus, stimulate; to create, establish; to commence.</definition>
      <page>302</page>
      <examples>
        <example>
          <unicode>ᠡᠭᠦᠰᠭᠡᠭᠴᠢ</unicode>
          <transcript>--gci</transcript>
          <definition> See separate entry.</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠰᠭᠡᠺᠦᠢ</unicode>
          <transcript>--kyi </transcript>
          <definition>Beginning, origin, appearance, phenomenon</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠰᠭᠡᠨ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <transcript>--n γarγaxu</transcript>
          <definition> To found, originate; to introduce, initiate.</definition>
        </example>
        <example>
          <unicode>ᠠᠷᠭ᠎ᠠ ᠡᠭᠦᠰᠭᠡᠺᠦ</unicode>
          <transcript>arγ-a --ky </transcript>
          <definition>To find ways and means, take steps or measures; to use a ruse</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠶᠢᠯᠳᠤᠭᠠᠨ ᠢ ᠡᠭᠦᠰᠭᠡᠵᠦ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <transcript>bailduγan i --zy γarγaxu</transcript>
          <definition> To start a war.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠰᠠᠯᠠᠩ ᠰᠡᠳᠺᠢᠯ ᠪᠤᠤ ᠡᠭᠦᠰᠭᠡ</unicode>
          <transcript>γasalang sedkil buu -- </transcript>
          <definition>Do not abandon yourself to grief, do not grieve</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠭᠤ ᠰᠠᠨᠠᠭ᠎ᠠ ᠡᠭᠦᠰᠭᠡᠺᠦ</unicode>
          <transcript>maγu sanaγ-a --ky </transcript>
          <definition>To conceive an evil plan</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠭᠦᠰᠺᠡᠺᠦ</unicode>
      <transcript>EGYSKEKY </transcript>
      <page>1168</page>
      <examples>
        <example>
          <unicode>ᠪᠢᠯᠢᠭ ᠢ ᠡᠭᠦᠰᠺᠡᠺᠦ</unicode>
          <transcript>bilig i --; </transcript>
          <definition>T. çes rab, skyed pa; S.prajnavardhana. Increase of wisdom. </definition>
        </example>
        <example>
          <unicode>ᠪᠣᠳᠢ ᠬᠤᠲᠤᠭ ᠎ᠲᠤᠷ ᠰᠡᠳᠺᠢᠯ ᠡᠭᠦᠰᠺᠡᠺᠦ</unicode>
          <transcript>+++ bodi xutuγ tur sedkil -- ; </transcript>
          <definition>T. byang chub tu sems bskyed; S. bodhi -cittotpida. To awaken the mind in or to enlightenment. ED 229. </definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠎ᠲᠤᠷ ᠡᠭᠦᠰᠺᠡᠺᠦ</unicode>
          <transcript>+++ øber tyr --; </transcript>
          <definition>T. bdag bskyed. That part of the bytygel arγ-a where the lama mentally realizes his identity with the deity he evokes. Self-realization through self-deification. See bej-e, zarliγ, sedkil. </definition>
        </example>
        <example>
          <unicode>ᠰᠡᠳᠺᠢᠯ ᠡᠭᠦᠰᠺᠡᠺᠦ</unicode>
          <transcript>+++ sedkil --; </transcript>
          <definition>T. sems (b)skyed pa; S. cittotāda Intention to enter the path leading to enlightemnent. ED229b</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠡᠭᠦᠰᠺᠡᠺᠦ</unicode>
      <definition>donner le commencement, commencer, fonder quelque chose, établir; entreprendre: 2 produire, créer, faire.</definition>
      <page>239</page>
      <examples>
        <example>
          <unicode>ᠠᠷᠭ᠎ᠠ ᠡᠭᠦᠰᠺᠡᠺᠦ</unicode>
          <definition>inventer une moyen, employer la ruse</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠰᠺᠡᠺᠦ ᠦᠺᠦᠯᠡᠯ</unicode>
          <definition>interprétation élémentaire.</definition>
        </example>
        <example>
          <unicode>ᠦᠢᠯᠡᠳᠪᠦᠷᠢ ᠎ᠶᠢ ᠡᠭᠦᠰᠺᠡᠺᠳᠦᠨ</unicode>
          <definition>commencez l'ouvrage (travail)</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠳᠺᠢᠯ ᠡᠭᠦᠰᠺᠡᠺᠦ</unicode>
          <definition>s'appliqiuer, s'efforcer, entreprendre, se determiner a quelq. ch., se mettre à ..., faire le commencement de quelque chose.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠰᠠᠯᠠᠩ ᠰᠡᠳᠺᠢᠯ ᠢ ᠪᠤᠤ ᠡᠭᠦᠰᠺᠡ</unicode>
          <definition>ne t'abandonne pas au chagrin, ne te chagrine pas.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠰᠤᠯᠠᠯ ᠺᠦᠺᠵᠢᠮ ᠢ ᠡᠭᠦᠰᠺᠡᠺᠦ</unicode>
          <definition>régler les cérémonies et la musique</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠯᠢᠵᠡ ᠡᠩᠺᠦᠢ ᠎ᠶᠢᠨ ᠺᠦᠴᠦᠨ ᠢ ᠡᠭᠦᠰᠺᠡᠺᠦ</unicode>
          <definition>s'habituer à la patience.</definition>
        </example>
      </examples>
