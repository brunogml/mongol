    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠷᠺᠢᠯᠠᠺᠥ</unicode>
      <uighur>erkilekü</uighur>
      <cyrillic>эрхлэх</cyrillic>
      <transcript>ERKILE-</transcript>
      <definition>V. t, and i. To have charge of, manage, direct; to occupy oneself with.</definition>
      <page>330</page>
      <examples>
        <example>
          <unicode>ᠡᠷᠺᠢᠯᠠᠭᠴᠢ</unicode>
          <transcript>--gci</transcript>
          <definition> See separate entry.</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠺᠢᠯᠠᠭᠴᠢᠳ</unicode>
          <transcript>--gcid</transcript>
          <definition> Plural of erkilegci,</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠺᠢᠯᠠᠭᠰᠡᠨ ᠰᠠᠶᠢᠳ</unicode>
          <transcript>--gsen said</transcript>
          <definition> Head of a ministry (obs., Ch. Shang-shu)</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠺᠢᠯᠠᠨ ᠪᠠᠶᠢᠴᠠᠭᠠᠭᠴᠢ ᠰᠠᠶᠢᠳ</unicode>
          <transcript>--n baicaγaγci said</transcript>
          <definition> Chief prosecutor (obs. Ch. tso-tu yü -shih).</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠺᠢᠯᠠ ᠰᠢᠯᠭᠠᠭᠴᠢ ᠲᠦᠰᠢᠮᠡᠯ</unicode>
          <transcript>--n silγaγci tysimel</transcript>
          <definition> Chief examiner ( obs. Ch. cheng-k'ao-kuan ).</definition>
        </example>
        <example>
          <unicode>ᠠᠵᠢᠯ ᠡᠷᠺᠢᠯᠠᠺᠦ</unicode>
          <transcript>azil i --ky </transcript>
          <definition>To direct, manage, or be in charge of a job</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠭᠰᠢ ᠎ᠶᠢᠨ ᠠᠵᠢᠯ ᠡᠷᠺᠢᠯᠠᠺᠦ</unicode>
          <transcript>baγsi jin azil --ky </transcript>
          <definition>To be engaged in teaching, do educational work</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠎ᠶᠢᠨ ᠺᠦᠴᠦᠨ ᠢ ᠡᠷᠺᠢᠯᠠᠺᠦ</unicode>
          <transcript>bej-e jin kycyn i --ky </transcript>
          <definition>To do manual or physical work</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠷᠡᠭ ᠡᠷᠺᠢᠯᠠᠺᠦ ᠭᠠᠵᠠᠷ</unicode>
          <transcript>kereg –ky γazar</transcript>
          <definition> Secretariat.</definition>
        </example>
        <example>
          <unicode>ᠰᠣᠨᠢᠨ ᠢ ᠡᠷᠺᠢᠯᠠᠺᠦ</unicode>
          <transcript>sonin i --ky </transcript>
          <definition>To edit or manage a newspaper</definition>
        </example>
      </examples>
    </entry_item>
