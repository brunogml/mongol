      <dico>Lessing</dico>
      <unicode>ᠡᠺᠠᠯᠳᠥᠷᠺᠥ</unicode>
      <uighur>egeldürkü</uighur>
      <cyrillic>эгэлдрэх</cyrillic>
      <transcript>EGELDYR-</transcript>
      <definition>v.t. To hang something on the arm, carryon the arm or slung over the shoulder; to tow or track a boat with ropes; to bind, tie, tie around.</definition>
      <page>297</page>
      <examples>
        <example>
          <unicode>ᠪᠤᠤ ᠡᠺᠠᠯᠳᠥᠷᠺᠥ</unicode>
          <transcript>buu --ky </transcript>
          <definition>To carry a gun slung over the shoulder</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠷ ᠡᠺᠠᠯᠳᠥᠷᠺᠥ</unicode>
          <transcript>γar --ky</transcript>
          <definition> To carry the arm in a sling.</definition>
        </example>
      </examples>
    </entry_item>
