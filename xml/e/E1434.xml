      <dico>Lessing</dico>
      <unicode>ᠡᠺᠠᠨᠠᠷ</unicode>
      <uighur>ekener</uighur>
      <cyrillic>эхнэр</cyrillic>
      <transcript>EKENER</transcript>
      <definition>[Originally pl. of eke] n, and adj. Woman, wife, married woman, women in general female.</definition>
      <page>305</page>
      <examples>
        <example>
          <unicode>ᠡᠺᠠᠨᠠᠷ ᠠᠪᠬᠤ</unicode>
          <transcript>-- abxu</transcript>
          <definition>To take a wife, marry (of a man).</definition>
        </example>
        <example>
          <unicode>ᠡᠺᠠᠨᠠᠷ ᠭᠡᠭᠡᠺᠦ</unicode>
          <transcript>-- gegeky</transcript>
          <definition>To divorce a wife.</definition>
        </example>
        <example>
          <unicode>ᠡᠺᠠᠨᠠᠷ ᠺᠡᠦᠺᠡᠨ</unicode>
          <transcript>-- keyken</transcript>
          <definition>Women and girls.</definition>
        </example>
        <example>
          <unicode>ᠡᠺᠠᠨᠠᠷ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition>Unmarried man, bachelor.</definition>
        </example>
      </examples>
