    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠺᠥᠷᠺᠥ</unicode>
      <uighur>egürkü</uighur>
      <cyrillic>үүрэх</cyrillic>
      <transcript>EGYR-</transcript>
      <definition>[= ygyr-] v.t To carry or load on one's back; to bear; to take a burden or responsibility upon oneself.</definition>
      <page>301</page>
      <examples>
        <example>
          <unicode>ᠪᠤᠤ ᠡᠺᠥᠷᠺᠥ</unicode>
          <transcript>buu --ky </transcript>
          <definition>To carry a gun on ones back</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠷᠤᠭᠤ ᠪᠡᠨ ᠲᠣᠯᠤᠭᠠᠢ ᠎ᠳᠠᠭᠠᠨ ᠡᠺᠥᠷᠺᠥ</unicode>
          <transcript>buruγu ben toluγai daγan --ky </transcript>
          <definition>To take the consequence of one's error</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠯᠠ ᠡᠺᠥᠷᠺᠥ</unicode>
          <transcript>jala --ky</transcript>
          <definition> To be fined, penalized.</definition>
        </example>
        <example>
          <unicode>ᠨᠡᠷ᠎ᠡ ᠡᠺᠥᠷᠺᠥ</unicode>
          <transcript>ner-e --ky </transcript>
          <definition>To have the reputation of, be notorious for</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠷᠤᠭᠤ ᠪᠡᠨ ᠡᠺᠥᠷᠺᠥ</unicode>
          <transcript>niruγu ben --ky </transcript>
          <definition>To carry one's hands behind one's back</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠯᠤᠭᠠᠢ ᠎ᠳᠠᠭᠠᠨ ᠡᠺᠥᠷᠺᠥ</unicode>
          <transcript>toluγai daγan --ky </transcript>
          <definition>To take on, as a task or responsibility</definition>
        </example>
        <example>
          <unicode>ᠲᠤᠰᠢᠶᠠᠯ ᠡᠺᠥᠷᠺᠥ</unicode>
          <transcript>tusijal --ky </transcript>
          <definition>To be charged or occupied with</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
