      <dico>Lessing</dico>
      <unicode>ᠡᠪᠯᠠᠯᠳᠥᠺᠥ</unicode>
      <uighur>ebleldükü</uighur>
      <cyrillic>эвлэлдэх</cyrillic>
      <transcript>EBLELDY-</transcript>
      <definition>[v. rec. of eble-] To agree mutually, make o an agreement; to be organized into a union.</definition>
      <page>288</page>
      <examples>
        <example>
          <unicode>ᠡᠪᠯᠠᠯᠳᠥᠨ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>--n jabuxu</transcript>
          <definition>To proceed or act jointly or in agreement with.</definition>
        </example>
        <example>
          <unicode>ᠡᠪᠯᠠᠯᠳᠥᠨ ᠨᠢᠭᠡᠳᠺᠦ</unicode>
          <transcript>--n nigedky</transcript>
          <definition> To unite, form an organization,</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠤ ᠪᠡᠷ ᠡᠪᠯᠠᠯᠳᠥᠭᠰᠡᠨ ᠺᠦᠴᠦᠨ</unicode>
          <transcript>batu her --gsen kycyn</transcript>
          <definition> Consolidated power,</definition>
        </example>
      </examples>
