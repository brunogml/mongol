    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠡᠨᠠᠷᠢᠺᠥ</unicode>
      <uighur>enerikü</uighur>
      <cyrillic>энэрэх</cyrillic>
      <transcript>ENERI-</transcript>
      <definition>v.i. To have pity or compassion; to be touched or moved; to be benevolent, display tender love, show sympathy or humaneness.</definition>
      <page>317</page>
      <examples>
        <example>
          <unicode>ᠡᠨᠠᠷᠢᠭᠴᠢ</unicode>
          <transcript>--gci</transcript>
          <definition> Softhearted, compassionate.</definition>
        </example>
        <example>
          <unicode>ᠡᠨᠠᠷᠢᠭᠴᠢ ᠡᠺᠡ</unicode>
          <transcript>- -gci eke</transcript>
          <definition> Tender-hearted mother.</definition>
        </example>
        <example>
          <unicode>ᠡᠨᠠᠷᠢᠺᠦᠢ ᠰᠡᠳᠺᠢᠯ ᠲᠥᠷᠦᠺᠦ</unicode>
          <transcript>--kyi sedkil tøryky</transcript>
          <definition> To have compassion.</definition>
        </example>
      </examples>
    </entry_item>
