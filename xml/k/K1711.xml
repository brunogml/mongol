      <dico>Lessing</dico>
      <unicode>ᠺᠠᠷᠺᠢᠺᠥ</unicode>
      <uighur>kerkikü</uighur>
      <cyrillic>хэрхэх</cyrillic>
      <transcript>KERKI-</transcript>
      <definition>[ker +.ki-] v.interrog. How to act?. What to do?. How to proceed?.</definition>
      <page>458</page>
      <examples>
        <example>
          <unicode>ᠺᠠᠷᠺᠢᠪᠡᠴᠦ</unicode>
          <transcript>--becy</transcript>
          <definition> No matter how, _by all means, in any case</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠷᠺᠢᠪᠡᠴᠦ ᠪᠡᠷ</unicode>
          <transcript>-- becy ber</transcript>
          <definition> Under any circumstance., no matter how, in any case</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠷᠺᠢᠪᠡᠴᠦ ᠪᠡᠷ ᠬᠠᠯᠠᠵᠤ ᠦᠯᠦ ᠪᠣᠯᠤᠮᠤᠢ</unicode>
          <transcript>--becy ber xalazu yly bolumui</transcript>
          <definition> Under no circumstances should one change it</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠷᠺᠢᠪᠡᠴᠦ ... ᠦᠭᠡᠢ</unicode>
          <transcript>--becy … ygei</transcript>
          <definition> In no way, by no means.</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠷᠺᠢᠨ</unicode>
          <transcript>--n </transcript>
          <definition>How? Which way?. In what matter?.</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠷᠺᠢᠵᠦ</unicode>
          <transcript>--zy </transcript>
          <definition>How? In what manner?</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠶᠢᠰᠢ ᠲᠠᠯᠪᠢᠵᠤ ᠺᠠᠷᠺᠢᠪᠡᠴᠦ ᠦᠯᠦ ᠪᠣᠯᠤᠮᠤᠢ</unicode>
          <transcript>xoisi talbizu --becy yly bolumui</transcript>
          <definition> Under no circumstance should It be delayed or put off.</definition>
        </example>
      </examples>
