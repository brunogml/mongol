      <dico>Lessing</dico>
      <unicode>ᠺᠥᠷᠪᠡᠺᠥᠯᠺᠥ</unicode>
      <uighur>körbegülkü</uighur>
      <cyrillic>хөрвүүлэх</cyrillic>
      <transcript>KØRBEGYL-</transcript>
      <definition>v.t. To turn, turn over; to change, alter; to buy and resell; to translate.</definition>
      <page>490</page>
      <examples>
        <example>
          <unicode>ᠴᠢᠨᠠᠭᠰᠢ</unicode>
          <transcript>cinaγsi --ky</transcript>
          <definition>To turn to another direction</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠭᠤ ᠺᠥᠷᠪᠡᠺᠥᠯᠺᠥ</unicode>
          <transcript>daγu –ky</transcript>
          <definition>To disguise one's voice; to imitate another's voice</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
