      <dico>Lessing</dico>
      <unicode>ᠭᠥᠷᠢᠮ</unicode>
      <uighur>gürim</uighur>
      <cyrillic>гүрэм</cyrillic>
      <transcript>GYRIM</transcript>
      <definition>[=gyrym,T. sku rim] n. Religious ceremony, prayer, rite; rank, grade.</definition>
      <page>392</page>
      <examples>
        <example>
          <unicode>ᠭᠥᠷᠢᠮ ᠪᠦᠲᠦᠭᠡᠺᠦ</unicode>
          <transcript>-- bytygeky</transcript>
          <definition>To conduct a religious ceremony; to venerate.</definition>
        </example>
        <example>
          <unicode>ᠭᠥᠷᠢᠮ ᠺᠢᠺᠦ</unicode>
          <transcript>-- kiky</transcript>
          <definition>To conduct or perform a religious ceremony.</definition>
        </example>
        <example>
          <uighur>gᠥᠷᠢᠮ ungsigulqu</uighur>
          <transcript>-- ungsiγulxu</transcript>
          <definition>To have a religious ceremony performed.</definition>
        </example>
      </examples>
