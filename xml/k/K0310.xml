    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠭᠡᠪ</unicode>
      <uighur>geb</uighur>
      <cyrillic>гэв</cyrillic>
      <transcript>GEB</transcript>
      <definition>Intensifying particle used before certain adj. and adv. beginning with the syllable ge</definition>
      <page>372</page>
      <examples>
        <example>
          <unicode>ᠭᠡᠪ ᠭᠡᠭᠡᠭᠡᠨ</unicode>
          <transcript>-- gegegen</transcript>
          <definition>Very bright, most serene.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠪ ᠭᠡᠨᠡᠳᠲᠡ</unicode>
          <transcript>-- genedte</transcript>
          <definition>Suddenly, quite unexpectedly.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠪ ᠭᠡᠨᠡᠳᠲᠡᠺᠡᠨ</unicode>
          <transcript>-- genedteken</transcript>
          <definition>Suddenly, all of a sudden.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
