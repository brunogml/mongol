    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠠᠯᠪᠠᠷᠢᠺᠥ</unicode>
      <uighur>kelberikü</uighur>
      <cyrillic>хэлбэрэх</cyrillic>
      <transcript>KELBERI-</transcript>
      <definition>v.i. To lean to one side, incline, slope; to be biased; to sway, swing; to deviate from the norm, be abnormal; to act insincerely or deceitfully.</definition>
      <page>446</page>
      <examples>
        <example>
          <unicode>ᠺᠠᠯᠪᠠᠷᠢᠨ ᠭᠤᠯᠪᠠᠬᠤ</unicode>
          <transcript>--n γulbaxu</transcript>
          <definition>To deviate from the correct path.</definition>
        </example>
        <example>
          <unicode>ᠨᠠᠷᠠᠨ ᠺᠠᠯᠪᠠᠷᠢᠪᠡ</unicode>
          <transcript>naran --be</transcript>
          <definition>The sun is setting.</definition>
        </example>
        <example>
          <unicode>ᠦᠯᠦ ᠺᠠᠯᠪᠠᠷᠢᠭᠴᠢ</unicode>
          <transcript>yly --gci</transcript>
          <definition>Immutable, unchangeable, firm</definition>
        </example>
      </examples>
    </entry_item>
