    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠠᠮᠠᠺᠥ</unicode>
      <uighur>kemekü</uighur>
      <cyrillic>хэмээх</cyrillic>
      <transcript>KEME-</transcript>
      <definition>v.i. To say, speak; to be named or called; to intend (cf. kemen).</definition>
      <page>450</page>
      <examples>
        <example>
          <unicode>ᠺᠠᠮᠠᠪᠡᠴᠦ</unicode>
          <transcript>… --becy</transcript>
          <definition>Even, although (in neg. sentences).</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠮᠠᠪᠡᠰᠦ</unicode>
          <transcript>… --besy</transcript>
          <definition>If or when one says ...</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠮᠠᠨ</unicode>
          <transcript>--n</transcript>
          <definition>mod conv. of keme-. See separate entry for special uses.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠤ ᠺᠠᠮᠠᠺᠦ ᠺᠦᠮᠦᠨ</unicode>
          <transcript>batu --ky kymyn</transcript>
          <definition>A man named Batu.</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠯᠬᠤ ᠦᠭᠡᠢ ᠺᠠᠮᠠᠮᠦᠢ</unicode>
          <transcript>bolxu ygei - -myi</transcript>
          <definition>[He] said no.</definition>
        </example>
        <example>
          <unicode>ᠴᠢ ᠶᠠᠭᠤᠨ ᠺᠠᠮᠠᠪᠡ</unicode>
          <transcript>ci javun --be?</transcript>
          <definition>What did you say?.</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠷᠤᠨ ᠺᠠᠮᠠᠪᠡᠰᠦ</unicode>
          <transcript>jarun --besy</transcript>
          <definition>If one asks why or what.</definition>
        </example>
        <example>
          <unicode>ᠨᠡᠷ᠎ᠡ ᠺᠠᠮᠠᠭᠰᠡᠨ</unicode>
          <transcript>ner-e --gsen</transcript>
          <definition>In name only.</definition>
        </example>
        <example>
          <unicode>ᠨᠡᠷ᠎ᠡ ᠺᠠᠮᠠᠭᠰᠡᠨ ᠡᠮ᠎ᠡ</unicode>
          <transcript>ner-e --gsen em-e</transcript>
          <definition>Wife in name only.</definition>
        </example>
        <example>
          <unicode>ᠦᠯᠢᠭᠡᠷ ᠤᠨ ᠳᠠᠯᠠᠢ ᠺᠠᠮᠠᠺᠦ ᠨᠣᠮ</unicode>
          <transcript>yliger yn dalai --ky nom</transcript>
          <definition>The book called 'Ocean of stories'</definition>
        </example>
      </examples>
    </entry_item>
