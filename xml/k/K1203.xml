    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠭᠡᠭᠡᠺᠠ ~ ᠭᠡᠭᠡᠭᠡᠨ</unicode>
      <uighur>gegege - gegegen</uighur>
      <cyrillic>гэгээ(н)</cyrillic>
      <transcript>GEGEGE(N)</transcript>
      <definition>[=gege(n)] n, and adj. Daylight; morning dawn; light; . splendor, brightness; heart, mind (honorific); bright, brilliant, serene</definition>
      <page>373</page>
      <examples>
        <example>
          <unicode>ᠭᠡᠭᠡᠺᠠ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <transcript>-- γarγaxu</transcript>
          <definition>To radiate.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠺᠠᠨ ᠴᠠᠭᠠᠨ</unicode>
          <transcript>--n caγan</transcript>
          <definition>Bright, light.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠺᠠᠨ ᠴᠠᠭᠠᠨ ᠡᠳᠦᠷ ᠢᠶᠡᠷ</unicode>
          <transcript>--n caγan edyr ijer</transcript>
          <definition>In broad daylight.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠺᠠᠨ ᠎ᠳᠡᠭᠡᠨ ᠠᠶᠢᠯᠠᠳᠬᠤ</unicode>
          <transcript>--n degen ailadxu</transcript>
          <definition>To consider (honorific).</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠺᠠᠨ ᠣᠶᠤᠲᠤ</unicode>
          <transcript>---n ojutu</transcript>
          <definition>Intelligent, enlightened, having a clear mind.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠺᠠ ᠣᠷᠤᠮ</unicode>
          <transcript>-- orum</transcript>
          <definition>To dawn; to be lighted or illuminated; to recover one's eyesight; to begin to see.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠺᠠ ᠲᠠᠰᠤᠯᠭ᠎ᠠ</unicode>
          <transcript>-- tasulγ-a</transcript>
          <definition>Light room.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠺᠠ ᠲᠠᠰᠤᠷᠠᠬᠤ</unicode>
          <transcript>-- tasuraxu,</transcript>
          <definition>To grow dark (of the day)</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠭᠰᠢ ᠭᠡᠭᠡᠺᠠ ᠎ᠳᠡᠭᠡᠨ ᠰᠡᠳᠺᠢᠪᠡᠢ</unicode>
          <transcript>baγsi -- degen sedkibei</transcript>
          <definition>The teacher thought in his mind.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
