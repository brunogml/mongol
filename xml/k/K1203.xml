    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠺᠠᠺᠠᠺᠠ</unicode>
      <uighur>kekeken</uighur>
      <definition>Lightness, brightness. Clearness. The face of God, a sovereign, prince or idol. The title of a high priest.</definition>
      <page>775</page>
      <examples>
        <example>
          <uighur>kekeken eǰen</uighur>
          <definition>n. A good sovereign.</definition>
        </example>
        <example>
          <uighur>kekeken ügei</uighur>
          <definition>Rustic. Unpolished. Coarse.</definition>
        </example>
      </examples>
