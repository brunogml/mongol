    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠺᠡᠷ</unicode>
      <definition>comme , quel, quelle.</definition>
      <page>2502</page>
      <examples>
        <example>
          <unicode>ᠡᠨᠡ ᠡᠺᠡ ᠪᠡᠷ ᠺᠡᠷ ᠮᠡᠲᠦ ᠺᠡᠨ ᠡᠴᠡ ᠠᠨᠠᠬᠤᠢ ᠪᠣᠯᠬᠤ</unicode>
          <definition>de quelle manière et par qui cette mère peut être guérie?</definition>
        </example>
        <example>
          <unicode>ᠤᠷᠢᠳᠠ ᠺᠡᠷ ᠪᠣᠯᠤᠭᠰᠠᠨ ᠰᠢᠯᠲᠠᠭᠠᠨ ᠢ ᠥᠭᠦᠯᠡᠺᠦ</unicode>
          <definition>raconter les faits antérieurs, i.e. tout ce qui est arrivé</definition>
        </example>
        <example>
          <unicode>ᠪᠢ ᠪᠡᠷ ᠡᠺᠡ ᠎ᠳᠡᠭᠡᠨ ᠺᠡᠷ ᠲᠤᠰᠠᠯᠠᠬᠤ</unicode>
          <definition>quel secours puis-je porter à ma mère?</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠷ ᠦᠭᠡᠢ</unicode>
          <definition>personne; celui qui manque</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠷ ᠪᠦᠭᠡᠳ</unicode>
          <definition>quand</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠷ ᠲᠡᠳᠦᠢ</unicode>
          <definition>tant, autant, tout autant</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠷ ᠮᠡᠲᠦ</unicode>
          <definition>comme, ainsi, ainsi que</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠷ ᠵᠠᠷᠯᠢᠬ ᠪᠣᠯᠤᠭᠰᠠᠨ ᠤ ᠵᠣᠰᠤᠭᠠᠷ ᠺᠦ ᠪᠣᠯᠲᠤᠭᠠᠢ</unicode>
          <definition>que votre parole s'accomplisse! i.e. j'exécuterai cvotre ordre</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠷ ᠺᠡᠮᠡᠨ</unicode>
          <definition>comme cela est dit</definition>
        </example>
      </examples>
