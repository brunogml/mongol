    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠡᠭᠦᠷ</unicode>
      <uighur>kegür</uighur>
      <cyrillic>хүүр</cyrillic>
      <transcript>KEGYR</transcript>
      <definition>n. Corpse, dead body; cemetery.</definition>
      <page>443</page>
      <examples>
        <example>
          <unicode>ᠺᠡᠭᠦᠷ ᠠᠭᠤᠯᠬᠤ ᠭᠠᠵᠠᠷ</unicode>
          <transcript>-- aγulxu yazar</transcript>
          <definition>Morgue, mortuary.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠭᠦᠷ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <transcript>-- γarγaxu</transcript>
          <definition>To remove a corpse (from the tent Into the steppe or to the burying ground ).</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠺᠥᠷ ᠢ ᠣᠩᠭᠤᠯᠠᠬᠤ</unicode>
          <transcript>-- [i] ongγulaxu</transcript>
          <definition>To bury the dead.</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠺᠥᠷ ᠣᠷᠤᠰᠢᠭᠤᠯᠬᠤ ᠭᠠᠵᠠᠷ</unicode>
          <transcript>-- orusiγulxu γazar</transcript>
          <definition>Burial place, grave .</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠺᠥᠷ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <transcript>-- talbixu</transcript>
          <definition>To remove a corpse into the steppe, bury the dead</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠺᠥᠷ ᠬᠠᠶᠢᠯᠠᠬᠤ</unicode>
          <transcript>-- xailaxu</transcript>
          <definition>To cremate a corpse.</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠺᠥᠷ ᠬᠠᠶᠠᠬᠤ</unicode>
          <transcript>-- xajaxu,</transcript>
          <definition>To bury (lit throwaway) the corpse.</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠺᠥᠷ ᠤᠨ ᠪᠤᠯᠠᠰᠢ</unicode>
          <transcript>-- yn bulasi</transcript>
          <definition>Tomb, burial ground</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠺᠥᠷ ᠤᠨ ᠳᠠᠪᠤᠰᠤ</unicode>
          <transcript>-- yn dabusu</transcript>
          <definition>, Salt used for preserving a dead body.</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠺᠥᠷ ᠤᠨ ᠭᠠᠵᠠᠷ</unicode>
          <transcript>-- yn γazar</transcript>
          <definition>Cemetery.</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠺᠥᠷ ᠤᠨ ᠮᠣᠳᠤ</unicode>
          <transcript>-- yn modu</transcript>
          <definition>Wood used for cremating a corpse, funeral pyre.</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠺᠥᠷ ᠤᠨ ᠣᠪᠤᠭ᠎ᠠ</unicode>
          <transcript>-- yn obuγ-a,</transcript>
          <definition>Tomb, sepulcher</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠺᠥᠷ ᠤᠨ ᠣᠷᠢᠶᠠᠳᠠᠰᠤ</unicode>
          <transcript>-- yn orijadasu</transcript>
          <definition>Cotton sheet for wrapping a dead body, shroud.</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠺᠥᠷ ᠤᠨ ᠣᠷᠤᠰᠢᠯ</unicode>
          <transcript>-- yn orusil</transcript>
          <definition>Burial ground, sepulcher.</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠺᠥᠷ ᠤᠨ ᠲᠠᠯᠪᠢᠭᠤᠷ</unicode>
          <transcript>-- yn talbiγur ,</transcript>
          <definition>Catafalque</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠺᠥᠷ ᠤᠨ ᠬᠤᠪᠴᠠᠰᠤ</unicode>
          <transcript>-- yn xubcasu</transcript>
          <definition>Shroud, winding-sheet.</definition>
        </example>
        <example>
          <unicode>ᠡᠪᠦᠭᠡᠳ ᠤᠨ ᠺᠠᠺᠥᠷ ᠪᠤᠮᠪᠠ ᠎ᠶᠢ ᠲᠠᠺᠢᠬᠤ</unicode>
          <transcript>-- ebyged yn -- bumba ji takixu</transcript>
          <definition>To worship or make offerings at the tombs of the ancestors.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
