          <definition>tissu en coton pour envelopper les morts</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠭᠦᠷ ᠣᠷᠣᠰᠢᠭᠤᠯᠬᠤ</unicode>
          <definition>enterrer les morts</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠭᠦᠷ ᠤᠨ ᠦᠨᠡᠰᠦᠨ</unicode>
          <definition>les cendres du trépassé</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠭᠦᠷ ᠬᠠᠶᠢᠯᠠᠬᠤ</unicode>
          <definition>brûler un corps</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠭᠦᠷ ᠤᠨ ᠬᠤᠪᠴᠠᠰᠤᠨ</unicode>
          <definition>un suaire, linceul</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠭᠦᠷ ᠤᠨ ᠪᠠᠶᠢᠰᠢᠩ</unicode>
          <definition>place préparée pour brûler un corps, bûcher funéraire, cimetière</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠭᠦᠷ ᠤᠨ ᠪᠤᠯᠠᠰᠢ</unicode>
          <definition>tombe, tombeau</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠭᠦᠷ ᠲᠠᠪᠢᠬᠤ</unicode>
          <definition>enterrer un mort</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠭᠦᠷ ᠲᠦᠯᠡᠺᠦ</unicode>
          <definition>brûler le cadavre</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠭᠦᠷ ᠤᠨ ᠲᠠᠪᠤᠰᠤᠨ</unicode>
          <definition>sel jeté au dessus et au dessous d'un corps mort</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠭᠦᠷ ᠤᠨ ᠮᠣᠳᠤᠨ</unicode>
          <definition>bûcher funéraire</definition>
        </example>
      </examples>
