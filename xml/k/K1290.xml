    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠺᠠᠺᠥᠷ</unicode>
      <uighur>kegür</uighur>
      <definition>n. A dead body. A corpse. Rumour, saying. Report.</definition>
      <page>586</page>
      <examples>
        <example>
          <uighur>kegür-ün bolasi</uighur>
          <definition>n. A grave, a tomb, a sepulchre .</definition>
        </example>
        <example>
          <uighur>kegür orosiγulqu</uighur>
