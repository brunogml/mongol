    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠥᠭᠡᠺᠦ</unicode>
      <uighur>kökekü</uighur>
      <cyrillic>хөөх</cyrillic>
      <transcript>KØGE-</transcript>
      <definition>2 v.t To chase, pursue, expel; to exclude; to fire.</definition>
      <page>478</page>
      <examples>
        <example>
          <unicode>ᠺᠥᠺᠡᠨ ᠠᠷᠢᠯᠭᠠᠬᠤ</unicode>
          <transcript>--n arilγaxu</transcript>
          <definition>To expel, purge.</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠺᠡᠨ ᠵᠠᠶᠢᠯᠠᠭᠤᠯᠬᠤ</unicode>
          <transcript>--n zailaγulxu</transcript>
          <definition>To drive away, expel.</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠺᠡᠵᠦ ᠭᠦᠢᠴᠡᠺᠦ</unicode>
          <transcript>--zy gyiceky</transcript>
          <definition>To pursue and catch up with.</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠺᠡᠵᠦ ᠲᠠᠷᠬᠠᠭᠠᠬᠤ</unicode>
          <transcript>--zy tarxaγaxu</transcript>
          <definition>To disperse.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠠᠭᠠᠨ᠎ᠠ ᠺᠥᠺᠡᠺᠦ</unicode>
          <transcript>bataγan-a --ky</transcript>
          <definition>To chase away flies.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠳᠡᠷᠭᠦᠦ ᠺᠥᠺᠡᠺᠦ</unicode>
          <transcript>gedergyy --ky</transcript>
          <definition>To chase back.</definition>
        </example>
      </examples>
    </entry_item>
