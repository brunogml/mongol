  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠠᠮᠺᠠᠯᠠᠺᠥ</unicode>
      <uighur>kemkelekü</uighur>
      <cyrillic>хэмхлэх</cyrillic>
      <transcript>KEMKELE-</transcript>
      <definition>[=xamxala-] v.t. To break to, pieces, smash; to pulverize, crush, stamp; to shatter, squash; to pound in a mortar; to make a dent, indent.</definition>
      <page>451</page>
      <examples>
        <example>
          <unicode>ᠴᠢᠯᠠᠭᠤ ᠺᠠᠮᠺᠠᠯᠠᠺᠥ</unicode>
          <transcript>cilaγu --ky</transcript>
          <definition>To pound stones (into small pieces)</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠷᠤᠵᠤ ᠺᠠᠮᠺᠠᠯᠠᠺᠥ</unicode>
          <transcript>daruzu --ky</transcript>
          <definition>To crush, squash</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠺᠡᠮᠺᠡᠯᠡᠺᠦ</unicode>
      <definition>morceler, mettre en pièces, briser, piler, casser (les noisettes, les oeufs), concasser, pulvériser.</definition>
      <page>2488</page>
      <examples>
        <example>
          <unicode>ᠪᠢᠰᠢᠷᠡᠯᠲᠦ ᠸᠴᠢᠷ ᠢᠶᠡᠷ ᠤᠮᠤᠭ ᠤᠨ ᠠᠭᠤᠯᠠ ᠎ᠶᠢ ᠺᠡᠮᠺᠡᠯᠡᠺᠦ</unicode>
          <definition>pulvériser la montagne d'orgueil avec le sceptre de la piété</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠯᠠᠭᠤ ᠺᠡᠮᠺᠡᠯᠡᠺᠦ</unicode>
          <definition>briser la pierre</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠰᠤᠨ ᠢ ᠰᠢᠯᠠᠭᠤᠨ ᠢᠶᠠᠷ ᠺᠡᠮᠺᠡᠯᠡᠺᠦ</unicode>
          <definition>fracasser un os avec une pierre</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Schmidt</dico>
      <unicode>ᠺᠠᠮᠺᠠᠯᠠᠺᠥ</unicode>
      <uighur>kemkelekü</uighur>
      <definition>in kleine Stücke zerbrechen, zerstückeln, zermalmen</definition>
      <page>149</page>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠺᠠᠮᠺᠠᠯᠠᠺᠥ</unicode>
      <uighur>kemkelekü</uighur>
      <definition>v.t. To break into small pieces. To cut into little pieces. To crush or dash into pieces.</definition>
      <page>589</page>
    </entry_item>
