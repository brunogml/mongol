  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠢᠯᠠᠮᠺᠢᠺᠥ</unicode>
      <uighur>kilamkikü</uighur>
      <cyrillic>хяламхийх</cyrillic>
      <transcript>KILAMKI-</transcript>
      <definition>v.t. To look about, look behind one, turn one's head to look at something; to lose one's head, take fright; to be worried.</definition>
      <page>466</page>
      <examples>
        <example>
          <unicode>ᠺᠢᠯᠠᠮᠺᠢᠨ ᠦᠵᠡᠺᠦ</unicode>
          <transcript>--n yzeky</transcript>
          <definition>To look about; to look behind one.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠺᠢᠯᠡᠮᠺᠢᠺᠦ ~ ᠺᠢᠯᠡᠮ ᠺᠢᠺᠦ</unicode>
      <definition>1 regarder autour de soi, regarder derrière soi, tourner la tète pour voir qc.: 
2 être inquiet, perdre la tête, prendre la peur.</definition>
      <page>2529</page>
      <examples>
        <example>
          <unicode>ᠺᠢᠯᠠᠮ ᠺᠢᠵᠦ ᠦᠵᠡᠺᠦ = ᠺᠢᠯᠠᠮᠺᠢᠨ ᠦᠵᠡᠺᠦ</unicode>
          <definition>regarder autour de oi, regarder derrière soi</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Schmidt</dico>
      <unicode>ᠺᠢᠯᠠᠮᠺᠢᠺᠥ</unicode>
      <uighur>kilemkikü</uighur>
      <definition>seitwärts blicken, einen Seitenblick auf etwas werfen; unstätt seyn</definition>
      <page>156</page>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠺᠢᠯᠠᠮᠺᠢᠺᠥ</unicode>
      <uighur>kilemkiqu</uighur>
      <definition>To look by stealth sideways. To look askance.</definition>
      <page>788</page>
