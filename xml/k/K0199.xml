    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠭᠡᠨᠠᠳᠠᠺᠥ</unicode>
      <uighur>genedekü</uighur>
      <cyrillic>гэндэх</cyrillic>
      <transcript>GENEDE-</transcript>
      <definition>v.i. To be taken by surprise, be panic-stricken; to overlook; to take a false step, to commit a mistake; to be credulous.</definition>
      <page>377</page>
      <examples>
        <example>
          <unicode>ᠭᠡᠨᠠᠳᠠᠵᠦ ᠳᠠᠶᠢᠰᠤᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠪᠠᠷᠢᠭᠳᠠᠬᠤ</unicode>
          <transcript>- -zy daisun dur bariγdaxu</transcript>
          <definition> To be seized by the enemy by surprise.</definition>
        </example>
      </examples>
    </entry_item>
