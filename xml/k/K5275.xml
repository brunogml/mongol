      <dico>Lessing</dico>
      <unicode>ᠭᠭᠢᠷᠲᠡᠺᠥ</unicode>
      <uighur>kkirdekü</uighur>
      <cyrillic>хиртэх</cyrillic>
      <transcript>GKIRTE-</transcript>
      <definition>To be[come] foul, soiled, or dirty; to be[come] obscured or eclipsed (as the sun).</definition>
      <page>385</page>
      <examples>
        <example>
          <unicode>ᠭᠭᠢᠷᠲᠡᠭᠰᠡᠨ</unicode>
          <transcript>--gsen</transcript>
          <definition> Soiled, dirty.</definition>
        </example>
        <example>
          <unicode>ᠭᠭᠢᠷᠲᠡᠺᠦ ᠠᠮᠤᠷᠬᠠᠨ</unicode>
          <transcript>--ky amurxan</transcript>
          <definition> Easily soiled.</definition>
        </example>
        <example>
          <unicode>ᠨᠠᠷᠠ ᠭᠭᠢᠷᠲᠡᠺᠦ</unicode>
          <transcript>nara - -ky</transcript>
          <definition> For the sun to be eclipsed.</definition>
        </example>
      </examples>
    </entry_item>
