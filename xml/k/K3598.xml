    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠥᠪᠺᠡᠯᠺᠥ</unicode>
      <uighur>köbkelkü</uighur>
      <cyrillic>хөвхлөх</cyrillic>
      <transcript>KØBKEL-</transcript>
      <definition>v.i. To jump up, start, rise; to palpitate; to take flight; to float, drift.</definition>
      <page>476</page>
      <examples>
        <example>
          <unicode>ᠤᠰᠤᠨ ᠡᠴᠡ ᠳᠡᠭᠡᠭᠰᠢᠳᠡ ᠺᠥᠪᠺᠡᠯᠺᠥ</unicode>
          <transcript>usun ece degegside--ky</transcript>
          <definition>To emerge from the water</definition>
        </example>
        <example>
          <unicode>ᠤᠰᠤᠨ ᠤ ᠢᠳᠡᠭᠡᠭᠦᠷ ᠺᠥᠪᠺᠡᠯᠦᠨ ᠣᠳᠬᠤ</unicode>
          <transcript>usun u idegegyr —- yn odxu</transcript>
          <definition>To float on the surface of water.</definition>
        </example>
        <example>
          <unicode>ᠵᠢᠷᠦᠺᠡᠨ ᠺᠥᠪᠺᠡᠯᠺᠥ</unicode>
          <transcript>ziryken --ky</transcript>
          <definition>Palpitation of the heart.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠭᠦᠪᠺᠡᠯᠺᠦ</unicode>
      <definition>1 sauter en l'air, s'élever, prendre son essort: nager sur, surnager, vauguer , flouer &#13;
2 chanceler, trembler, tremhlotter.</definition>
      <page>2582</page>
      <examples>
        <example>
          <unicode>ᠤᠰᠤᠨ ᠡᠴᠡ ᠳᠡᠭᠡᠭᠰᠢᠳᠡ ᠺᠥᠪᠺᠡᠯᠺᠦ</unicode>
          <definition>sortir de l'eau</definition>
        </example>
        <example>
          <unicode>ᠤᠰᠤᠨ ᠤ ᠳᠡᠭᠡᠭᠦᠷ ᠺᠥᠪᠺᠡᠯᠦᠨ ᠣᠳᠪᠠᠢ</unicode>
          <definition>il nagea sur l'eau</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠯᠠᠢ ᠳ᠋‍‍ᠤ‍ᠷ ᠺᠥᠪᠺᠡᠯᠦᠭᠰᠡᠨ ᠮᠣᠳᠤᠨ</unicode>
          <definition>une poutre qui flotte sur la mer</definition>
        </example>
        <example>
          <unicode>ᠵᠢᠷᠦᠺᠡᠨ ᠺᠥᠪᠺᠡᠯᠺᠦ</unicode>
          <definition>palpitation de coeur</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠪᠺᠡᠯᠦᠨ ᠶᠠᠪᠤᠭᠴᠢ</unicode>
          <definition>sauteur, sauteuse: grenouille, singe</definition>
        </example>
      </examples>
    </entry_item>
  </entries>
</entry>
