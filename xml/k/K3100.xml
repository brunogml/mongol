    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠥᠨᠳᠥᠯᠡᠺᠥ</unicode>
      <uighur>kündülekü</uighur>
      <cyrillic>хүндлэх</cyrillic>
      <transcript>KYNDYLE-</transcript>
      <definition>v. t. To show respect, revere, honor; to be polite; to treat, regale, entertain.</definition>
      <page>502</page>
      <examples>
        <example>
          <unicode>ᠺᠥᠨᠳᠥᠯᠡᠨ ᠡᠷᠭᠦᠺᠦ</unicode>
          <transcript>--n ergyky</transcript>
          <definition>To respect and honor</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠨᠳᠥᠯᠡᠨ ᠲᠠᠺᠢᠬᠤ</unicode>
          <transcript>--n takixu</transcript>
          <definition>To sacrifice with devotion</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠪᠡᠨ ᠺᠥᠨᠳᠥᠯᠡᠺᠦ</unicode>
          <transcript>bej-e ben --ky</transcript>
          <definition>To respect oneself, show self-respect.</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠭᠦᠨ ᠺᠥᠨᠳᠥᠯᠡᠺᠦ</unicode>
          <transcript>ergyn --ky</transcript>
          <definition>To respect, show deference to</definition>
        </example>
      </examples>
    </entry_item>
