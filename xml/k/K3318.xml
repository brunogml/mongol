    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠥᠪᠡᠺᠡᠯᠡᠺᠥ</unicode>
      <uighur>köbekelekü</uighur>
      <cyrillic>хөвөөлөх</cyrillic>
      <transcript>KØBEGELE-</transcript>
      <definition>v.t. and i. To border, hem, edge, trim; to move along the bank or edge.</definition>
      <page>476</page>
      <examples>
        <example>
          <unicode>ᠺᠥᠪᠡᠺᠡᠯᠡᠨ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>--n jabuxu</transcript>
          <definition>To go along the edge or shore; to skirt.</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠳᠡᠨᠢᠰ ᠢᠶᠡᠷ ᠺᠥᠪᠡᠺᠡᠯᠡᠺᠦ</unicode>
          <transcript>erdenis ijer --ky</transcript>
          <definition>Togborder with precious stones.</definition>
        </example>
        <example>
          <unicode>ᠭᠤᠤᠯᠢ ᠪᠡᠷ ᠺᠥᠪᠡᠺᠡᠯᠡᠺᠦ</unicode>
          <transcript>γuuli ber --ky</transcript>
          <definition>To make 'a brass border or trimming.</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠩᠬ᠎ᠠ ᠺᠥᠪᠡᠺᠡᠯᠡᠵᠦ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>mangx-a --zy jabuxu</transcript>
          <definition>To skirt the dunes.</definition>
        </example>
      </examples>
    </entry_item>
