    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠭᠡᠮᠰᠢᠺᠥ</unicode>
      <uighur>gemsikü</uighur>
      <cyrillic>гэмших</cyrillic>
      <transcript>GEMSI-</transcript>
      <definition>v.i. To repent, regret, feel remorse, do penance, confess (sins), plead guilty.</definition>
      <page>376</page>
      <examples>
        <example>
          <unicode>ᠭᠡᠮᠰᠢᠺᠥ ᠭᠣᠮᠤᠳᠠᠬᠤ</unicode>
          <transcript>--ky γomudaxu</transcript>
          <definition>To be sad or sorry.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠮᠰᠢᠨ ᠨᠠᠮᠠᠨᠴᠢᠯᠠᠬᠤ</unicode>
          <transcript>--n namancilaxu</transcript>
          <definition>To confess one's sin[s] and repent.</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠭᠤ ᠺᠢᠭᠰᠡᠨ ᠢᠶᠡᠨ ᠭᠡᠮᠰᠢᠺᠥ</unicode>
          <transcript>maγu kigsen ijen --ky</transcript>
          <definition>To repent one's wrong-doing.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠺᠡᠮᠰᠢᠺᠦ</unicode>
      <definition>se repentir, regretter, faire pénitence.</definition>
      <page>2485</page>
      <examples>
        <example>
          <unicode>ᠡᠴᠢᠭᠡ ᠡᠺᠡ ᠎ᠳᠡᠭᠡᠨ ᠮᠠᠭᠤ ᠺᠢᠭᠰᠡᠨ ᠢ ᠺᠡᠮᠰᠢᠮᠤᠢ ᠪᠢ</unicode>
          <definition>je me repens d'avoir fait du mal à mes parents</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠮᠰᠢᠯ ᠨᠠᠮᠠᠭᠴᠢᠯᠠᠬᠤ</unicode>
          <definition>avouer sa faute en se repentant</definition>
        </example>
      </examples>
    </entry_item>
