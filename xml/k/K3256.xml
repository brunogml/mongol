    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠦᠩᠭᠢᠨᠡᠺᠦ</unicode>
      <uighur>küngkinekü</uighur>
      <cyrillic>хүнгэнэх</cyrillic>
      <transcript>KYNGGINE-</transcript>
      <definition>[= kynggene-] v.i. To make a hollow sound.</definition>
      <page>503</page>
      <examples>
        <example>
          <unicode>ᠺᠥᠩᠺᠢᠨᠡᠨ ᠴᠢᠩᠭᠢᠨᠡᠺᠦ</unicode>
          <transcript>--zy cinggineky</transcript>
          <definition>To sound tambourines or timpani.</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠩᠺᠢᠨᠡᠵᠦ ᠰᠤᠤᠭᠢᠬᠤ</unicode>
          <transcript>--zy suugixu</transcript>
          <definition>To drone, hum (of engines).</definition>
        </example>
        <example>
          <unicode>ᠪᠦᠭᠦᠳᠦᠨ ᠺᠥᠩᠺᠢᠨᠡᠭᠰᠡᠨ ᠳᠠᠭᠤ ᠪᠡᠷ</unicode>
          <transcript>bydygyn --gsen daγu ber</transcript>
          <definition>In a deep bass.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠺᠦᠩᠭᠢᠨᠡᠺᠦ</unicode>
      <definition>marmoter entre les dents,</definition>
