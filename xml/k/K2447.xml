  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠢᠴᠢᠶᠡᠩᠺᠥᠶᠢᠯᠡᠺᠥ</unicode>
      <uighur>kičiyenggüyilekü</uighur>
      <cyrillic>хичээнгүйлэх</cyrillic>
      <transcript>KlCIJENGGYILE-</transcript>
      <definition>v.i. To be zealous or studious; to be cautious, be attentive; to take heed, beware of; to be respectful or humble</definition>
      <page>464</page>
      <examples>
        <example>
          <unicode>ᠺᠢᠴᠢᠶᠡᠩᠺᠥᠶᠢᠯᠡᠨ</unicode>
          <transcript>--n</transcript>
          <definition>With an effort, zealously; respectfully</definition>
        </example>
        <example>
          <unicode>ᠺᠢᠴᠢᠶᠡᠩᠺᠥᠶᠢᠯᠡᠨ ᠳᠠᠭᠠᠬᠤ</unicode>
          <transcript>--n daγaxu,</transcript>
          <definition>To conform respectfully</definition>
        </example>
        <example>
          <unicode>ᠺᠢᠴᠢᠶᠡᠩᠺᠥᠶᠢᠯᠡᠨ ᠭᠤᠶᠤᠬᠤ</unicode>
          <transcript>--n γujuxu</transcript>
          <definition>To request humbly.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠺᠢᠴᠢᠶᠡᠩᠭᠦᠶᠢᠯᠡᠺᠦ ~ ᠺᠢᠴᠡᠺᠡᠭᠦ</unicode>
      <definition>1 être zélê , assidu, s'appliquer à: 
2 respecter, honorer, faire honneur, rendre hommage.</definition>
      <page>2540</page>
      <examples>
        <example>
          <unicode>ᠠᠬᠠ ᠎ᠪᠠᠨ ᠺᠢᠴᠢᠶᠡᠩᠭᠦᠶᠢᠯᠡᠺᠦ</unicode>
          <definition>respecter son frère aîné</definition>
        </example>
        <example>
          <unicode>ᠺᠢᠴᠢᠶᠡᠩᠭᠦᠶᠢᠯᠡᠨ ᠪᠢᠴᠢᠺᠦ</unicode>
          <definition>écrire avec soin (scribere caracteribus perfecte efformatis), écrire d'une manière respectueuse (scribere cum reverentia)</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Schmidt</dico>
      <unicode>ᠺᠢᠴᠢᠶᠡᠩᠺᠥᠶᠢᠯᠡᠺᠥ</unicode>
      <uighur>kičiyenggüyilekü</uighur>
      <definition>mit Aufmerksamkeit, Ergebenheit oder Achtung behandeln.</definition>
      <page>159</page>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠺᠢᠴᠢᠶᠡᠩᠺᠥᠶᠢᠯᠡᠺᠥ</unicode>
      <uighur>kičiyenggüyilekü</uighur>
      <definition>v.t. To treat with attentive respect. To esteem. To take heed.</definition>
      <page>623</page>
      <examples>
        <example>
          <uighur>kičiyenggüyilen</uighur>
          <definition>With care and watchfulness. With prudence, loyalty and respect.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠺᠢᠴᠢᠶᠡᠩᠺᠥᠶᠢᠯᠡᠺᠥ</unicode>
      <uighur>kičiyenggüyilekü üsüg</uighur>
      <definition>The regular style of handwriting.</definition>
      <page>623</page>
    </entry_item>
    <entry_item>
      <dico>Chinese</dico>
      <unicode>ᠬᠢᠴᠢᠶᠡᠩᠭᠦᠢᠯᠡᠬᠦ</unicode>
      <cyrillic>хичээнгүйлэх</cyrillic>
      <definition>〔动〕①努力，勤奋，勤勉，用功：~н суралцах 用功学习；②慎重，仔细，认真；尊重：~н ёслов 敬启，敬上（书信末尾用语）；~н бичих 正写，楷书.</definition>
      <page>1343</page>
    </entry_item>
    <entry_item>
      <dico>lamrd</dico>
