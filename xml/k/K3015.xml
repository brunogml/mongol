      <dico>Lessing</dico>
      <unicode>ᠺᠥᠨᠳᠡᠯᠡᠳᠺᠥ</unicode>
      <uighur>köndeledkü</uighur>
      <cyrillic>хөндөлдөх</cyrillic>
      <transcript>KØNDELED-</transcript>
      <definition>[=køndyled-] v, t, and i, To stand athwart the road, block the way; to obstruct, stop up</definition>
      <page>488</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠪᠠ ᠺᠥᠨᠳᠡᠯᠡᠳᠺᠥ</unicode>
          <transcript>alba --ky</transcript>
          <definition> To obstruct the collection of taxes</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠮ ᠺᠥᠨᠳᠡᠯᠡᠳᠺᠥ</unicode>
          <transcript>zam --ky</transcript>
          <definition> To block the road.</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠮ ᠎ᠳᠦ ᠺᠥᠨᠳᠡᠯᠡᠳᠴᠦ ᠺᠡᠪᠲᠡᠺᠦ</unicode>
          <transcript>zam dy --cy kebteky. </transcript>
          <definition>To lie across the road.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
