      <dico>Lessing</dico>
      <unicode>ᠭᠡᠭᠡᠭᠳᠠᠺᠥ</unicode>
      <uighur>gegegdekü</uighur>
      <cyrillic>гээгдэх</cyrillic>
      <transcript>GEGEGDE-</transcript>
      <definition>[v, pass. of gege -] To be lost; to be left, rejected, repudiated.</definition>
      <page>373</page>
      <examples>
        <example>
          <unicode>ᠭᠡᠭᠡᠭᠳᠠᠭᠰᠡᠨ ᠡᠺᠡᠨᠡᠷ</unicode>
          <transcript>--gsen ekener</transcript>
          <definition>Divorced or repudiated woman.</definition>
        </example>
        <example>
          <unicode>ᠦᠭᠡ ᠭᠡᠭᠡᠭᠳᠠᠺᠦ</unicode>
          <transcript>yge --ky</transcript>
          <definition>To leave out or omit a word or words.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
