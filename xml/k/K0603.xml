  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠭᠡᠲᠦᠯᠭᠡᠺᠦ</unicode>
      <uighur>gedülgekü</uighur>
      <cyrillic>гэтэлгэх</cyrillic>
      <transcript>GETYLGE-</transcript>
      <definition>[v. caus. of getyl-] To cause to traverse or cross; to transport; to deliver from danger or misfortune; to save.</definition>
      <page>380</page>
      <examples>
        <example>
          <unicode>ᠠᠶᠤᠢ ᠡᠴᠡ ᠭᠡᠲᠥᠯᠺᠠᠺᠥ</unicode>
          <transcript>ajui ece - -ky</transcript>
          <definition>To deliver from danger.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠭᠡᠲᠦᠯᠭᠡᠺᠦ</unicode>
      <definition>1 transporter, faire traverser (sur le rivage opposé): 
2 fig. délivrer du danger.,du malheur; sauver: 
3 faire mourir.</definition>
      <page>2466</page>
      <examples>
        <example>
          <unicode>ᠠᠶᠤᠯ ᠡᠴᠡ ᠭᠡᠲᠦᠯᠭᠡᠺᠦ</unicode>
          <definition>délivrer du danger</definition>
        </example>
        <example>
          <unicode>ᠡᠨᠡ ᠮᠥᠷᠡᠨ ᠡᠴᠡ ᠨᠠᠮᠠᠶᠢ ᠭᠡᠲᠦᠯᠭᠡᠨ ᠰᠤᠶᠤᠷᠬᠠ</unicode>
          <definition>veuillez me faire traverser ce fleuve, i.e. délivrez-moi de cette vie  malheureuse</definition>
        </example>
        <example>
          <unicode>ᠤᠰᠤᠨ ᠡᠴᠡ ᠭᠡᠲᠦᠯᠭᠡᠺᠦ</unicode>
          <definition>sauver de l'eau</definition>
        </example>
        <example>
          <unicode>ᠪᠣᠳᠢ ᠰᠡᠳᠺᠢᠯ ᠳ᠋‍‍ᠤ‍ᠷ ᠬᠠᠮᠤᠭ ᠠᠮᠢᠲᠠᠨ ᠢ ᠭᠡᠲᠦᠯᠭᠡᠺᠦ</unicode>
          <definition>procurer à tous les êtres le moyen d'atteindre la Raison</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠨᠰᠠᠷ ᠤᠨ ᠴᠢᠳᠤᠷ ᠡᠴᠡ ᠭᠡᠲᠦᠯᠭᠡ</unicode>
          <definition>délivre-moi des liens du sansara</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠩᠭᠠᠷᠢᠭ ᠡᠪᠳᠡᠷᠡᠭᠰᠡᠨ ᠳᠠᠶᠢᠰᠤᠨ ᠢ ᠭᠡᠲᠦᠯᠭᠡᠺᠦ</unicode>
          <definition>tuer l'ennemi qui a violé son voeu</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠲᠦᠯᠭᠡᠺᠦᠢ ᠲᠡᠷᠭᠡᠨ</unicode>
          <definition>bateau, bâtiment; 2 chaque moyen de délivrance ou de salut</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠯᠦᠩ ᢐᠠᠷᠮ ᠠ ᠬᠠᠭᠠᠨ ᠢ ᠭᠡᠲᠦᠯᠭᠡᠪᠡᠢ</unicode>
          <definition>le ghélong a tué Darma khan</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Schmidt</dico>
      <unicode>ᠭᠡᠲᠦᠯᠭᠡᠺᠦ</unicode>
      <uighur>kedülkekü</uighur>
      <definition>hinüberführen (auf das jenseitige Ufer); aus Gefahr erretten.</definition>
      <page>199</page>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠭᠡᠲᠦᠯᠭᠡᠺᠦ</unicode>
      <uighur>kedülkekü</uighur>
      <definition>To ferry someonecwer a river or lake. To cause someone to cross a mountain or a country. To rescue from danger.</definition>
      <page>785</page>
    </entry_item>
    <entry_item>
      <dico>Chinese</dico>
      <unicode>ᠭᠡᠲᠦᠯᠭᠡᠬᠦ</unicode>
      <cyrillic>гэтэлгэх</cyrillic>
      <definition>〔动〕гэтлэх 的使动态①(хэнийг-юуг, юунаас-хэнээс)使摆脱，使避免，拯救，解放，使免遭灾祸；②使渡过，使越过，使克服；③〈宗〉超度.</definition>
      <page>356</page>
    </entry_item>
    <entry_item>
      <dico>lamrd</dico>
      <unicode>ᠭᠡᠲᠦᠯᠭᠡᠺᠦ</unicode>
      <cyrillic>ГЭТЭЛГЭХ</cyrillic>
      <definition>гэтлэх-ийн үйлдүүл., 1) освобождать, избавлять, спасать; аюулаас гэтэлгэх избавлять от опасности; зовлонгоос гэтэлгэх избавлять от мук; 2) переправлять, перевозить (на другую сторону).</definition>
      <page>0</page>
    </entry_item>
    <entry_item>
      <dico>cevel</dico>
      <unicode>ᠭᠡᠲᠦᠯᠭᠡᠬᠦ</unicode>
      <cyrillic>гэтэлгэх</cyrillic>
      <definition>гэтлэхийн үйлдүүлэх хэв. гэтлүүлэх.</definition>
      <page>171</page>
