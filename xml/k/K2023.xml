    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠭᠢᠯᠠᠯᠵᠠᠬᠣ</unicode>
      <uighur>gilalǰaqu</uighur>
      <cyrillic>гялалзах</cyrillic>
      <transcript>GILALZA-</transcript>
      <definition>[= gilulza-] v.i To twinkle, sparkle; to scintillate, glitter, gleam, shine; to be glossy or shiny; to be dazzled; to be radiant, beaming.</definition>
      <page>382</page>
      <examples>
        <example>
          <unicode>ᠭᠢᠯᠠᠯᠵᠠᠭᠰᠠᠨ</unicode>
          <transcript>--γsan</transcript>
          <definition> Shining, splendid, magnificent.</definition>
        </example>
        <example>
          <unicode>ᠣᠳᠤ ᠭᠢᠯᠠᠯᠵᠠᠵᠤ ᠪᠠᠶᠢᠮᠤᠢ</unicode>
          <transcript>odu --zu baimui</transcript>
          <definition> Stars are sparkling.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
