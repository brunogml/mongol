    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠢᠯᠺᠡᠺᠥ</unicode>
      <uighur>kilkekü</uighur>
      <cyrillic>хийлгэх</cyrillic>
      <transcript>KILGE-</transcript>
      <definition>[v. caus. of ki-] To let, cause, or force to do something, entrust a task to someone.</definition>
      <page>466</page>
      <examples>
        <example>
          <unicode>ᠠᠵᠢᠯ ᠺᠢᠯᠺᠡᠺᠥ</unicode>
          <transcript>azil --ky</transcript>
          <definition>To cause or let someone work.</definition>
        </example>
        <example>
          <unicode>ᠬᠤᠷᠠᠯ ᠺᠢᠯᠺᠡᠺᠥ</unicode>
          <transcript>xural --ky</transcript>
          <definition>To order to hold a meeting, charge with convening a meeting.</definition>
        </example>
        <example>
          <unicode>ᠦᠢᠯᠡ ᠎ᠶᠢ ᠺᠢᠯᠺᠡᠺᠥ</unicode>
          <transcript>yile [ji] --ky</transcript>
          <definition>To give somebody work to do,</definition>
        </example>
      </examples>
    </entry_item>
