    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠠᠵᠢᠶᠠᠨᠠᠢ</unicode>
      <uighur>keǰiyenei</uighur>
      <cyrillic>хэзээний</cyrillic>
      <transcript>KEZIJENEI</transcript>
      <definition>[=kezijen -e] adv. and adj. Since long ago, a long time ago; sometime ago; already; old, of long standing.</definition>
      <page>462</page>
      <examples>
        <example>
          <unicode>ᠺᠠᠵᠢᠶᠠᠨᠠᠢ ᠡᠴᠡ ᠪᠡᠨ</unicode>
          <transcript>-- ece [ben]</transcript>
          <definition> Since long ago, from olden times.</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠵᠢᠶᠠᠨᠠᠢ ᠡᠷᠲᠡ ᠡᠴᠡ</unicode>
          <transcript>-- erte [ece]</transcript>
          <definition> [From] times immemorial.</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠵᠢᠶᠠᠨᠠᠢ ᠺᠢ</unicode>
          <transcript>-- ki</transcript>
          <definition> Old (time), ancient, of old standing.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠭᠦᠨ ᠎ᠯᠦᠭᠡ ᠪᠢ ᠺᠠᠵᠢᠶᠠᠨᠠᠢ ᠲᠠᠨᠢᠯ ᠪᠦᠯᠦᠭᠡ</unicode>
          <transcript>tegyn lyge bi -- tanil bylyge</transcript>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠡ ᠺᠠᠵᠢᠶᠠᠨᠠᠢ ᠢᠷᠡᠭᠰᠡᠨ</unicode>
          <transcript>tere -- iregsen</transcript>
          <definition> He had come already some time ago</definition>
        </example>
      </examples>
    </entry_item>
