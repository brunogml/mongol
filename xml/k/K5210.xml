    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠺᠥᠷᠵᠢᠺᠢᠨᠡᠺᠥ</unicode>
      <uighur>kürǰikinekü</uighur>
      <definition>To roar, making a buzzing noise (e.g.wind or flowing water).</definition>
      <page>732</page>
      <examples>
        <example>
          <uighur>kürǰikineǰü daγun γarqu</uighur>
          <definition>Continual thundering without interruption.</definition>
        </example>
      </examples>
    </entry_item>
