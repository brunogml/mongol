    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠥᠷᠵᠢᠺᠢᠨᠡᠺᠥ</unicode>
      <uighur>kürǰikinekü</uighur>
      <cyrillic>хүржигнэх</cyrillic>
      <transcript>KYRZIGINE-</transcript>
      <definition>v.i. To make noise; to roar; to crash, rumble, din; to purr.</definition>
      <page>508</page>
      <examples>
        <example>
          <unicode>ᠺᠥᠷᠵᠢᠺᠢᠨᠡᠵᠦ ᠳᠠᠭᠤ ᠭᠠᠷᠬᠤ</unicode>
          <transcript>--zy daγu γarxu </transcript>
          <definition>To make a continuous loud noise; to roar</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠷᠵᠢᠺᠢᠨᠡᠵᠦ ᠢᠨᠢᠶᠡᠺᠦ</unicode>
          <transcript>--zy inijeky</transcript>
          <definition> To burst out laughing</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
