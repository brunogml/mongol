  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠥᠺᠡᠴᠡᠯᠳᠥᠺᠥ</unicode>
      <uighur>kökečeldükü</uighur>
      <cyrillic>хөөцөлдөх</cyrillic>
      <transcript>KØGECELDY-</transcript>
      <definition>[v, rec. of køge -] To chase after each other, pursue each other; to chase or pursue together.</definition>
      <page>479</page>
      <examples>
        <example>
          <unicode>ᠥᠪᠡᠷᠰᠡᠳ ᠤᠨ ᠡᠷᠺᠡ ᠠᠰᠢᠭ ᠢ ᠺᠥᠺᠡᠴᠡᠯᠳᠥᠺᠥ</unicode>
          <transcript>øbersed yn erke asiγ i --kyo </transcript>
          <definition>To pursue the interests of many people</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠭᠤᠰᠤᠨ ᠨᠡᠷ᠎ᠡ ᠎ᠶᠢᠨ ᠬᠣᠶᠢᠨ᠎ᠠ ᠡᠴᠡ ᠺᠥᠺᠡᠴᠡᠯᠳᠥᠺᠥ</unicode>
          <transcript>xoγusun ner-e jin xoin-a ece --ky </transcript>
          <definition>To pursue empty fame (of many people)</definition>
        </example>
      </examples>
    </entry_item>
  </entries>
