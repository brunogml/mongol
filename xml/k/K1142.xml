    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠺᠡᠺᠡᠨ</unicode>
      <definition>1 éclat, splendeur, clarté; clair, lumineux; éclatant, brillant: 
2 figure image (d'un saint); personne vénérable, grave personnage: 
3 coeur, âme; 
4 titre honoraire d'un grave personnage.</definition>
      <page>2492</page>
      <examples>
        <example>
          <unicode>ᠨᠠᠷᠠᠨ ᠭᠡᠭᠡᠨ ᠦᠭᠡᠢ</unicode>
          <definition>soleil pâle</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠳᠦᠨ ᠤ ᠭᠡᠭᠡᠨ ᠠᠨᠢᠬᠤ</unicode>
          <definition>fermer les yeux, cligner des yeux</definition>
        </example>
        <example>
          <unicode>ᠳᠡᠭᠡᠳᠦ ᠎ᠶᠢᠨ ᠭᠡᠭᠡᠨ</unicode>
          <definition>son altesse, sa sainteté</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠎ᠳᠡᠭᠡᠨ ᠠᠶᠢᠯᠠᠳᠬᠤ</unicode>
          <definition>comprendre par son coeur, avoir une connaissance profonde</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠡᠪᠳᠡᠷᠡᠭᠰᠡᠨ</unicode>
          <definition>l'éclat s'est éteint: la mort d'une personne vénérable</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠤ ᠡᠮᠦᠨᠡ</unicode>
          <definition>devant, en présence d'une grave personne</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠡ ᠢᠯᠠᠭᠤᠭᠴᠢ</unicode>
          <definition>nom d'un roi du Kôçala</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠤᠶᠤᠲᠤ = ᠭᠡᠭᠡᠨ ᠤᠳᠬᠠᠲᠠᠢ</unicode>
          <definition>qui a une intelligence claire, intelligent, éclairé, qui a du bon sens et de la pénétration</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠨᠣᠮᠲᠤ ᠳᠡᠪᠡᠯ</unicode>
          <definition>les vêtements des lamas</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠪᠡᠶ ᠡ ᠰᠡᠷᠭᠡᠺᠦ</unicode>
          <definition>la joie, le plaisir d'une personne vénérable</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠤ ᠪᠤᠶᠠᠨ ᠺᠡᠰᠢᠭ</unicode>
          <definition>félicité, prospérité, bonheur, vertu, mérite moral d'une personne vénßerable</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠳᠠᠰᠤᠷᠠᠬᠤ</unicode>
          <definition>commencer à faire sombre; 2 le crépuscule</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠲᠣᠩᠭᠠᠯᠠᠭ</unicode>
          <definition>nom d'une fête chinoise, "Sic vocantur 15 dies, a 5 ad 20 aprilis, quibus Sinenses sepulturas componunt, mundant et faciunt sacrificia mortuorum". Lex. msc.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠤ ᠮᠠᠭᠲᠠᠭᠠᠯ</unicode>
          <definition>hymne en l'honneur d'un religieux</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠵᠠᠪᠰᠠᠷ</unicode>
          <definition>l'atmosphère, l'espace intermédiaire entre la terre et le ciel lumineux</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠵᠠᠪᠰᠠᠷ ᠎ᠲᠤᠷ ᠳᠡᠭᠳᠡᠭᠡᠳ</unicode>
          <definition>s'élevant dans le ciel</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠵᠠᠪᠰᠠᠷ ᠤᠨ ᠳᠣᠯᠺᠢᠶᠠᠨ</unicode>
          <definition>fantôme, vision , apparition</definition>
        </example>
      </examples>
    </entry_item>
