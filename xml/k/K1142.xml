    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠺᠠᠺᠠᠨ</unicode>
      <uighur>keken</uighur>
      <definition>Light. The lustre of light. Refined and elegant. Title of respect.</definition>
      <page>774</page>
      <examples>
        <example>
          <uighur>keken abčiqu</uighur>
          <definition>To excuse. To forgive</definition>
        </example>
        <example>
          <uighur>keken dungγalaq</uighur>
          <definition>The Chinese "ch'ing ming"</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠺᠠᠺᠠᠨ</unicode>
      <uighur>keke dasoraqu</uighur>
      <definition>Getting dark after sunset. Twilight, eventide.</definition>
