  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠥᠯᠢᠴᠡᠺᠥ</unicode>
      <uighur>küličekü</uighur>
      <cyrillic>хүлцэх</cyrillic>
      <transcript>KYLICE-</transcript>
      <definition>v.t. A and i. To wait for, expect; to be patient; to tolerate, bear; to be indulgent or tolerant.</definition>
      <page>499</page>
      <examples>
        <example>
          <unicode>ᠨᠠᠮᠠᠶᠢ ᠺᠥᠯᠢᠴᠡᠭᠲᠦᠨ</unicode>
          <transcript>lnamaji --gtyn</transcript>
          <definition>Please forgive me.</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠯᠢᠴᠡᠨ ᠥᠩᠭᠡᠷᠡᠭᠡᠺᠦ</unicode>
          <transcript>--n ønggeregeky</transcript>
          <definition>To tolerate (someone's mistake).</definition>
        </example>
        <example>
          <unicode>ᠲᠥᠷ ᠺᠥᠯᠢᠴᠡᠺᠦ</unicode>
          <transcript>tør –ky</transcript>
          <definition>To wait a little</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠭᠦᠯᠢᠴᠡᠺᠦ</unicode>
      <definition>1 souffrir, supporter: 
2 pardonner. excuser.</definition>
      <page>2600</page>
      <examples>
        <example>
          <unicode>ᠬᠤᠷᠤᠮᠬᠠᠨ ᠺᠦᠯᠢᠴᠡ</unicode>
          <definition>patiente un peu, attends un peu</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠳᠠᠯ ᠮᠡᠭᠦᠰ ᠤᠨ ᠵᠠᠳᠠᠷᠠᠩᠭᠤᠢ ᠎ᠶᠢ ᠺᠦᠯᠢᠴᠡᠨ ᠲᠠᠭᠠᠬᠤ</unicode>
          <definition>supporter les infirmités des faibles</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠨᠠᠳᠤᠷ ᠨᠠᠮᠠᠨᠴᠢᠯᠠᠰᠤᠭᠠᠢ ᠴᠢ ᠪᠡᠷ ᠺᠦᠯᠢᠴᠡᠨ ᠰᠣᠶᠤᠷᠭ᠎ᠠ</unicode>
          <definition>je me confesserai à toi, pardonne-moi</definition>
        </example>
        <example>
          <unicode>ᠶᠡᠺᠡ ᠲᠤᠰᠠ ᠪᠦᠲᠦᠭᠡᠺᠦᠢ ᠳ᠋‍‍ᠤ‍ᠷ ᠺᠦᠯᠢᠴᠡᠺᠦᠢ ᠶᠡᠺᠡ ᠺᠡᠷᠡᠭᠲᠡᠢ ᠪᠤᠢ</unicode>
          <definition>pour accomplir une action grande et utile, il faut s'armer de patience</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠮ ᠠᠯᠳᠠᠯ ᠢ ᠺᠦᠯᠢᠴᠡᠨ ᠥᠴᠢᠺᠦ</unicode>
          <definition>demander pardon pour sa faute</definition>
        </example>
      </examples>
    </entry_item>
