      <dico>Lessing</dico>
      <unicode>ᠺᠥᠩᠺᠡᠪᠴᠢᠯᠡᠺᠥ</unicode>
      <uighur>köngkebčilekü</uighur>
      <cyrillic>хөнгөвчлөх</cyrillic>
      <transcript>KØNGGEBCILE-</transcript>
      <definition>v.t. To make lighter or easier, relieve, alleviate, assuage.</definition>
      <page>488</page>
      <examples>
        <example>
          <unicode>ᠠᠴᠢᠶ᠎ᠠ ᠪᠡᠨ ᠺᠥᠩᠺᠡᠪᠴᠢᠯᠡᠺᠥ</unicode>
          <transcript>acij-a --ky</transcript>
          <definition> To alleviate the burden</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠪᠡᠨ ᠺᠥᠩᠺᠡᠪᠴᠢᠯᠡᠺᠥ</unicode>
          <transcript>bej-e ben --ky</transcript>
          <definition> To put on a lighter garment.</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠯ᠎ᠠ ᠎ᠶᠢ ᠺᠥᠩᠺᠡᠪᠴᠢᠯᠡᠺᠥ</unicode>
          <transcript>jal-a ji --ky</transcript>
          <definition> To reduce a punishment</definition>
        </example>
      </examples>
