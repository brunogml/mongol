    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠺᠥᠰᠢᠺᠥᠷᠺᠡᠺᠥ</unicode>
      <uighur>küsigürkekü</uighur>
      <definition>To have antipathy or disinclination. To feel uncomfortable. To be ill.</definition>
      <page>742</page>
      <examples>
        <example>
          <uighur>küsigürken ögülekü</uighur>
          <definition>To talk against. To contradict.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
