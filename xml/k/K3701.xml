      <uighur>kösigürkekü</uighur>
      <transcript>KØSIGYRKE-</transcript>
      <definition>[=køsiyrke-] v.i. To be stubborn</definition>
      <page>493</page>
      <examples>
        <example>
          <unicode>ᠺᠥᠰᠢᠺᠥᠷᠺᠡᠨ ᠦᠭᠦᠯᠡᠺᠦ</unicode>
