    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠡᠵᠢᠶ᠎ᠡ</unicode>
      <uighur>keǰiy-e</uighur>
      <cyrillic>хэзээ</cyrillic>
      <transcript>KEZIJ-E</transcript>
      <definition>adv. When?. What time?.</definition>
      <page>462</page>
      <examples>
        <example>
          <unicode>ᠺᠡᠵᠢᠶ᠎ᠡ ᠪᠡᠷ</unicode>
          <transcript>--ber</transcript>
          <definition>Sooner or later</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠵᠢᠶ᠎ᠡ ᠪᠡᠷ ᠶᠢᠷᠲᠢᠨᠴᠦ ᠳ᠋‍‍ᠤ‍ᠷ ᠰᠠᠭᠤᠪᠠᠰᠤ ᠪᠡᠷ</unicode>
          <transcript>--ber jirtincy dyr saγubasu ber</transcript>
          <definition>However long my life will be in this world ...</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠵᠢᠶ᠎ᠡ ᠴᠦ ᠪᠣᠯᠪᠠ</unicode>
          <transcript>--cy bolba</transcript>
          <definition>No matter when; always</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠵᠢᠶ᠎ᠡ ᠴᠦ ᠪᠤᠴᠠᠬᠤ ᠨᠢᠴᠤᠬᠤ ᠦᠭᠡᠢ</unicode>
          <transcript>--cy bucaxu nicuxu ygei</transcript>
          <definition>Never to refuse, never to go back on one's word.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠵᠢᠶ᠎ᠡ ᠴᠦ ᠤᠮᠠᠷᠲᠠᠬᠤ ᠦᠭᠡᠢ</unicode>
          <transcript>-- cy umartaxu ygei</transcript>
          <definition>I shall' never forget.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠵᠢᠶ᠎ᠡ ᠎ᠳᠡ</unicode>
          <transcript>-- de</transcript>
          <definition>See kezijede</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠵᠢᠶ᠎ᠡ ᠡᠴᠡ</unicode>
          <transcript>-- ece</transcript>
          <definition>Since when?.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠵᠢᠶ᠎ᠡ ᠢᠮᠠᠭᠲᠠ</unicode>
          <transcript>-- imaγta</transcript>
          <definition>See imaγta,</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠵᠢᠶ᠎ᠡ ᠺᠡᠵᠢᠶ᠎ᠡ ᠦᠭᠡᠢ</unicode>
          <transcript>-- [kezij -e] ygei</transcript>
          <definition>Immediately, right. Away soon, quickly.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠵᠢᠶ᠎ᠡ ᠮᠠᠨᠠᠭᠠᠷ</unicode>
          <transcript>-- manaγar</transcript>
          <definition>Some day.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠵᠢᠶ᠎ᠡ ᠨᠢᠭᠡᠨ ᠴᠠᠭ ᠎ᠲᠤ</unicode>
          <transcript>-- nige caγ tu,</transcript>
          <definition>Once (upon a time); some day</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠺᠡᠵᠢᠶ᠎ᠡ</unicode>
      <definition>quand?: quand, si; tandis que, aussi longtemps que.</definition>
      <page>2490</page>
      <examples>
        <example>
          <unicode>ᠺᠠᠵᠢᠶ ᠠ ᠠᠮᠢᠲᠤ ᠠᠲᠠᠯᠠ</unicode>
          <definition>à vie, pendant la vie</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠵᠢᠶ ᠠ ᠴᠤ</unicode>
          <definition>toujours, sans interruption, sans cesse; (avec la nég.) jamais</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠵᠢᠶ ᠠ ᠴᠤ ᠮᠠᠷᠳᠠᠬᠤ ᠦᠭᠡᠢ</unicode>
          <definition>jamais je n'oublierai pas</definition>
        </example>
        <example>
          <unicode>ᠺᠠᠵᠢᠶ ᠠ ᠪᠡᠷ ᠵᠢᠷᠲᠢᠨᠴᠦ ᠳ᠋‍‍ᠤ‍ᠷ ᠰᠠᠭᠤᠪᠠᠰᠤ ᠪᠡᠷ</unicode>
          <definition>quelle que soit la durée de ma vie dans ce bas monde</definition>
        </example>
      </examples>
    </entry_item>
