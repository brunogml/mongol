  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠥᠮᠥᠷᠢᠺᠥ</unicode>
      <uighur>kömürikü</uighur>
      <cyrillic>хөмрөх</cyrillic>
      <transcript>KØMYRI-</transcript>
      <definition>[= kømeri-] v. t. and i. To upset, overturn, capsize; to cover with a bowl or other concave object.</definition>
      <page>487</page>
      <examples>
        <example>
          <unicode>ᠺᠥᠮᠥᠷᠢᠭᠰᠡᠨ ᠰᠠᠪᠠ</unicode>
          <transcript>-- gsen saba</transcript>
          <definition>A vessel or container turned upside down</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠮᠥᠷᠢᠨ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <transcript>--n talbixu</transcript>
          <definition>To put or place (a container) upside –dowm</definition>
        </example>
        <example>
          <unicode>ᠠᠶᠠᠭ᠎ᠠ ᠪᠡᠨ ᠺᠥᠮᠥᠷᠢᠺᠦ</unicode>
          <transcript>ajaγ-a ben –ky</transcript>
          <definition>To put one's bowl upside down</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Schmidt</dico>
      <unicode>ᠺᠥᠮᠥᠷᠢᠺᠥ</unicode>
      <uighur>kümürikü</uighur>
      <definition>sich wälzen, umwälzen, umwerfen, das unterste zu oberst stellen</definition>
      <page>183</page>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠺᠥᠮᠥᠷᠢᠺᠥ</unicode>
      <uighur>kümürikü</uighur>
      <definition>v.t. To turn. To turn over, to overturn. To turn the mouth or opening of a vessel downward.</definition>
      <page>718</page>
    </entry_item>
    <entry_item>
