    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠺᠥᠴᠥᠯᠡᠺᠥ</unicode>
      <uighur>küčülekü</uighur>
      <cyrillic>хүчлэх</cyrillic>
      <transcript>KYCYLE-</transcript>
      <definition>v.t. and i. To force, use force or violence; to exert oneself, use every effort</definition>
      <page>496</page>
      <examples>
        <example>
          <unicode>ᠺᠥᠴᠥᠯᠡᠨ ᠭᠤᠶᠤᠬᠤ</unicode>
          <transcript>--n γujuxu</transcript>
          <definition>To beg urgently, demand</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠴᠥᠯᠡᠵᠦ ᠠᠪᠴᠢᠷᠠᠬᠤ</unicode>
          <transcript>--zy abciraxu</transcript>
          <definition>To bring somebody by force or against his will.</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠪᠡᠨ ᠺᠥᠴᠥᠯᠡᠨ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>bej-e ben --n jabuxu</transcript>
          <definition>To work with all one's strength, exert oneself</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
