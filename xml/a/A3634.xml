    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠠᠢᠢᠯᠠᠳᠬᠠᠬᠤ</unicode>
      <uighur>ayiladqaqu</uighur>
      <definition>faire savoir, rapporter, faire un rapport, présenter, parler (à une personne supérieure)</definition>
      <page>3</page>
      <examples>
        <example>
          <unicode>ᠠᠢᠢᠯᠠᠳᠬᠠᠬᠤ ᠡᠪᠬᠡᠮᠡᠯ</unicode>
          <uighur>ayiladqaqu ebgemel</uighur>
          <definition>le paquet, couvert du rapport</definition>
        </example>
        <example>
          <unicode>ᠠᠢᠢᠯᠠᠳᠬᠠᠬᠤ ᠬᠠᠭᠤᠳᠠᠰᠤᠨ</unicode>
          <uighur>ayiladqaqu qaγudasun</uighur>
          <definition>Lettre de rapport</definition>
        </example>
        <example>
          <unicode>ᠠᠢᠢᠯᠠᠳᠬᠠᠬᠤ ᠪᠢᠴᠢᠭ᠍</unicode>
          <uighur>ayiladqaqu bičik</uighur>
          <definition>Rapport (écrit)</definition>
        </example>
        <example>
          <unicode>ᠠᠢᠢᠯᠠᠳᠬᠠᠬᠤ ᠪᠢᠴᠢᠭ᠍ ᠪᠢᠴᠢᠬᠦ ᠭᠠᠵᠠᠷ</unicode>
          <uighur>ayiladqaqu bičik bičikü γaǰar</uighur>
          <definition>Bureau où l'on écrit des rapports</definition>
        </example>
        <example>
          <unicode>ᠠᠢᠢᠯᠠᠳᠬᠠᠬᠤ ᠪᠢᠴᠢᠭ᠍ ᠦᠨ ᠪᠦᠰᠡᠯᠡᠭᠦᠷ</unicode>
          <uighur>ayiladqaqu bičik-ün büselegür</uighur>
          <definition>Enveloppe de papier du rapport</definition>
        </example>
        <example>
          <unicode>ᠠᠢᠢᠯᠠᠳᠬᠠᠬᠤ ᠪᠢᠴᠢᠭ᠍ ᠦᠨ ᠲᠣᠭ᠎ᠠ</unicode>
          <uighur>ayiladqaqu bičik-ün duγa</uighur>
          <definition>Registre des rapports</definition>
        </example>
        <example>
          <unicode>ᠠᠢᠢᠯᠠᠳᠬᠠᠬᠤ ᠪᠢᠴᠢᠭ᠍ ᠢ ᠴᠣᠭᠤᠯᠬᠤ ᠭᠠᠵᠠᠷ</unicode>
          <uighur>ayiladqaqu bičik-i čuγulqu γaǰar</uighur>
          <definition>bureau dans lequel on souscrit les apports, pour les présenter au chef</definition>
        </example>
        <example>
          <unicode>ᠠᠢᠢᠯᠠᠳᠬ᠎ᠠ ᠬᠡᠮᠡᠨ ᠪᠢᠴᠢᠬᠦ</unicode>
          <uighur>ayiladq-a kemen bičikü</uighur>
          <definition>rapport designé pour être présenté au chef</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠭᠠᠨ ᠠ ᠶᠠᠪᠤᠳᠠᠯ ᠢᠶᠠᠨ ᠠᠢᠢᠯᠠᠳᠬᠠᠪᠠᠢ</unicode>
          <uighur>qaγan-a yabudal-iyan ayiladqabai</uighur>
          <definition>il exposa son affaire au monarque</definition>
        </example>
        <example>
          <unicode>ᠪᠢ ᠬᠠᠷᠢᠭᠤ ᠡᠢᠨ ᠠᠢᠢᠯᠠᠳᠬᠠᠪᠠᠢ</unicode>
          <uighur>bi qariγu-iyan ayiladqabai</uighur>
          <definition>j'ai répondu ainsi</definition>
        </example>
        <example>
          <unicode>ᠰᠣᠨᠤᠰᠬᠠᠨ ᠠᠢᠢᠯᠠᠳᠬᠠᠬᠤ</unicode>
          <uighur>sunusqan ayiladdqaqu</uighur>
          <definition>rapporter, exposer, offrir à l'examen</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠨ᠎ᠡ ᠶᠢᠨ ᠠᠮᠤᠭᠤᠯᠠᠩ ᠠᠢᠢᠯᠠᠳᠬᠠᠬᠤ</unicode>
          <uighur>sina-yin amuγulang ayiladqaqu</uighur>
          <definition>féliciter à l'occasion de la nouvelle année, présenter les félicitations le jour du nouvel an</definition>
        </example>
      </examples>
    </entry_item>
