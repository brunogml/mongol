    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠶᠢᠯᠠᠳᠬᠠᠬᠣ</unicode>
      <uighur>ayiladqaqu</uighur>
      <cyrillic>айлтгах</cyrillic>
      <transcript>AILADXA-</transcript>
      <definition>[v. caus. of ailda-] To speak respectfully, report to or memorialize a superior or the emperor.</definition>
      <page>20</page>
      <examples>
        <example>
          <unicode>ᠠᠶᠢᠯᠠᠳᠬᠠᠬᠤ ᠪᠢᠴᠢᠭ</unicode>
          <transcript>--xu bicig</transcript>
          <definition> Report to a prince or to the throne.</definition>
        </example>
        <example>
          <unicode>ᠠᠶᠢᠯᠠᠳᠬᠠᠬᠤ ᠡᠪᠺᠡᠮᠡᠯ</unicode>
          <transcript>--xu ebkemel</transcript>
          <definition> Report or memorial to the throne (Ch. tsou-che).</definition>
        </example>
        <example>
          <unicode>ᠠᠮᠤᠭᠤᠯᠠᠩ ᠢ ᠠᠶᠢᠯᠠᠳᠬᠠᠬᠤ</unicode>
          <transcript>amuγulang i --xu</transcript>
          <definition> To greet respectfully.</definition>
        </example>
        <example>
          <unicode>ᠭᠤᠶᠤᠨ ᠠᠶᠢᠯᠠᠳᠬᠠᠬᠤ</unicode>
          <transcript>γujun --xu</transcript>
          <definition> To request respectfully.</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠨ᠎ᠡ ᠎ᠶᠢᠨ ᠠᠮᠤᠭᠤᠯᠠᠩ ᠠᠶᠢᠯᠠᠳᠬᠠᠬᠤ</unicode>
          <transcript>sin-e jin amuγulang --xu</transcript>
          <definition> To present New Year's congratulations.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷᠢᠬᠤ ᠠᠶᠢᠯᠠᠳᠬᠠᠬᠤ ᠠᠨᠤ</unicode>
          <transcript>xariγu --xu anu</transcript>
          <definition> I respectfully answer that ( epist.).</definition>
        </example>
      </examples>
    </entry_item>
