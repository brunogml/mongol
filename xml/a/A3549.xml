    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠶᠠᠯᠭᠣᠯᠠᠬᠣ</unicode>
      <uighur>ayalγulaqu</uighur>
      <cyrillic>аялгуулах</cyrillic>
      <transcript>AJALГULA-</transcript>
      <definition>v. t.. To emit harmonious sounds, hum, chant; to play a musical instrument.</definition>
      <page>23</page>
      <examples>
        <example>
          <unicode>ᠠᠶᠠᠯᠭᠤᠯᠠᠨ ᠳᠠᠭᠤᠯᠠᠬᠤ</unicode>
          <transcript>--n daγulaxu</transcript>
          <definition>To sing melodiously.</definition>
        </example>
        <example>
          <unicode>ᠠᠶᠠᠯᠭᠤᠯᠠᠨ ᠤᠩᠰᠢᠬᠤ</unicode>
          <transcript>--n ungsixu,</transcript>
          <definition>To recite melodiously</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠭᠤ ᠠᠶᠠᠯᠭᠤᠯᠠᠬᠤ</unicode>
          <transcript>daγu --xu</transcript>
          <definition>To hum or sing a tune or melody.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠠᠶᠠᠯᠭᠣᠯᠠᠬᠣ</unicode>
      <uighur>ayalγulan taγulaqu</uighur>
      <definition>To sing harmoniously. To sing quartet.</definition>
      <page>71</page>
    </entry_item>
    <entry_item>
      <dico>lamrd</dico>
      <unicode>ᠠᠶᠠᠯᠭᠣᠯᠠᠬᠣ</unicode>
      <cyrillic>АЯЛГУУЛАХ</cyrillic>
      <definition>1. произносить; читать нараспев, петь в тон; напевать, петь; аялгуулан эгшиглэх читать нараспев; напевать; 2. аялгуулахуй–г үз.; 3. мелодично; аялгуулан жиргэх мелодично щебетать.</definition>
      <page>0</page>
    </entry_item>
