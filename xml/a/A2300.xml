    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠯᠠᠬᠯᠠᠬᠣ</unicode>
      <uighur>alaqlaqu</uighur>
      <cyrillic>алаглах</cyrillic>
      <transcript>ALAГLA-</transcript>
      <definition>v.t. and i. To make something variegated, streak with several colors; to be or appear variegated or multicolored.</definition>
      <page>27</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠠᠬᠯᠠᠨ ᠴᠢᠮᠡᠭᠰᠡᠨ</unicode>
          <transcript>--n cimegsen</transcript>
          <definition>Decorated with various colors.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠷ᠎ᠠ ᠴᠠᠭᠠᠨ ᠢᠶᠠᠷ ᠠᠯᠠᠬᠯᠠᠬᠤ</unicode>
          <transcript>xar-a caγan ijer --xu</transcript>
          <definition>To alternate or intermix black and white.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
