    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠷᠢᠭᠣᠯᠠᠬᠣ</unicode>
      <uighur>ariγulaqu</uighur>
      <cyrillic>ариулах</cyrillic>
      <transcript>ARIГULA-</transcript>
      <definition>v.t. To cleanse, purify; to abstain from defilement or sin.</definition>
      <page>53</page>
      <examples>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠎ᠪᠡᠨ ᠠᠷᠢᠭᠣᠯᠠᠬᠣ</unicode>
          <transcript>bej-e ben --xu</transcript>
          <definition> To cleanse or purify oneself.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠯ ᠳᠡᠭᠡᠭᠦᠷ ᠠᠷᠢᠭᠣᠯᠠᠬᠣ</unicode>
          <transcript>γal degegyr --xu</transcript>
          <definition> To purify over a fire.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
