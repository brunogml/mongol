      <cyrillic>алга</cyrillic>
      <transcript>ALГ-A</transcript>
      <definition>[= alaγ-a, 2.] Adverbial particle of restricted usage expressing negation: there are none; does not exist.</definition>
      <page>31</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠭ᠎ᠠ ᠪᠣᠯᠬᠤ</unicode>
          <transcript>-- bolxu</transcript>
