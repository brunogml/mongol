    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠯᠳᠠᠭᠣᠯᠬᠣ</unicode>
      <uighur>aldaγulqu</uighur>
      <cyrillic>алдуулах</cyrillic>
      <transcript>ALDAГUL-</transcript>
      <definition>v . caus. of alda-.</definition>
      <page>30</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠳᠠᠭᠤᠯᠵᠤ ᠠᠪᠬᠤ</unicode>
          <transcript>--zu abxu</transcript>
          <definition> To take away, snatch away, cheat out of.</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠰᠤᠨ ᠠᠯᠳᠠᠭᠤᠯᠬᠤ</unicode>
          <transcript>cisun --xu</transcript>
          <definition> To bleed., lose blood.</definition>
        </example>
        <example>
          <unicode>ᠮᠥᠷ ᠠᠯᠳᠠᠭᠤᠯᠬᠤ</unicode>
          <transcript>mør --xu</transcript>
          <definition> To lead astray.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠨᠠᠭᠠᠨ ᠳᠠᠭᠠᠨ ᠠᠭᠤᠯᠵᠤ ᠠᠯᠳᠠᠭᠤᠯᠬᠤ ᠦᠭᠡᠢ</unicode>
          <transcript>sanaγan daγan aγulzu --xu ygei</transcript>
          <definition> To engrave so firmly in one's memory as never to forget it.</definition>
        </example>
        <example>
          <unicode>ᠤᠬᠠᠭ᠎ᠠ ᠠᠯᠳᠠᠭᠤᠯᠬᠤ</unicode>
          <transcript>uxaγ-a --xu</transcript>
          <definition> To scare, frighten; to cause someone' to lose his senses.</definition>
        </example>
        <example>
          <unicode>ᠦᠭᠡ ᠠᠯᠳᠠᠭᠤᠯᠬᠤ</unicode>
          <transcript>yge --xu</transcript>
          <definition> To cause to give one's word or information.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
