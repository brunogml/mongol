      <examples>
        <example>
          <unicode>ᠠᠮᠤᠰᠤ ᠪᠠᠷᠢᠬᠤ</unicode>
          <transcript>-- barixu</transcript>
          <definition> To make a food offering to spirits.</definition>
        </example>
        <example>
          <unicode>ᠠᠮᠤᠰᠤᠨ ᠤ ᠮᠢᠬ᠎ᠠ</unicode>
          <transcript>--n u mix-a</transcript>
          <definition> Meat used in offerings.</definition>
        </example>
      </examples>
