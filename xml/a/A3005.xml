      <dico>Lessing</dico>
      <unicode>ᠠᠮᠣᠰᠣ</unicode>
      <uighur>amusu - amusun</uighur>
      <cyrillic>амас</cyrillic>
      <transcript>AMUSU(N)</transcript>
      <definition>n. Cooked cereal, porridge; food offering made to spirits.</definition>
