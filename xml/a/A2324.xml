    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠯᠠᠯᠳᠣᠬᠣ</unicode>
      <uighur>alalduqu</uighur>
      <cyrillic>алалдах</cyrillic>
      <transcript>ALALDU-</transcript>
      <definition>[v. rec. of ala-] To kill each other; to fight each other.</definition>
      <page>27</page>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠠᠯᠠᠯᠳᠤᠬᠤ ~ ᠠᠯᠠᠯᠴᠠᠬᠤ</unicode>
      <definition>s'entretuer; se battre, lutter, combatte</definition>
      <page>74</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠠᠯᠳᠤᠬᠤᠢ ᠦᠯᠡᠰ ᠳ᠋‍‍ᠤ‍ᠷ ᠨᠠᠴᠢᠨ ᠰᠢᠪᠠᠭᠤᠨ ᠮᠡᠲᠦ ᠳᠠᠭᠤᠯᠢᠯᠠᠨ ᠶᠠᠪᠤ</unicode>
          <definition>pendant le combat, jettes-toi sur l'ennemi, comme un aigle sur sa proie</definition>
        </example>
        <example>
          <unicode>ᠠᠷᠰᠯᠠᠨ ᠪᠡᠷ ᠪᠤᠬ᠎ᠠ ᠎ᠯᠤᠭ᠎ᠠ ᠠᠯᠠᠯᠳᠣᠮᠣᠢ</unicode>
          <definition>le lion combat avec le taureau</definition>
        </example>
      </examples>
    </entry_item>
