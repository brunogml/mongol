    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠠᠩᠭᠢᠵᠢᠷᠠᠬᠤ</unicode>
      <uighur>angkiǰiraqu</uighur>
      <definition>se séparer, se quitter, se détacher: 2 rester en arrière: 3 laisser, abandonner: 4 se délivrer, se défaire, éviter</definition>
      <page>20</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠠᠨ ᠠᠪᠤᠭᠰᠠᠨ ᠲᠠᠩᠭᠠᠷᠢᠭ ᠠᠴᠠ ᠠᠩᠭᠢᠵᠢᠷᠠᠬᠤ</unicode>
          <uighur>aman abuqsan tangγariq-ača ankiǰiraqu</uighur>
          <definition>transgresser, violer le serment prêté</definition>
        </example>
        <example>
          <unicode>ᠠᠮᠢᠨ ᠠᠴᠠ ᠠᠩᠭᠢᠵᠢᠷᠠᠬᠤ</unicode>
          <uighur>amin-ača angkiǰiraqu</uighur>
          <definition>quitter la vie, mourir</definition>
        </example>
        <example>
          <unicode>ᠠᠶᠤᠯ ᠠᠴᠠ ᠠᠩᠭᠢᠵᠢᠷᠠᠬᠤ</unicode>
          <uighur>ayul-ača angkiǰiraqu</uighur>
          <definition>maîtriser la frayeur, ne aps craindre</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠢᠯᠳᠤᠭᠠᠨ ᠠᠴᠠ ᠠᠩᠭᠢᠵᠢᠷᠠᠭᠰᠠᠨ ᠲᠩᠷᠢ</unicode>
          <uighur>bayilduγan-ača angkiǰiraqsan tngri</uighur>
          <definition>Tégris éloignés de la guerre, paisibles et pacifiques génies</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠢᠨ ᠪᠠᠭᠰᠢ ᠠᠴᠠ ᠦᠯᠦ ᠠᠩᠭᠢᠵᠢᠷᠠᠬᠤ</unicode>
          <uighur>sayin baqsi-ača ülü angkiǰiraqu</uighur>
          <definition>ne pas abandonner, quitter un bon maître</definition>
        </example>
        <example>
          <unicode>ᠴᠤᠬᠤᠮ ᠵᠠᠮ ᠠᠴᠠ ᠠᠩᠭᠢᠵᠢᠷᠠᠵᠤ ᠶᠠᠪᠤᠬᠤ</unicode>
          <uighur>čuqum ǰam-ača angkiǰiraǰu yabuqu</uighur>
          <definition>quitter le vrai (droit) chemin, s'égarer</definition>
        </example>
        <example>
          <unicode>ᠵᠡᠷᠭᠡ ᠡᠴᠡ ᠠᠩᠭᠢᠵᠢᠷᠠᠭᠰᠠᠨ</unicode>
          <uighur>ǰerke-eče angkiǰiraqsan</uighur>
          <definition>désordonné, irrégulier, sans méthode; ² démesuré, sans borne</definition>
        </example>
        <example>
          <unicode>ᠵᠢᠰᠢᠶ ᠠ ᠪᠠᠷᠠᠵᠤ ᠰᠠᠬᠢᠬᠤ ᠭᠠᠵᠠᠷ ᠠᠴᠠ ᠠᠩᠭᠢᠵᠢᠷᠠᠬᠤ</unicode>
          <uighur>ǰisiy-e baraǰu sakiqu γaǰar-ača angkiǰiraqu</uighur>
          <definition>quitter son poste après avoir resté le temps marqué</definition>
        </example>
        <example>
          <unicode>ᠬᠬᠢᠷ ᠡᠴᠡ ᠠᠩᠭᠢᠵᠢᠷᠠᠭᠰᠠᠨ ᠨᠣᠮ</unicode>
          <uighur>kkir-ača angkiǰiraqsan nom</uighur>
          <definition>qualité divine exempte de toute souillure</definition>
        </example>
      </examples>
    </entry_item>
