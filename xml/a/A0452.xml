    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠩᠭᠢᠵᠢᠷᠠᠬᠤ</unicode>
      <uighur>anggkiǰiraqu</uighur>
      <cyrillic>ангижрах</cyrillic>
      <transcript>ANGGIZIRA-</transcript>
      <definition>v.i. To detach oneself; to separate from; to become free from; to leave; to be reduced (chem. ).</definition>
      <page>45</page>
      <examples>
        <example>
          <unicode>ᠠᠩᠭᠺᠢᠵᠢᠷᠠᠨ ᠰᠠᠯᠬᠤ</unicode>
          <transcript>--n salxu</transcript>
          <definition> To be separated; to branch off from; to get free from.</definition>
        </example>
        <example>
          <unicode>ᠠᠶᠤᠯ ᠡᠴᠡ ᠠᠩᠭᠺᠢᠵᠢᠷᠠᠬᠤ</unicode>
          <transcript>ajul ece --xu</transcript>
          <definition> To become free from fear or danger.</definition>
        </example>
        <example>
          <unicode>ᠠᠮᠢᠨ ᠡᠴᠡ ᠠᠩᠭᠺᠢᠵᠢᠷᠠᠬᠤ</unicode>
          <transcript>amin ece --xu</transcript>
          <definition> To separate from life (i. e, to die).</definition>
        </example>
        <example>
          <unicode>ᠶᠢᠷᠲᠢᠨᠴᠦ ᠡᠴᠡ ᠠᠩᠭᠺᠢᠵᠢᠷᠠᠬᠤ</unicode>
          <transcript>jirtincy ece --xu</transcript>
          <definition> To depart from the world ( i. e., to die).</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠪᠠᠯᠠᠩ ᠡᠴᠡ ᠠᠩᠭᠺᠢᠵᠢᠷᠠᠬᠤ</unicode>
          <transcript>zobalang ece --xu</transcript>
          <definition> To become free from suffering.</definition>
        </example>
      </examples>
    </entry_item>
