    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠯᠣᠰᠯᠠᠬᠣ</unicode>
      <uighur>aluslaqu</uighur>
      <cyrillic>алслах</cyrillic>
      <transcript>ALUSLA-</transcript>
      <definition>v.i. and I, To pass over, traverse; to jump over, skip;. to omit, avoid; to be remote or distant.</definition>
      <page>34</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠤᠰᠯᠠᠨ ᠬᠠᠷᠠᠭᠳᠠᠬᠤ</unicode>
          <transcript>--n xaraγdaxu</transcript>
          <definition> To become visible or appear in the distance.</definition>
        </example>
        <example>
          <unicode>ᠭᠣᠤᠯ ᠠᠯᠤᠰᠯᠠᠬᠤ</unicode>
          <transcript>γoul --xu</transcript>
          <definition> To cross a river.</definition>
        </example>
        <example>
          <unicode>ᠭᠤᠷᠪᠠᠨ ᠵᠢᠯ ᠠᠯᠤᠰᠯᠠᠵᠤ</unicode>
          <transcript>γurban zil --zu</transcript>
          <definition> After three years.</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠭᠤᠮ ᠠᠯᠤᠰᠯᠠᠬᠤ</unicode>
          <transcript>siγum --xu</transcript>
          <definition> To skip or omit a line.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠠᠯᠤᠰᠯᠠᠬᠤ</unicode>
      <uighur>aloslaqu</uighur>
      <definition>passer, passer au delà, traverser, sauter par dessus: éviter</definition>
      <page>79</page>
      <examples>
        <example>
          <unicode>ᠡᠺᠡᠨᠡᠷ ᠵᠢᠯ ᠪᠦᠷᠢ ᠠᠯᠣᠰᠯᠠᠬᠤ ᠦᠭᠡᠢ ᠺᠡᠦᠺᠡᠳ ᠲᠥᠷᠥᠮᠦᠢ</unicode>
          <definition>une femme accouche chaque année</definition>
        </example>
        <example>
          <unicode>ᠭᠤᠷᠪᠠᠨ ᠵᠢᠯ ᠠᠯᠤᠰᠯᠠᠵᠤ</unicode>
          <definition>trois années écoulées, après trois années</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠡ ᠪᠤᠬᠲᠠ᠎ᠠᠴᠠ ᠠᠯᠣᠰᠯᠠᠬᠰᠠᠨ ᠠᠨᠤ ᠬᠣᠯᠠ ᠪᠣᠯᠤᠭᠤᠨ</unicode>
          <definition>longtemps après la mort de ce philosophe.</definition>
        </example>
      </examples>
    </entry_item>
