    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠪᠣᠭᠠᠢ</unicode>
      <uighur>abuγai</uighur>
      <cyrillic>авгай – авгуай</cyrillic>
      <transcript>ABUГAI</transcript>
      <definition>.A title of respect used in addressing one's seniors: Sir, Mister. Cf. abaiγai.</definition>
      <page>5</page>
      <examples>
        <example>
          <unicode>ᠪᠯᠠᠮ᠎ᠠ ᠠᠪᠤᠭᠠᠢ</unicode>
          <transcript>blam-a --</transcript>
          <definition> Reverend Lama.</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠳᠦᠨ ᠠᠪᠤᠭᠠᠢ</unicode>
          <transcript>Gendyn -- </transcript>
          <definition> Mr. Gendun.</definition>
        </example>
        <example>
          <unicode>ᠤᠩᠰᠢᠭᠴᠢ ᠠᠪᠤᠭᠠᠢ ᠨᠠᠷ</unicode>
          <transcript>ungsiγci -- nar , </transcript>
          <definition>Respected or dear readers</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠶᠢᠷᠠᠲᠤ ᠨᠣᠶᠠᠨ ᠠᠪᠤᠭᠠᠢ ᠮᠢᠨᠤ</unicode>
          <transcript>xairatu nojan -- minu</transcript>
          <definition> My Dear Sir: (beginning a letter).</definition>
        </example>
      </examples>
    </entry_item>
