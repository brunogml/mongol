    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠪᠲᠠᠷᠠᠬᠣ</unicode>
      <uighur>abtaraqu</uighur>
      <cyrillic>автрах</cyrillic>
      <transcript>ABTARA-</transcript>
      <definition>v. 1. To be destroyed; to be carried away; to be conquered; to be defeated; to be exhausted (as by illness or work).</definition>
      <page>5</page>
      <examples>
        <example>
          <unicode>ᠳᠠᠶᠢᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠠᠪᠲᠠᠷᠠᠬᠤ</unicode>
          <transcript>dain dur --xu</transcript>
          <definition> To be defeated in war.</definition>
        </example>
        <example>
          <unicode>ᠳᠡᠭᠡᠷᠡᠮᠴᠢ ᠳ᠋‍‍ᠤ‍ᠷ ᠠᠪᠲᠠᠷᠠᠬᠤ</unicode>
          <transcript>degeremci dyr --xu</transcript>
          <definition> To be carried away by bandits.</definition>
        </example>
        <example>
          <unicode>ᠤᠰᠤᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠠᠪᠲᠠᠷᠠᠬᠤ</unicode>
          <transcript>usun dur --xu</transcript>
          <definition> To be carried away by flood.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
