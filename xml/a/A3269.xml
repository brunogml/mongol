      <dico>Lessing</dico>
      <unicode>ᠠᠴᠢᠯᠠᠬᠣ</unicode>
      <uighur>ačilaqu</uighur>
      <cyrillic>ачлах</cyrillic>
      <transcript>ACILA-</transcript>
      <definition>v.t. To treat with benevolence, be benevolent; to treat with filial piety; to benefit, be beneficial; to recompense, return a favor.</definition>
      <page>8</page>
      <examples>
        <example>
          <unicode>ᠡᠴᠢᠭᠡ ᠡᠺᠡ ᠪᠡᠨ ᠠᠴᠢᠯᠠᠬᠤ</unicode>
          <transcript>ecige eke ben --xu.</transcript>
          <definition> To display filial piety to one's parents.</definition>
        </example>
        <example>
          <unicode>ᠡᠨᠡ ᠨᠣᠮ ᠨᠠᠮᠠᠶᠢ ᠠᠴᠢᠯᠠᠵᠤ ᠪᠠᠶᠢᠨ᠎ᠠ</unicode>
          <transcript>ene nom namaji -:-zu bain-a, </transcript>
          <definition>This book benefits me greatly</definition>
        </example>
      </examples>
    </entry_item>
