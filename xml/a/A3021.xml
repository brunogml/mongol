    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠮᠣᠷᠠᠬᠣ</unicode>
      <uighur>amuraqu</uighur>
      <cyrillic>амрах</cyrillic>
      <transcript>AMURA-</transcript>
      <definition>[:= amara-] v.i To rest, relax; to feel contentment or joy; to be relieved.</definition>
      <page>40</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠤᠷᠠᠬᠤ ᠴᠠᠭ</unicode>
          <transcript>--xu caγ</transcript>
          <definition>The time of rest.</definition>
        </example>
        <example>
          <unicode>ᠠᠮᠤᠷᠠᠬᠤ ᠣᠷᠤᠨ</unicode>
          <transcript>--xu orun</transcript>
          <definition>Place of retreat, resort.</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠠᠮᠤᠷᠠᠬᠤ</unicode>
          <transcript>bej-e --xu</transcript>
          <definition>For the body to rest; to feel rested</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠨᠠᠭ᠎ᠠ ᠠᠮᠤᠷᠠᠬᠤ</unicode>
          <transcript>sanaγ-a --xu</transcript>
          <definition>To be relieved; to calm down.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠠᠮᠣᠷᠠᠬᠤ</unicode>
      <definition>se reposer, être tranquille, se calmer</definition>
      <page>110</page>
      <examples>
        <example>
          <unicode>ᠠᠷᠰᠠᠯᠠᠨ ᠪᠡᠷ ᠮᠠᠰᠢ ᠴᠡᠳᠦᠨ ᠠᠮᠣᠷᠠᠵᠤ ᠺᠡᠪᠳᠡᠮᠦᠢ</unicode>
          <definition>le lion rassasie reste couche tranquillement</definition>
        </example>
        <example>
          <unicode>ᠠᠳᠠ ᠭᠤᠷᠤᠮᠬᠠᠨᠠ ᠠᠮᠣᠷᠠᠨ ᠰᠠᠭᠤᠨ ᠰᠣᠶᠢᠷᠬ᠎ᠠ</unicode>
          <definition>veuillez ici reposer un peu;</definition>
        </example>
        <example>
          <unicode>ᠡᠳᠦᠭᠡ ᠪᠡᠶ᠎ᠡ ᠰᠡᠳᠺᠢᠯ ᠢᠶᠡᠷ ᠠᠮᠤᠷᠠᠨ ᠰᠠᠭᠤᠰᠤᠭᠠᠢ</unicode>
          <definition>je désire maintenant tranquilliser l'ame et le corps.</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠯᠡᠺᠰᠡᠳ ᠪᠦᠭᠦᠳᠡᠺᠡᠷ ᠠᠮᠤᠷᠠᠬᠤ ᠪᠣᠯᠪᠠᠢ</unicode>
          <definition>tous les souffrants trouvèrent le repos</definition>
        </example>
      </examples>
