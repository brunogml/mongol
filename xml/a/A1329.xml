    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠠᠪᠠᠯᠠᠬᠣ</unicode>
      <uighur>abalaqu</uighur>
      <definition>faire la chasse, chasser, entourer les bêtes</definition>
      <page>42</page>
      <examples>
        <example>
          <unicode>ᠠᠭᠤᠯᠠ ᠳ᠋‍‍ᠤ‍ᠷ ᠠᠪᠠᠯᠠᠷ᠎ᠠ ᠣᠳᠬᠤ</unicode>
          <definition>partir pour la chasse dans les montagnes</definition>
        </example>
        <example>
          <unicode>ᠠᠯᠠᠨ ᠠᠪᠠᠯᠠᠬᠤ</unicode>
          <definition>tuer [les bêtes) à la chasse (d'automne).</definition>
        </example>
        <example>
          <unicode>ᠰᠣᠩᠭᠤᠨ ᠠᠪᠠᠯᠠᠬᠤ</unicode>
          <definition>faire la chasse avec choix c -a-d. au printemps en tuant seulement les animaux qui sont sans petits.</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠪᠠᠭᠤᠨ ᠢ ᠠᠪᠠᠯᠠᠬᠤ</unicode>
          <definition>prendre les oiseaux</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠷᠢᠶᠠᠯᠠᠩ ᠤᠨ ᠲᠤᠯᠠ ᠠᠪᠠᠯᠠᠬᠤ</unicode>
          <definition>chasser en été, pour preserver les semailles de la destruction des animaux</definition>
        </example>
        <example>
          <unicode>ᠵᠢᠭᠠᠰᠤᠨ ᠠᠪᠠᠯᠠᠬᠤ</unicode>
          <definition>pêcher les poissons, prendre du poisson</definition>
        </example>
      </examples>
    </entry_item>
