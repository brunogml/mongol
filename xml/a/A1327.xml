      <transcript>ABAD</transcript>
      <definition>Intensifier of negatives: (nof at all, absolutely (not).</definition>
      <page>2</page>
      <examples>
        <example>
          <unicode>ᠠᠪᠠᠳ ᠢᠷᠡᠺᠦ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ireky ygei</transcript>
          <definition>Does not come back at all.</definition>
        </example>
        <example>
          <unicode>ᠠᠪᠠᠳ ᠥᠰᠺᠦ ᠦᠭᠡᠢ</unicode>
          <transcript>-- øsky ygei</transcript>
          <definition>Does not grow at all.</definition>
        </example>
      </examples>
