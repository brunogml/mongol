  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠭᠣᠴᠢᠯᠠᠬᠣ</unicode>
      <uighur>aγučilaqu</uighur>
      <cyrillic>уучлах</cyrillic>
      <transcript>AГUCILA-</transcript>
      <definition>v.t. To pardon, forgive, condone, excuse; to treat with mercy or magnanimity.</definition>
      <page>16</page>
      <examples>
        <example>
          <unicode>ᠠᠭᠤᠴᠢᠯᠠᠭᠠᠷᠠᠢ</unicode>
          <transcript>--γarai!</transcript>
          <definition> Forgive me!. Pardon me!.</definition>
        </example>
        <example>
          <unicode>ᠠᠭᠤᠴᠢᠯᠠᠨ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <transcript>--n talbixu</transcript>
          <definition> To pardon; to release, remit.</definition>
        </example>
        <example>
          <unicode>ᠠᠭᠤᠴᠢᠯᠠᠬᠤ ᠠᠵᠢᠶᠠᠮᠤ</unicode>
          <transcript>--xu azijamu</transcript>
          <definition> Will you forgive (epist.).</definition>
        </example>
        <example>
          <unicode>ᠠᠭᠤᠴᠢᠯᠠᠬᠤ ᠭᠠᠵᠠᠷ ᠦᠭᠡᠢ</unicode>
          <transcript>--xu γazar ygei</transcript>
          <definition> Unpardonable.</definition>
        </example>
        <example>
          <unicode>ᠠᠮᠢ ᠠᠭᠤᠴᠢᠯᠠᠬᠤ</unicode>
          <transcript>ami --xu</transcript>
          <definition> To spare [somebody's] life.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠲᠦᠷᠭᠡᠢ ᠠᠭᠤᠴᠢᠯᠠᠬᠤ</unicode>
          <transcript>ketyrkei --xu</transcript>
          <definition> To be magnanimous.</definition>
        </example>
        <example>
          <unicode>ᠣᠰᠤᠯ ᠢ ᠠᠭᠤᠴᠢᠯᠠᠬᠤ</unicode>
          <transcript>osul i --xu</transcript>
          <definition> To forgive a mistake or fault.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
