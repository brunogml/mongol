          <definition>avoir pitié de qn., faire grâce</definition>
        </example>
        <example>
          <unicode>ᠠᠭᠤᠴᠢᠯᠠᠵᠤ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <definition>pardonner, excuser</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
