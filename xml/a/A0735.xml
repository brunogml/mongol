    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠬᠣ</unicode>
      <uighur>aqu</uighur>
      <transcript>A-</transcript>
      <definition>v . i., aux., and copul. To be (not all forms of this verb are used; see examples also under abacu, abasu, atal-a, axui, azu, azuγu ).</definition>
      <page>1</page>
      <examples>
        <example>
          <unicode>ᠠᠵᠢ</unicode>
          <transcript>--zi</transcript>
          <definition> Past tense used instead of azuγu (q. v. ).</definition>
        </example>
        <example>
          <unicode>ᠪᠢ ᠡᠨᠡ ᠭᠠᠵᠠᠷ ᠠᠰᠤᠭᠠᠢ</unicode>
          <transcript>bi ene γazar - -suγai </transcript>
          <definition>Let me stay at this place</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠢ ᠠᠮᠤᠢ</unicode>
          <transcript>bui --mui</transcript>
          <definition> There is.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠯᠢᠶᠡᠨ ᠠᠭᠰᠠᠭᠠᠷ ᠡᠳᠦᠷ ᠤᠪᠠᠳᠠ</unicode>
          <transcript>kylijen --γsaγar edyr udaba</transcript>
          <definition> [I] have been waiting for many days.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠶᠢᠨ ᠰᠠᠭᠠᠲᠠᠵᠤ ᠠᠮᠤᠢ ᠤᠤ</unicode>
          <transcript>sain saγatazu --mui uu?</transcript>
          <definition> How are you?. lit,: are you living well ?.)</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠭᠦᠨ ᠤ ᠠᠭᠰᠠᠨ ᠭᠠᠵᠠᠷ</unicode>
          <transcript>tegyn y --γsan γazar</transcript>
          <definition> The place where he had been.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠶᠢᠨ ᠠᠬᠤᠯ᠎ᠠ</unicode>
          <transcript>tein --xul-a</transcript>
          <definition> If it is or were so.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠨᠳᠡ ᠠᠲᠤᠭᠠᠢ</unicode>
          <transcript>tende --tuγai</transcript>
          <definition> [Let him] be there !.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠡ ᠣᠷᠤᠵᠤ ᠢᠷᠡᠺᠦᠢ ᠳᠦ ᠪᠢ ᠰᠠᠭᠤᠵᠤ ᠠᠪᠠᠢ</unicode>
          <transcript>tere oruzu irekyi dy bi saγuzu --bai</transcript>
          <definition> When he came in I was sitting.</definition>
        </example>
      </examples>
    </entry_item>
