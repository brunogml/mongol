    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠠᠷᠪᠢᠴᠢᠭᠤᠯᠬᠤ</unicode>
      <definition>augmenter, agrandir, multiplier; etendre</definition>
      <page>159</page>
      <examples>
        <example>
          <unicode>ᠦᠷ᠎ᠡ ᠎ᠶᠢ ᠠᠷᠪᠢᠴᠢᠭᠤᠯᠬᠤ</unicode>
          <definition>augmenter la fertilité.</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠳᠺᠢᠯ ᠢ ᠡᠭᠦᠰᠭᠡᠨ ᠠᠷᠪᠢᠴᠢᠭᠤᠯᠬᠤ</unicode>
          <definition>élever l'esprit ou les sentimens, encourager, ranimer</definition>
        </example>
        <example>
          <unicode>ᠭᠤᠷᠪᠠᠨ ᠡᠷᠳᠡᠨᠢᠰ ᠤᠨ ᠢᠵᠠᠭᠤᠷ ᠢ ᠨᠡᠮᠡᠭᠦᠯᠦᠨ ᠳᠠᠷᠪᠢᠴᠢᠭᠤᠯᠬᠤ</unicode>
          <definition>encourager le vénération de trois precieux, c'est-a dire du Triratna, ou de Bouddha, Dharma, Sanga.</definition>
        </example>
      </examples>
    </entry_item>
  </entries>
</entry>
