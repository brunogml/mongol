      <dico>Lessing</dico>
      <unicode>ᠠᠮᠣᠬᠣ</unicode>
      <uighur>amuqu</uighur>
      <cyrillic>амах</cyrillic>
      <transcript>AMU-</transcript>
      <definition>v, i. To rest, relax; to feel contentment or joy; to be relieved.</definition>
      <page>40</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠤᠬᠤᠢ ᠰᠡᠳᠺᠢᠯ ᠣᠯᠬᠤ</unicode>
          <transcript>--xui sedkil olxu, </transcript>
          <definition>To find rest, rest one's soul</definition>
        </example>
        <example>
          <unicode>ᠠᠮᠤᠬᠤ ᠦᠭᠡᠢ</unicode>
          <transcript>--xu ygei</transcript>
          <definition> Without rest, untiringly, indefatigably.</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠳᠺᠢᠯ ᠠᠮᠤᠬᠤ</unicode>
          <transcript>sedkil --xu</transcript>
          <definition> To calm down, be relieved.</definition>
        </example>
      </examples>
    </entry_item>
