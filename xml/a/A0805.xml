    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠭᠣᠳᠠᠯᠠᠬᠣ</unicode>
      <uighur>aγudalaqu</uighur>
      <cyrillic>уудлах</cyrillic>
      <transcript>AГUDALA-</transcript>
      <definition>v.t. To pour; from a large container into a smaller one, decant; to empty out, pour out; to dig for, rummage; to ferret out, expose, reveal, disclose.</definition>
      <page>16</page>
      <examples>
        <example>
          <unicode>ᠠᠭᠤᠳᠠᠯᠠᠨ ᠦᠵᠡᠭᠦᠯᠺᠦ</unicode>
          <transcript>--n yzegylky</transcript>
          <definition> 'To expose, reveal, disclose.</definition>
        </example>
        <example>
          <unicode>ᠠᠪᠳᠠᠷ ᠢ ᠠᠭᠤᠳᠠᠯᠠᠬᠤ</unicode>
          <transcript>abdar-i ---xu</transcript>
          <definition> To rummage in a box.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠷᠡᠭ ᠠᠭᠤᠳᠠᠯᠠᠬᠤ</unicode>
          <transcript>kereg --xu</transcript>
          <definition> To look into, investigate, or reveal a matter or affair.</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠭᠤᠴᠠ ᠎ᠶᠢ ᠠᠭᠤᠳᠠᠯᠠᠬᠤ</unicode>
          <transcript>niγuca ji --xu.</transcript>
          <definition> To reveal a secret.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠢᠶᠡᠷ ᠠᠭᠤᠳᠠᠯᠠᠬᠤ</unicode>
          <transcript>øbyr ijen --xu</transcript>
          <definition> To search in the breast pocket.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠪᠠ ᠠᠭᠤᠳᠠᠯᠠᠬᠤ</unicode>
          <transcript>saba --xu</transcript>
          <definition> To empty out a container.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
