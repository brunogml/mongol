      <uighur>aliba</uighur>
      <cyrillic>аливаа</cyrillic>
      <transcript>ALIBA</transcript>
      <definition>pron. and adj. Whoever, whatever, whichever; who, which., what; anything, anybody; every, all.</definition>
      <page>32</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠢᠪᠠ ᠶᠠᠭᠤᠮ᠎ᠠ</unicode>
          <transcript>-- jaγum-a</transcript>
          <definition> Anything, everything, all things.</definition>
        </example>
        <example>
          <unicode>ᠠᠯᠢᠪᠠ ᠨᠢᠭᠡᠨ</unicode>
          <transcript>-- nigen</transcript>
          <definition> Anyone, everyone.</definition>
        </example>
        <example>
          <unicode>ᠠᠯᠢᠪᠠ ᠨᠢᠭᠡᠨ ᠲᠠᠯᠠ ᠪᠡᠷ</unicode>
          <transcript>-- nigen tal-a ber</transcript>
          <definition> In any or every respect.</definition>
        </example>
        <example>
          <unicode>ᠠᠯᠢᠪᠠ ᠵᠦᠢᠯ</unicode>
          <transcript>-- zyil</transcript>
          <definition> All kinds, every kind.</definition>
        </example>
      </examples>
    </entry_item>
