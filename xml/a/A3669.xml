    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠠᠢᠮᠠᠭ</unicode>
      <uighur>ayimaq</uighur>
      <definition>division, section, détachement, compagnie, régiment, troupe, assemblée, assemblée religieuse: 2. département, district, principauté, province, circuit.</definition>
      <page>6</page>
      <examples>
        <example>
          <unicode>ᠠᠢᠮᠠᠭ ᠠᠢᠮᠠᠭ ᠪᠣᠯᠭᠠᠨ ᠬᠤᠪᠢᠶᠠᠬᠤ</unicode>
