    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠠᠯᠭᠣᠷ</unicode>
      <uighur>alγur</uighur>
      <cyrillic>алгуур</cyrillic>
      <transcript>ALГUR</transcript>
      <definition>[= alaγur] adj. and adv, slow[ly], quiet[ly], calm[ly], l.eisure[1y], gradual[ly].</definition>
      <page>31</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠭᠤᠷ ᠠᠶᠠᠷ</unicode>
          <transcript>-- ajar</transcript>
          <definition> Slowly; leisurely; tranquilly.</definition>
        </example>
        <example>
          <unicode>ᠠᠯᠭᠤᠷ ᠢᠶᠠᠷ</unicode>
          <transcript>-- ijer</transcript>
          <definition> Slowly, gradually, calmly.</definition>
        </example>
        <example>
          <unicode>ᠠᠯᠭᠤᠷ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>-- jabuxu</transcript>
          <definition> To walk slowly or quietly.</definition>
        </example>
        <example>
          <unicode>ᠠᠯᠭᠤᠷ ᠺᠡᠯᠡᠺᠦ</unicode>
          <transcript>-- keleky</transcript>
          <definition> To speak slowly.</definition>
        </example>
        <example>
          <unicode>ᠠᠯᠭᠤᠷ ᠵᠠᠩ</unicode>
          <transcript>-- zang</transcript>
          <definition> Slow or calm nature or behavior.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
