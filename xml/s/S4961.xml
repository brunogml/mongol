    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠰᠣᠨᠣᠰᠳᠠᠬᠣ</unicode>
      <uighur>sonosdaqu</uighur>
      <cyrillic>сонсдох</cyrillic>
      <transcript>SONUSTA-</transcript>
      <definition>[= sonusuγda- , v.pass. of sonus-] To be[come] heard or audible,~ to resound, to become known</definition>
      <page>728</page>
      <examples>
        <example>
          <unicode>ᠴᠢᠮᠠᠳᠤ ᠶᠠᠭᠤᠮ᠎ᠠ ᠰᠣᠨᠣᠰᠳᠠᠪᠠᠤ</unicode>
          <transcript>cimadu jaγum-a -- bau?</transcript>
          <definition> Have you heard anything?.</definition>
        </example>
        <example>
          <unicode>ᠡᠪ ᠦᠭᠡᠢ ᠰᠣᠨᠣᠰᠳᠠᠬᠣ</unicode>
          <transcript>eb ygei --xu</transcript>
          <definition> To sound disagreeable</definition>
        </example>
        <example>
          <unicode>ᠮᠣᠩᠭᠤᠯ ᠦᠭᠡ ᠰᠢᠭ ᠰᠣᠨᠣᠰᠳᠠᠬᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>mongγul yge sig --xu ygei</transcript>
          <definition> Does not sound like a Mongol word.</definition>
        </example>
      </examples>
    </entry_item>
