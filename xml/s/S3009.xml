      <dico>Lessing</dico>
      <unicode>ᠰᠢᠨᠠᠯᠠᠬᠣ</unicode>
      <uighur>sinalaqu</uighur>
      <cyrillic>шаналах</cyrillic>
      <transcript>SINALA-</transcript>
      <definition>v.i. To lament, wail, sob, moan, whimper ; to regret, repent, grieve ; to be afflicted or disappointed</definition>
      <page>710</page>
      <examples>
        <example>
          <unicode>ᠰᠢᠨᠠᠯᠠᠨ ᠵᠣᠪᠠᠬᠤ</unicode>
          <transcript>-- zobaxu </transcript>
          <definition>To grieve, suffer; to be vexed or disappointed</definition>
        </example>
        <example>
          <unicode>ᠡᠨᠡᠯᠦᠨ ᠰᠢᠨᠠᠯᠠᠬᠤ</unicode>
          <transcript>enelyn --xu</transcript>
          <definition> To be sorry; to be unhappy; to grieve</definition>
        </example>
      </examples>
