    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠰᠢᠮᠨᠤ ~ ᠰᠢᠮᠨᠣᠰ</unicode>
      <definition>esprit malfaisant. démon, représentant de la matière</definition>
      <page>1505</page>
      <examples>
        <example>
          <unicode>ᠡᠮ᠎ᠡ ᠰᠢᠮᠨᠣᠰ</unicode>
          <definition>esprit malfaisant du genre féminin</definition>
        </example>
        <example>
          <unicode>ᠡᠷ᠎ᠡ ᠰᠢᠮᠨᠣᠰ</unicode>
          <definition>esprit malfaisant du genre masculin</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠮᠨᠣᠰ ᠡᠴᠡ ᠢᠯᠠᠭᠤᠭᠰᠠᠨ</unicode>
          <definition>le vainqueur des démons</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠮᠨᠣᠰ ᠤᠨ ᠢᠳᠡᠭᠡᠯ</unicode>
          <definition>protecteur ou maître des démons</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠮᠨᠣᠰ ᠤᠨ ᠥᠺᠢᠨ</unicode>
          <definition>fille d'un esprit malfaisant</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠮᠨᠣᠰ ᠢ ᠨᠣᠮᠤᠭᠠᠳᠬᠠᠭᠴᠢ</unicode>
          <definition>dompteur des malins esprits ou des passions: bouddha</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠮᠨᠣᠰ ᠤᠨ ᠬᠠᠨ</unicode>
          <definition>roi des démons, maître du monde sensuel, dieu de l'amour et de toutes les passions</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠮᠨᠣᠰ ᠤᠨ ᠪᠠᠶᠠᠰᠬᠤᠯᠠᠩ ᠡᠺᠡ</unicode>
          <definition>l'épouse du maître des Chimnous</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠮᠨᠣᠰ ᠤᠨ ᠰᠤᠷᠪᠢ</unicode>
          <definition>gousse de l'acacia d'Égypte</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠮᠨᠣᠰ ᠢᠶᠠᠷ ᠦᠯᠦ ᠴᠢᠳᠠᠬᠤ</unicode>
          <definition>résister au démon</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠮᠨᠣᠰ ᠤᠨ ᠴᠢᠷᠢᠭ</unicode>
          <definition>armée du démon</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠮᠨᠣᠰ ᠤᠨ ᠵᠣᠯᠵᠠᠭᠠᠨ</unicode>
          <definition>enfant du démon</definition>
        </example>
      </examples>
