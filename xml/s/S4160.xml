    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠰᠢᠮᠨᠣᠰ</unicode>
      <uighur>simnos</uighur>
      <definition>n. A kind of mighty malevolent spirit (Buddh.).</definition>
      <page>1439</page>
      <examples>
        <example>
          <uighur>simnos-un qan</uighur>
          <definition>n. The ruler of the world of lusts, the spirit of love and affections (Buddh.).</definition>
        </example>
        <example>
          <uighur>simnos-un sorbi</uighur>
          <definition>n. The gods of Gleditsia. Gleditsia sinensis.</definition>
        </example>
      </examples>
    </entry_item>
