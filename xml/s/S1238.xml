    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠰᠠᠮᠠᠭᠣᠨ</unicode>
      <uighur>samaγun</uighur>
      <cyrillic>самуун</cyrillic>
      <transcript>SAMAΓUN</transcript>
      <definition>n., adj. and adv. Confusion, disturbance; disorder, disorganization; rebellion, mutiny, debauchery; adultery, depravity; disordered, troubled, agitated; immoral.</definition>
      <page>667</page>
      <examples>
        <example>
          <unicode>ᠰᠠᠮᠠᠭᠣᠨ ᠪᠤᠳᠤᠯᠢᠶᠠᠨ</unicode>
          <transcript>-- budulijan</transcript>
          <definition>Disorder, confusion.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠮᠠᠭᠣᠨ ᠴᠠᠭ</unicode>
          <transcript>-- caγ</transcript>
          <definition>Troubled times; time of confusion.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠮᠠᠭᠣᠨ ᠳᠡᠭᠳᠡᠺᠦ</unicode>
          <transcript>-- degdeky</transcript>
          <definition>Trouble or commotion starts.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠮᠠᠭᠣᠨ ᠡᠭᠦᠰᠭᠡᠺᠦ</unicode>
          <transcript>-- egyskeky</transcript>
          <definition>To start trouble or revolt.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠮᠠᠭᠣᠨ ᠡᠮ᠎ᠡ</unicode>
          <transcript>-- em-e</transcript>
          <definition>Lewd woman.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠮᠠᠭᠣᠨ ᠢ ᠳᠠᠷᠤᠬᠤ</unicode>
          <transcript>-- i daruxu</transcript>
          <definition>To quell a revolt.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠮᠠᠭᠣᠨ ᠶᠠᠪᠤᠳᠠᠯ</unicode>
          <transcript>-- jabudal</transcript>
          <definition>Debauchery, immoral conduct.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠮᠠᠭᠣᠨ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>-- jabuxu</transcript>
          <definition>To behave or live immorally or in a disorderly fashion.</definition>
        </example>
        <example>
