      <dico>Lessing</dico>
      <unicode>ᠰᠠᠷᠠᠭᠣᠯ</unicode>
      <uighur>saraγul</uighur>
      <cyrillic>саруул</cyrillic>
      <transcript>SARAΓUL</transcript>
      <definition>adj. Bright (as the moon), moonlit; light; clear, serene; intelligent; open, broad.</definition>
      <page>674</page>
      <examples>
        <example>
          <unicode>ᠰᠠᠷᠠᠭᠣᠯ ᠠᠮᠢᠰᠬᠤᠯ</unicode>
          <transcript>-- amisxul</transcript>
          <definition> Clear air.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠷᠠᠭᠣᠯ ᠪᠣᠯᠬᠤ</unicode>
          <transcript>-- bolxu</transcript>
          <definition> To clear up; to become light or moonlit.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠷᠠᠭᠣᠯ ᠰᠠᠶᠢᠬᠠᠨ</unicode>
          <transcript>-- saixan</transcript>
          <definition> Bright and beautiful.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠷᠠᠭᠣᠯ ᠰᠥᠨᠢ</unicode>
          <transcript>-- søni</transcript>
          <definition> Clear night.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠷᠠᠭᠣᠯ ᠲᠠᠯ᠎ᠠ</unicode>
          <transcript>-- tai-a</transcript>
          <definition> Open plain.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠷᠠᠭᠣᠯ ᠲᠠᠰᠤᠯᠭ᠎ᠠ</unicode>
          <transcript>-- tasulγ-a</transcript>
          <definition> A light room.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠷᠠᠭᠣᠯ ᠲᠤᠩᠭᠠᠯᠠᠭ</unicode>
          <transcript>-- tungγalaγ</transcript>
          <definition> Beautiful and clear.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠷᠠᠭᠣᠯ ᠤᠬᠠᠭᠠᠨ</unicode>
