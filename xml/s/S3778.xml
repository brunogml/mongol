      <dico>Boberg</dico>
      <unicode>ᠰᠢᠳᠥ</unicode>
      <uighur>sidu</uighur>
      <definition>n. A tooth.</definition>
      <page>1461</page>
      <examples>
        <example>
          <uighur>sidun-u büil-e</uighur>
          <definition>n. The gums between the teeth.</definition>
        </example>
        <example>
          <uighur>sidun-u ǰabsar</uighur>
          <definition>n. Spaces between teeth.</definition>
        </example>
        <example>
          <uighur>sidun-u Sikičilegür</uighur>
          <definition>n. A tooth-pick.</definition>
        </example>
        <example>
          <uighur>sidu qabiraqu</uighur>
          <definition>To gnash, to grind with the teeth.</definition>
        </example>
        <example>
          <uighur>sidu qabčikinaqu</uighur>
          <definition>v.i. To chatter with the teeth because of cold or anxiety.</definition>
        </example>
        <example>
          <uighur>sidu ǰaγuqu</uighur>
          <definition>To bite the teeth together or show the teeth in wrath or madness.</definition>
        </example>
        <example>
          <uighur>sidu ǰaγuraqu</uighur>
          <definition>To bite the teeth together.</definition>
        </example>
        <example>
          <uighur>sidu sikičilekü</uighur>
          <definition>To pick one's teeth.</definition>
        </example>
      </examples>
