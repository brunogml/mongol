    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ</unicode>
      <uighur>šaqšabad</uighur>
      <cyrillic>шaгшаавад</cyrillic>
      <transcript>ŠAΓŠABAD</transcript>
      <definition>[S. çikshā-pada] n. Rules of religious life, esp. for monks; vow to keep these rules; ethics, morals.</definition>
      <page>748</page>
      <examples>
        <example>
          <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ ᠡᠪᠡᠳᠺᠦ</unicode>
          <transcript>-- ebdeky</transcript>
          <definition> To violate precepts or commandments.</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ ᠰᠠᠪᠢᠬᠤ</unicode>
          <transcript>-- sakixu</transcript>
          <definition> To keep precepts, commandments, or a vow.</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ ᠲᠡᠭᠦᠯᠳᠡᠷ</unicode>
          <transcript>-- tegylder</transcript>
          <definition> One who keeps precepts perfectly, rigidly virtuous, strictly religious.</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition> Violating precepts, immoral.</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ ᠦᠨᠡᠺᠡᠷ ᠲᠡᠭᠦᠰᠦᠭᠰᠡᠨ</unicode>
          <transcript>-- yneker tegysygsen</transcript>
          <definition> Truly perfected virtue.</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠯᠠᠭᠠᠢ ᠱᠠᠬᠱᠠᠪᠠᠳ</unicode>
          <transcript>calaγai -- </transcript>
          <definition> Lack or breach of [religious] discipline.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ</unicode>
      <transcript>ŠAΓŠABAD</transcript>
      <definition> (fr. S. çikshā-pada "moral command"); T. tshul khrims; S. çila. Monk's discipline. </definition>
      <page>1184</page>
      <examples>
        <example>
          <unicode>ᠱᠠᠭᠱᠠᠪᠠᠳ ᠲᠡᠭᠦᠯᠳᠡᠷ</unicode>
          <transcript>+++ -- tegylder; </transcript>
          <definition>T. tshul khrims ldan, tshul khrims can. One who keeps the precepts perfectly; perfectly virtuous</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ</unicode>
      <definition>bonne conduite , conduite morale, préceptes de la morale; 2 commandement. préceptes de l'enseignement, méthode; 3 étude. exercice, action d'apprendre, de s'instruire; 4 observation des préceptes, du voeu.</definition>
      <page>1451</page>
      <examples>
        <example>
          <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ ᠡᠪᠳᠡᠺᠦ</unicode>
          <definition>violer les préceptes de la morale, cesser observer les préceptes</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ ᠦᠨᠡᠭᠡᠷ ᠲᠡᠭᠦᠰᠦᠭᠰᠡᠨ</unicode>
          <definition>pureté des moeurs, bonne conduite, d'une moralité irréprochable</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ ᠦᠭᠡᠢ</unicode>
          <definition>immoral; 2 qui ne connait ni ordre ni méthode; 3 qui contrevient qu préceptes de la morale</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ ᠪᠠᠷᠠᠮᠢᠳ</unicode>
          <definition>accomplissement des devoirs moraux ou religieux comme moyen de salut</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ ᠤᠨ ᠰᠠᠩ</unicode>
          <definition>trésor de principes de la morale: Câkyamouni</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ ᠰᠠᠺᠢᠬᠤ</unicode>
          <definition>observer les préceptes de la morale, accomplir les devoirs moraux, accomplir un voeu</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ ᠲᠡᠭᠦᠯᠳᠡᠷ</unicode>
          <definition>d'une bonne conduite, doué d'une conduite morale; qui s'est imposé les devoirs moraux; qui a fait un voeu</definition>
        </example>
        <example>
          <unicode>ᠱᠠᠬᠱᠠᠪᠠᠳ ᠤᠨ ᠴᠤᠭᠴᠠ</unicode>
          <definition>recueil ou abrégé des réceptes de la morale et des devoirs des religieux</definition>
        </example>
      </examples>
    </entry_item>
