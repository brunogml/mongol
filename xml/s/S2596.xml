    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠰᠠᠺᠰᠥᠷᠠᠺᠥ</unicode>
      <uighur>seksürekü</uighur>
      <cyrillic>сэгсрэх</cyrillic>
      <transcript>SEGSYRE-</transcript>
      <definition>v.t. To shake the head or body; to shake off, shake out (as dust).</definition>
      <page>683</page>
      <examples>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠪᠡᠨ ᠰᠠᠺᠰᠥᠷᠠᠺᠥ</unicode>
          <transcript>bej-e ben --ky</transcript>
          <definition> To shake one's body (in order to shake off snow, dust, etc.).</definition>
        </example>
        <example>
          <unicode>ᠲᠣᠯᠤᠭᠠᠢ ᠪᠡᠨ ᠰᠠᠺᠰᠥᠷᠠᠺᠥ</unicode>
          <transcript>toluγai ben --ky</transcript>
          <definition>To shake one's head in disagreement.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
