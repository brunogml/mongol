    <entry_item>
      <dico>lamrd</dico>
      <unicode>ᠰᠢᠷᠪᠥᠰᠥ</unicode>
      <cyrillic>ШӨРМӨС(ӨН)</cyrillic>
      <definition>1. жила; сухожилие; фибра; нервы; арьс шөрмөс хорш. кожа; нийтгэмэл шөрмөс сучёные сухожилия, сучёные нитки из сухожилий; судас шөрмөс, шөрмөс судас хорш. жилы; сухожилия; шөрмөс боох обматывать тонкими жилами оперённый конец стрелы; шөрмөс долоолгох обвивать жилами (тонкие места лука); шөрмөс орхих наклеивать жилы на внутреннюю сторону лука для придания большей упругости; шөрмөс татах судорога, конвульсия; шөрмөс татна сводит судорога; шөрмөс шандас хорш. жилы; фибра; 2. жилистый; шөрмөсөн аргамж верёвка из жил; шөрмөсөн чулуу асбест (үгчил. жилистый камень).</definition>
      <page>0</page>
    </entry_item>
