    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠰᠠᠴᠠᠭᠣ</unicode>
      <uighur>sačaγu</uighur>
      <cyrillic>сацуу</cyrillic>
      <transcript>SACAΓU</transcript>
      <definition>[= cacaγu, cicau] adj., adv. and n. Equal[ly], level, even, on a level; proportionately; coeval; as soon as ( cf. saca).</definition>
      <page>654</page>
      <examples>
        <example>
          <unicode>ᠰᠠᠴᠠᠭᠣ ᠨᠠᠰᠤᠲᠠᠢ</unicode>
          <transcript>-- nasutai</transcript>
          <definition> Of the same age, coeval.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠴᠠᠭᠣ ᠬᠤᠪᠢᠶᠠᠬᠤ</unicode>
          <transcript>-- xubijaxu</transcript>
          <definition> To divide into even parts.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠴᠠᠭᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition> Inequality; not equal, not even.</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠨ ᠎ᠯᠦᠭᠡ ᠰᠠᠴᠠᠭᠣ</unicode>
          <transcript>egyn lyge -- </transcript>
          <definition> Along with this, simultaneously with this.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠷᠬᠤᠢ ᠎ᠯᠤᠭ᠎ᠠ ᠰᠠᠴᠠᠭᠣ</unicode>
          <transcript>γarxui luγ-a -- </transcript>
          <definition> As soon as [something] came out, appeared, was seen</definition>
        </example>
        <example>
          <unicode>ᠨᠠᠰᠤ ᠰᠠᠴᠠᠭᠣ</unicode>
          <transcript>nasu -- </transcript>
          <definition> Coeval, of the same age, contemporary</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠤᠬᠤ ᠎ᠶᠢᠨ ᠰᠠᠴᠠᠭᠣ</unicode>
          <transcript>oruxu [jin] -- </transcript>
          <definition> As soon as [he] entered.</definition>
        </example>
      </examples>
    </entry_item>
