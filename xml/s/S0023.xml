    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠰᠠᠨᠠᠭᠠᠳᠠᠢ ~ ᠰᠠᠨᠠᠭᠠᠳᠤ</unicode>
      <definition>celui qui pense; qui pense juste, qui sait trouver des expédients, qui pense beaucoup; 2 qui se rappele; 3 sensé, raisonnable, homme entendu.</definition>
      <page>1283</page>
      <examples>
        <example>
          <unicode>ᠠᠭᠤᠤ ᠰᠠᠨᠠᠭᠠᠳᠤ</unicode>
          <definition>prévoyant</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠶᠢᠨ ᠰᠠᠨᠠᠭᠠᠳᠤ</unicode>
          <definition>bien intentionné, bienveillant, affectionné, bénévole</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠨᠠᠭᠠᠳᠤ ᠪᠣᠯᠬᠤ</unicode>
          <definition>reprendre ses forces, reprendre ses esprits; être circonspect, prudent</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠭᠤ ᠰᠠᠨᠠᠭᠠᠳᠤ</unicode>
          <definition>mal intentionné, malveillant, ennemi</definition>
        </example>
      </examples>
    </entry_item>
