      <dico>Lessing</dico>
      <unicode>ᠰᠣᠷᠲᠠᠭᠣᠨ</unicode>
      <uighur>surdaγun</uighur>
      <cyrillic>суртгуун</cyrillic>
      <transcript>SURTAΓUN</transcript>
      <definition>n. That which is taught or studied; science, rules, doctrine</definition>
      <page>740</page>
      <examples>
        <example>
          <unicode>ᠰᠢᠷ᠎ᠠ ᠰᠣᠷᠲᠠᠭᠣᠨ</unicode>
          <transcript>sir-a – </transcript>
          <definition>The doctrine of the yellow (reformed) sect of Lamaism</definition>
        </example>
        <example>
          <unicode>ᠤᠯᠠᠭᠠᠨ ᠰᠣᠷᠲᠠᠭᠣᠨ ᠢ ᠪᠢᠰᠢᠷᠡᠺᠦ</unicode>
          <transcript>ulaγan -- i bisireky </transcript>
          <definition> To profess the red (unreformed) persuasion of Lamaism.</definition>
        </example>
      </examples>
