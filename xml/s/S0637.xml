    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠰᠠᠪ</unicode>
      <uighur>sab</uighur>
      <cyrillic>сав</cyrillic>
      <transcript>SAB</transcript>
      <definition>1 Intensifying particle used before certain adjectives and adverbs beginning with sa: very, much, completely.</definition>
      <page>653</page>
      <examples>
        <example>
          <unicode>ᠰᠠᠪ ᠰᠠᠶᠢᠬᠠᠨ</unicode>
          <transcript>-- saixan</transcript>
          <definition> Perfectly, very nicely.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠪ ᠰᠠᠶᠢ</unicode>
          <transcript>-- saji</transcript>
          <definition> Just a moment ago.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠪ ᠰᠠᠨᠠᠭᠠᠨ ᠎ᠳᠤ ᠦᠭᠡᠢ</unicode>
          <transcript>-- sanaγan du ygei</transcript>
          <definition> Quite unexpectedly.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
