    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠰᠠᠮᠠᠭᠣᠷᠠᠭᠣᠯᠬᠣ</unicode>
      <uighur>samaγuraγulqu</uighur>
      <cyrillic>самууруулах</cyrillic>
      <transcript>SAMAΓURAΓUL-</transcript>
      <definition>[v. caus. of samaγura-] To cause disorder, alarm, disturbances or commotion; to disorganize, disturb; to arouse discord or mutiny; to trouble, agitate.</definition>
      <page>667</page>
      <examples>
        <example>
          <unicode>ᠰᠠᠮᠠᠭᠣᠷᠠᠭᠣᠯᠤᠨ ᠦᠢᠮᠡᠭᠦᠯᠺᠦ</unicode>
          <transcript>--un yimegylky</transcript>
          <definition> To disturb, cause confusion.</definition>
        </example>
        <example>
          <unicode>ᠡᠨᠡ ᠭᠡᠷ ᠢ ᠺᠡᠦᠺᠡᠳ ᠢᠶᠡᠷ ᠪᠢᠲᠡᠭᠡᠢ ᠰᠠᠮᠠᠭᠣᠷᠠᠭᠣᠯ</unicode>
          <transcript>ene ger i keyked ijer bitegei -- !</transcript>
          <definition> Do not let children mess up this room</definition>
        </example>
        <example>
          <unicode>ᠵᠢᠷᠤᠮ ᠢ ᠰᠠᠮᠠᠭᠣᠷᠠᠭᠣᠯᠬᠤ</unicode>
          <transcript>zirum i --xu</transcript>
          <definition> To disturb the law, upset the order</definition>
        </example>
      </examples>
    </entry_item>
