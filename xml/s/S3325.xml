    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠰᠢᠭᠠᠷᠳᠠᠬᠣ</unicode>
      <uighur>siγardaqu</uighur>
      <cyrillic>шаардах</cyrillic>
      <transcript>SIΓARDA-</transcript>
      <definition>[= saγarda-] v. t. To urge, drive, speed up; to insist, importune, demand; to press, compel.</definition>
      <page>699</page>
      <examples>
        <example>
          <unicode>ᠰᠢᠭᠠᠷᠳᠠᠨ ᠨᠡᠺᠡᠮᠵᠢᠯᠡᠺᠦ</unicode>
          <transcript>--n nekemzileky</transcript>
          <definition> To ask, insist, importune.</definition>
        </example>
        <example>
          <unicode>... ᠭᠡᠵᠦ ᠰᠢᠭᠠᠷᠳᠠᠬᠤ</unicode>
          <transcript> . . gezy --xu.</transcript>
          <definition> To demand that .. .</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠨ ᠤ ᠡᠮᠦᠨ᠎ᠡ ᠰᠢᠭᠠᠷᠳᠠᠵᠤ ᠪᠠᠶᠢᠬᠤ ᠶᠠᠪᠤᠳᠠᠯ</unicode>
          <transcript>man u emyn-e --zu baixu jabudal</transcript>
          <definition> A matter demanding our immediate attention.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠶᠢᠵᠢᠷᠠᠭᠤᠯᠬᠤ ᠎ᠶᠢ ᠰᠢᠭᠠᠷᠳᠠᠬᠤ</unicode>
          <transcript>saiziraγulxu ji --xu</transcript>
          <definition> To demand or require improvement.</definition>
        </example>
        <example>
          <unicode>ᠵᠢᠳᠺᠦᠯ ᠢ ᠰᠢᠭᠠᠷᠳᠠᠬᠤ</unicode>
          <transcript>zidkyl i --xu</transcript>
          <definition> To require effort.</definition>
        </example>
      </examples>
    </entry_item>
