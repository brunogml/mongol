    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠰᠢᠬᠠᠭᠠᠬᠣ</unicode>
      <uighur>siqaγaqu</uighur>
      <cyrillic>шагаах</cyrillic>
      <transcript>SIXAΓA-</transcript>
      <definition>[= siгγa-, 3.] v.t. To peer, look intently or searchingly; to peep through; to take aim</definition>
      <page>721</page>
      <examples>
        <example>
          <unicode>ᠰᠢᠬᠠᠭᠠᠵᠤ ᠬᠠᠷᠠᠬᠤ</unicode>
          <transcript>--zu xaraxu</transcript>
          <definition> To gaze, spy; to peep in or through.</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠬᠠᠭᠠᠵᠤ ᠦᠵᠡᠺᠦ</unicode>
          <transcript>--zu yzeky</transcript>
          <definition> To look or peep through (a door, window, chink).</definition>
        </example>
      </examples>
    </entry_item>
