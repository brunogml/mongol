    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠰᠢᠨᠠᠯᠠᠺᠥ</unicode>
      <uighur>sinelekü</uighur>
      <cyrillic>шинэлэх</cyrillic>
      <transcript>SINELE-</transcript>
      <definition>v. t. To celebrate the New Year; to present one's wishes for the New Year.</definition>
      <page>711</page>
      <examples>
        <example>
          <unicode>ᠰᠢᠨᠠᠯᠠᠺᠥ ᠣᠶᠢᠷᠠᠲᠠᠵᠤ ᠪᠠᠶᠢᠨ᠎ᠠ</unicode>
          <transcript>--ky oiratazu bain- a</transcript>
          <definition> The New Year is approaching.</definition>
        </example>
        <example>
          <unicode>ᠪᠢ ᠸᠢᠮᠠᠯᠤᠭ᠎ᠠ ᠰᠢᠨᠠᠯᠠᠶ᠎ᠡ</unicode>
          <transcript>bi cimaluγ-a --j-e</transcript>
          <definition> I wish to present you with a New Year's greeting (an introductory phrase preceding the formal exchange of New Year, s greetings ).</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠨᠡ ᠠᠮᠠᠷᠬᠠᠨ ᠰᠠᠶᠢᠨ ᠰᠢᠨᠠᠯᠠᠪᠡᠦ</unicode>
          <transcript>[sine] amarxan sain –bey!</transcript>
          <definition> Happy New Year!. ( lit.: Have you passed the New Year well ?.).</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
