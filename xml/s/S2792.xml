      <dico>Boberg</dico>
      <unicode>ᠰᠠᠷᠢᠺᠥᠨ</unicode>
      <uighur>serigün</uighur>
      <definition>adj. Pleasant. Cool. Refreshing, fresh, breezy. Chilly. Awake, not fallen asleep.</definition>
      <page>1407</page>
      <examples>
        <example>
          <uighur>serigün bayising</uighur>
          <definition>n. A summer-house. A pavilion.</definition>
        </example>
        <example>
          <uighur>serigün dara</uighur>
          <definition>A cool or refreshing pillow, a child-shaped porcelain vessel filled with gold water used as a pilow.</definition>
        </example>
        <example>
          <uighur>serigün čečeg</uighur>
          <definition>n. The narcissus.</definition>
        </example>
        <example>
          <uighur>serigün selkin</uighur>
          <definition>n. Cool breeze.</definition>
        </example>
