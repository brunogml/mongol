  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠰᠢᠢᠳᠬᠡᠭᠥ</unicode>
      <uighur>siidkekü</uighur>
      <cyrillic>шийтгэх</cyrillic>
      <transcript>SIIDKE-</transcript>
      <definition>[v. caus. of siid-] v. t. To make a decision, pass a resolution; to try in court; to pass judgment; to punish, chastise</definition>
      <page>704</page>
      <examples>
        <example>
          <unicode>ᠪᠠᠶᠢᠴᠠᠭᠠᠨ ᠰᠢᠢᠳᠬᠡᠭᠥ</unicode>
          <transcript>baicaγan --ky</transcript>
          <definition> To investigate and bring to justice.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠷᠡᠭ ᠢ ᠰᠢᠢᠳᠬᠡᠭᠥ</unicode>
          <transcript>kereg i --ky</transcript>
          <definition> To decide an affair; to try a case (in court).</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠰᠤᠯᠤᠨ ᠰᠢᠢᠳᠬᠡᠭᠥ</unicode>
          <transcript>tasulun --ky</transcript>
          <definition> To solve, decide, pass a resolunon or decision</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠷᠢᠬᠤ ᠪᠡᠷ ᠰᠢᠢᠳᠬᠡᠭᠥ</unicode>
          <transcript>xorixu ber --ky</transcript>
          <definition> To sentence to imprisonment.</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠯᠬᠠᠭᠠᠨ ᠰᠢᠢᠳᠬᠡᠭᠥ</unicode>
          <transcript>zalxaγan --ky</transcript>
          <definition> To chastise; to punish</definition>
        </example>
      </examples>
    </entry_item>
