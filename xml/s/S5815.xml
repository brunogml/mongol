      <dico>Lessing</dico>
      <unicode>ᠰᠣᠯᠢᠶᠠᠷᠠᠬᠣ</unicode>
      <uighur>soliyaraqu</uighur>
      <cyrillic>солиорох</cyrillic>
      <transcript>SOLIJARA-</transcript>
      <definition>v. i. To become crazy; to be delirious; to act or speak without sense</definition>
      <page>725</page>
      <examples>
        <example>
          <unicode>ᠰᠣᠯᠢᠶᠠᠷᠠᠵᠤ ᠦᠺᠦᠺᠦ</unicode>
          <transcript>--zu ykyky</transcript>
          <definition> To die from madness.</definition>
        </example>
        <example>
          <unicode>ᠪᠢᠲᠡᠭᠡᠢ ᠰᠣᠯᠢᠶᠠᠷᠠ</unicode>
          <transcript>bitegei --!</transcript>
          <definition> Don't speak nonsense!.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
