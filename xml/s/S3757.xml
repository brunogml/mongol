      <dico>Lessing</dico>
      <unicode>ᠰᠢᠳᠢ</unicode>
      <uighur>sidi</uighur>
      <cyrillic>шид</cyrillic>
      <transcript>SIDI</transcript>
      <definition>[= siddhi= siddi, S. siddhi, translated by various forms of byty-.] n. Supernatural power, magic; certain mundane and supernatural gifts of which often eight are enumerated,</definition>
      <page>698</page>
      <examples>
        <example>
          <unicode>ᠰᠢᠳᠢ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <transcript>-- γarγaxu</transcript>
          <definition> To perform magic feats, display supernatural power.</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠳᠢ ᠎ᠶᠢᠨ ᠦᠵᠡᠯ</unicode>
          <transcript>-- jin yzel</transcript>
          <definition> Mysticism.</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠳᠢ ᠣᠯᠤᠭᠰᠠᠨ</unicode>
          <transcript>-- oluγsan</transcript>
          <definition> (Person) having obtained supernatural power; magician.</definition>
        </example>
        <example>
          <unicode>ᠰᠢᠳᠢ ᠣᠷᠤᠭᠤᠯᠬᠤ</unicode>
          <transcript>-- oruγulxu</transcript>
          <definition> To inject magic.</definition>
        </example>
      </examples>
    </entry_item>
