      <dico>Lessing</dico>
      <unicode>ᠰᠢᠩᠺᠠᠺᠠᠺᠥ</unicode>
      <uighur>sinkkekekü</uighur>
      <cyrillic>шингээх</cyrillic>
      <transcript>SINGGEGE-</transcript>
      <definition>[v. caus. of singge-] To cause to absorb, imbibe; to digest, as food; to impregnate; to assimilate, appropriate</definition>
      <page>712</page>
      <examples>
        <example>
          <unicode>ᠰᠢᠩᠺᠠᠺᠠᠺᠦᠶ᠎ᠡ ᠺᠢᠯᠪᠠᠷ</unicode>
          <transcript>--kyi-e kilbar</transcript>
          <definition> Easy to digest, digestible.</definition>
        </example>
        <example>
          <unicode>ᠢᠳᠡᠭᠡᠨ ᠰᠢᠩᠺᠠᠺᠠᠺᠦ</unicode>
          <transcript>idegen --ky</transcript>
          <definition> To digest food</definition>
        </example>
        <example>
          <unicode>ᠬᠤᠪᠢ ᠎ᠳᠤ ᠠᠰᠢᠭᠯᠠᠨ ᠰᠢᠩᠺᠠᠺᠠᠺᠦ</unicode>
          <transcript>xubi du asiylan --ky</transcript>
          <definition> To use or apply for one's personal advantage; to appropriate.</definition>
        </example>
      </examples>
