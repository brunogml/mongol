    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠰᠠᠺᠥᠺᠥ</unicode>
      <uighur>segükü</uighur>
      <cyrillic>сөхөх</cyrillic>
      <transcript>SEKY-</transcript>
      <definition>[= søky-] v.t. To raise, lift up, open by lifting up</definition>
      <page>685</page>
      <examples>
        <example>
          <unicode>ᠴᠣᠩᠬᠤ ᠰᠠᠺᠥᠺᠥ</unicode>
          <transcript>congxu --ky</transcript>
          <definition> To raise the window.</definition>
        </example>
        <example>
          <unicode>ᠡᠭᠦᠳᠡ ᠰᠠᠺᠥᠺᠥ</unicode>
          <transcript>egyde --ky</transcript>
          <definition> To lift up the felt curtain in front of the door.</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠦᠺᠡ ᠰᠠᠺᠥᠺᠥ</unicode>
          <transcript>eryke --ky</transcript>
          <definition> To lift (raise, open) the covering of the smoke hole in a yurt</definition>
        </example>
        <example>
          <unicode>ᠨᠣᠮ ᠰᠠᠺᠥᠺᠥ</unicode>
          <transcript>nom --ky</transcript>
          <definition> To open a book.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠰᠡᠭᠦᠺᠦ</unicode>
      <definition>lever, relever (p. e. un habit de devant, ses manches), rouler (des habits , une couverture de lit).</definition>
      <page>1365</page>
      <examples>
        <example>
          <unicode>ᠮᠣᠳᠤᠨ ᠤ ᠨᠠᠪᠴᠢᠳ ᠢ ᠲᠡᠭᠡᠭᠰᠢ ᠰᠡᠭᠦᠪᠡᠢ</unicode>
          <definition>(le vent) souleva les feuilles des arbres</definition>
        </example>
      </examples>
    </entry_item>
