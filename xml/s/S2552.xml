    <entry_item>
      <dico>cevel</dico>
      <unicode>ᠰᠡᠬᠦᠬᠦ</unicode>
      <cyrillic>сөхөх</cyrillic>
      <definition>1. унжуулсан юмыг өөд нь болгох шуух; хаяа сөхөх;2. юмны хавхаг, таглаа зэргийг өөд нь болгох буюу онгойлгох нээх; авдрын хавхаг нээх;3. дарагдсан хэргийг гаргах.</definition>
