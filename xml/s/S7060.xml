    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠰᠥᠷᠴᠢᠺᠥ</unicode>
      <uighur>sürčikü</uighur>
      <cyrillic>сүрчих</cyrillic>
      <transcript>SYRCI-</transcript>
      <definition>v.t. To spray (paint, etc.); to strew, spread by scattering; to sprinkle. [Mo.] To anoint (a dying man).</definition>
      <page>744</page>
      <examples>
        <example>
          <unicode>ᠰᠥᠷᠴᠢᠺᠥ ᠡᠮ</unicode>
          <transcript>--ky em</transcript>
          <definition> Medicine applied by spraying; ointment, unguent.</definition>
        </example>
        <example>
          <unicode>ᠤᠰᠤ ᠰᠥᠷᠴᠢᠺᠥ</unicode>
          <transcript>usu --ky</transcript>
          <definition> To sprinkle water.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠰᠦᠷᠴᠢᠺᠦ</unicode>
      <definition>oindre, enduire (d'onguent, de couleur), asperger, arroser, parfumer tout autour, encenser. saupoudrer.</definition>
      <page>1437</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠲᠠᠨ ᠰᠦᠷᠴᠢᠭᠰᠠᠨ</unicode>
          <definition>enduit d'or, doré</definition>
        </example>
        <example>
          <unicode>ᠦᠨᠡᠰᠦᠨ ᠰᠦᠷᠴᠢᠺᠦ</unicode>
          <definition>saupoudrer, couvrir de cendre</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠪᠡᠨ ᠺᠦᠵᠢᠰ ᠎ᠶᠢᠡᠷ ᠰᠦᠷᠴᠢᠺᠦ</unicode>
          <definition>frotter le corps, enduire le corps de parfums</definition>
        </example>
        <example>
          <unicode>ᠰᠦᠨ ᠪᠠ ᠲᠤᠰᠤ ᠢᠶᠠᠷ ᠨᠢᠳᠦᠨ ᠤ ᠵᠡᠷᠡ ᠳ᠋‍‍ᠤ‍ᠷ ᠰᠦᠷᠴᠢᠺᠦ</unicode>
          <definition>asperger de lait ou enduire de beurre la plaie d'un oeil</definition>
        </example>
        <example>
          <unicode>ᠰᠦᠷᠴᠢᠺᠦᠢ ᠡᠮ</unicode>
          <definition>onguent</definition>
        </example>
        <example>
          <unicode>ᠰᠦᠷᠴᠢᠺᠦᠢ ᠺᠦᠵᠢ</unicode>
          <definition>parfums dont on se frotte</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠭᠤᠢ ᠪᠤᠷᠳᠠᠬ ᠢᠶᠠᠷ ᠪᠡᠶ᠎ᠡ ᠳ᠋‍‍ᠤ‍ᠷ ᠴᠢᠨᠤ ᠰᠦᠷᠴᠢᠮᠦᠢ</unicode>
          <definition>je te parfumerai d'odeur puante et impure</definition>
        </example>
      </examples>
    </entry_item>
