    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠰᠢᠯᠺᠥᠳᠺᠥ</unicode>
      <uighur>silgüdkü</uighur>
      <transcript>SILGYD-</transcript>
      <definition>v. i. and t. To shake, move; to be very zealous; to be jealous; to envy; to hold as very dear; to value.</definition>
      <page>706</page>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠰᠢᠯᠭᠦᠳᠺᠦ</unicode>
      <definition>estimer trop: 2 s&apos;attacher à qc. , tenir à qc. 3 regarder avec envie, envier; chercher à égaler.</definition>
      <page>1503</page>
      <examples>
        <example>
          <unicode>ᠰᠢᠯᠭᠦᠳᠴᠦ ᠺᠦᠢᠺᠦ</unicode>
