      <dico>Lessing</dico>
      <unicode>ᠰᠢᠺᠥᠷᠳᠠᠺᠥ</unicode>
      <uighur>sigürdekü</uighur>
      <cyrillic>шүүрдэх</cyrillic>
      <transcript>SIGYRDE-</transcript>
      <definition>1 v. t. To sweep, wipe off, dust with a broom; to comb with a fine comb</definition>
      <page>703</page>
      <examples>
        <example>
          <unicode>ᠰᠢᠺᠥᠷᠳᠠᠨ ᠠᠷᠢᠭᠤᠳᠬᠠᠬᠤ</unicode>
          <transcript>--n ariγudxaxu</transcript>
          <definition> To clean thoroughly, wipe out ( also fig. ).</definition>
        </example>
        <example>
          <unicode>ᠠᠷᠴᠢᠨ ᠰᠢᠺᠥᠷᠳᠠᠺᠥ</unicode>
          <transcript>arcin --ky</transcript>
          <definition> To sweep and clean.</definition>
        </example>
      </examples>
    </entry_item>
