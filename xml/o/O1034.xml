      <dico>Lessing</dico>
      <unicode>ᠥᠯᠳᠠᠺᠥ</unicode>
      <uighur>üldekü</uighur>
      <cyrillic>үлдэх</cyrillic>
      <transcript>YLDE-</transcript>
      <definition>2 v. t. To chase away; to drive out; to expel.</definition>
      <page>1004</page>
      <examples>
        <example>
          <unicode>ᠥᠯᠳᠠᠵᠦ ᠢᠯᠡᠭᠡᠺᠦ</unicode>
          <transcript>--zy ilegeky</transcript>
          <definition> To expel, chase away or out.</definition>
        </example>
        <example>
          <unicode>ᠥᠯᠳᠠᠵᠦ ᠺᠥᠭᠡᠭᠡᠺᠦ</unicode>
          <transcript>--zy køgegeky</transcript>
          <definition> To drive out, chase away.</definition>
        </example>
        <example>
          <unicode>ᠠᠳᠠ ᠎ᠶᠢ ᠥᠯᠳᠠᠺᠥ</unicode>
          <transcript>ada ji --ky</transcript>
          <definition> To exorcize an evil spirit.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠷᠭᠠᠬᠤ ᠥᠯᠳᠠᠺᠥ</unicode>
          <transcript>γarγazu --ky</transcript>
          <definition> To expel, banish.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠭᠡ ᠥᠯᠳᠠᠺᠥ</unicode>
          <transcript>terge --ky</transcript>
          <definition> To drive a cart.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠶᠢᠨ᠎ᠠ ᠡᠴᠡ ᠥᠯᠳᠠᠺᠥ</unicode>
          <transcript>xoin-a ece --ky</transcript>
          <definition> To pursue.</definition>
        </example>
      </examples>
    </entry_item>
