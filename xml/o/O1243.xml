      <dico>Lessing</dico>
      <unicode>ᠥᠮᠺᠠᠷᠠᠺᠥ</unicode>
      <uighur>ömkerekü</uighur>
      <cyrillic>өмхрөх</cyrillic>
      <transcript>ØMKERE-</transcript>
      <definition>[= ømkeri-, ømkyri-, øngkeri-] v. i. To roll about, toss, wallow.</definition>
      <page>635</page>
      <examples>
        <example>
          <unicode>ᠥᠮᠺᠠᠷᠠᠺᠦ ᠡᠪᠡᠰᠦ</unicode>
          <transcript>--ky ebesy</transcript>
          <definition> Wormwood</definition>
        </example>
        <example>
          <unicode>ᠥᠮᠺᠠᠷᠠᠵᠦ ᠭᠠᠷ</unicode>
          <transcript>--zu γar!</transcript>
          <definition> Get out !. Get lost !.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠵᠠᠷ ᠎ᠲᠤᠷ ᠥᠮᠺᠠᠷᠠᠺᠦ</unicode>
          <transcript>γazar tur – </transcript>
          <definition>To roll on the ground</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠰᠦᠷᠡ ᠥᠮᠺᠠᠷᠠᠺᠦ</unicode>
          <transcript>køsyre –ky </transcript>
          <definition>To roll on the ground or floor</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
