  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠥᠷᠪᠢᠰᠺᠠᠺᠥ</unicode>
      <uighur>örbiskekü</uighur>
      <cyrillic>өрөвсгөх</cyrillic>
      <transcript>ØRBISKE-</transcript>
      <definition>[v. caus. of ørbis-] To cause to burn, make fire; to spread, stir up, agitate.</definition>
      <page>640</page>
      <examples>
        <example>
          <unicode>ᠥᠷᠪᠢᠰᠺᠠᠵᠦ ᠪᠣᠰᠬᠠᠬᠤ</unicode>
          <transcript>--zy bosxaxu</transcript>
          <definition> To bring to light; to stir up.</definition>
        </example>
        <example>
          <unicode>ᠳᠠᠷᠤᠭᠳᠠᠭᠰᠠᠨ ᠺᠡᠷᠡᠭ ᠢ ᠥᠷᠪᠢᠰᠺᠠᠵᠦ ᠪᠣᠰᠬᠠᠬᠤ</unicode>
          <transcript>daruγdaγsan kereg i --zy bosxaxu</transcript>
          <definition> To bring to light a matter that has been suppressed.</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠯ ᠢ ᠥᠷᠪᠢᠰᠺᠠᠵᠦ ᠪᠣᠰᠬᠠᠬᠤ</unicode>
          <transcript>γal i --zy bosxaxu</transcript>
          <definition> To stir fire.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
