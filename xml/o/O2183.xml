      <dico>Lessing</dico>
      <unicode>ᠥᠷᠭᠡᠳᠬᠡᠭᠥ</unicode>
      <uighur>örgedkekü</uighur>
      <cyrillic>өргөтгөх</cyrillic>
      <transcript>ØRGEDKE-</transcript>
      <definition>v. t. To widen, broaden, enlarge, increase, spread, develop.</definition>
      <page>640</page>
      <examples>
        <example>
          <unicode>ᠥᠷᠭᠡᠳᠬᠡᠨ ᠪᠠᠶᠢᠭᠤᠯᠬᠤ</unicode>
          <transcript>--n baiγulxu</transcript>
          <definition> To expand, establish on a larger scale.</definition>
        </example>
        <example>
          <unicode>ᠡᠮᠨᠡᠯᠭᠡ ᠎ᠶᠢᠨ ᠭᠠᠵᠠᠷᠤᠳ ᠢ ᠥᠷᠭᠡᠳᠬᠡᠨ ᠪᠠᠶᠢᠭᠤᠯᠬᠤ</unicode>
          <transcript>emnelge jin γazarud i --n baiγulxu</transcript>
          <definition> To increase [the number of] medical institutions.</definition>
        </example>
        <example>
          <unicode>ᠥᠷᠭᠡᠳᠬᠡᠨ ᠪᠠᠶᠢᠭᠤᠯᠬᠤ</unicode>
          <transcript>--n baiγulxu</transcript>
          <definition> To enlarge, extend.</definition>
        </example>
      </examples>
    </entry_item>
