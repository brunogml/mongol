      <dico>Lessing</dico>
      <unicode>ᠥᠨᠥᠺᠠ</unicode>
      <uighur>önüke</uighur>
      <cyrillic>өнөө</cyrillic>
      <transcript>ØNYGE</transcript>
      <definition>[= øny] adj. and adv. Now, today; the present, this; the said, the one.</definition>
      <page>639</page>
      <examples>
        <example>
          <unicode>ᠥᠨᠥᠺᠠ ᠡᠴᠡ</unicode>
          <transcript>-- ece</transcript>
          <definition> Henceforward.</definition>
        </example>
        <example>
          <unicode>ᠥᠨᠥᠺᠠ ᠡᠳᠦᠷ</unicode>
          <transcript>-- edyr</transcript>
          <definition> Today.</definition>
        </example>
        <example>
          <unicode>ᠥᠨᠥᠺᠠ ᠎ᠶᠢᠨ</unicode>
          <transcript>-- jin</transcript>
          <definition> Today's; present.</definition>
