        <example>
          <unicode>ᠥᠨᠥᠺᠠ ᠮᠠᠷᠭᠠᠰᠢ</unicode>
          <transcript>-- marγasi</transcript>
          <definition> Soon, before long, any day.</definition>
        </example>
      </examples>
