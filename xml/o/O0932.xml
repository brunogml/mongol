    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠦᠯᠢᠺᠦ</unicode>
      <definition>comparer, mettre en comparaison. donner un exemple: 2 lever, soulever (avec un levier), 3 élever, ériger.</definition>
      <page>527</page>
      <examples>
        <example>
          <unicode>ᠦᠯᠢᠺᠦᠢ ᠤᠳᠬ᠎ᠠ</unicode>
          <definition>sens comparatif</definition>
        </example>
        <example>
          <unicode>ᠦᠯᠢᠺᠦᠢ ᠦᠭᠡ</unicode>
          <definition>expression comparative</definition>
        </example>
        <example>
          <unicode>ᠦᠯᠢᠵᠦ ᠦᠯᠦ ᠪᠣᠯᠬᠤ</unicode>
          <definition>sans comparaison, incomparablement, inimitable, superbe</definition>
        </example>
        <example>
          <unicode>ᠦᠯᠢᠵᠦ ᠪᠤᠳᠤᠬᠤ</unicode>
          <definition>évaluer qc. par comnparaison; 2 compter mentalement; 3 réfléchir, délibérer, méditer</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠯᠭᠠᠳ ᠢ ᠦᠯᠢᠺᠦ</unicode>
          <definition>bâtir une ville</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠭᠦᠨ ᠎ᠯᠦᠭᠡ ᠦᠯᠢᠺᠦ</unicode>
          <definition>comparer avec cela</definition>
        </example>
        <example>
          <unicode>ᠦᠯᠢᠭᠦᠨ ᠲᠠᠭᠠᠨ</unicode>
          <definition>jeter dans la balance, peser, évaluer, mettre une valeur, estimer; 2 penser, réfléchir, considérer, examiner: 3 conclure, venir à la conclusion, prononcer par analogie</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠮᠵᠢᠶᠡᠨ ᠢ ᠦᠯᠢᠺᠦ</unicode>
          <definition>mesure, arpenter, toiser; 2 démontrer, prouver, établir la vérité d'un fait, d'une proposition, etc.</definition>
        </example>
      </examples>
    </entry_item>
