    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠥᠪᠠᠷ</unicode>
      <uighur>öber</uighur>
      <definition>(ö) Self, myself, yourself, himself etc.</definition>
      <page>260</page>
      <examples>
        <example>
          <uighur>öber-e</uighur>
          <definition>(ö) Others, another, otherwise. Besides. Different</definition>
        </example>
        <example>
          <uighur>öber-e öber-e</uighur>
          <definition>Different from each other. Everyone for himself.</definition>
        </example>
        <example>
          <uighur>öberečilen</uighur>
          <definition>Each, every, everyone. Different, unlike.</definition>
        </example>
        <example>
          <uighur>öberečilekü</uighur>
          <definition>v.t. To do otherwise, to perform in another way. To act in one's own way. To look at with amezement, to gaze at.</definition>
        </example>
        <example>
          <uighur>öber-iyen</uighur>
          <definition>Self in accusative case.</definition>
        </example>
        <example>
          <uighur>öber-iyer</uighur>
          <definition>of its own. Spontaneously. Automatically</definition>
        </example>
        <example>
          <uighur>öber-ün</uighur>
          <definition>One's own, private, personal .</definition>
        </example>
        <example>
          <uighur>öber öber-ün</uighur>
          <definition>Each one individually.</definition>
        </example>
        <example>
          <uighur>öber ügei</uighur>
          <definition>No other</definition>
        </example>
        <example>
          <uighur>öber ǰaγur-a</uighur>
          <definition>Mutually. Between themselves,</definition>
        </example>
      </examples>
    </entry_item>
