      <dico>Lessing</dico>
      <unicode>ᠥᠪᠠᠷ</unicode>
      <uighur>öber</uighur>
      <cyrillic>өөр</cyrillic>
      <transcript>ØBER</transcript>
      <definition>n. and adj. Self, one's own</definition>
      <page>627</page>
      <examples>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠢᠶᠡᠨ</unicode>
          <transcript>-- ijen</transcript>
          <definition> By oneself; oneself (acc..); on one's own account.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠢᠶᠡᠨ ᠰᠤᠷᠤᠭᠰᠠᠨ</unicode>
          <transcript>-- ijen suruγsan</transcript>
          <definition> Self-taught, self-educated.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠢᠶᠡᠨ ᠰᠤᠷᠬᠤ ᠪᠢᠴᠢᠭ</unicode>
          <transcript>-- ijen surxubicig</transcript>
          <definition> Self-teaching manual.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠥᠪᠠᠷ᠎ᠡ</unicode>
          <transcript>-- øber-e</transcript>
          <definition> Each by himself, individually.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠎ᠲᠡᠭᠡᠨ</unicode>
          <transcript>-- tegen</transcript>
          <definition> See special entry.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ</unicode>
          <transcript>-- yn</transcript>
          <definition> One‘s own.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠪᠡᠶ᠎ᠡ</unicode>
          <transcript>-- yn bej-e</transcript>
          <definition>ben yzeky. To see, look at oneself ( as in a mirror).</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠪᠡᠶ᠎ᠡ ᠪᠡᠷ</unicode>
          <transcript>-- yn bej-e ber</transcript>
          <definition> Personally.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠪᠣᠯᠭᠠᠬᠤ</unicode>
          <transcript>-- yn bolγaxu</transcript>
          <definition> To make (something) one's own ; to appropriate.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠳᠤᠷ᠎ᠠ</unicode>
          <transcript>-- yn dur-a</transcript>
          <definition> Free will, one's own will; arbitrariness.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠳᠤᠷ᠎ᠠ ᠪᠡᠷ</unicode>
          <transcript>-- yn dur-a ber</transcript>
          <definition> According to one's own wishes, voluntarily.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠡᠷᠺᠡ</unicode>
          <transcript>-- yn erke</transcript>
          <definition> Independence, free will; personal rights.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠡᠷᠺᠡ ᠪᠡᠷ ᠪᠤᠰᠤ</unicode>
          <transcript>-- yn erke ber busu </transcript>
          <definition>Not of one's own free will</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠡᠷᠺᠡ ᠪᠡᠷ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>-- yn erke ber jabuxu</transcript>
          <definition> To be a free man, live as a free individual.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠡᠷᠺᠡ ᠎ᠲᠦ</unicode>
          <transcript>-- yn erke ty</transcript>
          <definition> Independent, free.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠺᠢ</unicode>
          <transcript>-- yn ki</transcript>
          <definition> One's own.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠺᠢᠭᠰᠡᠨ</unicode>
          <transcript>-- yn kigsen</transcript>
          <definition> Made or caused by oneself.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠺᠦᠮᠦᠨ</unicode>
          <transcript>-- yn kymyn</transcript>
          <definition> A person of [our] own family, kind, class, or group.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠨᠠᠮᠲᠠᠷ</unicode>
          <transcript>-- yn_ namtar</transcript>
          <definition> Autobiography.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠰᠢᠨᠵᠢᠯᠡᠯ</unicode>
          <transcript>-- yn sigymzilel</transcript>
          <definition> Self-criticism.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠤᠨ ᠦᠨ᠎ᠡ</unicode>
          <transcript>-- yn yn-e</transcript>
          <definition> Cost price.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠠᠷ ᠵᠠᠭᠤᠷ᠎ᠠ</unicode>
          <transcript>-- zaγur-a</transcript>
          <definition> Among themselves or ourselves.</definition>
        </example>
      </examples>
    </entry_item>
