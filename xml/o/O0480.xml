    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠥᠪᠠᠷ ~ ᠥᠪᠡᠷ᠎ᠡ</unicode>
      <transcript>ØBER (ØBER-E) </transcript>
      <definition>T. so so, translates the S. prefix prati- in a distributive or singularizing meaning; each taken individually, singly. See øber-e, below.   </definition>
      <page>1181</page>
      <examples>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠢᠶᠡᠨ ᠪᠤᠷᠬᠠᠨ = ᠪᠷᠠᠳᠢᠻᠠᠪᠤᠳ</unicode>
          <transcript>+++ -- ijen burxan ( = bradigabud); </transcript>
          <definition>T. rang sangs rgyas; S. pratyeka-buddha. A Buddha who has found enlightenment for himself but does not reveal it. </definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠢᠶᠡᠨ ᠭᠠᠷᠤᠭᠰᠠᠨ</unicode>
          <transcript>+++ -- ijen γaruγsan;</transcript>
          <definition> T. rang hbyung; S. svayambhū. 'Self-originated' (as the øber ijen burxan).</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠢᠶᠡᠨ ᠢᠯᠠᠭᠤᠭᠰᠠᠨ</unicode>
          <transcript>+++ -- ijen ilaγuγsan; </transcript>
          <definition>T. rang rgyal; S. praty-eka-buddha. Pratyekabuddha. See øber ijen burxan. +</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠢᠶᠡᠨ ᠨᠢᠷᠸᠠᠨ ᠢ ᠡᠭᠡᠷᠡᠭᠴᠢ</unicode>
          <transcript>++ -- ijen nirvan i egeregci; </transcript>
          <definition>T. rang zhi don gnyer. One who hopes to reach nirvana by himself (without a spiritual guide), a Pratyeka-buddha. </definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠤᠨ ᠴᠢᠨᠠᠷ</unicode>
          <transcript>+++ -- yn cinar; </transcript>
          <definition>T. rang gi mtshan nyid; S.svalakshana. Individual characteristic (contrasts with jery jin belge cinar; S. samanya-lakshana, general or universal characteristics.</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠤᠨ ᠺᠡᠷᠡᠭ</unicode>
          <transcript>+++ -- yn kereg; </transcript>
          <definition>T. rang don; S. svartha.One’s own aim or purpose or advantage (as opposed to the aim of others).</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠦᠪᠡᠷ</unicode>
      <definition>lui-même, propre: 2 vide entre la poitrine et la partie supérieure de l'habillement</definition>
      <page>502</page>
      <examples>
        <example>
          <unicode>ᠠᠭᠤᠯᠠ ᠎ᠶᠢᠨ ᠥᠪᠡᠷ</unicode>
          <definition>le côté de la montagne qui est exposé au midi</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠤᠨ</unicode>
          <definition>propre, qui appartient en propre</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠢᠶᠡᠨ</unicode>
          <definition>moi-même, lui-même, elle-même, soi-même, de soi-même</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠤᠨ ᠡᠷᠺᠡᠪᠡᠷ ᠪᠤᠰᠤ</unicode>
          <definition>qui n'a pas sa volonté, assujetti, subordonné, soumis</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠤᠨ ᠡᠷᠺᠡᠲᠦ</unicode>
          <definition>qui a le souverain pouvoir, qui a le plein pouvoir, plénipotentiaire</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠢᠶᠡᠨ ᠢᠯᠠᠭᠤᠭᠰᠠᠨ</unicode>
          <definition>celui qui atteint la perfection de lui-même: pratyekabouddha, richi, saint</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠥᠪᠡᠷ᠎ᠡ</unicode>
          <definition>chacun à part, chaque</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠥᠪᠡᠷ ᠤᠨ ᠵᠡᠷᠭᠡ ᠎ᠶᠢ ᠳᠠᠭᠠᠨ ᠲᠡᠭᠰᠢᠯᠡᠨ ᠰᠠᠭᠤᠪᠠ</unicode>
          <definition>chacun occupait une place d'après son rang</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠎ᠵᠦᠭᠡᠨ ᠦᠵᠡᠺᠦᠢ ᠳ᠋‍‍ᠤ‍ᠷ ᠲᠣᠯᠢ ᠭᠡᠷᠡᠭᠳᠡᠢ</unicode>
          <definition>pour se voir, il faut un miroir</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠢᠶᠡᠨ ᠨᠢᠷᠸᠠᠨ ᠢ ᠡᠭᠡᠷᠡᠭᠴᠢ</unicode>
          <definition>qui espÈre d'Atteindre le nirvâna: pratyekabuddha</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠢᠶᠡᠨ ᠭᠠᠷᠤᠭᠰᠠᠨ</unicode>
          <definition>né de soi-même, né spontanément, qui a la cause de son existence en lui-même: 2 Esrous (Brahma)</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠤᠨ ᠪᠡᠯᠭᠡ ᠴᠢᠨᠠᠷ ᠢᠶᠠᠷ ᠦᠭᠡᠢ</unicode>
          <definition>insignifiant ou nul dans son origine; faux</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠤᠨ ᠪᠤᠲᠠ</unicode>
          <definition>qualité naturelle, le naturel, nature, qualité</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠤᠨ ᠪᠤᠷᠬᠠᠨ</unicode>
          <definition>devenu bouddha de soi-même: pratyekabouddha</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠵᠠᠭᠤᠷ᠎ᠠ</unicode>
          <definition>entre soi, mutuellement</definition>
        </example>
      </examples>
