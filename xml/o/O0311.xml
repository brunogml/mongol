  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠥᠨᠳᠥᠶᠢᠺᠥ</unicode>
      <uighur>öndüyikü</uighur>
      <cyrillic>өндийх</cyrillic>
      <transcript>ØNDYI-</transcript>
      <definition>[= øndei-] v. i. To raise one's head; to raise oneself, rise slightly.</definition>
      <page>636</page>
      <examples>
        <example>
          <unicode>ᠥᠨᠳᠥᠶᠢᠨ ᠪᠣᠰᠬᠤ</unicode>
          <transcript>--n bosxu</transcript>
          <definition> To arise; to arise from oppression.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠷᠢᠶᠡᠨ ᠤ ᠳᠡᠭᠡᠭᠦᠷ ᠥᠨᠳᠥᠶᠢᠵᠦ ᠬᠠᠷᠠᠬᠤ</unicode>
          <transcript>kyrijen y degegyr --zy xaraxu</transcript>
          <definition> To look over the wall.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠭᠤᠳᠠᠯ ᠡᠴᠡ ᠪᠡᠨ ᠥᠨᠳᠥᠶᠢᠺᠦ</unicode>
          <transcript>saγudal ece ben --ky</transcript>
          <definition> To raise oneself slightly from one's seat.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠡ ᠺᠡᠪᠲᠡᠷᠢ ᠡᠴᠡ ᠪᠡᠨ ᠥᠨᠳᠥᠶᠢᠨ ᠪᠣᠰᠪᠠ</unicode>
          <transcript>tere kebteri ece ben --n bosba</transcript>
          <definition> He raised himself a little in his bed; he sat up in his bed.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠦᠨᠳᠡᠶᠢᠺᠦ ~ ᠦᠨᠳᠦᠶᠢᠺᠦ</unicode>
      <definition>lever, élever, soulever.</definition>
      <page>488</page>
    </entry_item>
    <entry_item>
      <dico>Schmidt</dico>
      <unicode>ᠥᠨᠳᠥᠶᠢᠺᠥ</unicode>
      <uighur>ündüyikü</uighur>
      <definition>sich heben, sich in die Höhe richten.</definition>
      <page>65</page>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠥᠨᠳᠥᠶᠢᠺᠥ</unicode>
      <uighur>öndüyikü</uighur>
      <definition>(o)v.i. To raise up oneself a little (from sitting).</definition>
      <page>256</page>
    </entry_item>
    <entry_item>
      <dico>Chinese</dico>
      <unicode>ᠥᠨᠳᠡᠢᠬᠦ</unicode>
      <cyrillic>өндийх</cyrillic>
      <definition>〔动〕稍微坐起，起身，抬头，挺起，翘起，踮起：цээжээ ~ 挺起胸；орон дээрээс ~ж чадахгүй ядуу 虚弱得不能从床上坐起来.</definition>
      <page>848</page>
    </entry_item>
