    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠨᠠᠮᠬᠠᠷᠠᠬᠣ</unicode>
      <uighur>namqaraqu</uighur>
      <cyrillic>намхрах</cyrillic>
      <transcript>NAMXARA-</transcript>
      <definition>v.i. To calm or quiet down ( as a storm), be appeased; to fall, sink, be lowered, be reduced (as water after floods)</definition>
      <page>564</page>
      <examples>
        <example>
          <unicode>ᠠᠭᠤᠷ ᠨᠠᠮᠬᠠᠷᠠᠪᠠ</unicode>
          <transcript>aγur --ba </transcript>
          <definition>The anger has abated</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠯ ᠨᠠᠮᠬᠠᠷᠠᠪᠠ</unicode>
          <transcript>γal --ba </transcript>
          <definition>The fire has subsided</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠯᠺᠢᠨ ᠨᠠᠮᠬᠠᠷᠠᠪᠠ</unicode>
          <transcript>salkin --ba</transcript>
          <definition> The wind has calmed down.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
