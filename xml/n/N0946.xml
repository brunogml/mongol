      <dico>Lessing</dico>
      <unicode>ᠨᠠᠪᠲᠠᠯᠺᠥ</unicode>
      <uighur>nebdelkü</uighur>
      <cyrillic>нэвтлэх</cyrillic>
      <transcript>NEBTEL-</transcript>
      <definition>v.t. and i. To break through, pierce, pass through, penetrate; to breach through, chisel through.</definition>
      <page>567</page>
      <examples>
        <example>
          <unicode>ᠨᠠᠪᠲᠠᠯᠵᠦ ᠴᠣᠭᠤᠯᠬᠤ</unicode>
          <transcript>--zy coγulxu </transcript>
          <definition>To pierce through</definition>
        </example>
        <example>
          <unicode>ᠨᠠᠪᠲᠠᠯᠺᠵᠦ ᠺᠡᠯᠡᠺᠦ</unicode>
          <transcript>--zy keleky</transcript>
          <definition> To explain thoroughly, fully.</definition>
        </example>
      </examples>
    </entry_item>
