    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠨᠥᠺᠴᠢᠺᠥ</unicode>
      <uighur>nökčikü</uighur>
      <cyrillic>нөхцөх</cyrillic>
      <transcript>NØGCI-</transcript>
      <definition>v.i. To pass by, pass on; to die.</definition>
      <page>592</page>
      <examples>
        <example>
          <unicode>ᠨᠥᠺᠴᠢᠭᠰᠡᠨ</unicode>
          <transcript>--gsen</transcript>
          <definition> Past, previous; the deceased, the late.</definition>
        </example>
        <example>
          <unicode>ᠨᠥᠺᠴᠢᠭᠰᠡᠨ ᠦᠢᠯᠡᠰ</unicode>
          <transcript>--gsen yiles</transcript>
          <definition> Previous actions.</definition>
        </example>
        <example>
          <unicode>ᠨᠠᠰᠤ ᠨᠥᠺᠴᠢᠺᠦ</unicode>
          <transcript>nasu --ky</transcript>
          <definition> To die.</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠲᠡ ᠨᠥᠺᠴᠢᠭᠰᠡᠨ ᠴᠠᠭ ᠎ᠲᠤᠷ</unicode>
          <transcript>erte --gsen cay tur</transcript>
          <definition> In ancient times, long ago.</definition>
        </example>
        <example>
          <unicode>ᠢᠯᠠᠵᠤ ᠲᠡᠭᠦᠰ ᠨᠥᠺᠴᠢᠭᠰᠡᠨ</unicode>
          <transcript>ilazu tegys --gsen</transcript>
          <definition> Victoriously perfected ( epithet of the Buddha or saintly person).</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
