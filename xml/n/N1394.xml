    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠨᠢᠭᠣᠷᠴᠢᠯᠠᠬᠣ</unicode>
      <uighur>niγurčilaqu</uighur>
      <definition>To simulate. To play the hypocrite. To pretend to. To be influenced by feelings in giving a decision. To show favour and connive at wrong. To put on a bold face.</definition>
      <page>348</page>
      <examples>
        <example>
          <uighur>niγurčilaqu ügei</uighur>
          <definition>Not to be influenced by feelings. Not to show favour and connive at wrong.</definition>
        </example>
      </examples>
