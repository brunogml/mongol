    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠨᠢᠵᠢᠺᠢᠨᠠᠺᠥ</unicode>
      <uighur>niǰikinekü</uighur>
      <cyrillic>нэжигнэх - нижигнэх</cyrillic>
      <transcript>NIZIGINE-</transcript>
      <definition>v.i. To thunder.</definition>
      <page>587</page>
      <examples>
        <example>
          <unicode>ᠨᠢᠵᠢᠺᠢᠨᠠᠲᠡᠯ᠎ᠡ</unicode>
          <transcript>--tel-e</transcript>
          <definition> Thunderously.</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠵᠢᠺᠢᠨᠠᠲᠡᠯ᠎ᠡ ᠠᠯᠠᠭ᠎ᠠ ᠲᠠᠰᠢᠬᠤ</unicode>
          <transcript>--tel e alarγ-a tasixu</transcript>
          <definition> To give thunderous applause.</definition>
        </example>
        <example>
          <unicode>ᠪᠤᠤ ᠨᠢᠵᠢᠺᠢᠨᠠᠮᠦᠢ</unicode>
          <transcript>buu --myi</transcript>
          <definition> The guns roar</definition>
        </example>
      </examples>
