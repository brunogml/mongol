    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠨᠣᠮᠣᠭᠠᠳᠬᠠᠬᠣ</unicode>
      <uighur>nomuγadqaqu</uighur>
      <cyrillic>номготгох - номхотгох</cyrillic>
      <transcript>NOMUΓADXA-</transcript>
      <definition>v.t. To appease, pacify; to subjugate, conquer; to convert; to tame (as animal).</definition>
      <page>591</page>
      <examples>
        <example>
          <unicode>ᠰᠡᠳᠺᠢᠯ ᠢᠶᠡᠨ ᠨᠣᠮᠣᠭᠠᠳᠬᠠᠬᠣ</unicode>
          <transcript>sedkil ijen --xu</transcript>
          <definition> To discipline oneself</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
