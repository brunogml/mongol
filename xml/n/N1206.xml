      <dico>Lessing</dico>
      <unicode>ᠨᠠᠶᠢᠯᠠᠯᠴᠠᠺᠥ</unicode>
      <uighur>neyilelčekü</uighur>
      <cyrillic>нийлэлцэх</cyrillic>
      <transcript>NEILELCE-</transcript>
      <definition>[v. coop. of neile-] v.i. To join, assemble, gather; to agree, be in harmony, fit, correspond, match.</definition>
      <page>571</page>
      <examples>
        <example>
          <unicode>ᠨᠠᠶᠢᠯᠠᠯᠴᠠᠺᠥ ᠦᠭᠡᠢ</unicode>
          <transcript>--ky ygei</transcript>
          <definition> Does not conform, agree; is not right or fitting</definition>
        </example>
        <example>
          <unicode>ᠠᠰᠢᠭ ᠲᠤᠰᠠ ᠎ᠳᠤ ᠨᠠᠶᠢᠯᠠᠯᠴᠠᠺᠥ</unicode>
          <transcript>asiγ tusa du --ky</transcript>
          <definition> To answer the interests of; to be in one's interests.</definition>
        </example>
        <example>
          <unicode>ᠰᠤᠷᠲᠠᠯ ᠎ᠯᠤᠭ᠎ᠠ ᠨᠠᠶᠢᠯᠠᠯᠴᠠᠺᠥ</unicode>
          <transcript>surtal luy-a --ky</transcript>
          <definition> To conform with the theory, habit, custom, doctrine.</definition>
        </example>
      </examples>
    </entry_item>
