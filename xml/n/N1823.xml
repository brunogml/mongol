    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠨᠢᠺᠥᠯᠲᠠᠢ</unicode>
      <uighur>nigüldei</uighur>
      <cyrillic>нүгэлтэй</cyrillic>
      <transcript>NIGYLTEI</transcript>
      <definition>adj. Sinful</definition>
      <page>583</page>
      <examples>
        <example>
          <unicode>ᠨᠢᠺᠥᠯᠲᠠᠢ. ᠪᠤᠷᠬᠠᠨ ᠤ ᠥᠭᠡᠳᠡ ᠺᠥᠯ ᠢᠶᠡᠨ ᠪᠢᠲᠢᠭᠡᠢ ᠵᠢᠭᠢ</unicode>
          <transcript>-- ! burxan u øgede xøl ijen bitegei zigi !.</transcript>
          <definition>It is a sin!. Don't point your feet toward Buddha's immage.</definition>
        </example>
        <example>
          <unicode>ᠨᠢᠺᠥᠯᠲᠠᠢ. ᠬᠠᠴᠠᠪᠴᠢ ᠳᠡᠭᠡᠷ᠎ᠡ ᠪᠢᠲᠡᠭᠡᠢ ᠰᠠᠭᠤ</unicode>
          <transcript>-- ! xacabci deger-e bitegei saγu!.</transcript>
          <definition>It is a sin!. Don't sit on the threshold!.</definition>
        </example>
      </examples>
    </entry_item>
