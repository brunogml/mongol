    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠨᠥᠺᠴᠢᠺᠠᠺᠥ</unicode>
      <uighur>nökčikekü</uighur>
      <cyrillic>нөхцөөх</cyrillic>
      <transcript>NØGCIGE-</transcript>
      <definition>[= nøgcije- ; v. caus. of nøgci-] To pass the time; to free, deliver from.</definition>
      <page>592</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠢᠲᠠᠨ ᠢ ᠭᠠᠰᠠᠯᠠᠩ ᠡᠴᠡ ᠨᠥᠺᠴᠢᠺᠠᠺᠥ</unicode>
          <transcript>amitan i γasalang ece --ky</transcript>
          <definition> To deliver or save living beings from suffering.</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠭ ᠨᠥᠺᠴᠢᠺᠠᠺᠥ</unicode>
          <transcript>caγ --ky</transcript>
          <definition> To pass time futilely.</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠯᠠᠲᠤ ᠺᠦᠮᠦᠨ ᠢ ᠨᠥᠺᠴᠢᠺᠠᠺᠥ</unicode>
          <transcript>jalatu kymyn i --ky</transcript>
          <definition> To put to death, execute a criminal.</definition>
        </example>
      </examples>
    </entry_item>
