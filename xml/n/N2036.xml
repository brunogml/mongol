    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠨᠤᠭᠤᠳ ~ ᠨᠦᠭᠦᠳ</unicode>
      <uighur>nuγud - nügüd</uighur>
      <transcript>NUΓUD, NYGYD</transcript>
      <definition>Plural suffix used following nouns which end in vowels or the consonant n</definition>
      <page>594</page>
      <examples>
        <example>
          <unicode>ᠠᠯᠲᠠᠢ ᠬᠠᠩᠭᠠᠢ ᠠᠭᠤᠯᠠ ᠨᠤᠭᠤᠳ</unicode>
          <transcript>altai xangγai aγula nuγud</transcript>
          <definition> The Altai and Khangai mountains</definition>
        </example>
        <example>
          <unicode>ᠠᠮᠢᠲᠠᠨ ᠨᠤᠭᠤᠳ</unicode>
          <transcript>amitan nuγud</transcript>
          <definition> Living creatures</definition>
        </example>
        <example>
          <unicode>ᠡᠷᠳᠡᠮᠲᠡᠨ ᠨᠦᠭᠦᠳ</unicode>
          <transcript>erdemten nygyd</transcript>
          <definition> Scholars.</definition>
        </example>
      </examples>
