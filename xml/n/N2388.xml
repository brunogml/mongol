      <dico>Lessing</dico>
      <unicode>ᠨᠣᠴᠣᠬᠣ</unicode>
      <uighur>nočuqu</uighur>
      <cyrillic>ноцох</cyrillic>
      <transcript>NOCU-</transcript>
      <definition>a) v.t. To seize, grasp, clutch; to attack, pounce on b) v.i. To catch fire, begin to burn, ignite light</definition>
      <page>587</page>
      <examples>
        <example>
          <unicode>ᠨᠣᠴᠣᠵᠤ ᠪᠠᠷᠢᠬᠤ</unicode>
          <transcript>--zu barixu</transcript>
          <definition> To seize, grab (somebody).</definition>
        </example>
        <example>
          <unicode>ᠰᠡᠭᠦᠯ ᠡᠴᠡ ᠨᠣᠴᠣᠬᠤ</unicode>
          <transcript>segyl ece –xu </transcript>
          <definition>To seize by the tail</definition>
        </example>
        <example>
          <unicode>ᠭᠠᠯ ᠨᠣᠴᠣᠬᠤ</unicode>
          <transcript>γal --xu </transcript>
          <definition>To catch fire</definition>
        </example>
        <example>
          <unicode>ᠮᠠᠰᠢᠨ᠎ᠠ ᠲᠡᠷᠭᠡ ᠨᠣᠴᠣᠬᠤ ᠦᠭᠡᠢ ᠪᠠᠶᠢᠨ᠎ᠠ</unicode>
          <transcript>masin-a terge --xu ygei bain-a</transcript>
          <definition> The automobile [engine] does not start.</definition>
        </example>
      </examples>
