    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠨᠠᠮᠥᠷᠺᠥ</unicode>
      <uighur>nemürkü</uighur>
      <cyrillic>нөмрөх</cyrillic>
      <transcript>NEMYR-</transcript>
      <definition>[=nømyr-] v. t. To throw or wear a garment over one's shoulder; to protect or cover (as against the weather).</definition>
      <page>574</page>
      <examples>
        <example>
          <unicode>ᠺᠥᠨᠵᠢᠯ ᠢᠶᠡᠨ ᠨᠠᠮᠥᠷᠺᠥ</unicode>
          <transcript>kønzil ijen --ky</transcript>
          <definition> To throw one's blanket over one's back.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠨᠡᠮᠦᠷᠺᠦ ~ ᠨᠦᠮᠦᠷᠺᠦ</unicode>
      <definition>jeter sur soi (un vêtement). endosser, revêtir, mettre,</definition>
      <page>637</page>
      <examples>
