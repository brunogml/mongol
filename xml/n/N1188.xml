    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠨᠡᠶᠢ᠍ᠳᠬᠡᠭᠥ</unicode>
      <uighur>neyidkekü</uighur>
      <cyrillic>нийтгэх</cyrillic>
      <transcript>NEIDKE-</transcript>
      <definition>v.t. To unite, join, connect; to spin or twist (as thread)</definition>
      <page>570</page>
      <examples>
        <example>
          <unicode>ᠳᠡᠭᠡᠰᠦ ᠨᠡᠶᠢ᠍ᠳᠬᠡᠭᠥ</unicode>
          <transcript>degesy(n) --</transcript>
          <definition> To twist or splice a rope.</definition>
        </example>
        <example>
          <unicode>ᠤᠲᠠᠰᠤ ᠨᠡᠶᠢ᠍ᠳᠬᠡᠭᠥ</unicode>
          <transcript>utasu --ky</transcript>
          <definition> To twist several strands into a thread, splice.</definition>
        </example>
      </examples>
    </entry_item>
