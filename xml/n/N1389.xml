        </example>
        <example>
          <unicode>ᠨᠢᠭᠣᠷ ᠴᠢᠷᠠᠢ</unicode>
          <transcript>-- cirai</transcript>
          <definition> Face, physiognomy.</definition>
        </example>
        <example>
