    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠨᠢᠭᠣᠷ</unicode>
      <uighur>niγur debčikü</uighur>
      <definition>To put on a bold face. Brazen-faced.</definition>
      <page>346</page>
      <examples>
        <example>
          <uighur>niγur deger-e</uighur>
          <definition>In the presence of. Face to face.</definition>
        </example>
        <example>
          <uighur>niγur ǰilmayin</uighur>
          <definition>adj. Thick-skinned.</definition>
        </example>
        <example>
          <uighur>niγur ǰoǰaγan</uighur>
          <definition>adj. Impudent, shameless. "Thick-faced"</definition>
        </example>
        <example>
          <uighur>niγur ǰübčikü</uighur>
          <definition>To be shameless. To put ones honour in danger or gamble with same (thru undue demands etc.).</definition>
        </example>
        <example>
          <uighur>niγur ǰülčilǰekü</uighur>
          <definition>To turn away the face because of shame. To be embarrassed or bewildered. Not willing or able to look in anothers face because of illwill or hatred.</definition>
        </example>
