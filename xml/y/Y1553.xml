    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠠᠶᠠᠭᠠᠬᠣ</unicode>
      <uighur>ǰayaγaqu</uighur>
      <cyrillic>заяах</cyrillic>
      <transcript>ZAJAΓA-</transcript>
      <definition>v. t. To grant, bless, ordain (by God or heaven); to predestine.</definition>
      <page>1028</page>
      <examples>
        <example>
          <unicode>ᠨᠢᠭᠤᠨ ᠢ ᠵᠠᠶᠠᠭᠠᠬᠣ</unicode>
          <transcript>niγun i --xu</transcript>
          <definition>To bless with a son.</definition>
        </example>
        <example>
          <unicode>ᠲᠩᠷᠢ ᠡᠴᠡ ᠵᠠᠶᠠᠭᠠᠭᠰᠠᠨ</unicode>
          <transcript>tngri ece --γsan</transcript>
          <definition>Heaven-sent, ordained by heaven.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠵᠠᠶᠠᠭᠠᠬᠤ</unicode>
      <definition>1 accorder, envoyer (de Dieu); donner, prédestiner: 
2 créer.</definition>
      <page>2296</page>
      <examples>
        <example>
          <unicode>ᠳᠣᠯᠤᠭᠠᠨ ᠨᠢᠭᠤᠨ ᠭᠠᠭᠴᠠ ᠥᠺᠢᠨ ᠢ ᠵᠠᠶᠠᠭᠠᠬᠤ</unicode>
          <definition>accorde nous sept fils et une fille!</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠶᠠᠭᠠᠭᠰᠠᠨ ᠤ ᠡᠴᠦᠰ ᠮᠠᠭᠠᠳ ᠡᠪᠳᠡᠷᠡᠮᠦᠢ ᠢ ᠡ</unicode>
          <definition>la fin de la création de toutes choses, c'Est la destruction; tout ce qui est créé doit être détruit</definition>
        </example>
      </examples>
    </entry_item>
