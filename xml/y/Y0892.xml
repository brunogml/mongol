    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠠᠰᠠᠳᠠᠬ</unicode>
      <uighur>ǰasadaq</uighur>
      <cyrillic>засдаг</cyrillic>
      <transcript>ZASADAΓ</transcript>
      <definition>adj. Not natural or genuine; artificial, hypocritical, false; heretical.</definition>
      <page>1039</page>
      <examples>
        <example>
          <unicode>ᠵᠠᠰᠠᠳᠠᠬ ᠶᠠᠪᠤᠳᠠᠯ</unicode>
          <transcript>-- jabudal</transcript>
          <definition>False conduct, hypocrisy.</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠰᠠᠳᠠᠬ ᠨᠣᠮᠲᠤ</unicode>
          <transcript>-- nomtu</transcript>
          <definition>Follower of a false doctrine.</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠰᠠᠳᠠᠬ ᠦᠭᠡ</unicode>
          <transcript>-- yge</transcript>
          <definition>Hypocritical speech, false, insincere words, servile words.</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠰᠠᠳᠠᠬ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition>Veracious, honest, candid.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
