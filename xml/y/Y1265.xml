  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠠᠯᠭᠠᠮᠵᠢᠯᠠᠬᠣ</unicode>
      <uighur>ǰalγamǰilaqu</uighur>
      <cyrillic>залгамжлах</cyrillic>
      <transcript>ZALΓAMZILA-</transcript>
      <definition>v.t. To continue, succeed, inherit.</definition>
      <page>1031</page>
      <examples>
        <example>
          <unicode>ᠵᠠᠯᠭᠠᠮᠵᠢᠯᠠᠭᠰᠠᠨ</unicode>
          <transcript>--γsan</transcript>
          <definition>Hereditary, inherited.</definition>
        </example>
        <example>
          <unicode>ᠰᠠᠭᠤᠷᠢᠨ ᠢ ᠵᠠᠯᠭᠠᠮᠵᠢᠯᠠᠭᠴᠢ</unicode>
          <transcript>saγurin i --γci</transcript>
          <definition>Heir or successor to the throne.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠭᠠᠨ ᠰᠠᠭᠤᠷᠢᠨ ᠢ ᠵᠠᠯᠭᠠᠮᠵᠢᠯᠠᠬᠣ</unicode>
          <transcript>xaγan saγurin i --xu</transcript>
          <definition>To inherit the throne of a Khan.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠶᠢᠴᠢ ᠎ᠶᠢ ᠵᠠᠯᠭᠠᠮᠵᠢᠯᠠᠬᠣ</unicode>
          <transcript>xoici ji --xu</transcript>
          <definition>To inherit, succeed.</definition>
        </example>
        <example>
          <unicode>ᠦᠶ᠎ᠡ ᠵᠠᠯᠭᠠᠮᠵᠢᠯᠠᠬᠣ</unicode>
          <transcript>yj-e --xu</transcript>
          <definition>To succeed, inherit.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠵᠠᠯᠭᠠᠮᠵᠢᠯᠠᠬᠤ</unicode>
      <definition>1 suivre l'un après l'autre: 
2 succéder (à ses ancêtres dans la charge dont ils étaient revêtue), prendre la place de (son père dans les emplois): 
3 continuer, poursuivre.</definition>
      <page>2288</page>
      <examples>
        <example>
          <unicode>ᠨᠣᠮ ᠢ ᠵᠠᠯᠭᠠᠮᠵᠢᠯᠠᠭᠴᠢ ᠱᠠᠪᠢ</unicode>
          <definition>disciple qui continue d'enseigner la doctrine (de son maître)</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Schmidt</dico>
      <unicode>ᠵᠠᠯᠭᠠᠮᠵᠢᠯᠠᠬᠣ</unicode>
      <uighur>ǰalγamǰilaqu</uighur>
      <definition>auf einander folgen. nachfolgen (in Amt und Würden); anreihen,</definition>
      <page>297</page>
    </entry_item>
    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠵᠠᠯᠭᠠᠮᠵᠢᠯᠠᠬᠣ</unicode>
      <uighur>ǰalγamǰilaqu</uighur>
      <definition>To follow. To follow one after another. To succeed (in office or rank).</definition>
      <page>1193</page>
    </entry_item>
    <entry_item>
      <dico>Chinese</dico>
      <unicode>ᠵᠠᠯᠭᠠᠮᠵᠢᠯᠠᠬᠤ</unicode>
      <cyrillic>залгамжлах</cyrillic>
      <definition>〔动〕①继续，接续，连接：үе ~ 传代；②承袭，继承，袭爵，接班：хойчийг ~ 接班，继承未来；залгамжилсан хаад 世袭君主.</definition>
      <page>536</page>
    </entry_item>
    <entry_item>
      <dico>lamrd</dico>
      <unicode>ᠵᠠᠯᠭᠠᠮᠵᠢᠯᠠᠬᠣ</unicode>
      <cyrillic>ЗАЛГАМЖЛАХ</cyrillic>
      <definition>1. продолжать; преемствовать, наследовать; улирч залгамжлах наследовать, преемствовать; үе залгамжлах бичиг родословная; үе залгамжлах түшмэл наследственный чиновник; үе залгамжлах эрх тушаал наследственные должности; хаан ширээ залгамжлах наследовать престол; хойчийг залгамжлах наследовать, быть преемником, сменой; хутагт хувилгаадыг залгамжлах ёс обычай продолжать дальнейшие перерождения хутукт и хубилганов (о высших духовных лицах); хэргэм зэрэг залгамжлах наследовать титул; 2. залгамжлахуй-г үз.</definition>
      <page>0</page>
    </entry_item>
    <entry_item>
      <dico>lamrd</dico>
      <unicode>ᠵᠠᠯᠭᠠᠮᠵᠢᠯᠠᠬᠣ</unicode>
      <cyrillic>ЗАЛГАМЖЛАХУЙ</cyrillic>
      <definition>продолжение; преемственность, наследование.</definition>
      <page>0</page>
    </entry_item>
    <entry_item>
      <dico>lamrd</dico>
      <unicode>ᠵᠠᠯᠭᠠᠮᠵᠢᠯᠠᠬᠣ</unicode>
      <cyrillic>ЗАЛГАМЖЛАН</cyrillic>
      <definition>залгамжлах-ын хамж., 1) преемственно, наследственно; өв залгамжлан авах получить по наследству; залгамжлан суух наследовать престол, занимать престол по наследству; 2) последовательно, беспрерывно; ажил залгамжлан гүйцэтгэх последовательно выполнять работу; залгамжлан халах сменять, быть сменой кому-л.</definition>
      <page>0</page>
    </entry_item>
