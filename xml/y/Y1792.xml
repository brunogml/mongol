    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠠᠷᠢᠮᠯᠠᠬᠣ</unicode>
      <uighur>ǰarimlaqu</uighur>
      <cyrillic>заримлах</cyrillic>
      <transcript>ZARIMLA-</transcript>
      <definition>v. t. To do something halfway or in part; to give a part.</definition>
      <page>1038</page>
      <examples>
        <example>
          <unicode>ᠵᠠᠷᠢᠮᠯᠠᠨ ᠥᠭᠺᠦ</unicode>
          <transcript>--n øgky</transcript>
          <definition>To give or entrust a part of something.</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠷᠢᠮᠯᠠᠵᠤ ᠢᠷᠡᠭᠳᠡᠺᠦᠢ</unicode>
          <transcript>--zu iregdekyi</transcript>
          <definition>Let some come!.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠭᠠᠨ ᠤ ᠲᠥᠷᠦ ᠎ᠶᠢ ᠵᠠᠷᠢᠮᠯᠠᠨ ᠥᠭᠺᠦ</unicode>
          <transcript>xaγan u tøry ji --n øgky</transcript>
          <definition>To entrust part of the rule to.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
