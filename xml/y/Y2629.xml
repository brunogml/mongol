    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠢᠭᠣᠷᠠᠬᠣ</unicode>
      <uighur>ǰiγuraqu</uighur>
      <cyrillic>зуурах</cyrillic>
      <transcript>ZIΓURA-</transcript>
      <definition>[= zuγura-] v.t. To knead, mix.</definition>
      <page>1051</page>
      <examples>
        <example>
          <unicode>ᠪᠡᠺᠡ ᠵᠢᠭᠣᠷᠠᠬᠣ</unicode>
          <transcript>beke --xu</transcript>
          <definition>To prepare ink on an ink-slab.</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠺᠡ ᠵᠢᠭᠣᠷᠠᠬᠣ ᠴᠢᠯᠠᠭᠤ</unicode>
          <transcript>beke --xu cilaγu</transcript>
          <definition>Ink-slab.</definition>
        </example>
        <example>
          <unicode>ᠡᠮ ᠵᠢᠭᠣᠷᠠᠬᠣ</unicode>
          <transcript>em --xu</transcript>
          <definition>To mix medicine.</definition>
        </example>
        <example>
          <unicode>ᠭᠤᠯᠢᠷ ᠵᠢᠭᠣᠷᠠᠬᠣ</unicode>
          <transcript>γulir --xu</transcript>
          <definition>To knead dough.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
