      <dico>Lessing</dico>
      <unicode>ᠵᠣᠵᠠᠭᠠᠨ</unicode>
      <uighur>ǰuǰaγan</uighur>
      <cyrillic>зузаан</cyrillic>
      <transcript>ZUZAΓAN</transcript>
      <definition>adj. and n. Thick, dense; strong, massive, powerful; thickness.</definition>
      <page>1081</page>
      <examples>
        <example>
          <unicode>ᠵᠣᠵᠠᠭᠠᠨ ᠠᠷᠢᠰᠤᠲᠠᠢ</unicode>
          <transcript>-- arisutai</transcript>
          <definition>Thick-skimmed, thick-hided, pachydermous.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠵᠠᠭᠠᠨ ᠪᠣᠯᠭᠠᠬᠤ</unicode>
          <transcript>-- bolγaxu</transcript>
          <definition>To make thick; to reinforce.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠵᠠᠭᠠᠨ ᠴᠠᠢ</unicode>
          <transcript>-- cai</transcript>
          <definition>Green brick tea.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠵᠠᠭᠠᠨ ᠡᠭᠦᠯᠡ</unicode>
          <transcript>-- egyle</transcript>
          <definition>Thick clouds.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠵᠠᠭᠠᠨ ᠡᠮᠦᠰᠺᠦ</unicode>
          <transcript>-- emysky</transcript>
          <definition>To put on thick clothing.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠵᠠᠭᠠᠨ ᠢᠨᠤ ᠲᠠᠪᠤᠨ ᠰᠠᠨᠲᠢᠮᠡᢐᠡᠷ</unicode>
          <transcript>-- inu tabun santimeter</transcript>
          <definition>It is 5 centimeters thick.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠵᠠᠭᠠᠨ ᠺᠡᠰᠢᠭ</unicode>
          <transcript>-- kesig</transcript>
          <definition>Great favors, generosity.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠵᠠᠭᠠᠨ ᠣᠢ</unicode>
          <transcript>-- oi</transcript>
          <definition>Dense wood, thick forest.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠵᠠᠭᠠᠨ ᠤ ᠺᠡᠮᠵᠢᠶ᠎ᠡ</unicode>
          <transcript>-- u kemzij-e</transcript>
          <definition>Thickness.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠵᠠᠭᠠᠨ ᠬᠣᠯᠪᠤᠭ᠎ᠠ</unicode>
          <transcript>-- xolbuγ-a</transcript>
          <definition>Strong ties.</definition>
        </example>
      </examples>
