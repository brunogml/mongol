      <dico>Lessing</dico>
      <unicode>ᠵᠠᠯᠠᠷᠠᠭᠣᠯᠬᠣ</unicode>
      <uighur>ǰalaraγulqu</uighur>
      <cyrillic>залруулах</cyrillic>
      <transcript>ZALARAΓUL-</transcript>
      <definition>v. caus. of zalara-, 1 and 2.</definition>
      <page>1030</page>
      <examples>
        <example>
          <unicode>ᠵᠠᠯᠠᠷᠠᠭᠣᠯᠤᠨ ᠵᠠᠰᠠᠬᠤ</unicode>
          <transcript>--un zasaxu</transcript>
          <definition>To correct.</definition>
        </example>
        <example>
          <unicode>ᠠᠯᠠᠯ ᠢᠶᠠᠨ ᠵᠠᠯᠠᠷᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>aldal ijen --xu</transcript>
          <definition>To correct one's mistakes.</definition>
        </example>
        <example>
          <unicode>ᠲᠠᠰᠢᠶᠠᠷᠠᠨ ᠺᠡᠪᠯᠡᠭᠳᠡᠭᠰᠡᠨ ᠢ ᠵᠠᠯᠠᠷᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>tasijaran keblegdegsen i --xu</transcript>
          <definition>To correct misprints.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠵᠠᠯᠠᠷᠠᠭᠤᠯᠬᠤ</unicode>
      <definition>1 redresser qc. (p. e. une flèche) 
2 corriger, redresser qn., le faire rentrer dans son devoir: 
3 ordonner de faire une entrée solennelle.</definition>
      <page>2282</page>
      <examples>
        <example>
          <unicode>ᠨᠠᠩᠭᠢᠠᠳ ᠣᠷᠣᠨ ᠠ ᠵᠠᠯᠠᠷᠠᠭᠤᠯᠬᠤ</unicode>
          <definition>ordonner de partir pour Nanggyat (la Chine)</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠯᠠᠷᠠᠭᠤᠯᠤᠨ ᠵᠠᠰᠠᠬᠤ</unicode>
          <definition>corriger (la traduction, la composition)</definition>
        </example>
      </examples>
    </entry_item>
