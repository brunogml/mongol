        <example>
          <unicode>ᠵᠥᠩ ᠪᠡᠯᠡᠭᠲᠦ</unicode>
          <transcript>-- belegty</transcript>
          <definition>Prophet, diviner; sage.</definition>
        </example>
        <example>
          <unicode>ᠵᠥᠩ ᠪᠢᠯᠢᠭ</unicode>
          <transcript>-- bilig</transcript>
          <definition>Prescience, gift of prophecy; knowledge, wisdom; instinct.</definition>
        </example>
        <example>
          <unicode>ᠵᠥᠩ ᠪᠢᠯᠢᠭ ᠤᠨ ᠨᠡᠭᠡᠭᠳᠡᠯ</unicode>
          <transcript>-- bilig yn negegdel</transcript>
          <definition>Apocalypse, revelation.</definition>
        </example>
        <example>
          <unicode>ᠵᠥᠩ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
