    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠥᠩ</unicode>
      <uighur>ǰöng</uighur>
      <cyrillic>зөн</cyrillic>
      <transcript>ZØNG</transcript>
      <definition>3 n. Will, arbitrariness; spontaneity.</definition>
      <page>1075</page>
      <examples>
        <example>
          <unicode>ᠵᠥᠩ ᠎ᠳᠡᠭᠡᠨ</unicode>
          <transcript>-- degen</transcript>
          <definition>Naturally, in its own way, by itself; arbitrarily, according to one's own wish or will; as much or little as one wishes.</definition>
        </example>
        <example>
          <unicode>ᠵᠥᠩ ᠎ᠳᠡᠭᠡᠨ ᠶᠠᠪᠤᠳᠠᠭ ᠺᠦᠮᠦᠨ</unicode>
          <transcript>-- degen jabudaγ kymyn</transcript>
          <definition>A person who minds his own business or keeps to himself.</definition>
        </example>
        <example>
          <unicode>ᠵᠥᠩ ᠎ᠳᠡᠭᠡᠨ ᠺᠥᠳᠡᠯᠺᠦ</unicode>
          <transcript>-- degen kødelky</transcript>
          <definition>To move arbitrarily, spontaneously, or automatically.</definition>
        </example>
        <example>
          <unicode>ᠵᠥᠩ ᠎ᠳᠦ ᠢᠨᠤ</unicode>
          <transcript>-- dy inu</transcript>
          <definition>Spontaneously; immoderately, much.</definition>
        </example>
        <example>
          <unicode>ᠵᠥᠩ ᠎ᠳᠤ ᠢᠨᠤ ᠣᠷᠺᠢᠬᠤ</unicode>
          <transcript>-- du inu orkixu</transcript>
          <definition>To let things take their natural course.</definition>
        </example>
        <example>
          <unicode>ᠵᠥᠩ ᠢᠶᠡᠷ</unicode>
          <transcript>-- ijer</transcript>
          <definition>By itself, spontaneously, involuntarily, automatically.</definition>
        </example>
        <example>
          <unicode>ᠵᠥᠩ ᠢᠶᠡᠷ ᠪᠠᠶᠢᠯᠭᠠᠬᠤ</unicode>
          <transcript>-- ijer bailγaxu</transcript>
          <definition>To leave somebody or something alone</definition>
        </example>
        <example>
          <unicode>ᠵᠥᠩ ᠢᠶᠡᠷ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <transcript>-- ijer talbixu</transcript>
          <definition>To leave somebody or something alone.</definition>
        </example>
      </examples>
    </entry_item>
