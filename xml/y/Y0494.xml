    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠶᠠᠭᠠᠷᠠᠬᠣ</unicode>
      <uighur>yaγaraqu</uighur>
      <cyrillic>яарах</cyrillic>
      <transcript>JAΓARA-</transcript>
      <definition>1 v.i. To hurry, hasten, rush, speed; to be busy.</definition>
      <page>423</page>
      <examples>
        <example>
          <unicode>ᠶᠠᠭᠠᠷᠠᠨ ᠰᠠᠨᠳᠤᠷᠤᠨ</unicode>
          <transcript>--n sandurun</transcript>
          <definition>In haste, hastily; in a panic.</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠭᠠᠷᠠᠬᠤ ᠳᠠᠭᠠᠨ</unicode>
          <transcript>--xu daγan</transcript>
          <definition>Hurriedly, in a hurry.</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠭᠠᠷᠠᠵᠤ ᠮᠡᠭᠳᠡᠵᠦ</unicode>
          <transcript>--zu megdezy,</transcript>
          <definition>In a hurry, in haste</definition>
        </example>
        <example>
          <unicode>ᠪᠢᠲᠡᠭᠡᠢ ᠶᠠᠭᠠᠷᠠ</unicode>
          <transcript>bitegei - - !</transcript>
          <definition>Do not hurry!.</definition>
        </example>
      </examples>
    </entry_item>
