    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠡᠷᠺᠡᠴᠡᠺᠥᠯᠺᠥ</unicode>
      <uighur>ǰerkečegülkü</uighur>
      <cyrillic>зэрэгцүүлэх</cyrillic>
      <transcript>ZERGECEGYL-</transcript>
      <definition>[v. caus. of zergece-] v.t. To place side by side, alongside; to juxtapose, line up, to compare; to make equal.</definition>
      <page>1046</page>
      <examples>
        <example>
          <unicode>ᠵᠡᠷᠺᠡᠴᠡᠺᠥᠯᠦᠨ ᠲᠠᠯᠪᠢᠬᠤ</unicode>
          <transcript>--yn talbixu </transcript>
          <definition> To put next to, place side by side.</definition>
        </example>
        <example>
          <unicode>ᠵᠡᠷᠺᠡᠴᠡᠺᠥᠯᠦᠨ ᠦᠵᠡᠺᠦ</unicode>
          <transcript>--yn yzeky</transcript>
          <definition> To compare with.</definition>
        </example>
      </examples>
    </entry_item>
