    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠢᠳᠭᠦᠺᠦ</unicode>
      <uighur>ǰidgükü</uighur>
      <cyrillic>зүтгэх</cyrillic>
      <transcript>ZIDKY-</transcript>
      <definition>v.t. and i. To pull; to endeavor, strive, exert oneself; to render a service</definition>
      <page>1049</page>
      <examples>
        <example>
          <unicode>ᠵᠢᠳᠭᠦᠺᠦ ᠮᠠᠯ</unicode>
          <transcript>--ky mal</transcript>
          <definition>Draught animal</definition>
        </example>
        <example>
          <unicode>ᠵᠢᠳᠭᠦᠨ ᠴᠢᠷᠮᠠᠶᠢᠬᠤ</unicode>
          <transcript>--n cirmaixu</transcript>
          <definition>To exert oneself, make an effort.</definition>
        </example>
        <example>
          <unicode>ᠵᠢᠳᠭᠦᠨ ᠰᠡᠳᠺᠢᠺᠦ</unicode>
          <transcript>--n sedkiky</transcript>
          <definition>To make an effort, try to.</definition>
        </example>
        <example>
          <unicode>ᠢᠳᠡᠪᠺᠢᠲᠡᠢ ᠪᠡᠷ ᠵᠢᠳᠭᠦᠺᠦ</unicode>
          <transcript>idebkitei ber --ky</transcript>
          <definition>To strive energetically.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠴᠦᠨ ᠵᠢᠳᠭᠦᠺᠦ</unicode>
          <transcript>kycyn –ky</transcript>
          <definition>To give one’s strength; to exert one’s strength or effort</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠭᠡ ᠵᠢᠳᠭᠦᠺᠦ</unicode>
          <transcript>terge –ky</transcript>
          <definition>To pull a cart</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
