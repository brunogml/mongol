    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠢᠺᠢᠢᠺᠥ</unicode>
      <uighur>ǰikiikü</uighur>
      <cyrillic>жийх</cyrillic>
      <transcript>ZIGII-</transcript>
      <definition>[= zigei-, zigi-] v.t. To stretch, extend, prolong; to be stubborn or persistent.</definition>
      <page>1052</page>
      <examples>
        <example>
          <unicode>ᠪᠠᠷᠠᠭᠤᠨ ᠭᠠᠷ ᠢᠶᠠᠷ ᠵᠢᠺᠢᠢᠺᠥ</unicode>
          <transcript>baraγun [γar] ijen --ky</transcript>
          <definition>To extend the right hand</definition>
        </example>
        <example>
          <unicode>ᠺᠥᠯ ᠢᠶᠡᠨ ᠵᠢᠺᠢᠢᠺᠥ</unicode>
          <transcript>køl ijen --</transcript>
          <definition>To stretch one's legs.</definition>
        </example>
      </examples>
    </entry_item>
