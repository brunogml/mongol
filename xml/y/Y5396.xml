    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠥᠺᠡᠺᠥ</unicode>
      <uighur>ǰökekü</uighur>
      <cyrillic>зөөх</cyrillic>
      <transcript>ZØGE-</transcript>
      <definition>[=zøgege-] v. t. To move something from one place to another, transport; to gather, collect; to acquire, possess (hist. ).</definition>
      <page>1074</page>
      <examples>
        <example>
          <unicode>ᠵᠥᠺᠡᠵᠦ ᠪᠠᠭᠤᠬᠤ</unicode>
          <transcript>--zy baγuxu</transcript>
          <definition>To move to a nearby place.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠷᠠᠭ᠎ᠠ ᠵᠥᠺᠡᠺᠥ</unicode>
          <transcript>baraγ -a --ky</transcript>
          <definition>To transport, transfer, or ship merchandise</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠯᠡ ᠵᠥᠺᠡᠺᠥ</unicode>
          <transcript>kele --ky</transcript>
          <definition>To pass on words, information.</definition>
        </example>
        <example>
          <unicode>ᠤᠰᠤ ᠵᠥᠺᠡᠭᠴᠢ</unicode>
          <transcript>usu --gci</transcript>
          <definition>Water carrier.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠵᠦᠺᠡᠺᠦ</unicode>
      <definition>1 transporter , transférer qc. d'un lieu en un autre: &#13;
2 faire des imprécations contre qu., lui souhaiter du mal.</definition>
      <page>2423</page>
      <examples>
        <example>
          <unicode>ᠡᠳ ᠠᠭᠤᠷᠠᠰᠤᠨ ᠢ ᠲᠡᠷᠭᠡᠨ ᠢᠶᠡᠷ ᠵᠥᠭᠡᠺᠦ</unicode>
          <definition>transporter les effets sur un chariot</definition>
        </example>
        <example>
          <unicode>ᠤᠰᠤᠨ ᠵᠥᠭᠡᠭᠴᠢ</unicode>
          <definition>un porteur d'eau</definition>
        </example>
        <example>
          <unicode>ᠦᠷᠡᠰ ᠤᠨ ᠵᠥᠭᠡᠭᠰᠡᠨ ᠠᠯᠪᠠᠲᠤ ᠤᠯᠤᠰ</unicode>
          <definition>les sujets comme l'héritage de tes descendants</definition>
        </example>
        <example>
          <unicode>ᠨᠡᠭᠦᠷᠡᠰᠦ ᠵᠥᠭᠡᠺᠦ</unicode>
          <definition>transporter la houille</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠯᠠᠭᠤᠨ ᠰᠢᠪᠠᠷ ᠢ ᠵᠥᠭᠡᠺᠦ</unicode>
          <definition>porter les pierres et la terre glaise</definition>
        </example>
        <example>
          <unicode>ᠵᠥᠭᠡᠨ ᠨᠡᠭᠦᠺᠦ</unicode>
          <definition>changer de demeure</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
