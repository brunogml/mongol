      <dico>Lessing</dico>
      <unicode>ᠵᠣᠯᠢᠬ</unicode>
      <uighur>ǰoliq</uighur>
      <cyrillic>золиг</cyrillic>
      <transcript>ZOLIΓ</transcript>
      <definition>n. Ransom, rescue; figurines usually made of dough which are used in Lamaistic ritual for ridding one of evil spirits causing illness; devil (curse).</definition>
      <page>1070</page>
      <examples>
        <example>
          <unicode>ᠵᠣᠯᠢᠬ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <transcript>-- γarγaxu</transcript>
          <definition>To pay a ransom; to dispose of a</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠯᠢᠬ ᠮᠠᠯ</unicode>
          <transcript>-- mal</transcript>
          <definition>Ransom cattle; cattle returned to the wife's family after a divorce.</definition>
        </example>
        <example>
          <unicode>ᠮᠣᠷᠢᠨ ᠵᠣᠯᠢᠬ</unicode>
          <transcript>morin --</transcript>
          <definition>Ransom paid in horses.</definition>
        </example>
      </examples>
    </entry_item>
