  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠣᠭᠣᠬᠯᠠᠬᠣ</unicode>
      <uighur>ǰoγuqlaqu</uighur>
      <cyrillic>зооглох</cyrillic>
      <transcript>ZOΓUΓLA-</transcript>
      <definition>v.t. To eat, drink; to wear, put on; to mount or ride; to be affected (as by illness). Used in elevated style exclusively.</definition>
      <page>1067</page>
      <examples>
        <example>
          <unicode>ᠴᠢᠯᠡᠭᠡ ᠵᠣᠭᠣᠬᠯᠠᠬᠣ</unicode>
          <transcript>cilege --xu</transcript>
          <definition>To be ill.</definition>
        </example>
        <example>
          <unicode>ᠺᠢᠯᠢᠩ ᠵᠣᠭᠣᠬᠯᠠᠬᠣ</unicode>
          <transcript>kiling --xu</transcript>
          <definition>Tobe angry.</definition>
        </example>
        <example>
          <unicode>ᠮᠣᠷᠢ ᠵᠣᠭᠣᠬᠯᠠᠬᠣ</unicode>
          <transcript>mori --xu</transcript>
          <definition>To mount or ride a horse.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠢᠭᠦᠨ᠎ᠡ ᠲᠢᠲᠢᠮ ᠵᠣᠭᠣᠬᠯᠠᠬᠣ</unicode>
          <transcript>terigyn-e titim --</transcript>
          <definition>To put on a diadem, headgear.</definition>
        </example>
        <example>
          <unicode>ᠬᠤᠪᠴᠠᠰᠤᠨ ᠵᠣᠭᠣᠬᠯᠠᠬᠣ</unicode>
          <transcript>xubcasun --xu</transcript>
          <definition>To dress, clothe (of a dignitary).</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠵᠣᠭᠤᠬᠯᠠᠬᠤ</unicode>
      <definition>1 manger et boire, faire bonne chère: 
2 mettre, ou porter (un habit).</definition>
      <page>2376</page>
      <examples>
        <example>
          <unicode>ᠪᠤᠭᠤᠷᠰᠤᠬ ᠵᠣᠭᠤᠬᠯᠠᠬᠤ</unicode>
          <definition>manger de la pâtisserie</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠢᠭᠦᠨ ᠡ ᠳᠢᠳᠢᠮ ᠵᠣᠭᠤᠬᠯᠠᠬᠤ</unicode>
          <definition>mettre un bonnet sur la tête</definition>
        </example>
        <example>
          <unicode>ᠴᠠᠭᠠᠵᠤᠩᠲᠤ ᠴᠠᠢ ᠎ᠶᠢᠨ ᠬᠠᠭᠠᠰ ᠢ ᠵᠣᠭᠤᠬᠯᠠᠬᠤ</unicode>
          <definition>prendre une demie tasse de thé</definition>
        </example>
        <example>
          <unicode>ᠭᠡᠭᠡᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠬᠤᠪᠴᠠᠰᠤᠨ ᠵᠣᠭᠤᠬᠯᠠᠬᠤ</unicode>
          <definition>habiller un saint</definition>
        </example>
      </examples>
    </entry_item>
