      <dico>Lessing</dico>
      <unicode>ᠵᠣᠯ</unicode>
      <uighur>ǰol</uighur>
      <cyrillic>зол</cyrillic>
      <transcript>ZOL</transcript>
      <definition>n. Good luck, fortime, good result, success.</definition>
      <page>1069</page>
      <examples>
        <example>
          <unicode>ᠵᠣᠯ ᠪᠣᠯᠬᠤ</unicode>
          <transcript>-- bolxu</transcript>
          <definition>To be lucky or successful; to be advantageous.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠯ ᠢᠶᠠᠷ</unicode>
          <transcript>-- ijer</transcript>
          <definition>Fortunately, luckily.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠯ ᠰᠠᠶᠢᠨ</unicode>
          <transcript>-- sain</transcript>
          <definition>Good luck, success;</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠯ ᠦᠭᠡᠢ</unicode>
          <transcript>-- ygei</transcript>
          <definition>No luck or success; successful; dishonest, ignoble, worthless</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠯ ᠦᠭᠡᠢ ᠡᠳ</unicode>
          <transcript>-- ygei ed</transcript>
          <definition>Worthless stuff, trash.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠯ ᠦᠭᠡᠢ ᠵᠠᠩ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <transcript>-- ygei zang γarγaxu</transcript>
          <definition>To act dishonestly or shamelessly.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠯ ᠵᠠᠪᠰᠢᠶᠠᠨ</unicode>
          <transcript>-- zabsijan</transcript>
          <definition>Fortune, happiness.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠯ ᠵᠠᠶᠠᠭ᠎ᠠ</unicode>
          <transcript>-- zajaγ-a</transcript>
          <definition>Fate, destiny; good luck, lucky chance , fortune, happiness.</definition>
        </example>
      </examples>
