      <dico>Lessing</dico>
      <unicode>ᠵᠢᠮ᠎ᠡ</unicode>
      <uighur>ǰim-e</uighur>
      <cyrillic>зэм</cyrillic>
      <transcript>ZIM-E</transcript>
      <definition>[= zem-e, 1] n. Conduct, manner of behavior, procedure; blame, reprimand; fault.</definition>
      <page>1056</page>
      <examples>
        <example>
          <unicode>ᠵᠢᠮ᠎ᠡ ᠶᠣᠰᠤ</unicode>
          <transcript>-- josu</transcript>
          <definition>Custom, conduct, procedure.</definition>
        </example>
        <example>
          <unicode>ᠵᠢᠮ᠎ᠡ ᠶᠣᠰᠤᠲᠤ</unicode>
          <transcript>-- josutu</transcript>
          <definition>Penitent</definition>
        </example>
        <example>
          <unicode>ᠪᠡᠶ᠎ᠡ ᠳ᠋‍‍ᠤ‍ᠷ ᠵᠢᠮ᠎ᠡ ᠬᠠᠯᠳᠠᠬᠤ</unicode>
          <transcript>bej-e dyr -- xaldaxu</transcript>
          <definition>To be blamed for, be accused of.</definition>
        </example>
        <example>
          <unicode>ᠶᠠᠯ᠎ᠠ ᠵᠢᠮ᠎ᠡ</unicode>
          <transcript>jal-a --</transcript>
          <definition>Punishment, penalty.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
