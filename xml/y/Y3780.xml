      <dico>Lessing</dico>
      <unicode>ᠵᠣᠨ</unicode>
      <uighur>ǰun</uighur>
      <cyrillic>зун</cyrillic>
      <transcript>ZUN</transcript>
      <definition>n. and adv. Summer; in summer.</definition>
      <page>1079</page>
      <examples>
        <example>
          <unicode>ᠵᠣᠨ ᠢᠶᠠᠷ</unicode>
          <transcript>-- ijer</transcript>
          <definition>In summer, during summer.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠨ ᠢᠶᠠᠷ ᠢᠶᠠᠨ ᠰᠠᠭᠤᠬᠤ</unicode>
          <transcript>-- ijer ijen saγuxu</transcript>
          <definition>To live as in summer.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠨ ᠤ ᠠᠳᠠᠭ ᠰᠠᠷ᠎ᠠ</unicode>
          <transcript>-- u adaγ sar-a</transcript>
          <definition>Last month of summer ( July).</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠨ ᠤ ᠪᠠᠭᠤᠴᠠ</unicode>
          <transcript>-- u baγuca</transcript>
          <definition>The waning of a summer day.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠨ ᠤ ᠳᠤᠮᠳᠠ ᠰᠠᠷ᠎ᠠ</unicode>
          <transcript>-- u dumda sar -a</transcript>
          <definition>Mid-month of summer ( June).</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠨ ᠤ ᠡᠺᠢᠨ ᠰᠠᠷ᠎ᠠ</unicode>
          <transcript>-- u ekin sar-a</transcript>
          <definition>First month of summer (May)</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠨ ᠤᠨ ᠭᠡᠷ</unicode>
          <transcript>-- -- un ger</transcript>
          <definition>Summer home, villa.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠨ ᠤ ᠣᠷᠤᠰᠢᠯ</unicode>
          <transcript>-- -- u orusil</transcript>
          <definition>Beginning of summer; summer dwelling place.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠨ ᠤ ᠲᠠᠺᠢᠯ</unicode>
          <transcript>-- -- u takil</transcript>
          <definition>Summer sacrifice.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠨ ᠤ ᠲᠤᠶᠢᠯ</unicode>
          <transcript>-- -- u tuil</transcript>
          <definition>Summer solstice.</definition>
        </example>
      </examples>
