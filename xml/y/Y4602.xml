  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠤᠵᠠᠭᠠᠳᠬᠠᠬᠤ</unicode>
      <uighur>ǰuǰaγadqaqu</uighur>
      <cyrillic>зузаатгах</cyrillic>
      <transcript>ZUZAΓADXA-</transcript>
      <definition>[v. caus. of zuzaγad-] v.t. To make thick; to strengthen.</definition>
      <page>1081</page>
      <examples>
        <example>
          <unicode>ᠠᠵᠤ ᠠᠬᠤᠢ ᠎ᠶᠢ ᠵᠤᠵᠠᠭᠠᠳᠬᠠᠬᠤ</unicode>
          <transcript>azu axui ji --xu</transcript>
          <definition>To strengthen the economy.</definition>
        </example>
        <example>
          <unicode>ᠪᠠᠲᠤᠯᠠᠨ ᠬᠠᠮᠠᠭᠠᠯᠠᠬᠤ ᠺᠡᠷᠡᠭ ᠢ ᠵᠤᠵᠠᠭᠠᠳᠬᠠᠬᠤ</unicode>
          <transcript>batulan xamaγalaxu kereg i --xu</transcript>
          <definition>To strengthen the defense.</definition>
        </example>
        <example>
          <unicode>ᠺᠡᠪ ᠬᠠᠤᠯᠢ ᠎ᠶᠢ ᠵᠤᠵᠠᠭᠠᠳᠬᠠᠬᠤ</unicode>
          <transcript>keb xauli ji --xu</transcript>
          <definition>To strenthen or vitalize the ancient customs.</definition>
        </example>
        <example>
          <unicode>ᠺᠦᠴᠦᠨ ᠢ ᠵᠤᠵᠠᠭᠠᠳᠬᠠᠬᠤ</unicode>
          <transcript>kycyn i --xu</transcript>
          <definition>To strengthen the power.</definition>
        </example>
        <example>
          <unicode>ᠬᠣᠯᠪᠤᠭ᠎ᠠ ᠵᠤᠵᠠᠭᠠᠳᠬᠠᠬᠤ</unicode>
          <transcript>xolbuy-a --xu</transcript>
          <definition>To strengthenan alliance.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠵᠣᠵᠠᠭᠠᠳᠬᠠᠬᠤ</unicode>
      <definition>1 rendre gros, grossier, épais; épaissir, 
2 corroborer, raffermir.</definition>
      <page>2393</page>
      <examples>
