    <entry_item>
      <dico>Boberg</dico>
      <unicode>ᠵᠣᠯᠢᠬᠣ</unicode>
      <uighur>ǰoliqu</uighur>
      <definition>v.t. To pledge, to collect. To redeem a pledge. To redeem, to ransom. To change.</definition>
      <page>1244</page>
      <examples>
        <example>
          <uighur>nigen üge ber ǰoliǰu ögülebesü</uighur>
          <definition>In other words.</definition>
        </example>
      </examples>
