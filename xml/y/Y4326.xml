    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠣᠯᠢᠬᠣ</unicode>
      <uighur>ǰoliqu</uighur>
      <cyrillic>золих</cyrillic>
      <transcript>ZOLI-</transcript>
      <definition>v. t. To ransom, redeem.</definition>
      <page>1070</page>
      <examples>
        <example>
          <unicode>ᠵᠣᠯᠢᠵᠤ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <transcript>--zu γarγaxu</transcript>
          <definition>To deliver, redeem; to free from prison.</definition>
        </example>
        <example>
          <unicode>ᠠᠮᠢ ᠵᠣᠯᠢᠬᠣ</unicode>
          <transcript>ami --xu</transcript>
          <definition>To ransom oneself.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠵᠣᠯᠢᠬᠤ</unicode>
      <definition>1 rançonner, racheter , reprendre tout ce qu'on avait mis en gage: 
2 faire payer, condamner à une amende.</definition>
      <page>2387</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠢᠨ ᠵᠣᠯᠢᠬᠤ</unicode>
          <definition>payer une rançon pour sa vie</definition>
        </example>
        <example>
          <unicode>ᠡᠳ ᠲᠠᠸᠠᠷ ᠢᠶᠠᠷ ᠵᠣᠯᠢᠬᠤ</unicode>
          <definition>se racheter par des effets</definition>
        </example>
        <example>
          <unicode>ᠥᠪᠡᠷ ᠢᠶᠡᠨ ᠦᠨᠡᠨ ᠪᠡᠷ ᠵᠣᠯᠢᠵᠤ ᠠᠪᠬᠤ</unicode>
          <definition>racheter à prix d'argent</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠯᠢᠵᠤ ᠭᠠᠷᠭᠠᠬᠤ</unicode>
          <definition>délivrer, racheter, affranchir (de la prison)</definition>
        </example>
        <example>
          <unicode>ᠶᠡᠺᠡ ᠤᠰᠤᠨ ᠳ᠋‍‍ᠤ‍ᠷ ᠠᠮᠢᠨ ᠢᠶᠠᠨ ᠵᠣᠯᠢᠬᠤ</unicode>
          <definition>s'exposer au danger pendant la traversée sur mer</definition>
        </example>
      </examples>
    </entry_item>
