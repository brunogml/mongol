    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠥᠯᠺᠥᠺᠥ</unicode>
      <uighur>ǰülgükü</uighur>
      <cyrillic>зүлгэх</cyrillic>
      <transcript>ZYLGY-</transcript>
      <definition>[= zilgy-] v.t. To wipe, polish, dust; to rub or brush against.</definition>
      <page>1085</page>
      <examples>
        <example>
          <unicode>ᠰᠢᠷᠡᠭᠡᠨ ᠢ ᠵᠥᠯᠺᠥᠺᠥ</unicode>
          <transcript>siregen i --ky</transcript>
          <definition>To dust, wipe, or polish a table.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠵᠦᠯᠺᠦᠺᠦ</unicode>
      <definition>1 frotter avec un linge, etc, (lès hois des flèches après l'avoir raclé), polir, lisser, ôter la rouille, aiguiser: 
2 lancer, jeter en lançant.</definition>
      <page>2415</page>
      <examples>
        <example>
          <unicode>ᠰᠤᠮᠤᠨ ᠢᠶᠠᠨ ᠵᠦᠯᠭᠦᠵᠢ ᠣᠷᠺᠢᠪᠠ</unicode>
          <definition>il lança une flèche en l'air</definition>
        </example>
        <example>
          <unicode>ᠴᠢᠯᠠᠭᠤᠨ ᠢ ᠵᠦᠯᠭᠦᠺᠦ</unicode>
          <definition>polir une pierre</definition>
        </example>
      </examples>
    </entry_item>
