    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠠᠨᠴᠢᠬᠣ</unicode>
      <uighur>ǰančiqu</uighur>
      <cyrillic>занчих - жанчих</cyrillic>
      <transcript>ZANCI-</transcript>
      <definition>[= nanci-, zangci-] v. t. To beat, hit; to punish by hitting with rods or a whip; to thrash, whip.</definition>
      <page>1034</page>
      <examples>
        <example>
          <unicode>ᠵᠠᠨᠴᠢᠵᠤ ᠵᠠᠯᠴᠠᠭᠠᠬᠤ</unicode>
          <transcript>--zu zalxaγaxu</transcript>
          <definition>To punish by whipping.</definition>
        </example>
        <example>
          <unicode>ᠦᠺᠦᠲᠡᠯ᠎ᠡ ᠵᠠᠨᠴᠢᠬᠣ</unicode>
          <transcript>ykytel-e --xu</transcript>
          <definition>To beat to death.</definition>
        </example>
      </examples>
    </entry_item>
