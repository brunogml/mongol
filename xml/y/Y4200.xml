    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠶᠣᠰᠣᠴᠢᠯᠠᠬᠣ</unicode>
      <uighur>yosučilaqu</uighur>
      <cyrillic>ёсчлох</cyrillic>
      <transcript>JOSUCILA-</transcript>
      <definition>v.i. To act according to custom, law or rule.</definition>
      <page>436</page>
      <examples>
        <example>
          <unicode>ᠶᠣᠰᠣᠴᠢᠯᠠᠨ</unicode>
          <transcript>--no </transcript>
          <definition>According to custom or rules; regularly, justly, properly, legally</definition>
        </example>
        <example>
          <unicode>ᠶᠣᠰᠣᠴᠢᠯᠠᠨ ᠳᠠᠭᠠᠬᠤ</unicode>
          <transcript>--n daγaxu, </transcript>
          <definition>To conform to</definition>
        </example>
        <example>
          <unicode>ᠶᠣᠰᠣᠴᠢᠯᠠᠨ ᠭᠦᠢᠴᠡᠳᠺᠡᠺᠦ</unicode>
          <transcript>--n gyicedkeky</transcript>
          <definition> To fulfill in a proper way.</definition>
        </example>
        <example>
          <unicode>ᠶᠣᠰᠣᠴᠢᠯᠠᠨ ᠦᠢᠯᠡᠳᠺᠦ</unicode>
          <transcript>--n yiledky</transcript>
          <definition> To follow the custom or rule in doing something.</definition>
        </example>
        <example>
          <unicode>ᠶᠣᠰᠣᠴᠢᠯᠠᠵᠤ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>--zu jabuxu</transcript>
          <definition> To conduct oneself or behave well, act according to reason, law or custom; to proceed ethically.</definition>
        </example>
        <example>
          <unicode>ᠬᠠᠤᠯᠢ ᠎ᠶᠢ ᠶᠣᠰᠣᠴᠢᠯᠠᠨ ᠳᠠᠭᠠᠬᠤ</unicode>
          <transcript>xauli ji --n daγaxu </transcript>
          <definition>To proceed legally, act according to law</definition>
        </example>
      </examples>
    </entry_item>
