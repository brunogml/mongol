  <entries>
    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵ᠎ᠠ</unicode>
      <uighur>ǰ-a</uighur>
      <transcript>Z-A</transcript>
      <definition> A particle which after the narrative present in -mui / -myi and the verb bui expresses presumption, probability, or hope.</definition>
      <page>1018</page>
      <examples>
        <example>
          <unicode>ᠠᠮᠤᠭᠤᠯᠠᠩ ᠰᠠᠭᠠᠲᠠᠵᠤ ᠠᠮᠤᠢ ᠎ᠵᠠ</unicode>
          <transcript>amuγulang saγatazu amui -- </transcript>
          <definition> [I] presume that [you] are in good health (epist. ).</definition>
        </example>
        <example>
          <unicode>... ᠪᠤᠢ ᠎ᠵᠠ ᠪᠢᠵ᠎ᠠ</unicode>
          <transcript>.. bui -- = ... biz-a. </transcript>
          <definition>Most probably.</definition>
        </example>
        <example>
          <unicode>ᠢᠷᠡᠮᠦᠢ ᠎ᠵᠠ</unicode>
          <transcript>iremyi -- </transcript>
          <definition> Will probably come.</definition>
        </example>
        <example>
          <unicode>ᠲᠡᠷᠡ ᠶᠠᠪᠤᠭᠰᠠᠨ ᠪᠤᠢ ᠎ᠵᠠ</unicode>
          <transcript>tere jabuγsan bui -- </transcript>
          <definition> [I] presume that he must have gone.</definition>
        </example>
        <example>
          <unicode>ᠤᠴᠢᠷᠠᠯᠳᠤᠬᠤ ᠦᠯᠦ ᠪᠣᠯᠣᠮᠤᠢ ᠎ᠵᠠ</unicode>
          <transcript>uciralduxu yly bolumui -- </transcript>
          <definition> Perhaps we shall not meet again.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
