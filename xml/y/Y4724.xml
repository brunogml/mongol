    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠣᠺᠢᠯᠳᠣᠬᠣ</unicode>
      <uighur>ǰokildoqu</uighur>
      <cyrillic>зохилдох</cyrillic>
      <transcript>ZOKILDU-</transcript>
      <definition>[v.rec. of zoki-] To agree, conform, be congruent, be in agreement; to suit each other</definition>
      <page>1069</page>
      <examples>
        <example>
          <unicode>ᠵᠣᠺᠢᠯᠳᠣᠨ ᠪᠠᠷᠢᠯᠳᠤᠬᠤ</unicode>
          <transcript>--n barilduxu</transcript>
          <definition>To be united in agreement, harmony.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠺᠢᠯᠳᠣᠨ ᠶᠠᠪᠤᠬᠤ</unicode>
          <transcript>--n jabuxu</transcript>
          <definition>To live as friends, in agreement, harmony.</definition>
        </example>
        <example>
          <unicode>ᠵᠣᠺᠢᠯᠳᠣᠬᠣ ᠦᠭᠡᠢ</unicode>
          <transcript>--xu ygei</transcript>
          <definition>Unsuitable, unfit, inadmissible, inapprpriate, disharmonious, discordant</definition>
        </example>
        <example>
          <unicode>ᠦᠯᠦ ᠵᠣᠺᠢᠯᠳᠣᠬᠣ</unicode>
          <transcript>--xu</transcript>
          <definition>Not fitting, inappropriate.</definition>
        </example>
      </examples>
    </entry_item>
