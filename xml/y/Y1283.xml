      <cyrillic>залбирах - залбарах</cyrillic>
      <transcript>ZALBARI-</transcript>
      <definition>v.i. To pray; to join the palms of ones hands in praying</definition>
      <page>1030</page>
      <examples>
        <example>
          <unicode>ᠵᠠᠯᠪᠠᠷᠢᠨ ᠭᠤᠶᠤᠬᠤ</unicode>
          <transcript>--n γujuxu</transcript>
          <definition>To supplicate, implore.</definition>
        </example>
        <example>
          <unicode>ᠭᠤᠷᠪᠠᠨ ᠡᠷᠳᠡᠨᠢ ᠳ᠋‍‍ᠤ‍ᠷ ᠵᠠᠯᠪᠠᠷᠢᠬᠣ</unicode>
          <transcript>γurban erdeni dyr --xu</transcript>
          <definition>To adore the 'three Jewels'</definition>
        </example>
      </examples>
    </entry_item>
