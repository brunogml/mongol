    <entry_item>
      <dico>Lessing</dico>
      <unicode>ᠵᠠᠶᠢᠯᠠᠭᠣᠯᠬᠣ</unicode>
      <uighur>ǰayilaγulqu</uighur>
      <cyrillic>зайлуулах</cyrillic>
      <transcript>ZAILAΓUL-</transcript>
      <definition>[v. caus. of zaila- j v. t. To move, remove; to evacuate.</definition>
      <page>1027</page>
      <examples>
        <example>
          <unicode>ᠵᠠᠶᠢᠯᠠᠭᠣᠯᠵᠤ ᠰᠠᠭᠤᠯᠭᠠᠬᠤ</unicode>
          <transcript>--zu saγulγaxu</transcript>
          <definition>To cause to move to another seat; to resettle (a person, a family, or population).</definition>
        </example>
        <example>
          <unicode>ᠠᠵᠢᠯ ᠡᠴᠡ ᠵᠠᠶᠢᠯᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>azil ece --xu</transcript>
          <definition>To dismiss from work.</definition>
        </example>
        <example>
          <unicode>ᠴᠡᠪᠡᠷᠯᠡᠨ ᠵᠠᠶᠢᠯᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>ceberlen --xu</transcript>
          <definition>To remove, move out of the way; to purge.</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠤᠨ ᠡᠴᠡ ᠵᠠᠶᠢᠯᠠᠭᠣᠯᠬᠣ</unicode>
          <transcript>orun ece --xu</transcript>
          <definition>To remove from a place or an office.</definition>
        </example>
      </examples>
    </entry_item>
    <entry_item>
      <dico>Kowalewski</dico>
      <unicode>ᠵᠠᠶᠢᠯᠠᠭᠤᠯᠬᠤ</unicode>
      <definition>forcer de s'écarter du chemin; éloigner, mettre de côté.</definition>
      <page>2235</page>
      <examples>
        <example>
          <unicode>ᠢᠯᠠᠭ᠎ᠠ ᠪᠠᠳᠠᠭᠠᠨᠠ ᠎ᠶᠢ ᠬᠣᠯᠠ ᠵᠠᠶᠢᠯᠠᠭᠤᠯᠬᠤ</unicode>
          <definition>chasser les cousins et les moucherons</definition>
        </example>
        <example>
          <unicode>ᠣᠷᠣᠨ ᠡᠴᠡ ᠵᠠᠶᠢᠯᠠᠭᠤᠯᠬᠤ</unicode>
          <definition>chasser, pousser dehors</definition>
        </example>
        <example>
          <unicode>ᠵᠠᠶᠢᠯᠠᠭᠤᠯᠬᠤᠢ ᠮᠠᠯ</unicode>
          <definition>le bétail qu'il faut enfermer dans l'étable</definition>
        </example>
      </examples>
    </entry_item>
